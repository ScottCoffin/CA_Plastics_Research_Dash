# Add-on A1 release bundles and large local Parquet; keep slim fixtures versioned.
release/
# Large local Parquet files must use the .large.parquet suffix.
*.large.parquet

# Spike tooling (SPK-3/SPK-4): npm installs and Framework build cache
node_modules/
**/.observablehq/cache/

# Private outreach contacts and consent records (owner decision 2026-11-11): never commit.
data/private/

# S3.8 SEO entity pages and sitemaps: generated at deploy time only, never committed.
site/california/experts/
site/california/institutions/
# Before PLAT-1 (2026-11-17) the SEO pages were written at the root; keep stale local copies ignored.
site/experts/
site/institutions/
site/sitemap*.xml

# Local previews and spike outputs, never committed (2026-11-14):
# Quarto preview renders of agent files (e.g. quarto render .agent/QUESTIONS.md).
.agent/*.html
.agent/*_files/
# SPK-1 synthetic hosting Parquet (spikes/spk1_hosting/make_parquet.py; spike closed 2026-11-10).
data/processed/p5.parquet
data/processed/p25.parquet
data/processed/p100.parquet

# Agent state travels with the repo (owner, 2026-11-17): un-ignore the Claude local settings
# (Impeccable hooks), which a global git ignore would otherwise hide.
!.claude/settings.local.json

# PLAT-2: landing images copied from site/assets/landing by framework/scripts/sync_shared.mjs.
framework/src/assets/landing/

# Ambassador Worker (AMB-1 slice 1): local dependencies, wrangler state and local secrets
worker/.wrangler/
worker/.dev.vars
worker/dist/
