atlas_index":true,"last_year":2025,"name":"Yi-Sheng Chen","plastic_citations":0,"plastic_works_count":1,"topics":[["analytical_methods",1],["wastewater_and_treatment",1]],"works_at_institution":1,"years":{"2025":1}}],"institution":{"atlas_type":"company","author_count":8,"ca_flag":true,"city":"San Ramon","domain_tags":["analytical_methods","matrix:food_and_drink","wastewater_and_treatment"],"inst_id":"I4210118014","lat":37.77993,"lon":-121.97802,"name":"Chevron (United States)","region":"California","ror":"02jfa8730","scope":"california","work_count":3},"schema_version":"s3.1","works":[{"abstract":"","author_ids":["A5003971829","A5042755239","A5066611725","A5092920300","A5129633028"],"author_names":["Kelvin Adrah","Daniel Ananey-Obiri","Ruth Boahemaah Awuku","Rashid Adedeji","Reza Tahergorabi"],"ca_any_author":true,"ca_led":false,"cited_by_count":1,"doi":"https://doi.org/10.1007/978-3-030-11155-7_149-2","domain_tags":[],"facet_tags":["matrix:food_and_drink"],"institution_ids":["I35777872","I4210118014"],"is_oa":false,"journal":"Springer eBooks","last_updated":"2026-10-10T09:11:00.788812","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1007/978-3-030-11155-7_149-2","openalex_topics":["T10488","T10661","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2026-01-01","study_type":"book-chapter","title":"Development of Biobased and Biodegradable Plastics","type":"book-chapter","work_id":"W7133294410","year":2026},{"abstract":"Mesoporous Y (Meso-Y) zeolites are an emerging class of catalysts with mesopores (typically smaller than 9 nm in diameter) for accommodating sterically bulky reactant molecules, such as those commonly encountered in biomass and polymer waste upcycling. Here, in this manuscript, we report the synthesis, physicochemical characterization, and catalysis of novel Meso-Y zeolites consisting of tunable mesopores ranging from 9 to 20 nm in diameter and mesopore volumes of approximately 0.6 cm 3 /g. Our synthetic approach involves partial dissolution of the zeolite framework and zinc redistribution during calcination and hydrothermal treatment (HT) of conventional Meso-Y zeolites. The synthesis proceeds through an intermediate zinc-rich zincoaluminosilicate (ZnAlSi) phase, which was characterized by scanning electron microscopy\u2013energy-dispersive X-ray spectroscopy (SEM-EDX) before HT as a phase partially separated from the zeolite in syntheses involving high zinc concentrations. SEM-EDX characterization of these materials after HT demonstrates large mesopores, accompanied by zinc levels redistributing to the same uniformly low values throughout the material. Data from SEM, scanning transmission electron microscopy\u2013energy-dispersive X-ray spectroscopy (STEM-EDS), and high-angle annular dark-field\u2013scanning transmission electron microscopy (HAADF-STEM) show the synthesis of large mesopores after HT within the zeolite. H/D exchange and n -decane hydroconversion data prove acid-site accessibility in our catalysts under thermodynamically and kinetically controlled conditions, respectively, which is similar to a conventional Meso-Y control catalyst.","author_ids":["A5001705651","A5004773300","A5018333095","A5023656083","A5039442086","A5043668343","A5069459050","A5071006382","A5077106676","A5087892496","A5100600696","A5100652667"],"author_names":["Xuemin Li","Oleksandr O. Trybrat","Abraham Martinez","Jinyi Han","Kaustav Chaudhuri","Yi-Sheng Chen","Cong-Yan Chen","Michael Girgis","Joel E. Schmidt","Howard S. Lacheen","A. Kuperman","Son\u2010Jong Hwang","Alexander Katz"],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.1021/acs.chemmater.5c02486","domain_tags":["analytical_methods","wastewater_and_treatment"],"facet_tags":[],"institution_ids":["I122411786","I2803209242","I4210118014","I95457486"],"is_oa":false,"journal":"Chemistry of Materials","last_updated":"2026-10-28T10:33:24.094632","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.chemmater.5c02486","openalex_topics":["T10096","T10353","T10735"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10353","pub_date":"2025-11-11","study_type":"article","title":"Large-Mesopore Catalysts Synthesized via Calcination and Hydrothermal Treatment of Zinc-Meso-Y Zeolite Composites","type":"article","work_id":"W4416674436","year":2025},{"abstract":"Multi-scale upcycling of PPG polymer synthesizes propionaldehyde in 95% selectivity & 86% yield.","author_ids":["A5001705651","A5039379015","A5039442086","A5043668343","A5045044600","A5066549311","A5069459050","A5077106676","A5079400136","A5087892496","A5100652667"],"author_names":["Abraham Martinez","Kanan Shikhaliyev","Xuemin Li","Jinyi Han","Kaustav Chaudhuri","Son\u2010Jong Hwang","Jagoda M. Urban-Klaehn","A. Kuperman","Anne M. Gaffney","Jochen A. Lauterbach","Alexander Katz"],"ca_any_author":true,"ca_led":true,"cited_by_count":2,"doi":"https://doi.org/10.1039/d4re00001c","domain_tags":[],"facet_tags":[],"institution_ids":["I122411786","I155781252","I2800102766","I4210118014","I95457486"],"is_oa":true,"journal":"Reaction Chemistry & Engineering","last_updated":"2026-10-01T08:54:57.152042","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://pubs.rsc.org/en/content/articlepdf/2024/re/d4re00001c","openalex_topics":["T10353","T11009","T11831"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10353","pub_date":"2024-01-01","study_type":"article","title":"A multiscale investigation of polypropylene glycol polymer upcycling to propionaldehyde via catalytic cracking on acid sites of mesoporous Y zeolites","type":"article","work_id":"W4400201002","year":2024}]}
