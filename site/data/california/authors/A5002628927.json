ic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":167,"plastic":0,"year":2017},{"all":223,"plastic":0,"year":2018},{"all":194,"plastic":0,"year":2019},{"all":193,"plastic":0,"year":2020},{"all":196,"plastic":0,"year":2021},{"all":178,"plastic":0,"year":2022},{"all":166,"plastic":0,"year":2023},{"all":189,"plastic":0,"year":2024},{"all":188,"plastic":0,"year":2025},{"all":162,"plastic":0,"year":2026}],"cited_by_count":3641,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1892,"first_year":2026,"h_index":31,"institution_ids":["I154570441"],"last_ca_year":2026,"last_year":2026,"m_quotient":0.23,"name":"Erik B. Muller","orcid":"https://orcid.org/0000-0003-2300-0727","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":3,"primary_affiliations":[{"country_code":"US","id":"I154570441","name":"University of California, Santa Barbara","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W7160235137"]},"schema_version":"s3.1","works":[{"abstract":"Microplastics (MP) have become a major concern due to their ubiquity and persistence in the environment. Polyethylene terephthalate (PET) is a widely used type of polymer that has been abundantly found in aquatic ecosystems. Since microplastics can hinder the energy uptake from food of various aquatic animals, a phenomenon known as food dilution, we investigated the impacts of PET microplastics on the energy budget of the freshwater cladoceran Daphnia magna . Individual daphnids were exposed to 0, 125, 250 or 500 mg L \u22121 of PET microplastics (irregular shape, <63 \u03bcm), at two food levels (ad libitum or restricted), and changes in their life history traits were monitored for 21 d. A Dynamic Energy Budget (DEB) model was then applied to determine the potential physiological mode of action (PMoA) and provide mechanistic understanding of the combined effects of PET microplastics and food availability on D. magna . We found that chronic exposure to microplastics decreased survival during the embryonic period, restricted energy acquisition from food and altered the growth and reproduction of the daphnids. Low food conditions induced mortality and exacerbated the effects of microplastics on growth and reproduction. This work provides insights into the impact of resource limitations on the toxicity of an understudied polymer and sets up a mechanistic basis to extrapolate these effects to the population level, thereby supporting more ecologically realistic risk assessment of PET microplastics.","author_count":7,"author_ids":["A5002628927","A5005854883","A5013241968","A5020842159","A5023202616","A5025558208","A5037926764"],"author_institution_ids":["I154570441"],"authors":[{"id":"A5013241968","name":"Safa Chaabani"},{"id":"A5025558208","name":"Gabri\u00ebl Olthof"},{"id":"A5002628927","name":"Erik B. Muller"},{"id":"A5020842159","name":"Martin Wagner"},{"id":"A5037926764","name":"Veerle L.B. Jaspers"},{"id":"A5023202616","name":"Bettie Cormier"},{"id":"A5005854883","name":"Sigurd Einum"}],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"https://doi.org/10.1016/j.ecolmodel.2026.111929","domain_tags":["risk_assessment"],"facet_tags":["matrix:food_and_drink","matrix:freshwater"],"institution_ids":["I154570441","I204778367"],"is_oa":true,"journal":"Ecological Modelling","last_updated":"2026-11-27T09:11:17.138145","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://www.sciencedirect.com/science/article/pii/S0304380026004576/pdf","openalex_topics":["T10419","T10447","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-11-24","study_type":"article","title":"Combined effects of PET microplastics and food availability on the life-history traits of Daphnia magna: Mechanistic insights from DEB-TKTD modelling","type":"article","work_id":"W7160235137","year":2026}]}
