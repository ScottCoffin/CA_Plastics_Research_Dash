r":2026}],"cited_by_count":21995,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1999,"first_year":2026,"h_index":46,"institution_ids":["I36258959"],"last_ca_year":2026,"last_year":2026,"m_quotient":1.7,"name":"Lilia M. Iakoucheva","orcid":"https://orcid.org/0000-0002-4542-5219","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I36258959","name":"University of California San Diego","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W7236377746"]},"schema_version":"s3.1","works":[{"abstract":"Cortical organoids generate multiple neural rosettes, self-organizing and radially arranged structures that resemble ventricular zones of the developing brain. Here, we show that these rosettes, commonly considered as discrete entities, originate from an interconnected tubular network. We demonstrate that the formation of this continuous structure involves neuroepithelial folding, invagination, and internalization, resembling aspects of neural tube formation. Using fluorescently labeled polyethylene nanoplastics as extracellular tracers, we further show that they accumulate within the developing tubular lumen, consistent with its formation through neuroepithelial folding and internalization. These findings provide new insights into early human brain morphogenesis and suggest the potential utility of cortical organoids for investigating developmental processes relevant to neural tube defects.","author_count":5,"author_ids":["A5003090019","A5048323500","A5089578176","A5112172625","A5162757860"],"author_institution_ids":["I36258959"],"authors":[{"id":"A5089578176","name":"Luca Trov\u00f2"},{"id":"A5112172625","name":"Gimena G\u00f3mez"},{"id":"A5162757860","name":"Ashley Einhorn"},{"id":"A5048323500","name":"Alysson Renato Muotri"},{"id":"A5003090019","name":"Lilia M. Iakoucheva"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.64898/2026.11.16.767152","domain_tags":[],"facet_tags":[],"institution_ids":["I36258959","I4405269653"],"is_oa":true,"journal":"bioRxiv (Cold Spring Harbor Laboratory)","last_updated":"2026-11-24T14:10:38.155754","license":"cc-by-nd","needs_review":false,"oa_status":"green","oa_url":"https://www.biorxiv.org/content/biorxiv/early/2026/11/18/2026.11.16.767152.full.pdf","openalex_topics":["T10268","T10505","T10608"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10608","pub_date":"2026-11-18","study_type":"preprint","title":"Neural rosettes emerge from an interconnected tubular network in human cortical organoids","type":"preprint","work_id":"W7236377746","year":2026}]}
