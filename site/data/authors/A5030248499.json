17},{"all":181,"plastic":0,"year":2018},{"all":393,"plastic":0,"year":2019},{"all":600,"plastic":0,"year":2020},{"all":1045,"plastic":0,"year":2021},{"all":1291,"plastic":0,"year":2022},{"all":2155,"plastic":0,"year":2023},{"all":2222,"plastic":6,"year":2024},{"all":2620,"plastic":5,"year":2025},{"all":2163,"plastic":3,"year":2026}],"cited_by_count":12787,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2012,"first_year":2025,"h_index":52,"institution_ids":["I161318765"],"last_ca_year":2026,"last_year":2025,"m_quotient":3.71,"name":"Nanyun Peng","orcid":"https://orcid.org/0000-0002-8509-6595","plastic_basis":"openalex","plastic_citations":14,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I1291425158","name":"Google (United States)","source":"openalex_last_known"},{"country_code":"US","id":"I130769515","name":"Pennsylvania State University","source":"openalex_last_known"},{"country_code":"US","id":"I157725225","name":"University of Illinois Urbana-Champaign","source":"openalex_last_known"},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"},{"country_code":"CN","id":"I24943067","name":"Fudan University","source":"openalex_last_known"},{"country_code":"US","id":"I51556381","name":"University of Virginia","source":"openalex_last_known"},{"country_code":"CN","id":"I76130692","name":"Zhejiang University","source":"openalex_last_known"}],"rising_pct":48,"rising_score":0.0016,"work_count":1,"work_ids":["W4412888933"]},"schema_version":"s3.1","works":[{"abstract":"A common technique for aligning large language models (LLMs) relies on acquiring human preferences by comparing multiple generations conditioned on a fixed context.This method, however, relies solely on pairwise comparisons, where the generations are evaluated within an identical context.While effective to such conditional preferences often fail to encompass the nuanced and multidimensional nature of human preferences.In this work, we revisit the traditional paradigm of preference acquisition and propose a new axis based on eliciting preferences jointly over the instructionresponse pairs.Unlike prior preference optimizations, which are designed for conditional ranking protocols (e.g., DPO), we propose Joint Preference Optimization (JPO), a new preference optimization objective that upweights the joint probability of the chosen instructionresponse pair over the rejected instructionresponse pair.Interestingly, LLMs trained with joint instruction-response preference data using JPO outperform LLM trained with DPO by 5.2% and 3.3% win-rate for summarization and open-ended dialogue datasets, respectively.Our findings reveal that joint preferences over instruction and response pairs can significantly enhance the alignment of LLMs by tapping into a broader spectrum of human preference elicitation.The data and code is available at https://github.com/Hritikbansal/jpo.Create a list of four fruits other than Apple Create a list of four fruits Apple, Orange, Banana, Grape Orange, Blueberry, Kiwi, Banana Apple, Orange, Banana, Grape Create a list of beach activities wear sunscreen, don't litter","author_count":6,"author_ids":["A5014409944","A5027401438","A5028997209","A5030248499","A5087096372","A5112428050"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5112428050","name":"Hritik Bansal"},{"id":"A5027401438","name":"Ashima Suvarna"},{"id":"A5028997209","name":"Gantavya Bhatt"},{"id":"A5030248499","name":"Nanyun Peng"},{"id":"A5087096372","name":"Kai-Wei Chang"},{"id":"A5014409944","name":"Aditya Grover"}],"ca_any_author":true,"ca_led":true,"cited_by_count":14,"doi":"https://doi.org/10.18653/v1/2025.findings-acl.39","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I161318765","I201448701"],"is_oa":true,"journal":"Findings of the Association for Computational Linguistics: ACL (Findings of ACL)","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://aclanthology.org/2025.findings-acl.39.pdf","openalex_topics":["T10028","T10181","T11307"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10028","pub_date":"2025-01-01","study_type":"conference-paper","title":"Comparing Bad Apples to Good Oranges Aligning Large Language Models via Joint Preference Optimization","type":"conference-paper","work_id":"W4412888933","year":2025}]}
