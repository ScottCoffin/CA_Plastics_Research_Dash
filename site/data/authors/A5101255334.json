{"author":{"affiliation_history":[{"country_code":"US","id":"I71838634","name":"San Francisco State University","years":[2024,2025,2026]},{"country_code":"US","id":"I140172145","name":"University of Connecticut","years":[2024,2025]},{"country_code":"HK","id":"I889458895","name":"University of Hong Kong","years":[2016,2018,2019,2021,2024]},{"country_code":"US","id":"I78577930","name":"Columbia University","years":[2022,2023]},{"country_code":"US","id":"I97018004","name":"Stanford University","years":[2020,2021,2022]}],"author_id":"A5101255334","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":1,"plastic":0,"year":2017},{"all":9,"plastic":0,"year":2018},{"all":17,"plastic":0,"year":2019},{"all":45,"plastic":0,"year":2020},{"all":97,"plastic":0,"year":2021},{"all":110,"plastic":0,"year":2022},{"all":111,"plastic":0,"year":2023},{"all":121,"plastic":0,"year":2024},{"all":133,"plastic":0,"year":2025},{"all":147,"plastic":0,"year":2026}],"cited_by_count":793,"domain_tags":[],"early_career":false,"first_pub_year":2014,"first_year":2024,"h_index":11,"institution_ids":["I71838634"],"last_year":2024,"m_quotient":0.92,"name":"Anand Archana","orcid":"https://orcid.org/0000-0002-1834-6187","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I71838634","name":"San Francisco State University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4402129574"]},"profile":{"bio":"","keywords":[],"links":[{"label":"Lab webpage","url":"http://www.theanandlab.com"}]},"schema_version":"s3.1","works":[{"abstract":"Microplastics are defined as any plastic particles that are smaller than 5mm. They have been found in many of our household products, such as detergents, toothpaste, and other beauty products such as exfoliants. It has also been found that clothes with synthesized fibers, such as acrylics, nylon, and polyester shed hundreds of thousands of microplastic particles every time you wear or wash them. Due to the size of microplastics, they easily pass through many water filtration systems and end up in bodies of water, such as the San Francisco Bay or the Pacific Ocean. This protocol describes the procedure to extract and quantify microplastics in oyster tissue.","author_count":2,"author_ids":["A5099594026","A5101255334"],"author_institution_ids":["I71838634"],"authors":[{"id":"A5099594026","name":"Benjamin-Rafael Mingoa"},{"id":"A5101255334","name":"Anand Archana"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.17504/protocols.io.j8nlk81dxl5r/v1","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I71838634"],"is_oa":true,"journal":"","last_updated":"2026-11-09T13:22:03.289127","license":"cc-by","needs_review":false,"oa_status":"green","oa_url":"https://doi.org/10.17504/protocols.io.j8nlk81dxl5r/v1","openalex_topics":["T10419","T10447","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2024-09-01","study_type":"preprint","title":"Microplastics extraction from oyster tissue v1","type":"preprint","work_id":"W4402129574","year":2024}]}
