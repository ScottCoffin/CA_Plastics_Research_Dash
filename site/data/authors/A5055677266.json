 and show how both specialties continue to be vital for improving health and safety globally.","author_count":3,"author_ids":["A5020788754","A5055677266","A5082408715"],"author_institution_ids":["I36258959"],"authors":[{"id":"A5055677266","name":"Paul A. Insel"},{"id":"A5020788754","name":"Amrita Ahluwalia"},{"id":"A5082408715","name":"Susan Amara"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.1146/annurev-pharmtox-082525-041413","domain_tags":[],"facet_tags":[],"institution_ids":["I1299303238","I166337079","I36258959","I4210158500"],"is_oa":true,"journal":"The Annual Review of Pharmacology and Toxicology","last_updated":"2026-11-06T12:05:46.655746","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1146/annurev-pharmtox-082525-041413","openalex_topics":["T10211","T13656","T14020"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T13656","pub_date":"2025-09-29","study_type":"review","title":"Introduction to the Theme \u201cNew Approaches, Technology, and Techniques That Advance Pharmacology and Toxicology\u201d","type":"review","work_id":"W4414603223","year":2025}]}
