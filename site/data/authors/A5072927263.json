{"author":{"affiliation_history":[{"country_code":"US","id":"I47838141","name":"Saint Louis University","years":[2024,2025,2026]},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","years":[2020,2021,2022,2023]}],"author_id":"A5072927263","ca_plastic_works_count":3,"ca_works_count":3,"citations_by_year":[{"all":4,"plastic":0,"year":2020},{"all":39,"plastic":1,"year":2021},{"all":124,"plastic":19,"year":2022},{"all":156,"plastic":37,"year":2023},{"all":163,"plastic":55,"year":2024},{"all":180,"plastic":49,"year":2025},{"all":131,"plastic":26,"year":2026}],"cited_by_count":798,"current_in_ca":false,"domain_tags":[],"early_career":true,"first_pub_year":2020,"first_year":2021,"h_index":12,"institution_ids":["I161318765"],"last_ca_year":2023,"last_year":2023,"m_quotient":2.0,"name":"Annesh Borthakur","orcid":"https://orcid.org/0000-0002-9321-3683","plastic_basis":"openalex","plastic_citations":187,"plastic_works_count":3,"primary_affiliations":[{"country_code":"US","id":"I47838141","name":"Saint Louis University","source":"openalex_last_known"}],"rising_pct":84,"rising_score":0.0119,"work_count":3,"work_ids":["W4206456970","W4229000651","W4315796571"]},"schema_version":"s3.1","works":[{"abstract":"Stormwater biofilters naturally experience dry-wet and freeze-thaw cycles, which could remobilize deposited particulate pollutants including microplastics. Yet, the effect of these natural weathering conditions on the mobility of deposited microplastics has not been evaluated. We deposited microplastics on columns packed with sand or a mixture of sand with soil (25% by volume) to simulate biofilter media, subjected them to intermittent infiltration events punctuated by either freeze-thaw cycles or drying cycles. Comparing the vertical distribution of microplastics in biofilters after both treatments, we showed that more than 90% of microplastics were retained within the first 3 cm of filter media, but the distribution in deeper layers varied with media type and treatment conditions. Freeze-thaw cycles were more effective than dry-wet cycles in increasing the downward mobility of deposited microplastics. We attributed these results to the disruption of filter media by expanding ice crystals, which could release deposited colloids and associated microplastics. An increase in natural colloid concentration in the effluent following freeze-thaw treatments confirmed the hypothesis. The results are useful in predicting microplastic transport in the root zone in stormwater biofilters or contaminated land experiencing natural freeze-thaw cycles.","author_count":9,"author_ids":["A5004267363","A5016207990","A5017392305","A5044552538","A5060319855","A5072927263","A5076477801","A5077951659","A5095022614"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5076477801","name":"Vera S. Koutnik"},{"id":"A5072927263","name":"Annesh Borthakur"},{"id":"A5004267363","name":"Jamie Leonard"},{"id":"A5095022614","name":"Sara Alkidim"},{"id":"A5077951659","name":"Hatice Ceylan Koydemir"},{"id":"A5017392305","name":"Derek K. Tseng"},{"id":"A5016207990","name":"Aydogan \u00d6zcan"},{"id":"A5044552538","name":"Sujith Ravi"},{"id":"A5060319855","name":"Sanjay Kumar Mohanty"}],"ca_any_author":true,"ca_led":true,"cited_by_count":44,"doi":"https://doi.org/10.1016/j.hazl.2022.100048","domain_tags":["fate_transport_and_sorption","soil_and_agriculture","wastewater_and_treatment"],"facet_tags":["matrix:freshwater","matrix:soil_and_agriculture","matrix:wastewater"],"institution_ids":["I142207940","I161318765","I84392919"],"is_oa":true,"journal":"Journal of Hazardous Materials Letters","last_updated":"2026-11-07T11:25:07.637180","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://www.sciencedirect.com/science/article/pii/S2666911022000016/pdf","openalex_topics":["T10419","T10753","T11119"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2022-01-12","study_type":"article"