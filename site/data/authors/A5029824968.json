ars":[1998,2001,2002,2004]},{"country_code":"US","id":"I185071736","name":"Chapman University","years":[2002]},{"country_code":"US","id":"I150209017","name":"Scripps Institution of Oceanography","years":[2002]},{"country_code":"US","id":"I36258959","name":"University of California San Diego","years":[2002]},{"country_code":"US","id":"I1174212","name":"University of Southern California","years":[2001]}],"author_id":"A5029824968","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":815,"plastic":2,"year":2017},{"all":1108,"plastic":4,"year":2018},{"all":1051,"plastic":3,"year":2019},{"all":1456,"plastic":6,"year":2020},{"all":1910,"plastic":7,"year":2021},{"all":1909,"plastic":2,"year":2022},{"all":2044,"plastic":7,"year":2023},{"all":2304,"plastic":5,"year":2024},{"all":2273,"plastic":3,"year":2025},{"all":2199,"plastic":1,"year":2026}],"cited_by_count":21529,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1998,"first_year":2015,"h_index":82,"institution_ids":["I97018004"],"last_ca_year":2026,"last_year":2015,"m_quotient":2.93,"name":"Alexandria B B Boehm","orcid":"https://orcid.org/0000-0002-8162-5090","plastic_basis":"openalex","plastic_citations":43,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I1289490764","name":"Centers for Disease Control and Prevention","source":"openalex_last_known"},{"country_code":"US","id":"I1324229392","name":"National Association of County and City Health Officials","source":"openalex_last_known"},{"country_code":"US","id":"I1336788258","name":"California Department of Public Health","source":"openalex_last_known"},{"country_code":"US","id":"I150468666","name":"Emory University","source":"openalex_last_known"},{"country_code":"US","id":"I205950553","name":"Council of State and Territorial Epidemiologists","source":"openalex_last_known"},{"country_code":"US","id":"I2802264141","name":"Association of State and Territorial Health Officials","source":"openalex_last_known"},{"country_code":"US","id":"I4405266550","name":"Water Environment Federation","source":"openalex_last_known"},{"country_code":"US","id":"I4405267758","name":"Verily Life Sciences LLC (United States)","source":"openalex_last_known"},{"country_code":"US","id":"I97018004","name":"Stanford University","source":"openalex_last_known"}],"rising_pct":28,"rising_score":-0.0018,"work_count":1,"work_ids":["W2272057080"]},"schema_version":"s3.1","works":[{"abstract":"Oceans cover most of the planet and 60% of the world's population lives near the coast. Anthropogenic activities along coastlines and in the open ocean have placed the oceans in peril. According to a Pew Oceans Commission Report, among the greatest threats to the ocean are land-based runoff from coastal development, nutrient pollution, overfishing, and invasive species. Here, we describe threats due to microbial, nutrient, chemical, and plastic pollution in addition to declining biodiversity and describe fundamental and applied research needed to mitigate the threats. While the research needs are diverse, we identify several research foci that transcend individual threats: monitoring, fate and transport studies, modeling, innovative natural and engineered treatment systems, and toxicity and health studies. Research within the environmental engineering and science community that addresses these needs will contribute to improving ocean health.","author_count":4,"author_ids":["A5011317017","A5029824968","A5058587544","A5082631144"],"author_institution_ids":["I97018004"],"authors":[{"id":"A5029824968","name":"Alexandria B B Boehm"},{"id":"A5011317017","name":"Niveen S. Ismail"},{"id":"A5082631144","name":"Lauren M. Sassoubre"},{"id":"A5058587544","name":"Elizabeth Andruszkiewicz Allan"}],"ca_any_author":true,"ca_led":true,"cited_by_count":43,"doi":"https://doi.org/10.1089/ees.2015.0252","domain_tags":["fate_transport_and_sorption","occurrence_and_monitoring","wastewater_and_treatment"],"facet_tags":["matrix:m