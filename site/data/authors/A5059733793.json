{"author":{"affiliation_history":[{"country_code":"US","id":"I70076703","name":"Whittier College","years":[2013,2017,2018,2020,2021,2024]},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","years":[2008,2009,2011,2013,2017]},{"country_code":"US","id":"I130701444","name":"Georgia Institute of Technology","years":[2006,2007,2008,2009]},{"country_code":"US","id":"I192454743","name":"Sandia National Laboratories California","years":[2006,2007,2008,2009]},{"country_code":"US","id":"I4210104735","name":"Sandia National Laboratories","years":[2006,2007,2008]},{"country_code":"US","id":"I138006243","name":"University of Arizona","years":[2002,2004,2006,2008]},{"country_code":"PL","id":"I126596746","name":"Jagiellonian University","years":[2007]},{"country_code":"US","id":"I59749544","name":"New Mexico Highlands University","years":[2007]},{"country_code":"DZ","id":"I187560010","name":"University of B\u00e9ja\u00efa","years":[2007]},{"country_code":"US","id":"I72951846","name":"Washington State University","years":[2007]},{"country_code":"US","id":"I27837315","name":"University of Michigan","years":[2006]},{"country_code":"US","id":"I134113660","name":"University of Nevada, Reno","years":[2003]}],"author_id":"A5059733793","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":486,"plastic":0,"year":2017},{"all":420,"plastic":0,"year":2018},{"all":422,"plastic":0,"year":2019},{"all":358,"plastic":0,"year":2020},{"all":350,"plastic":0,"year":2021},{"all":283,"plastic":0,"year":2022},{"all":249,"plastic":0,"year":2023},{"all":240,"plastic":1,"year":2024},{"all":192,"plastic":7,"year":2025},{"all":169,"plastic":2,"year":2026}],"cited_by_count":7019,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2002,"first_year":2024,"h_index":15,"institution_ids":["I70076703"],"last_ca_year":2024,"last_year":2024,"m_quotient":0.62,"name":"Christina A. Bauer","orcid":"https://orcid.org/0000-0002-7687-1676","plastic_basis":"openalex","plastic_citations":10,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I70076703","name":"Whittier College","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4401447742"]},"schema_version":"s3.1","works":[{"abstract":"Estuaries can behave as plastic pollution hotspots, although the dynamics of accumulation in these unique habitats are not understood. We quantified the current levels of meso-, micro-, and nanoplastic pollution in four Los Angeles County estuaries for the first time, as a function of distance from the water outlet and local population density. Fourier-transform infrared spectroscopy (FTIR) and microscope imaging revealed the presence of six types of plastic; polyethylene or polypropylene dominated the meso- and microplastic, and nanoplastics were identified as mainly polyolefin fibers. The distribution was heterogeneous throughout, although the sand between the river mouth and ocean generally contained more plastic than inland control samples. Population density did not appear to affect the abundance of plastic estuarine pollution. Other factors, such as waste treatment effluent, recreation, and river geography, may contribute to plastic deposition. A positive correlation between meso- and microplastic abundance provides insight into such mechanisms for accumulation.","author_count":3,"author_ids":["A5059733793","A5065786865","A5103308711"],"author_institution_ids":["I70076703"],"authors":[{"id":"A5103308711","name":"Connor Hoemann"},{"id":"A5059733793","name":"Christina A. Bauer"},{"id":"A5065786865","name":"C. Fissore"}],"ca_any_author":true,"ca_led":true,"cited_by_count":10,"doi":"https://doi.org/10.1016/j.marpolbul.2024.116822","domain_tags":["air","occurrence_and_monitoring","wastewater_and_treatment"],"facet_tags":["matrix:air","matrix:freshwater","matrix:marine","matrix:wastewater"],"institution_ids":["I70076703"],"is_oa":true,"journal":"Marine Pollution Bulletin","last_updated":"2026-11-09T13:22:03.289127","license":"cc-by-nc-nd","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1016/j.marpolbul.2024.116822","openalex_topics":["T10419","T10753","T12316"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2024-08-09","study_type":"article","title":"Assessing meso-, micro-, and nanoplastic pollution in Los Angeles County estuaries","type":"article","work_id":"W4401447742","year":2024}]}
