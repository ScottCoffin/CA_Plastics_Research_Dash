ns":[{"country_code":"US","id":"I84218800","name":"University of California, Davis","source":"openalex_last_known"}],"rising_pct":46,"rising_score":0.0015,"work_count":3,"work_ids":["W4206667595","W4294926346","W4406633700"]},"schema_version":"s3.1","works":[{"abstract":"","author_ids":["A5019799032"],"author_institution_ids":["I84218800"],"ca_any_author":true,"ca_led":true,"cited_by_count":1,"doi":"https://doi.org/10.1016/j.cub.2021.07.001","domain_tags":[],"facet_tags":[],"institution_ids":["I84218800"],"is_oa":true,"journal":"Current Biology","last_updated":"2026-08-28T12:50:07.497085","license":"","needs_review":false,"oa_status":"bronze","oa_url":"http://www.cell.com/article/S0960982221009568/pdf","openalex_topics":["T10174","T10199","T11913"],"plastic_related":false,"plastic_tier":"","primary_topic":"T10174","pub_date":"2021-08-01","study_type":"article","title":"Andrew Sih","type":"article","work_id":"W4206667595","year":2021},{"abstract":"","author_ids":["A5012048707","A5019799032","A5024714108","A5030563346","A5091222311"],"author_institution_ids":["I84218800"],"ca_any_author":true,"ca_led":true,"cited_by_count":9,"doi":"https://doi.org/10.1016/j.anbehav.2022.07.010","domain_tags":[],"facet_tags":[],"institution_ids":["I138006243","I4210125844","I4210126221","I74775410","I7882870","I84218800"],"is_oa":true,"journal":"Animal Behaviour","last_updated":"2026-11-11T12:16:26.678958","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://www.sciencedirect.com/science/article/am/pii/S0003347222002007","openalex_topics":["T10174","T10753","T11118"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10174","pub_date":"2022-09-07","study_type":"article","title":"Variation in plastic consumption: social group size enhances individual susceptibility to an evolutionary trap","type":"article","work_id":"W4294926346","year":2022},{"abstract":"Plastic pollution threatens almost every ecosystem in the world. Critically, many animals consume plastic, in part because plastic particles often look or smell like food. Plastic ingestion is thus an evolutionary trap, a phenomenon that occurs when cues are decoupled from their previously associated high fitness outcomes. Theory predicts that dominance hierarchies could dictate individual responses to evolutionary traps across social environments, but the social dimension of evolutionary trap responses has rarely been investigated. We tested how variation in group size influences the formation of dominance relationships and, in turn, how these dominance relationships drive differences in foraging behavior in Western mosquitofish (Gambusia affinis). This included foraging for a variety of familiar and novel food-like items, including microplastics. Overall, dominant individuals were often the first to sample food and had higher bite rates than subordinates, including when foraging for microplastics. Importantly, how dominance affected foraging behavior depended on group size and on whether groups were presented with familiar or novel foods. Furthermore, individuals were consistent in their foraging behavior across trials with different group sizes, indicating the formation of stable social roles. These results suggest that predicting the ecological and evolutionary consequences of evolutionary traps will require an understanding of how social structures influence trap susceptibility.","author_ids":["A5012048707","A5019799032","A5024714108"],"author_institution_ids":["I84218800"],"ca_any_author":true,"ca_led":true,"cited_by_count":6,"doi":"https://doi.org/10.1002/eap.3081","domain_tags":["ecotoxicology_and_trophic_transfer","human_exposure_and_health_risk"],"facet_tags":["matrix:food_and_drink"],"institution_ids":["I130238516","I4210100094","I84218800"],"is_oa":true,"journal":"Ecological Applications","last_updated":"2026-11-06T12:05:46.655746","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://onlinelibrary.wiley.com/doi/pdfdirect/10.1002/eap.3081","openalex_topics":["T10174","T10753","T11118"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10174","pub_date":"2025-01-01","study_type":"article","title":"Social dominance influences individual susceptibility to an evolutionary trap in mosquitofish","type":"article","work_id":"W4406633700","year":2025}]}
