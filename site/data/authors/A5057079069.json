":73,"year":2026}],"cited_by_count":11988,"domain_tags":[],"early_career":false,"first_pub_year":2000,"first_year":2021,"h_index":60,"institution_ids":["I148283060","I95457486"],"last_year":2021,"m_quotient":2.31,"name":"Ting Xu","orcid":"https://orcid.org/0000-0002-2831-2095","plastic_basis":"openalex","plastic_citations":360,"plastic_works_count":4,"primary_affiliations":[{"country_code":"US","id":"I148283060","name":"Lawrence Berkeley National Laboratory","source":"openalex_last_known"},{"country_code":"CN","id":"I17145004","name":"Northwestern Polytechnical University","source":"openalex_last_known"},{"country_code":"CN","id":"I921716337","name":"Northeast Petroleum University","source":"openalex_last_known"},{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","source":"openalex_last_known"}],"rising_pct":81,"rising_score":0.0098,"work_count":3,"work_ids":["W3156330672","W3204602871","W7130676631"]},"profile":{"bio":"","keywords":["polymer","nanomaterial","nanocomposite","self-assembly","biomaterials","nanocarrier"],"links":[]},"schema_version":"s3.1","works":[{"abstract":"","author_ids":["A5007044859","A5018132574","A5022471032","A5029685348","A5029976028","A5033835790","A5033930647","A5034751387","A5042134639","A5053989842","A5057079069","A5070849799","A5101538275","A5101867663"],"author_institution_ids":["I148283060","I95457486"],"ca_any_author":true,"ca_led":true,"cited_by_count":315,"doi":"https://doi.org/10.1038/s41586-021-03408-3","domain_tags":["fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I148283060","I24603500","I95457486"],"is_oa":true,"journal":"Nature","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"green","oa_url":"https://www.osti.gov/servlets/purl/1840943","openalex_topics":["T10404","T10661","T11136"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10661","pub_date":"2021-04-21","study_type":"article","title":"Near-complete depolymerization of polyesters with nano-dispersed enzymes","type":"article","work_id":"W3156330672","year":2021},{"abstract":"Embedding catalysts inside of plastics affords accelerated chemical modification with programmable latency and pathways. Nanoscopically embedded enzymes can lead to near-complete degradation of polyesters via chain-end mediated processive depolymerization. The overall degradation rate and pathways have a strong dependence on the morphology of semicrystalline polyesters. Yet, most studies to date focus on pristine polymers instead of mixtures that contain additives and other components despite their nearly universal use in plastic production. Here, additives are introduced to purposely change the morphology of polycaprolactone (PCL) by increasing the bending and twisting of crystalline lamellae. These morphological changes immobilize chain ends preferentially at the crystalline/amorphous interfaces and limit chain-end accessibility by the embedded processive enzyme. This chain-end redistribution reduces the polymer-to-monomer conversion from >95% to less than 50%, causing formation of highly crystalline plastic pieces, including microplastics. By synergizing both random chain scission and processive depolymerization, it is feasible to navigate morphological changes in polymer/additive blends and to achieve near-complete depolymerization. The random scission enzymes in the amorphous domains create new chain ends that are subsequently bound and depolymerized by processive enzymes. Present studies further highlight the importance to consider how the host polymer's morphologies affect the reactions catalyzed by embedded catalytic species.","author_ids":["A5007044859","A5022471032","A5030020531","A5033930647","A5036451352","A5057079069","A5070849799"],"author_institution_ids":["I148283060","I95457486"],"ca_any_author":true,"ca_led":true,"cited_by_count":43,"doi":"https://doi.org/10.1002/adma.202105707","domain_tags":["fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I148283060","I95457486"],"is_oa":true,"journal":"Advanced Materials","last_updated":"2026-11-09T13:22:03.289127","license":"cc-by-nc-nd","needs_review":false,"oa_status":"green","oa_url":"https://www.biorxiv.org/content/biorxiv/early/2021/08/27/2021.08.25.457667.full.pdf","openalex_topics":["T10389","T10404","T10661"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2021-10-08","study_type":"article","title":"Synergistic Enzyme Mixtures to Realize Near\u2010Complete Depolymerization in Biodegradable Polymer/Additive Blends","type":"article","work_id":"W3204602871","year":2021},{"abstract":"Compostable plastics are an alternative to conventional plastics, but their environmental value is debated. Although designed to biodegrade under controlled conditions, their real-world performance depends on both material properties and waste-management systems. This primer elaborates the development and deployment of compostable plastics as a conditional strategy for reducing plastic pollution and achieving broader waste-reduction goals by reviewing material-design considerations, system-performance challenges, and regulatory requirements that shape market entry and credibility, highlighting food-contact authorizations as a key example. By outlining these challenges and requirements, this primer aims to help researchers and developers align material innovation with regulatory pathways and end-of-life realities. This resource aims to support researchers, developers, and policymakers working to create and commercialize effective, safe, and fit-for-purpose compostable plastic solutions.","author_ids":["A5018132574","A5028731546","A5047819674","A5049860625","A5057079069","A5112548752"],"author_institution_ids":["I95457486"],"ca_any_author":true,"ca_led":true,"cited_by_count":1,"doi":"https://doi.org/10.1016/j.oneear.2026.101609","domain_tags":[],"facet_tags":["matrix:food_and_drink"],"institution_ids":["I38257878","I53012624","I95457486"],"is_oa":true,"journal":"One Earth","last_updated":"2026-11-04T10:54:05.112534","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1016/j.oneear.2026.101609","openalex_topics":["T10661","T10753","T14179"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2026-02-01","study_type":"article","title":"Aligning development and deployment of compostable plastics for meaningful impact","type":"article","work_id":"W7130676631","year":2026}]}
