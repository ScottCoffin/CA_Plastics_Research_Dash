id":"I4210144228","name":"Eunice Kennedy Shriver National Institute of Child Health and Human Development","years":[2007]},{"country_code":"US","id":"I201448701","name":"University of Washington","years":[1996,1997,2000,2001,2002,2003]},{"country_code":"US","id":"I1343551460","name":"The University of Texas MD Anderson Cancer Center","years":[2000]},{"country_code":"US","id":"I16452829","name":"The University of Texas System","years":[2000]},{"country_code":"US","id":"I1330342723","name":"Mayo Clinic","years":[1988]},{"country_code":"US","id":"I4210089162","name":"Northwestern Memorial Hospital","years":[1986]},{"country_code":"US","id":"I111979921","name":"Northwestern University","years":[1986]},{"country_code":"US","id":"I36258959","name":"University of California San Diego","years":[1986]}],"author_id":"A5049136514","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":377,"plastic":0,"year":2017},{"all":350,"plastic":0,"year":2018},{"all":401,"plastic":0,"year":2019},{"all":485,"plastic":0,"year":2020},{"all":551,"plastic":0,"year":2021},{"all":500,"plastic":0,"year":2022},{"all":450,"plastic":0,"year":2023},{"all":401,"plastic":0,"year":2024},{"all":380,"plastic":0,"year":2025},{"all":266,"plastic":0,"year":2026}],"cited_by_count":6860,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1986,"first_year":2013,"h_index":46,"institution_ids":["I180670191"],"last_ca_year":2026,"last_year":2013,"m_quotient":1.15,"name":"Victor Y. Fujimoto","orcid":"https://orcid.org/0000-0002-2172-4513","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"US","id":"I180670191","name":"University of California, San Francisco","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W1984254033"]},"schema_version":"s3.1","works":[{"abstract":"Bisphenol-A (BPA) is an endocrine disrupting chemical used in numerous consumer products, resulting in universal exposure in the United States. Prenatal exposure to BPA is associated with numerous reproductive and developmental effects in animals. However, little is known about human fetal exposure or metabolism of BPA during midgestation. In the present study, we present a new liquid chromatography-tandem mass spectrometry method to directly measure concentrations of BPA and two predominant metabolic conjugates-BPA glucuronide and BPA sulfate-in umbilical cord serum collected from elective second trimester pregnancy terminations. We detected at least one form of BPA in all umbilical cord serum samples: BPA (GM 0.16, range <LOD-52.26 ng/mL), BPA glucuronide (GM 0.14, range <LOD-5.41 ng/mL) and BPA sulfate (GM 0.32, range <LOD-12.65 ng/mL). Levels of BPA ranged from less than 1/100th to over 400 times higher than levels of BPA in conjugated form. Although levels of BPA in conjugated form exceeded BPA levels in about 3/4 of the samples, BPA levels were higher in samples with total BPA above the median. Our findings suggest universal fetal exposure to BPA in our study population, with some at relatively high levels, and we provide the first evidence of detectable BPA sulfate in midgestation fetuses.","author_count":9,"author_ids":["A5002599358","A5002692454","A5048164907","A5049136514","A5065255464","A5081433684","A5110343394","A5129707973"],"author_institution_ids":["I180670191"],"authors":[{"id":"A5065255464","name":"Roy R. L. Gerona"},{"id":"A5048164907","name":"Tracey J. Woodruff"},{"id":"A5002599358","name":"Carrie A. Dickenson"},{"id":"","name":"Janet Pan"},{"id":"A5110343394","name":"Jackie M. Schwartz"},{"id":"A5081433684","name":"\u015aaunak Sen"},{"id":"A5129707973","name":"Matthew W. Friesen"},{"id":"A5049136514","name":"Victor Y. Fujimoto"},{"id":"A5002692454","name":"Patricia A. Hunt"}],"ca_any_author":true,"ca_led":true,"cited_by_count":210,"doi":"https://doi.org/10.1021/es402764d","domain_tags":["human_exposure_and_health_risk"],"facet_tags":[],"institution_ids":["I180670191","I72951846"],"is_oa":true,"journal":"Environmental Science & Technology","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"green","oa_url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC3881559/","openalex_topics":["T10122","T10686","T14393"],"plastic_related":true,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10686","pub_date":"2013-08-13","study_type":"article","title":"Bisphenol-A (BPA), BPA Glucuronide, and BPA Sulfate in Midgestation Umbilical Cord Serum in a Northern and Central California Population","type":"article","work_id":"W1984254033","year":2013}]}
