:[2000]},{"country_code":"US","id":"I165488384","name":"General Mills (United States)","years":[1986]},{"country_code":"US","id":"I2802450327","name":"University of Nebraska System","years":[1986]},{"country_code":"US","id":"I114395901","name":"University of Nebraska\u2013Lincoln","years":[1984,1986]}],"author_id":"A5049256544","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":514,"plastic":21,"year":2017},{"all":547,"plastic":26,"year":2018},{"all":567,"plastic":23,"year":2019},{"all":728,"plastic":38,"year":2020},{"all":786,"plastic":41,"year":2021},{"all":671,"plastic":50,"year":2022},{"all":731,"plastic":35,"year":2023},{"all":679,"plastic":42,"year":2024},{"all":587,"plastic":39,"year":2025},{"all":535,"plastic":32,"year":2026}],"cited_by_count":10425,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1984,"first_year":2016,"h_index":56,"institution_ids":["I84218800"],"last_ca_year":2026,"last_year":2016,"m_quotient":1.33,"name":"Susan E. Ebeler","orcid":"https://orcid.org/0000-0002-8394-6736","plastic_basis":"openalex","plastic_citations":349,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I84218800","name":"University of California, Davis","source":"openalex_last_known"}],"rising_pct":12,"rising_score":-0.0105,"work_count":1,"work_ids":["W2549620114"]},"schema_version":"s3.1","works":[{"abstract":"Plastic debris is ingested by hundreds of species of organisms, from zooplankton to baleen whales, but how such a diversity of consumers can mistake plastic for their natural prey is largely unknown. The sensory mechanisms underlying plastic detection and consumption have rarely been examined within the context of sensory signals driving marine food web dynamics. We demonstrate experimentally that marine-seasoned microplastics produce a dimethyl sulfide (DMS) signature that is also a keystone odorant for natural trophic interactions. We further demonstrate a positive relationship between DMS responsiveness and plastic ingestion frequency using procellariiform seabirds as a model taxonomic group. Together, these results suggest that plastic debris emits the scent of a marine infochemical, creating an olfactory trap for susceptible marine wildlife.","author_count":4,"author_ids":["A5021063332","A5049256544","A5058920710","A5074815942"],"author_institution_ids":["I84218800"],"authors":[{"id":"A5074815942","name":"Matthew S. Savoca"},{"id":"A5058920710","name":"Martha Wohlfeil Zillig"},{"id":"A5049256544","name":"Susan E. Ebeler"},{"id":"A5021063332","name":"Gabrielle A. Nevitt"}],"ca_any_author":true,"ca_led":true,"cited_by_count":349,"doi":"https://doi.org/10.1126/sciadv.1600395","domain_tags":["ecotoxicology_and_trophic_transfer","human_exposure_and_health_risk"],"facet_tags":["matrix:food_and_drink","matrix:marine"],"institution_ids":["I84218800"],"is_oa":true,"journal":"Science Advances","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc","needs_review":false,"oa_status":"gold","oa_url":"https://doi.org/10.1126/sciadv.1600395","openalex_topics":["T10447","T10659","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2016-11-04","study_type":"article","title":"Marine plastic debris emits a keystone infochemical for olfactory foraging seabirds","type":"article","work_id":"W2549620114","year":2016}]}
