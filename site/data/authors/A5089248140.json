r_id":"A5089248140","ca_plastic_works_count":1,"ca_works_count":2,"citations_by_year":[{"all":778,"plastic":0,"year":2017},{"all":729,"plastic":0,"year":2018},{"all":846,"plastic":0,"year":2019},{"all":1030,"plastic":0,"year":2020},{"all":1092,"plastic":0,"year":2021},{"all":1099,"plastic":0,"year":2022},{"all":1048,"plastic":0,"year":2023},{"all":1033,"plastic":4,"year":2024},{"all":1148,"plastic":13,"year":2025},{"all":915,"plastic":9,"year":2026}],"cited_by_count":13982,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1996,"first_year":2024,"h_index":66,"institution_ids":["I1174212"],"last_ca_year":2026,"last_year":2026,"m_quotient":2.2,"name":"Myles Cockburn","orcid":"https://orcid.org/0000-0003-3658-6720","plastic_basis":"openalex","plastic_citations":26,"plastic_works_count":2,"primary_affiliations":[{"country_code":"US","id":"I1174212","name":"University of Southern California","source":"openalex_last_known"},{"country_code":"US","id":"I4210117038","name":"USC Norris Comprehensive Cancer Center","source":"openalex_last_known"}],"rising_pct":58,"rising_score":0.0029,"work_count":2,"work_ids":["W4392765129","W7131667924"]},"schema_version":"s3.1","works":[{"abstract":"Air pollution is a global health concern, with fine particulate matter (PM2.5) constituents posing potential risks to human health, including children's neurodevelopment. Here we investigated associations between exposure during pregnancy and infancy to specific traffic-related PM2.5 components with Autism Spectrum Disorder (ASD) diagnosis. For exposure assessment, we estimated PM2.5 components related to traffic exposure (Barium [Ba] as a marker of brake dust and Zinc [Zn] as a tire wear marker, Black Carbon [BC]) and oxidative stress potential (OSP) markers (Hydroxyl Radical [OPOH] formation, Dithiothreitol activity [OPDTT], reactive oxygen species [ROS]) modeled with land use regression with co-kriging based on an intensive air monitoring campaign. We assigned exposures to a cohort of 444,651 children born in Southern California between 2016 and 2019, among whom 11,466 ASD cases were diagnosed between 2018 and 2022, Odds ratios (ORs) and 95% confidence intervals (CIs) were obtained with logistic regression for single pollutant and PM2.5 mass co-adjusted models, also adjusting for sociodemographic characteristics. Among PM2.5 components, we found the strongest positive association with ASD for our brake wear marker Ba (ORper IQR = 1.29, 95 % CI: 1.24, 1.34). This was followed by an increased risk for all PM2.5 oxidative stress potential markers; the strongest association was with ROS formation (ORper IQR = 1.22, 95 % CI: 1.18, 1.25). PM2.5 mass was linked to ASD in Hispanic and Black children, but not White children, while traffic-related PM2.5 and OSP markers increased ASD risk across all groups. In neighborhoods with the lowest socioeconomic status (SES), associations with ASD were stronger for all examined pollutants compared to higher SES areas. Our findings suggest that brake wear-related PM2.5 and PM2.5 OSP are associated with ASD diagnosis in Southern California. These results suggest that strategies aimed at reducing the public health impacts of PM2.5 need to consider specific sources.","author_count":14,"author_ids":["A5005348351","A5007220667","A5009705170","A5016779302","A5043699175","A5044732415","A5077256521","A5079887473","A5084288347","A5089248140","A5100627891","A5103111691","A5111146088","A5114135522"],"author_institution_ids":["I1174212"],"authors":[{"id":"A5079887473","name":"Karl O\u2019Sharkey"},{"id":"A5005348351","name":"Qi Meng"},{"id":"A5111146088","name":"Sanjali Mitra"},{"id":"A5114135522","name":"Seung-a Paik"},{"id":"A5100627891","name":"Jonathan Z. Liu"},{"id":"A5044732415","name":"Jiaqi Shen"},{"id":"A5007220667","name":"Laura K Thompson"},{"id":"A5016779302","name":"Ting Chow"},{"id":"A5077256521","name":"Jason G. Su"},{"id":"A5089248140","name":"Myles Cockburn"},{"id":"A5009705170","name":"Scott Weichenthal"},{"id":"A5084288347","name":"Suzanne E. Paulson"},{"id":"A5043699175","name":"Michael Jerrett"},{"id":"A5103111691","name":"Beate R. Ritz"}],"ca_any_author":true,"ca_led":true,"cited_by_count":25,"doi":"https://doi.org/10.1016/j.envint.2024.108573","domain_tags":["occurrence_and_monitoring"],"facet_tags":[],"institution_ids":["I1174212","I161318765","I5023651","I95457486"],"is_oa":true,"journal":"Environment International","last_updated":"2026-11-04T10:54:05.112534","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://doi.org/10.1016/j.envint.2024.108573","openalex_topics":["T10106","T10190","T12259"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10190","pub_date":"2024-03-01","study_type":"article","title":"Associations between brake and tire wear-related PM2.5 metal components, particulate oxidative stress potential, and autism spectrum disorder in Southern California","type":"article","work_id":"W4392765129","year":2024},{"abstract":"","author_count":8,"author_ids":["A5007220667","A5065382859","A5071744840","A5079887473","A5089248140","A5103111691","A5111146088","A5114135522"],"author_institution_ids":["I1174212"],"authors":[{"id":"A5111146088","name":"Sanjali Mitra"},{"id":"A5079887473","name":"Karl O\u2019Sharkey"},{"id":"A5114135522","name":"Seung-a Paik"},{"id":"A5007220667","name":"Laura K Thompson"},{"id":"A5065382859","name":"Jason Su"},{"id":"A5089248140","name":"Myles Cockburn"},{"id":"A5071744840","name":"Roch A. Nianogo"},{"id":"A5103111691","name":"Beate R. Ritz"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.1016/j.envres.2026.124099","domain_tags":[],"facet_tags":[],"institution_ids":["I1174212","I161318765","I95457486"],"is_oa":false,"journal":"Environmental Research","last_updated":"2026-11-04T10:54:05.112534","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.envres.2026.124099","openalex_topics":["T10122","T10190",