_code":"US","id":"I1322219670","name":"American Hospital Association","years":[1990]}],"author_id":"A5057060580","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":3871,"plastic":0,"year":2017},{"all":4664,"plastic":0,"year":2018},{"all":5230,"plastic":0,"year":2019},{"all":6602,"plastic":0,"year":2020},{"all":7604,"plastic":0,"year":2021},{"all":6981,"plastic":0,"year":2022},{"all":6917,"plastic":0,"year":2023},{"all":7323,"plastic":0,"year":2024},{"all":7206,"plastic":2,"year":2025},{"all":7089,"plastic":1,"year":2026}],"cited_by_count":73070,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1990,"first_year":2025,"h_index":123,"institution_ids":["I150209017","I36258959"],"last_ca_year":2026,"last_year":2025,"m_quotient":3.42,"name":"Jack A. Gilbert","orcid":"https://orcid.org/0000-0001-7920-7001","plastic_basis":"openalex","plastic_citations":3,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I150209017","name":"Scripps Institution of Oceanography","source":"openalex_last_known"},{"country_code":"US","id":"I36258959","name":"University of California San Diego","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4408162654"]},"schema_version":"s3.1","works":[{"abstract":"Plastic pollution in the marine environment harbors a diverse community of microorganisms called the plastisphere. The plastisphere has been found to contain potential pathogenic species of concern to both marine organisms and human health. This study examines the ability of plastic to harbor Vibrio parahaemolyticus , the leading cause of seafood-borne illness around the globe, in varying environmental conditions. A modified crystal violet assay was utilized to measure biofilm growth over 24 h at 18 \u00b0C and 25 \u00b0C and at five nutrient conditions. Biofilm growth was compared to free-living cell growth, and results show that free-living cell growth significantly increases with both increased temperature and increased nutrient load, yet biofilm formation was minimally responsive to changing conditions. Thus, pathogen-laden biofilms have the ability to form on plastics throughout much of the year, making plastic pollution both a vector for the transport of pathogens and a reservoir of pathogens in adverse environmental conditions. \u2022 The plastisphere harbors potential pathogens of concern in the marine environment. \u2022 All Vibrio parahaemolyticus strains grow biofilms on plastic surfaces. \u2022 Free-living cell growth and not biofilms increase with temperature and nutrients. \u2022 Plastic pollution can be a vector and reservoir of pathogens in adverse conditions.","author_count":4,"author_ids":["A5005731611","A5054441271","A5057060580"],"author_institution_ids":["I150209017","I36258959"],"authors":[{"id":"A5054441271","name":"Kara J. Wiggin"},{"id":"","name":"Ryan K. Chung"},{"id":"A5057060580","name":"Jack A. Gilbert"},{"id":"A5005731611","name":"Sarah M. Allard"}],"ca_any_author":true,"ca_led":true,"cited_by_count":3,"doi":"https://doi.org/10.1016/j.marpolbul.2025.117772","domain_tags":["fate_transport_and_sorption","plastisphere"],"facet_tags":["matrix:marine"],"institution_ids":["I150209017","I36258959"],"is_oa":true,"journal":"Marine Pollution Bulletin","last_updated":"2026-11-07T11:25:07.637180","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1016/j.marpolbul.2025.117772","openalex_topics":["T10593","T10753","T11684"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2025-03-05","study_type":"article","title":"Effects of temperature and nutrient load on the interaction of Vibrio parahaemolyticus and plastic pollution in the marine environment","type":"article","work_id":"W4408162654","year":2025}]}
