ars":[1979,1980,1981,1983,1984]},{"country_code":"US","id":"I4210086933","name":"NYU Langone Health","years":[1976,1977,1979,1982]},{"country_code":"US","id":"I57206974","name":"New York University","years":[1976,1977,1979,1982]},{"country_code":"US","id":"I200870766","name":"Brookhaven National Laboratory","years":[1979]},{"country_code":"US","id":"I4210098204","name":"John B. Pierce Laboratory","years":[1978]},{"country_code":"US","id":"I32971472","name":"Yale University","years":[1978]},{"country_code":"US","id":"I4391768262","name":"United States Atomic Energy Commission","years":[1969]}],"author_id":"A5102738767","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":303,"plastic":0,"year":2017},{"all":348,"plastic":0,"year":2018},{"all":353,"plastic":0,"year":2019},{"all":466,"plastic":0,"year":2020},{"all":472,"plastic":0,"year":2021},{"all":423,"plastic":0,"year":2022},{"all":435,"plastic":0,"year":2023},{"all":490,"plastic":0,"year":2024},{"all":524,"plastic":0,"year":2025},{"all":450,"plastic":2,"year":2026}],"cited_by_count":8367,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1967,"first_year":2026,"h_index":46,"institution_ids":["I2803209242"],"last_ca_year":2026,"last_year":2026,"m_quotient":0.78,"name":"Michael T. Kleinman","orcid":"https://orcid.org/0000-0003-2724-0066","plastic_basis":"openalex","plastic_citations":2,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I204250578","name":"University of California, Irvine","source":"openalex_last_known"},{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W7164410660"]},"schema_version":"s3.1","works":[{"abstract":"Nontailpipe emissions including brake and tire wear and resuspended road dust have become emerging concerns in traffic air pollution. It is thus important to understand the health-related properties of nontailpipe particulate matter (PM) as it becomes a major contributor to traffic air pollution. Here we characterize the chemical composition, reactive oxygen species (ROS) formation, and oxidative potential of ambient PM collected next to two highways in California, as well as laboratory-generated PM from brake wear particles (BWPs), cryogenically milled tire tread (CMTT) from fresh and used tires, used tire tread particles, and road dust. The major metal components are found to be iron, barium and copper in BWPs, zinc in CMTT, and crustal elements such as aluminum, calcium, potassium, and sodium in road dust. CMTT is found to contain environmentally persistent free radicals (EPFRs), while BWPs and road dust do not contain detectable amounts of EPFRs. Ambient traffic PM generates hydroxyl radicals ( \u2022 OH) and carbon-centered organic radicals upon extraction in water, while BWPs exclusively generate \u2022 OH, consolidating findings by previous studies. CMTT and road dust exhibit relatively low ROS formation and PM oxidative potential. BWPs generated from three different brakes of varying Cu content show that a higher Cu content leads to higher ROS formation and higher oxidative potential as measured by dithiothreitol (DTT) decay and \u2022 OH formation in surrogate lung fluid. These results provide useful insights into health-related properties of nontailpipe PM, supporting that regulation of Cu in brake materials would help reduce potential health effects of BWPs.","author_count":17,"author_ids":["A5008840331","A5011455628","A5026824622","A5027618961","A5028814866","A5045818732","A5050132491","A5069195507","A5070324997","A5070749702","A5077899223","A5081950603","A5092104281","A5102738767","A5119752363","A5135920057","A5138436215"],"author_institution_ids":["I2803209242"],"authors":[{"id":"A5008840331","name":"Sukriti Kapur"},{"id":"A5119752363","name":"B. Sage Lauper-Cook"},{"id":"A5050132491","name":"Kasey C. Edwards"},{"id":"A5092104281","name":"Lena Gerritz"},{"id":"A5135920057","name":"David Herman"},{"id":"A5011455628","name":"Madeline E. Cooke"},{"id":"A5069195507","name":"Adam E. Thomas"},{"id":"A5077899223","name":"Lisa M. Wingen"},{"id":"A5026824622","name":"V\u00e9ronique Perraud"},{"id":"A5138436215","name":"Tsuyoshi Ito"},{"id":"A5027618961","name":"Hiroyuki Hagino"},{"id":"A5081950603","name":"Junichi Hosoya"},{"id":"A5028814866","name":"Tazuko Morikawa"},{"id":"A5045818732","name":"Andrea De Vizcaya Ru\u00edz"},{"id":"A5102738767","name":"Michael T. Kleinman"},{"id":"A5070749702","name":"JAMES N. M. SMITH"},{"id":"A5070324997","name":"Manabu Shiraiwa"}],"ca_any_author":true,"ca_led":true,"cited_by_count":2,"doi":"https://doi.org/10.1021/acsearthspacechem.6c00076","domain_tags":["air"],"facet_tags":["matrix:air"],"institution_ids":["I2803209242","I4210157397"],"is_oa":false,"journal":"ACS Earth and Space Chemistry","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acsearthspacechem.6c00076","openalex_topics":["T10075","T10122","T10190"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10075","pub_date":"2026-06-11","study_type":"article","title":"Nontailpipe Particulate Matter from Brake Wear, Tire Tread, and Road Dust: Environmentally Persistent Free Radicals, Reactive Oxygen Species, and Oxidative Potential","type":"article","work_id":"W7164410660","year":2026}]}
