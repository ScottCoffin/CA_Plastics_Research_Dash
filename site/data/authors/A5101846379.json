y_code":"CN","id":"I4405271926","name":"State Key Laboratory of Advanced Special Steel","years":[2017]}],"author_id":"A5101846379","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":11,"plastic":0,"year":2017},{"all":59,"plastic":0,"year":2018},{"all":92,"plastic":0,"year":2019},{"all":433,"plastic":0,"year":2020},{"all":888,"plastic":0,"year":2021},{"all":1337,"plastic":0,"year":2022},{"all":1699,"plastic":0,"year":2023},{"all":2124,"plastic":32,"year":2024},{"all":2079,"plastic":61,"year":2025},{"all":1408,"plastic":36,"year":2026}],"cited_by_count":10142,"domain_tags":[],"early_career":false,"first_pub_year":2012,"first_year":2024,"h_index":50,"institution_ids":["I161318765"],"last_year":2024,"m_quotient":3.57,"name":"Yihao Zhou","orcid":"https://orcid.org/0000-0002-7299-5911","plastic_basis":"openalex","plastic_citations":129,"plastic_works_count":1,"primary_affiliations":[{"country_code":"CN","id":"I148128674","name":"University of Shanghai for Science and Technology","source":"openalex_last_known"},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"},{"country_code":"AU","id":"I31746571","name":"UNSW Sydney","source":"openalex_last_known"},{"country_code":"CN","id":"I4385474403","name":"Changchun University of Technology","source":"openalex_last_known"}],"rising_pct":88,"rising_score":0.0149,"work_count":1,"work_ids":["W4390604011"]},"schema_version":"s3.1","works":[{"abstract":"Future exploitation of marine resources in a sustainable and eco-friendly way requires autonomous underwater robotics with human-like perception. However, the development of such intelligent robots is now impeded by the lack of adequate underwater haptic sensing technology. Inspired by the populational coding strategy of the human tactile system, we harness the giant magnetoelasticity in soft polymer systems as an innovative platform technology to construct a multimodal underwater robotic skin for marine object recognition with intrinsic waterproofness and a simple configuration. The bioinspired magnetoelastic artificial skin enables multiplexed tactile modality in each single taxel and obtains an impressive classification rate of 95% in identifying seven types of marine creatures and marine litter. By introducing another degree of freedom in underwater haptic sensing, this work represents a milestone toward sustainable marine resource exploitation.","author_ids":["A5027349342","A5063665829","A5076654722","A5089040164","A5100450180","A5101846379","A5103268543"],"author_institution_ids":["I161318765"],"ca_any_author":true,"ca_led":true,"cited_by_count":126,"doi":"https://doi.org/10.1126/sciadv.adj8567","domain_tags":[],"facet_tags":["matrix:marine"],"institution_ids":["I161318765"],"is_oa":true,"journal":"Science Advances","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc","needs_review":false,"oa_status":"gold","oa_url":"https://doi.org/10.1126/sciadv.adj8567","openalex_topics":["T10338","T10868","T10914"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10868","pub_date":"2024-01-05","study_type":"article","title":"A multimodal magnetoelastic artificial skin for underwater haptic sensing","type":"article","work_id":"W4390604011","year":2024}]}
