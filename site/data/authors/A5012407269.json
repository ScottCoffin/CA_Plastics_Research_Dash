institution_ids":["I1312222531","I1336096307","I4210140558"],"last_year":2018,"m_quotient":0.25,"name":"Charles C. Lee","orcid":"https://orcid.org/0000-0002-3606-1134","plastic_basis":"openalex","plastic_citations":33,"plastic_works_count":2,"primary_affiliations":[{"country_code":"US","id":"I1312222531","name":"Agricultural Research Service","source":"openalex_last_known"},{"country_code":"US","id":"I1336096307","name":"United States Department of Agriculture","source":"openalex_last_known"},{"country_code":"US","id":"I4210140558","name":"Western Regional Research Center","source":"openalex_last_known"},{"country_code":"US","id":"I121820613","name":"Louisiana State University","source":"openalex_last_known"}],"rising_pct":21,"rising_score":-0.0035,"work_count":2,"work_ids":["W2907716465","W3110763012"]},"schema_version":"s3.1","works":[{"abstract":"ABSTRACT Poly\u20103\u2010hydroxybutyrate (PHB) is a widely distributed carbon storage molecule in prokaryotes and can serve as a biodegradable plastic replacement. However, the handling and material properties of virgin PHB are not as robust as some traditional petroleum\u2010based plastics. Additives can be added to PHB to improve its qualities, but these additives are themselves often not biobased. A strategy was developed to utilize lower molecular weight PHB fragments derived from the recycling process as biobased additives. To simulate recycling, PHB was thermolyzed at elevated temperatures, and this degraded PHB (dPHB) was reactively processed with virgin PHB. Incorporation of dPHB nucleated and plasticized the virgin PHB as evidenced by increased crystallization temperature and crystallinity as well as decreased melt viscosity, stiffness, and melting temperature. Additionally, samples containing dPHB had increased toughness. Processing with dPHB decreased Mn, had little effect on Mw, and increased the Z\u2010average molecular weight, indicating branching. These results demonstrate a route for nucleating, plasticizing, and toughening virgin PHB by using recycled PHB. \u00a9 2018 Wiley Periodicals, Inc. J. Appl. Polym. Sci. 2019, 136, 47432.","author_ids":["A5000621023","A5012407269","A5036877777","A5055544444","A5060882878","A5066048715","A5067823186"],"author_institution_ids":["I1312222531","I1336096307","I4210140558"],"ca_any_author":true,"ca_led":true,"cited_by_count":6,"doi":"https://doi.org/10.1002/app.47432","domain_tags":[],"facet_tags":[],"institution_ids":["I1312222531","I1336096307","I4210140558"],"is_oa":true,"journal":"Journal of Applied Polymer Science","last_updated":"2026-10-30T12:39:25.321706","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://onlinelibrary.wiley.com/doi/pdfdirect/10.1002/app.47432","openalex_topics":["T10389","T10661","T10810"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2018-12-29","study_type":"article","title":"Nucleation and plasticization with recycled low\u2010molecular\u2010weight poly\u20103\u2010hydroxybutyrate toughens virgin poly\u20103\u2010hydroxybutyrate","type":"article","work_id":"W2907716465","year":2018},{"abstract":"","author_ids":["A5012407269","A5020840113","A5036877777","A5060882878","A5066048715","A5067823186","A5077000832"],"author_institution_ids":["I1312222531","I4210140558"],"ca_any_author":true,"ca_led":true,"cited_by_count":27,"doi":"https://doi.org/10.1016/j.ijbiomac.2020.12.015","domain_tags":[],"facet_tags":[],"institution_ids":["I1312222531","I4210140558"],"is_oa":true,"journal":"International Journal of Biological Macromolecules","last_updated":"2026-10-31T12:09:11.096373","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://www.sciencedirect.com/science/article/am/pii/S0141813020351734?via%3Dihub","openalex_topics":["T10661","T10932","T14285"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10661","pub_date":"2020-12-05","study_type":"article","title":"Production of polyhydroxyalkanoate copolymers containing 4-hydroxybutyrate in engineered Bacillus megaterium","type":"article","work_id":"W3110763012","year":2020}]}
