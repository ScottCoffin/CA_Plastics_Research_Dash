rds":[],"links":[{"label":"Portfolio","url":"http://www.semiquant.com"},{"label":"Mendeley Profile","url":"https://profiles.ucsf.edu/jason.limberis"}]},"schema_version":"s3.1","works":[{"abstract":"Abstract Microplastics have emerged as a major environmental concern due to their widespread presence and potential health impacts. Growing water contamination has raised concerns about its presence in seafood consumed by humans. In this single-center, cross-sectional study, we collected a sample of 10 Pacific oysters sold locally in Northern California. We compared microplastic content with a prior study performed at the same location in 2015 (Rochman et al.). Anthropogenic debris was extracted from the whole tissue of shellfish using a 10% KOH solution and quantified under a dissecting microscope. Microplastics were found in all ten samples (compared with 4/12 samples in 2015), from three to greater than 40 particles per sample. These anthropogenic debris were primarily filaments from 0.2 to 2 mm long. Our study findings suggest that microplastics in bivalves sold for human consumption have increased in the past ten years, with potential human health concerns.","author_count":3,"author_ids":["A5025423844","A5071157915","A5118832147"],"author_institution_ids":["I180670191"],"authors":[{"id":"A5118832147","name":"Zaeda Esperanza Metcalfe"},{"id":"A5071157915","name":"Jason D. Limberis"},{"id":"A5025423844","name":"John Z. Metcalfe"}],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"https://doi.org/10.1101/2025.07.03.25330794","domain_tags":["ecotoxicology_and_trophic_transfer"],"facet_tags":[],"institution_ids":["I180670191"],"is_oa":true,"journal":"medRxiv","last_updated":"2026-11-09T13:22:03.289127","license":"cc-by-nc-nd","needs_review":false,"oa_status":"green","oa_url":"https://www.medrxiv.org/content/medrxiv/early/2025/07/05/2025.07.03.25330794.full.pdf","openalex_topics":["T10419","T10447","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2025-07-05","study_type":"preprint","title":"Anthropogenic Debris in Bivalves Sold for Human Consumption in Northern California: A Cross-Sectional Follow-Up Study","type":"preprint","work_id":"W4412053000","year":2025}]}
