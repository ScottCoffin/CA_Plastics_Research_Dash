{"author":{"author_id":"A5028394790","ca_plastic_works_count":4,"ca_works_count":4,"cited_by_count":308,"domain_tags":[],"first_year":2020,"h_index":7,"institution_ids":[],"last_year":2023,"name":"Mary Ellen Crowley","orcid":"https://orcid.org/0000-0001-9227-919X","plastic_basis":"openalex","plastic_citations":194,"plastic_works_count":5,"work_count":4,"work_ids":["W3209884290","W3217042778","W4366163164","W4390393893"]},"schema_version":"s3.1","works":[{"abstract":"","author_ids":["A5006095851","A5006973475","A5024134323","A5028394790","A5038241764","A5052394898","A5058240698","A5064831180","A5068378342","A5090653877"],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":[],"is_oa":false,"journal":"AGU Fall Meeting Abstracts","last_updated":"2026-10-12T09:40:04.860316","license":"","needs_review":false,"oa_status":"closed","oa_url":"http://ui.adsabs.harvard.edu/abs/2020AGUFMB073...06H/abstract","openalex_topics":["T10753","T10765","T12213"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2020-12-01","study_type":"conference-abstract","title":"Effects of Marine Debris on Open Ocean Biodiversity","type":"conference-abstract","work_id":"W3209884290","year":2020},{"abstract":"Discoveries of persistent coastal species in the open ocean shift our understanding of biogeographic barriers. Floating plastic debris from pollution now supports a novel sea surface community composed of coastal and oceanic species at sea that might portend significant ecological shifts in the marine environment.","author_ids":["A5006095851","A5006973475","A5024124486","A5024134323","A5028394790","A5052394898","A5058240698","A5064831180","A5068378342","A5090653877"],"ca_any_author":true,"ca_led":false,"cited_by_count":90,"doi":"https://doi.org/10.1038/s41467-021-27188-6","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I117965899","I1319689352","I150209017","I201448701","I22675022","I2801725644","I36258959","I4210138199","I52218309"],"is_oa":true,"journal":"Nature Communications","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://www.nature.com/articles/s41467-021-27188-6.pdf","openalex_topics":["T10753","T10765","T12213"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2021-12-02","study_type":"article","title":"Emergence of a neopelagic community through the establishment of coastal species on the high seas","type":"article","work_id":"W3217042778","year":2021},{"abstract":"We show that the high seas are colonized by a diverse array of coastal species, which survive and reproduce in the open ocean, contributing strongly to its floating community composition. Analysis of rafting plastic debris in the eastern North Pacific Subtropical Gyre revealed 37 coastal invertebrate taxa, largely of Western Pacific origin, exceeding pelagic taxa richness by threefold. Coastal taxa, including diverse taxonomic groups and life history traits, occurred on 70.5% of debris items. Most coastal taxa possessed either direct development or asexual reproduction, possibly facilitating long-term persistence on rafts. Our results suggest that the historical lack of available substrate limited the colonization of the open ocean by coastal species, rather than physiological or ecological constraints as previously assumed. It appears that coastal species persist now in the open ocean as a substantial component of a neopelagic community sustained by the vast and expanding sea of plastic debris.","author_ids":["A5006095851","A5006973475","A5024124486","A5024134323","A5028394790","A5036201513","A5038241764","A5050157218","A5052394898","A5058240698","A5064639579","A5064831180","A5068378342","A5073900948","A5090653877","A5107248040"],"ca_any_author":true,"ca_led":false,"cited_by_count":77,"doi":"https://doi.org/10.1038/s41559-023-01997-y","domain_tags":["occurrence_and_monitoring","plastisphere"],"facet_tags":["matrix:marine"],"institution_ids":["I117965899","I1301826503","I1319689352","I1326324860","I150209017","I201448701","I22675022","I2801725644","I36258959","I4210086468","I4210138199","I4405266016","I52218309","I97018004"],"is_oa":true,"journal":"Nature Ecology & Evolution","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://www.nature.com/articles/s41559-023-01997-y.pdf","openalex_topics":["T10753","T10765","T12213"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2023-04-17","study_type":"article","title":"Extent and reproduction of coastal species on plastic debris in the North Pacific Subtropical Gyre","type":"article","work_id":"W4366163164","year":2023},{"abstract":"","author_ids":["A5006095851","A5006973475","A5024134323","A5028394790","A5035575335","A5068378342","A5093609881"],"ca_any_author":true,"ca_led":false,"cited_by_count":15,"doi":"https://doi.org/10.1007/s00227-023-04365-3","domain_tags":["ecotoxicology_and_trophic_transfer"],"facet_tags":["matrix:marine"],"institution_ids":["I117965899","I1331384533","I185103710","I22675022","I2801725644","I52218309","I71838634"],"is_oa":false,"journal":"Marine Biology","last_updated":"2026-11-07T11:25:07.637180","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1007/s00227-023-04365-3","openalex_topics":["T10341","T10753","T12213"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2023-12-29","study_type":"article","title":"Marine debris facilitates the long-distance dispersal of fish species","type":"article","work_id":"W4390393893","year":2023}]}
