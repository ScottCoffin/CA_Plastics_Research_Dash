025},{"all":288,"plastic":0,"year":2026}],"cited_by_count":3404,"domain_tags":[],"early_career":false,"first_pub_year":2006,"first_year":2019,"h_index":33,"institution_ids":["I4210090881"],"last_year":2019,"m_quotient":1.65,"name":"Brian C. Balmer","orcid":"https://orcid.org/0000-0001-9734-4042","plastic_basis":"openalex","plastic_citations":7,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I1343028186","name":"United States Fish and Wildlife Service","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2918906522"]},"schema_version":"s3.1","works":[{"abstract":"Tursiops truncatus (Common Bottlenose Dolphin) in Georgia are exposed to multiple natural and anthropogenic stressors. Here, we describe a case study of an adult, male Common Bottlenose Dolphin entangled in marine debris, that was temporarily captured, disentangled, sampled for health assessment, satellite tagged, and released. Photographic-identification history and short-term tagging data support that the animal, Z58, has long-term site fidelity to the estuaries of southern Georgia. Health-assessment results identified several abnormal health parameters, including anemia, which likely resulted from exposure to extremely high site-specific contaminants that are known in the area. This note provides a case study of the various stressors to which Common Bottlenose Dolphins in Georgia are exposed, which can be used to develop effective management strategies for at-risk populations.","author_ids":["A5011254428","A5018422190","A5022387805","A5043466281","A5052267678","A5068450020","A5068536572","A5070355909","A5090975969","A5108543322","A5108645370","A5109254915","A5109406162","A5109841537","A5110013168","A5112420606"],"author_institution_ids":["I4210090881"],"ca_any_author":true,"ca_led":true,"cited_by_count":7,"doi":"https://doi.org/10.1656/058.018.0112","domain_tags":["analytical_methods"],"facet_tags":["matrix:marine"],"institution_ids