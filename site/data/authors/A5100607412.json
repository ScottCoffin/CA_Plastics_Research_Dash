,"orcid":"https://orcid.org/0000-0003-0786-5931","plastic_basis":"openalex","plastic_citations":38,"plastic_works_count":1,"primary_affiliations":[{"country_code":"CN","id":"I114539943","name":"Zhejiang Chinese Medical University","source":"openalex_last_known"},{"country_code":"CN","id":"I192578869","name":"Chengde Medical University","source":"openalex_last_known"},{"country_code":"CN","id":"I200296433","name":"Chinese Academy of Medical Sciences & Peking Union Medical College","source":"openalex_last_known"},{"country_code":"CN","id":"I20231570","name":"Peking University","source":"openalex_last_known"},{"country_code":"CN","id":"I205016115","name":"Hubei University of Chinese Medicine","source":"openalex_last_known"},{"country_code":"CN","id":"I37574244","name":"Sichuan Agricultural University","source":"openalex_last_known"},{"country_code":"CN","id":"I4210124809","name":"Peking University People's Hospital","source":"openalex_last_known"},{"country_code":"CN","id":"I76130692","name":"Zhejiang University","source":"openalex_last_known"}],"rising_pct":27,"rising_score":-0.0021,"work_count":1,"work_ids":["W2959101220"]},"schema_version":"s3.1","works":[{"abstract":"High Resolution Image Download MS PowerPoint Slide Smoked cigarettes are the most prevalent form of litter worldwide, often finding their way into oceans and inland waterways. Cigarette smoke contains more than 4000 individual chemicals, some of them carcinogenic or otherwise toxic. We examined the cytotoxicity, genotoxicity, aryl hydrocarbon receptor (AhR), estrogen receptor (ER), and p53 response pathways of smoked cigarette leachate in vitro . Both seawater and freshwater leachates of smoked cigarettes were tested. Cytotoxicity and genotoxicity were negligible at 100 smoked cigarettes/L, while statistically significant AhR, ER, and p53 responses were observed in the extracts of both leachates, suggesting a potential risk to human health through exposure to cigarette litter in the environment. To identify responsible chemicals for the AhR response, an effect directed analysis approach was coupled with nontargeted chemical analysis based on comprehensive two-dimensional gas chromatography coupled to time-of-flight mass spectrometry (GC \u00d7 GC/TOF-MS). Eleven compounds potentially responsible for the AhR response were identified. Among them, 2-methylindole was partially responsible for the AhR response.","author_ids":["A5008874542","A5023645209","A5024114636","A5032960324","A5040981386","A5049789262","A5079172346","A5081141264","A5085686369","A5088307368","A5100607412"],"author_institution_ids":["I103635307"],"ca_any_author":true,"ca_led":true,"cited_by_count":38,"doi":"https://doi.org/10.1021/acs.chemrestox.9b00201","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:freshwater","matrix:marine"],"institution_ids":["I103635307","I180670191","I26538001"],"is_oa":true,"journal":"Chemical Research in Toxicology","last_updated":"2026-11-07T11:25:07.637180","license":"other-oa","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1021/acs.chemrestox.9b00201","openalex_topics":["T10122","T10433","T10447"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10433","pub_date":"2019-07-09","study_type":"article","title":"Assessing Toxicity and in Vitro Bioactivity of Smoked Cigarette Leachate Using Cell-Based Assays and Chemical Analysis","type":"article","work_id":"W2959101220","year":2019}]}
