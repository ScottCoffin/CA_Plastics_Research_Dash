,"years":[2005,2006]},{"country_code":"CN","id":"I4210112595","name":"Research Institute of Petroleum Exploration and Development","years":[2006]},{"country_code":"US","id":"I130701444","name":"Georgia Institute of Technology","years":[2004,2005]},{"country_code":"CN","id":"I162868743","name":"Tianjin University","years":[2005]}],"author_id":"A5100610196","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":175,"plastic":0,"year":2017},{"all":242,"plastic":0,"year":2018},{"all":302,"plastic":0,"year":2019},{"all":345,"plastic":0,"year":2020},{"all":410,"plastic":0,"year":2021},{"all":586,"plastic":0,"year":2022},{"all":590,"plastic":0,"year":2023},{"all":697,"plastic":0,"year":2024},{"all":876,"plastic":0,"year":2025},{"all":771,"plastic":4,"year":2026}],"cited_by_count":5848,"current_in_ca":false,"domain_tags":[],"early_career":false,"first_pub_year":2004,"first_year":2025,"h_index":38,"institution_ids":["I161318765"],"last_ca_year":2025,"last_year":2025,"m_quotient":1.73,"name":"Yijie Zhang","orcid":"https://orcid.org/0000-0002-6184-3963","plastic_basis":"openalex","plastic_citations":4,"plastic_works_count":2,"primary_affiliations":[{"country_code":"CN","id":"I204983213","name":"Harbin Institute of Technology","source":"openalex_last_known"},{"country_code":"GB","id":"I59433898","name":"Brunel University of London","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4410991782"]},"schema_version":"s3.1","works":[{"abstract":"The global shift to electric vehicles necessitates the expansion of Direct Current Fast Charging (DCFC) stations, yet the related environmental and public health impacts remain unclear. Here, we report that the power cabinet at DCFC stations emit fine particulate matter (PM 2.5 ). We collected integrated filter samples from 50 DCFC stations across 47 cities in Los Angeles County, California. The daily PM 2.5 concentrations were between 7.3 and 39.0 \u00b5g m \u22123 , significantly higher than urban background sites ( p = 0.02) and the nearest U.S. EPA monitoring stations ( p < 0.0001). To understand the emission mechanism of these particles, we measured real-time PM 2.5 mass concentration, particle size distribution, and other pollutants, as well as characterized particle chemical compositions on integrated filter samples. Our results indicate that these particles, primarily in the sub-micrometer range (0.5\u20131.0 \u00b5m), are likely due to particle resuspension from the power cabinets. PM 2.5 samples from power cabinets showed higher levels of brake and tire wear tracers (Ba, Cu, Zn) and dust tracers (Ca, Al, Fe) compared to samples from nearby chargers and background sites. With no current emission standards for DCFC, managing particle resuspension is crucial for improving air quality and protecting public health as transportation electrification advances.","author_count":12,"author_ids":["A5010638511","A5016207990","A5027897053","A5036277355","A5043699175","A5049927309","A5050828752","A5051677610","A5083480920","A5100610196","A5100737840"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5100737840","name":"Yuan Yao"},{"id":"A5036277355","name":"Liqiao Li"},{"id":"A5051677610","name":"Muchuan Niu"},{"id":"A5049927309","name":"Haoxuan Chen"},{"id":"","name":"Qiao Yu"},{"id":"A5010638511","name":"Qingyang Wu"},{"id":"A5083480920","name":"Yuhang Li"},{"id":"A5100610196","name":"Yijie Zhang"},{"id":"A5016207990","name":"Aydogan \u00d6zcan"},{"id":"A5043699175","name":"Michael Jerrett"},{"id":"A5050828752","name":"Yuan Yao"},{"id":"A5027897053","name":"Yifang Zhu"}],"ca_any_author":true,"ca_led":true,"cited_by_count":4,"doi":"https://doi.org/10.1016/j.envint.2025.109581","domain_tags":["air","occurrence_and_monitoring"],"facet_tags":["matrix:air"],"institution_ids":["I161318765"],"is_oa":true,"journal":"Environment International","last_updated":"2026-11-06T12:05:46.655746","license":"cc-by","needs_review":false,"oa_status":