{"author":{"affiliation_history":[{"country_code":"US","id":"I1333577951","name":"California Department of Fish and Wildlife","years":[2024,2026]},{"country_code":"US","id":"I84218800","name":"University of California, Davis","years":[2014,2015,2018,2019,2020,2022,2025]},{"country_code":"US","id":"I52218309","name":"Smithsonian Environmental Research Center","years":[2022]},{"country_code":"US","id":"I205783295","name":"Cornell University","years":[2013,2014]}],"author_id":"A5016494429","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":9,"plastic":0,"year":2017},{"all":19,"plastic":4,"year":2018},{"all":17,"plastic":4,"year":2019},{"all":15,"plastic":4,"year":2020},{"all":16,"plastic":3,"year":2021},{"all":24,"plastic":5,"year":2022},{"all":34,"plastic":4,"year":2023},{"all":36,"plastic":4,"year":2024},{"all":34,"plastic":2,"year":2025},{"all":36,"plastic":1,"year":2026}],"cited_by_count":264,"domain_tags":[],"early_career":false,"first_pub_year":2013,"first_year":2018,"h_index":8,"institution_ids":["I84218800"],"last_year":2018,"m_quotient":0.62,"name":"Gabriel Ng","orcid":"https://orcid.org/0000-0001-6481-1249","plastic_basis":"openalex","plastic_citations":31,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I1333577951","name":"California Department of Fish and Wildlife","source":"openalex_last_known"}],"rising_pct":33,"rising_score":-0.001,"work_count":1,"work_ids":["W2789116255"]},"schema_version":"s3.1","works":[{"abstract":"Marine debris is a global environmental problem especially apparent on small islands throughout the world. We implemented an educational outreach program to engage primary and secondary students in the scientific process using the tangible issue of marine debris on a typical small island in Indonesia (Barrang Lompo, Spermonde Islands, South Sulawesi). Over a three-year period, students conducted systematic sampling of debris on their island's beaches. They quantified the enormity of the debris problem, discussed data, and compared experiences with partner schools in California. The program inspired a unique, local perspective on marine debris that includes greater awareness of human health impacts as well as a need for realistic solutions to this problem faced by small islands.","author_count":15,"author_ids":["A5000229829","A5005804953","A5008463674","A5011252430","A5014821561","A5016494429","A5027342696","A5036398280","A5042431133","A5055685802","A5075342288","A5081600337","A5081631840","A5081918209","A5084561220"],"author_institution_ids":["I84218800"],"authors":[{"id":"A5055685802","name":"Christine Sur"},{"id":"A5081600337","name":"Jessica M. Abbott"},{"id":"A5000229829","name":"Rohani Ambo\u2010Rappe"},{"id":"A5005804953","name":"Nenni Asriani"},{"id":"A5084561220","name":"Sarah O. Hameed"},{"id":"A5011252430","name":"Brittany M. Jellison"},{"id":"A5042431133","name":"Hasriani Ayu Lestari"},{"id":"A5014821561","name":"Steven R. Limbong"},{"id":"A5008463674","name":"Musdalifah Mandasari"},{"id":"A5016494429","name":"Gabriel Ng"},{"id":"A5081631840","name":"Erin V. Satterthwaite"},{"id":"A5075342288","name":"Sulham Syahid"},{"id":"A5027342696","name":"Dale Trockel"},{"id":"A5036398280","name":"Widyastuti Umar"},{"id":"A5081918209","name":"Susan Lynn Williams"}],"ca_any_author":true,"ca_led":true,"cited_by_count":31,"doi":"https://doi.org/10.3389/fmars.2018.00035","domain_tags":[],"facet_tags":["matrix:marine"],"institution_ids":["I84218800","I98301867"],"is_oa":true,"journal":"Frontiers in Marine Science","last_updated":"2026-11-04T10:54:05.112534","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://www.frontiersin.org/articles/10.3389/fmars.2018.00035/pdf","openalex_topics":["T10753","T12165","T13557"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2018-02-16","study_type":"article","title":"Marine Debris on Small Islands: Insights from an Educational Outreach Program in the Spermonde Arc