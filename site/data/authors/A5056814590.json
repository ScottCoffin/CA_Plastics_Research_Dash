":"AT&T (United States)","years":[1991,1992,1993,1995]}],"author_id":"A5056814590","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":869,"plastic":0,"year":2017},{"all":865,"plastic":0,"year":2018},{"all":1130,"plastic":0,"year":2019},{"all":1219,"plastic":0,"year":2020},{"all":1477,"plastic":0,"year":2021},{"all":1885,"plastic":0,"year":2022},{"all":1892,"plastic":0,"year":2023},{"all":2047,"plastic":0,"year":2024},{"all":2755,"plastic":0,"year":2025},{"all":2853,"plastic":1,"year":2026}],"cited_by_count":24243,"domain_tags":[],"early_career":false,"first_pub_year":1987,"first_year":2026,"h_index":72,"institution_ids":["I148283060","I95457486"],"last_year":2026,"m_quotient":1.85,"name":"Teresa L. Head-Gordon","orcid":"https://orcid.org/0000-0003-0025-8987","plastic_basis":"openalex","plastic_citations":1,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I148283060","name":"Lawrence Berkeley National Laboratory","source":"openalex_last_known"},{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"},{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W7221776748"]},"profile":{"bio":"","keywords":[],"links":[],"photo":{"credit":"Teresa Head-Gordon sent it by mail to me.","license":"CC0","source_url":"https://commons.wikimedia.org/wiki/File:Teresa_Head-Gordon_2026.jpg","thumb_url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/87/Teresa_Head-Gordon_2026.jpg/250px-Teresa_Head-Gordon_2026.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"}},"schema_version":"s3.1","works":[{"abstract":"Plastics have become an integral part of our modern society, largely because they are generally regarded as chemically inert under normal circumstances. However, plastics fragmented into microplastics (less than 5 mm in size) have recently raised significant public concerns, and have been detected widely across ecosystems and human tissues with increasing environmental and health risks1\u20135. Here we show that commodity microplastics exhibit intrinsic physicochemical activity in water, manifested by the spontaneous generation of reactive oxygen species that increases with interfacial hydrophobicity and strongly correlates with interfacial electrostatics. Ab initio calculations support these observations and reveal that hydroxide oxidation becomes energetically more favourable at increasingly hydrophobic microplastic\u2013water interfaces through the combined effects of partial solvation and electrostatics. These interfacial properties and the resulting oxidative chemistry have direct implications for biomolecular adsorption, protein aggregation, and even cellular damage. Together, our findings challenge the prevailing paradigm of plastic inertness, identify a possibly overlooked mechanism for the detrimental effects of microplastics on health and the environment, and contribute to a fundamental understanding of the structure\u2013activity relationship of interfacial water, which may inform the design of safer and more sustainable plastic materials. Commodity microplastics exhibit intrinsic physicochemical activity at water interfaces, manifested by spontaneous generation of reactive oxygen species, challenging the prevailing paradigm of plastic inertness, with implications for human health and the environment.","author_count":12,"author_ids":["A5001978515","A5005469877","A5016576057","A5046584794","A5056814590","A5063833391","A5065649622","A5070879896","A5081170581","A5085580946","A5088396167","A5118871086"],"author_institution_ids":["I148283060","I95457486"],"authors":[{"id":"A5001978515","name":"Naixin Qian"},{"id":"A5065649622","name":"Ruoqi Zhao"},{"id":"A5085580946","name":"Kwing Yeung Chan"},{"id":"A5118871086","name":"Vinh Gia Vuong"},{"id":"A5088396167","name":"Xin Gao"},{"id":"A5005469877","name":"Zhilun Zhao"},{"id":"A5046584794","name":"R. Allen LaCour"},{"id":"A5070879896","name":"Yifan Dai"},{"id":"A5063833391","name":"Phoebe A. Stapleton"},{"id":"A5016576057","name":"Beizhan Yan"},{"id":"A5056814590","name":"Teresa L. Head-Gordon"},{"id":"A5081170581","name":"Wei Min"}],"ca_any_author":true,"ca_led":false,"cited_by_count":1,"doi":"https://doi.org/10.1038/s41586-026-11141-y","domain_tags":["fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I102322142","I148283060","I152304114","I204465549","I4210109165","I78577930","I95457486"],"is_oa":true,"journal":"Nature","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc-nd","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1038/s41586-026-11141-y","openalex_topics":["T10753","T11401","T14488"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-10-14","study_type":"article","title":"Intrinsic physicochemical activity at microplastic\u2013water interfaces","type":"article","work_id":"W7221776748","year":2026}]}
