ll":73,"plastic":0,"year":2017},{"all":95,"plastic":0,"year":2018},{"all":131,"plastic":2,"year":2019},{"all":202,"plastic":34,"year":2020},{"all":406,"plastic":138,"year":2021},{"all":494,"plastic":187,"year":2022},{"all":589,"plastic":205,"year":2023},{"all":823,"plastic":301,"year":2024},{"all":1002,"plastic":417,"year":2025},{"all":909,"plastic":305,"year":2026}],"cited_by_count":4974,"domain_tags":[],"early_career":false,"first_pub_year":1998,"first_year":2020,"h_index":35,"institution_ids":["I1174212"],"last_year":2020,"m_quotient":1.25,"name":"Yue Zhang","orcid":"https://orcid.org/0000-0002-4427-6127","plastic_basis":"openalex","plastic_citations":1589,"plastic_works_count":8,"primary_affiliations":[{"country_code":"CN","id":"I163151501","name":"Hangzhou Normal University","source":"openalex_last_known"},{"country_code":"CN","id":"I176808543","name":"Liaoning Technical University","source":"openalex_last_known"},{"country_code":"CN","id":"I114117164","name":"University of Science and Technology Liaoning","source":"openalex_last_known"},{"country_code":"CN","id":"I132586189","name":"Zhongyuan University of Technology","source":"openalex_last_known"},{"country_code":"CN","id":"I9842412","name":"Nanjing University of Aeronautics and Astronautics","source":"openalex_last_known"}],"rising_pct":96,"rising_score":0.033,"work_count":2,"work_ids":["W3084117248","W3084886685"]},"schema_version":"s3.1","works":[{"abstract":"Abstract According to the statistics, 8.3 billion metric tonnes of plastics have been produced since 1950s, which is far more than other synthetic materials and the annual production which are about 500 million tonnes per year at present. The production of plastics makes microplastics pollution extremely widespread distribution, which will have a lasting impact on the global environment, especially on the aquaculture systems. And the distribution of the microplastics is extremely imbalanced around the global waters. In the present review, we have summarized the development of aquaculture in the World and China based on the existing data sources. And the total aquaculture production of the World will over 90 million tonnes, which will exceed the capture production in 2020. Aquaculture products will become one of the most important sources of high\u2010quality protein. However, we found that many kinds of microplastics are detected and enriched in both farmed and captured species. Both endogenous and exogenous factors like the use of fishing plastic products, factory farming facility and equipment, natural and synthetic feed, animal health products, aquaculture fortifier and aquatic food additives make accumulation of microplastics easier. In addition, the safety of aquaculture products is closely related to human health because the residues of microplastics in fish leading to various potential hazards. In summary, this paper reviewed the relationship between microplastics and aquaculture, aimed at calling for the rational and restricted use of plastic products in the aquaculture ecosystems.","author_count":7,"author_ids":["A5072595218","A5084566120","A5100331124","A5100333721","A5100369613","A5101723558","A5103180110"],"author_institution_ids":["I1174212"],"authors":[{"id":"A5072595218","name":"Aiguo Zhou"},{"id":"A5100333721","name":"Yue Zhang"},{"id":"A5103180110","name":"Shaolin Xie"},{"id":"A5101723558","name":"Yuliang Chen"},{"id":"A5100331124","name":"Xiang Li"},{"id":"A5100369613","name":"Jun Wang"},{"id":"A5084566120","name":"Jixing Zou"}],"ca_any_author":true,"ca_led":false,"cited_by_count":185,"doi":"https://doi.org/10.1111/raq.12496","domain_tags":["ecotoxicology_and_trophic_transfer","occurrence_and_monitoring"],"facet_tags":["matrix:food_and_drink","matrix:marine"],"institution_ids":["I101479585","I1174212","I1307613440","I4210165264"],"is_oa":false,"journal":"Reviews in Aquaculture","last_updated":"2026-11-11T12:16:26.678958","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://