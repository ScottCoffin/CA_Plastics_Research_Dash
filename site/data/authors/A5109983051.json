rst_pub_year":1972,"first_year":1972,"h_index":25,"institution_ids":["I36053171"],"last_ca_year":2011,"last_year":1972,"m_quotient":0.46,"name":"Jerry R. Williams","orcid":"","plastic_basis":"openalex","plastic_citations":2,"plastic_works_count":1,"primary_affiliations":[{"country_code":"","id":"I36053171","name":"California State University, Chico","source":"atlas_recent"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2009163505"]},"schema_version":"s3.1","works":[{"abstract":"The ubiquitous nature of roadside trash easily lends itself to instructional use by geographers and others who are concerned with the environment. Various aspects of the litter problem can be manipulated in the classroom and in the field to effectively develop concepts of scientific method, information acquisition and recording, techniques of data analyses, means of classification and interpretation, and also to predict new problems and hypotheses. Moreover, through the use of the litter census technique, community-action projects may be stimulated and closer ties developed between the community and its schools.","author_count":2,"author_ids":["A5060147524","A5109983051"],"author_institution_ids":["I36053171"],"authors":[{"id":"A5060147524","name":"Bruce E. Bechtol"},{"id":"A5109983051","name":"Jerry R. Williams"}],"ca_any_author":true,"ca_led":true,"cited_by_count":2,"doi":"https://doi.org/10.1080/00221347208985331","domain_tags":[],"facet_tags":[],"institution_ids":["I36053171"],"is_oa":false,"journal":"Journal of Geography","last_updated":"2026-10-30T12:39:25.321706","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1080/00221347208985331","openalex_topics":["T12165","T12343","T13557"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T12343","pub_date":"1972-11-01","study_type":"article","title":"The Litter Census as a Tool in Geographic Education","type":"article","work_id":"W2009163505","year":1972}]}
