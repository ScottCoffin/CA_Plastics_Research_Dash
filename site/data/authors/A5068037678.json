_ids":["I95457486"],"last_year":2019,"m_quotient":1.98,"name":"Martyn T. Smith","orcid":"https://orcid.org/0000-0003-1451-6377","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2985810567"]},"schema_version":"s3.1","works":[{"abstract":"Endocrine-disrupting chemicals (EDCs) are exogenous chemicals that interfere with hormone action, thereby increasing the risk of adverse health outcomes, including cancer, reproductive impairment, cognitive deficits and obesity. A complex literature of mechanistic studies provides evidence on the hazards of EDC exposure, yet there is no widely accepted systematic method to integrate these data to help identify EDC hazards. Inspired by work to improve hazard identification of carcinogens using key characteristics (KCs), we have developed ten KCs of EDCs based on our knowledge of hormone actions and EDC effects. In this Expert Consensus Statement, we describe the logic by which these KCs are identified and the assays that could be used to assess several of these KCs. We reflect on how these ten KCs can be used to identify, organize and utilize mechanistic data when evaluating chemicals as EDCs, and we use diethylstilbestrol, bisphenol A and perchlorate as examples to illustrate this approach.","author_count":16,"author_ids":["A5015903547","A5032055617","A5032107481","A5037771157","A5048164907","A5054226597","A5056745479","A5063374927","A5064434278","A5068037678","A5068366960","A5075356259","A5077633544","A5079234992","A5101896580","A5104098074"],"author_institution_ids":["I95457486"],"authors":[{"id":"A5075356259","name":"Michele Andrea La Merrill"},{"id":"A5032055617","name":"Laura N. Vandenberg"},{"id":"A5068037678","name":"Martyn T. Smith"},{"id":"A5032107481","name":"William H. Goodson"},{"id":"A5015903547","name":"Patience Browne"},{"id":"A5056745479","name":"Heather B. Patisaul"},{"id":"A5054226597","name":"Kathryn Z. Guyton"},{"id":"A5063374927","name":"Andreas Kortenkamp"},{"id":"A5104098074","name":"Vincent James Cogliano"},{"id":"A5048164907","name":"Tracey J. Woodruff"},{"id":"A5068366960","name":"Linda Rieswijk"},{"id":"A5101896580","name":"Hideko Sone"},{"id":"A5037771157","name":"Kenneth Steven Korach"},{"id":"A5064434278","name":"Andrea C. Gore"},{"id":"A5079234992","name":"Lauren A. Zeise"},{"id":"A5077633544","name":"R. Thomas Zoeller"}],"ca_any_author":true,"ca_led":true,"cited_by_count":1089,"doi":"https://doi.org/10.1038/s41574-019-0273-8","domain_tags":["analytical_methods"],"facet_tags":[],"institution_ids":["CAAG-OEHHA","I1288051870","I1302368450","I137902535","I180670191","I200202764","I24603500","I2801780550","I34352273","I4210095140","I42237331","I59433898","I84218800","I86519309","I95457486"],"is_oa":true,"journal":"Nature Reviews Endocrinology","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://www.nature.com/articles/s41574-019-0273-8.pdf","openalex_topics":["T10433","T10686","T10756"],"plastic_related":false,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10686","pub_date":"2019-11-12","study_type":"review","title":"Consensus on the key characteristics of endocrine-disrupting chemicals as a basis for hazard identification","type":"review","work_id":"W2985810567","year":2019}]}
