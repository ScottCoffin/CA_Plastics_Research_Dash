{"author":{"affiliation_history":[{"country_code":"US","id":"I201448701","name":"University of Washington","years":[2021,2022,2023,2024,2025,2026]},{"country_code":"US","id":"I66958751","name":"Woods Hole Oceanographic Institution","years":[2020,2021,2022,2023,2026]},{"country_code":"US","id":"I186143895","name":"Lehigh University","years":[2023]},{"country_code":"US","id":"I97018004","name":"Stanford University","years":[2015,2016,2017,2019,2020,2021]},{"country_code":"US","id":"I107639228","name":"University of Notre Dame","years":[2016,2017]}],"author_id":"A5058587544","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":28,"plastic":2,"year":2017},{"all":84,"plastic":4,"year":2018},{"all":124,"plastic":3,"year":2019},{"all":201,"plastic":6,"year":2020},{"all":253,"plastic":7,"year":2021},{"all":271,"plastic":2,"year":2022},{"all":430,"plastic":7,"year":2023},{"all":415,"plastic":5,"year":2024},{"all":603,"plastic":3,"year":2025},{"all":798,"plastic":1,"year":2026}],"cited_by_count":3211,"domain_tags":[],"early_career":false,"first_pub_year":2015,"first_year":2015,"h_index":24,"institution_ids":["I97018004"],"last_year":2015,"m_quotient":2.18,"name":"Elizabeth Andruszkiewicz Allan","orcid":"https://orcid.org/0000-0002-9675-0003","plastic_basis":"openalex","plastic_citations":43,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I201448701","name":"University of Washington","source":"openalex_last_known"},{"country_code":"US","id":"I66958751","name":"Woods Hole Oceanographic Institution","source":"openalex_last_known"}],"rising_pct":28,"rising_score":-0.0018,"work_count":1,"work_ids":["W2272057080"]},"schema_version":"s3.1","works":[{"abstract":"Oceans cover most of the planet and 60% of the world's population lives near the coast. Anthropogenic activities along coastlines and in the open ocean have placed the oceans in peril. According to a Pew Oceans Commission Report, among the greatest threats to the ocean are land-based runoff from coastal development, nutrient pollution, overfishing, and invasive species. Here, we describe threats due to microbial, nutrient, chemical, and plastic pollution in addition to declining biodiversity and describe fundamental and applied research needed to mitigate the threats. While the research needs are diverse, we identify several research foci that transcend individual threats: monitoring, fate and transport studies, modeling, innovative natural and engineered treatment systems, and toxicity and health studies. Research within the environmental engineering and science community that addresses these needs will contribute to improving ocean health.","author_count":4,"author_ids":["A5011317017","A5029824968","A5058587544","A5082631144"],"author_institution_ids":["I97018004"],"authors":[{"id":"A5029824968","name":"Alexandria B B Boehm"},{"id":"A5011317017","name":"Niveen S. Ismail"},{"id":"A5082631144","name":"Lauren M. Sassoubre"},{"id":"A5058587544","name":"Elizabeth Andruszkiewicz Allan"}],"ca_any_author":true,"ca_led":true,"cited_by_count":43,"doi":"https://doi.org/10.1089/ees.2015.0252","domain_tags":["fate_transport_and_sorption","occurrence_and_monitoring","wastewater_and_treatment"],"facet_tags":["matrix:marine"],"institution_ids":["I97018004"],"is_oa":false,"journal":"Environmental Engineering Science","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1089/ees.2015.0252","openalex_topics":["T10032","T12414","T13485"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T13485","pub_date":"2015-12-18","study_type":"article","title":"Oceans in Peril: Grand Challenges in Applied Water Quality Research for the 21st Century","type":"article","work_id":"W2272057080","year":2015}]}
