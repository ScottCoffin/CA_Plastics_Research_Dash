plastic":2,"year":2025},{"all":2609,"plastic":1,"year":2026}],"cited_by_count":53653,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1996,"first_year":2018,"h_index":92,"institution_ids":["I142207940","I161318765"],"last_ca_year":2026,"last_year":2018,"m_quotient":3.07,"name":"Tian Xia","orcid":"https://orcid.org/0000-0003-0123-1305","plastic_basis":"openalex","plastic_citations":45,"plastic_works_count":1,"primary_affiliations":[{"country_code":"CN","id":"I135905480","name":"Shanghai Polytechnic University","source":"openalex_last_known"},{"country_code":"CN","id":"I143593769","name":"East China University of Science and Technology","source":"openalex_last_known"},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"},{"country_code":"CN","id":"I19820366","name":"Chinese Academy of Sciences","source":"openalex_last_known"},{"country_code":"CN","id":"I20231570","name":"Peking University","source":"openalex_last_known"},{"country_code":"CN","id":"I4210107235","name":"Institute of Subtropical Agriculture","source":"openalex_last_known"},{"country_code":"CN","id":"I47720641","name":"Huazhong University of Science and Technology","source":"openalex_last_known"},{"country_code":"CN","id":"I76130692","name":"Zhejiang University","source":"openalex_last_known"},{"country_code":"US","id":"I84218800","name":"University of California, Davis","source":"openalex_last_known"}],"rising_pct":21,"rising_score":-0.0036,"work_count":1,"work_ids":["W2782571191"]},"profile":{"bio":"As a professor, I am working to have a fundamental understanding of the interaction at the nano-bio interface between engineered nanomaterials and biological systems, which may lead to the beneficial effects including nanomedicine and nano-theranostics or adverse health effects such as nanosafety issues that may lead to diseases. To achieve this goal, I am working with a multidisciplinary team including chemists, engineers, biologists, medical doctors, public health professionals, statisticians and computer scientists. Daily interactions via email, phone call, and face to face meeting with\u2026","keywords":[],"links":[{"label":"Researchgate","url":"https://www.researchgate.net/profile/Tian-Xia-58"},{"label":"Google Scholar","url":"https://scholar.google.co.uk/citations?hl=en&user=z8Qoj7wAAAAJ"}]},"schema_version":"s3.1","works":[{"abstract":"Nanoenabled products (NEPs) have numerous outdoor uses in construction, transportation or consumer scenarios, and there is evidence that their fragments are released in the environment at low rates. We hypothesized that the lower surface availability of NEPs fragment reduced their environmental effects with respect to pristine nanomaterials. This hypothesis was explored by testing fragments generated by intentional micronisation (\"the SUN approach\"; Nowack et al. Meeting the Needs for Released Nanomaterials Required for Further Testing: The SUN Approach. Environmental Science & Technology, 2016 (50), 2747). The NEPs were composed of four matrices (epoxy, polyolefin, polyoxymethylene, and cement) with up to 5% content of three nanomaterials (carbon nanotubes, iron oxide, and organic pigment). Regardless of the type of nanomaterial or matrix used, it was observed that nanomaterials were only partially exposed at the NEP fragment surface, indicating that mostly the intrinsic and extrinsic properties of the matrix drove the NEP fragment toxicity. Ecotoxicity in multiple assays was done covering relevant media from terrestrial to aquatic, including sewage treatment plant (biological activity), soil worms (Enchytraeus crypticus), and fish (zebrafish embryo and larvae and trout cell lines). We designed the studies to explore the possible modulation of ecotoxicity by nanomaterial additives in plastics/polymer/cement, finding none. The results support NEPs grouping by the matrix material regarding ecotoxicological effect during the use phase. Furthermore, control results on nanomaterial-free polymer fragments representing microplastic had no significant adverse effects up to the highest concentration tested.","author_count":19,"author_ids":["A5006892025","A5007700138","A5008889869","A5011506032","A5012077515","A5034195776","A5036174856","A5038264749","A5042410162","A5044583774","A5049870120","A5050687086","A5051528309","A5073053565","A5073107103","A5075548630","A5078152853","A5090211289","A5091205267"],"author_institution_ids":["I142207940","I161318765"],"authors":[{"id":"A5073053565","name":"M\u00f3nica J.B. Amorim"},{"id":"A5006892025","name":"Sijie Lin"},{"id":"A5050687086","name":"Karsten Schlich"},{"id":"A5073107103","name":"Jose Maria Navas"},{"id":"A5042410162","name":"Andrea Brunelli"},{"id":"A5036174856","name":"Nicole Neubauer"},{"id":"A5011506032","name":"Klaus Vilsmeier"},{"id":"A5044583774","name":"Anna Luisa Costa"},{"id":"A5051528309","name":"Andreas P. Gondikas"},{"id":"A5091205267","name":"Tian Xia"},{"id":"A5078152853","name":"Liliana Galbis"},{"id":"A5008889869","name":"Elena Badetti"},{"id":"A5034195776","name":"Antonio Marcomini"},{"id":"A5012077515","name":"Danail Rumenov Hristozov"},{"id":"A5090211289","name":"Frank von der Kammer"},{"id":"A5049870120","name":"Kerstin Hund\u2010Rinke"},{"id":"A5038264749","name":"Janeck James Scott-Fordsmand"},{"id":"A5075548630","name":"Andr\u00e9 E. Nel"},{"id":"A5007700138","name":"Wendel Wohlleben"}],"ca_any_author":true,"ca_led":false,"cited_by_count":45,"doi":"https://doi.org/10.1021/acs.est.7b04122","domain_tags":["ecotoxicology_and_trophic_transfer","soil_and_agriculture","wastewater_and_treatment"],"facet_tags":["matrix:soil_and_agriculture","matrix:wastewater"],"institution_ids":["I116953780","I129774422","I142207940","I149461666","I161318765","I204337017","I4210090489","I4210106474","I4210107087","I4210108183","I4210134473","I4210155236","I60858718"],"is_oa":true,"journal":"Environmental Science & Technology","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by-nc-sa","needs_review":false,"oa_status":"green","oa_url":"http://hdl.handle.net/20.500.12792/566","openalex_topics":["T10079","T10447","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2018-01-27","study_type":"article","title":"Environmental Impacts by Fragments Released from Nanoenabled Products: A Multiassay, Multimaterial Exploration by the SUN Approach","type":"article","work_id":"W2782571191","year":2018}]}
