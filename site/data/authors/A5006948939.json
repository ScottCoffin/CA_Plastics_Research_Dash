:1591,"plastic":0,"year":2021},{"all":1793,"plastic":0,"year":2022},{"all":2067,"plastic":0,"year":2023},{"all":2391,"plastic":0,"year":2024},{"all":2870,"plastic":0,"year":2025},{"all":2944,"plastic":6,"year":2026}],"cited_by_count":16862,"domain_tags":[],"early_career":false,"first_pub_year":2006,"first_year":2026,"h_index":62,"institution_ids":["I114027177","I97018004"],"last_year":2026,"m_quotient":3.1,"name":"Colin Ophus","orcid":"https://orcid.org/0000-0003-2348-8558","plastic_basis":"openalex","plastic_citations":6,"plastic_works_count":2,"primary_affiliations":[{"country_code":"US","id":"I114027177","name":"University of North Carolina at Chapel Hill","source":"openalex_last_known"},{"country_code":"US","id":"I148283060","name":"Lawrence Berkeley National Laboratory","source":"openalex_last_known"},{"country_code":"US","id":"I4387154492","name":"Molecular Foundry","source":"openalex_last_known"},{"country_code":"US","id":"I97018004","name":"Stanford University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":2,"work_ids":["W4408165891","W7165908127"]},"profile":{"bio":"","keywords":["Scanning Transmission Electron Microscopy","Transmission Electron Microscopy","Data Science","Electron Scattering Simulations"],"links":[{"label":"Colin Ophus Lab","url":"http://colab.stanford.edu/"},{"label":"py4DSTEM Github","url":"https://github.com/py4dstem/py4DSTEM"},{"label":"Prismatic S/TEM Simulation","url":"https://prism-em.com/"}]},"schema_version":"s3.1","works":[{"abstract":"Blending polymers produces brittle materials due to macrophase separation and poor interfacial adhesion, which is exemplified by mixtures of polyolefins. This presents a formidable challenge for the mechanical recycling of mixed plastic waste. Here, we demonstrate that dynamic covalent crosslinking of immiscible polyolefin blends creates macrophase separated co-continuous architectures, yet they display excellent mechanical properties, which challenges the conventional wisdom regarding morphology-property relationships in polymer blend compatibilization. We find that the position and orientation of dynamic crosslinks and their influence on crystallinity are key to understanding the structure-morphology-property relationships. In particular, high-resolution microscopy imaging reveals alignment of crystallite planes with strong orientational preference, particularly at polymer-polymer interfaces, which contribute to material performance. We further demonstrate that changes in crosslinker density and valency allow the properties of binary and ternary polyolefin blends to be tuned in a modular fashion.","author_count":15,"author_ids":["A5001839231","A5006463823","A5006948939","A5012680865","A5049047772","A5056066091","A5062519013","A5066668731","A5075220872","A5076195940","A5082100545","A5083706074","A5088731924"],"author_institution_ids":["I114027177","I97018004"],"authors":[{"id":"A5066668731","name":"Eliza K. Neidhart"},{"id":"A5006463823","name":"Stephanie M. Ribet"},{"id":"A5082100545","name":"Taehyun A. Lee"},{"id":"A5083706074","name":"Logan T. Kearney"},{"id":"A5088731924","name":"Karen C. Bustillo"},{"id":"A5075220872","name":"Eric A. Dailing"},{"id":"A5001839231","name":"Mutian Hua"},{"id":"A5006948939","name":"Colin Ophus"},{"id":"","name":"Sophia N. Fricke"},{"id":"","name":"Ah-Young Song"},{"id":"A5076195940","name":"Jeffrey A. Reimer"},{"id":"A5056066091","name":"Erik J. Alexanian"},{"id":"A5049047772","name":"Joanna M. Atkin"},{"id":"A5012680865","name":"Brett A. Helms"},{"id":"A5062519013","name":"Frank A. Leibfarth"}],"ca_any_author":true,"ca_led":false,"cited_by_count":6,"doi":"https://doi.org/10.1126/sciadv.aee2328","domain_tags":[],"facet_tags":[],"institution_ids":["I114027177","I1289243028","I148283060","I201448701","I4387154492","I95457486","I97018004"],"is_oa":true,"journal":"Science Advances","last_updated":"2026-11-09T13:22:03.289127","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://doi.org/10.1126/sciadv.aee2328","openalex_topics":["T10389","T10661","T10810"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10389","pub_date":"2026-05-15","study_type":"article","title":"Polyolefin blends with co-continuous architectures enabled by dynamic covalent crosslinking","type":"article","work_id":"W4408165891","year":2026},{"abstract":"Blending polymers produces brittle materials due to macrophase separation and poor interfacial adhesion, which is exemplified by mixtures of polyolefins. This presents a formidable challenge for the mechanical recycling of mixed plastic waste. Here, we demonstrate that dynamic covalent crosslinking of immiscible polyolefin blends creates macrophase-separated co-continuous architectures, yet they display excellent mechanical properties, which challenges the conventional wisdom regarding morphology-property relationships in polymer blend compatibilization. We find that the position and orientation of dynamic crosslinks and their influence on crystallinity are key to understanding the structure-morphology-property relationships. In particular, high-resolution microscopy imaging reveals alignment of crystallite planes with strong orientational preference, particularly at polymer-polymer interfaces, which contribute to material performance. We further demonstrate that changes in crosslinker density and valency allow the properties of binary and ternary polyolefin blends to be tuned in a modular fashion.","author_count":15,"author_ids":["A5001839231","A5006463823","A5006948939","A5010555283","A5012680865","A5056066091","A5056365904","A5062519013","A5066668731","A5075220872","A5083706074","A5108822322","A5108823605","A5128088529","A5129794252"],"author_institution_ids":["I97018004"],"authors":[{"id":"A5066668731","name":"Eliza K. Neidhart"},{"id":"A5006463823","name":"Stephanie M. Ribet"},{"id":"A5108823605","name":"T N Guhr Lee"},{"id":"A5083706074","name":"Logan T. Kearney"},{"id":"A5129794252","name":"