,"years":[2008]},{"country_code":"US","id":"I4210159838","name":"NIST Center for Neutron Research","years":[2008]},{"country_code":"US","id":"I1321296531","name":"National Institute of Standards and Technology","years":[2008]},{"country_code":"US","id":"I66946132","name":"University of Maryland, College Park","years":[2008]},{"country_code":"US","id":"I75027704","name":"University of Tennessee at Knoxville","years":[2008]}],"author_id":"A5019614234","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":658,"plastic":0,"year":2017},{"all":888,"plastic":0,"year":2018},{"all":1046,"plastic":0,"year":2019},{"all":1315,"plastic":0,"year":2020},{"all":1423,"plastic":0,"year":2021},{"all":1514,"plastic":0,"year":2022},{"all":1563,"plastic":0,"year":2023},{"all":1701,"plastic":0,"year":2024},{"all":1708,"plastic":0,"year":2025},{"all":1388,"plastic":0,"year":2026}],"cited_by_count":14565,"domain_tags":[],"early_career":false,"first_pub_year":2004,"first_year":2024,"h_index":59,"institution_ids":["I180670191"],"last_year":2024,"m_quotient":2.68,"name":"Rafael Verduzco","orcid":"https://orcid.org/0000-0002-3649-3455","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I74775410","name":"Rice University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4399795912"]},"schema_version":"s3.1","works":[{"abstract":"Infertility affects \u223c12 % of couples, with environmental chemical exposure as a potential contributor. Of the chemicals that are actively manufactured, very few are assessed for reproductive health effects. Rodents are commonly used to evaluate reproductive effects, which is both costly and time consuming. Thus, there is a pressing need for rapid methods to test a broader range of chemicals. Here, we developed a strategy to evaluate large numbers of chemicals for reproductive toxicity via a yeast, S. cerevisiae high-throughput assay to assess gametogenesis as a potential new approach method (NAM). By simultaneously assessing chemicals for growth effects, we can distinguish if a chemical affects gametogenesis only, proliferative growth only or both. We identified a well-known mammalian reproductive toxicant, bisphenol A (BPA) and ranked 19 BPA analogs for reproductive harm. By testing mixtures of BPA and its analogs, we found that BPE and 17 \u03b2-estradiol each together with BPA showed synergistic effects that worsened reproductive outcome. We examined an additional 179 environmental chemicals including phthalates, pesticides, quaternary ammonium compounds and per- and polyfluoroalkyl substances and found 57 with reproductive effects. Many of the chemicals were found to be strong reproductive toxicants that have yet to be tested in mammals. Chemicals having affect before meiosis I division vs. meiosis II division were identified for 16 gametogenesis-specific chemicals. Finally, we demonstrate that in general yeast reproductive toxicity correlates well with published reproductive toxicity in mammals illustrating the promise of this NAM to quickly assess chemicals to prioritize the evaluation for human reproductive harm.","author_count":14,"author_ids":["A5007289285","A5007546431","A5016607357","A5019614234","A5028081724","A5041558527","A5048164907","A5056121737","A5056848056","A5062835705","A5069534306","A5073810052","A5090719346","A5092741245"],"author_institution_ids":["I180670191"],"authors":[{"id":"A5007546431","name":"Ravinder Kumar"},{"id":"A5056121737","name":"Ashwini Oke"},{"id":"A5069534306","name":"Beth Rockmill"},{"id":"A5056848056","name":"Matthew de Cruz"},{"id":"A5019614234","name":"Rafael Verduzco"},{"id":"A5041558527","name":"Anura Shodhan"},{"id":"A5092741245","name":"Xavier Woodruff-Madeira"},{"id":"A5007289285","name":"Dimitri Abrahamsson"},{"id":"A5073810052","name":"Julia Varshavsky"},{"id":"A5016607357","name":"Juleen Lam"},{"id":"A5028081724","name":"Joshua F. Robinson"},{"id":"A5062835705","name":"Patrick Allard"},{"id":"A5048164907","name":"Tracey J. Woodruff"},{"id":"A5090719346","name":"Jennifer Carol Fung"}],"ca_any_author":true,"ca_led":true,"cited_by_count":6,"doi":"https://doi.org/10.1016/j.reprotox.2024.108630","domain_tags":["analytical_methods","human_exposure_and_health_risk"],"facet_tags":[],"institution_ids":["I12912129","I161318765","I180670191","I184813773"],"is_oa":true,"journal":"Reproductive Toxicology","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by-nc-nd","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1016/j.reprotox.2024.108630","openalex_topics":["T10364","T10433","T10686"],"plastic_related":false,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10686","pub_date":"2024-06-19","study_type":"article","title":"Rapid identification of reproductive toxicants among environmental chemicals using an in vivo evaluation of gametogenesis in budding yeast Saccharomyces cerevisiae","type":"article","work_id":"W4399795912","year":2024}]}
