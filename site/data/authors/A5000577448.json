"all":330,"plastic":0,"year":2019},{"all":365,"plastic":3,"year":2020},{"all":432,"plastic":5,"year":2021},{"all":474,"plastic":3,"year":2022},{"all":454,"plastic":3,"year":2023},{"all":537,"plastic":7,"year":2024},{"all":588,"plastic":4,"year":2025},{"all":570,"plastic":8,"year":2026}],"cited_by_count":7323,"domain_tags":[],"early_career":false,"first_pub_year":1998,"first_year":2019,"h_index":38,"institution_ids":["I203455613"],"last_year":2019,"m_quotient":1.36,"name":"Mathew David Halls","orcid":"https://orcid.org/0000-0001-8989-8934","plastic_basis":"openalex","plastic_citations":33,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I203455613","name":"Schrodinger (United States)","source":"openalex_last_known"}],"rising_pct":36,"rising_score":-0.0008,"work_count":1,"work_ids":["W2982200123"]},"schema_version":"s3.1","works":[{"abstract":"We describe the implementation and outcomes of an outreach program that spanned three class periods for high school students in Advanced Placement Environmental Science or Chemistry. The outreach activities described herein encompass environmental chemistry, sustainable chemistry, polymer chemistry, materials science, ocean ecology, and computational chemistry. Peer instruction and process-oriented guided inquiry-based learning are used to guide student learning. Through these active learning approaches, students learn the differences in chemical structures of common plastics and how these differences define which plastics readily break down into microplastics in the ocean. A systems-thinking approach is used to place the chemistry of plastics into the context of sustainability initiatives, ocean impacts, and the utility of plastic in our everyday lives. Students were given the choice of a laboratory report or a service-learning assignment as a summative assessment. Results of formative assessments, including responses to peer instruction questions, are presented, and considerations for other institutions that may be interested in implementing this material in their courses are discussed.","author_count":5,"author_ids":["A5000577448","A5052933397","A5058159400","A5075260873","A5079359290"],"author_institution_ids":["I203455613"],"authors":[{"id":"A5058159400","name":"Jamie M. Schiffer"},{"id":"A5052933397","name":"Johnnie Lyman"},{"id":"A5075260873","name":"Debra Byrd"},{"id":"A5079359290","name":"Hercules Silverstein"},{"id":"A5000577448","name":"Mathew David Halls"}],"ca_any_author":true,"ca_led":true,"cited_by_count":33,"doi":"https://doi.org/10.1021/acs.jchemed.9b00249","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I203455613"],"is_oa":false,"journal":"Journal of Chemical Education","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.jchemed.9b00249","openalex_topics":["T10072","T10753","T12327"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T12327","pub_date":"2019-10-25","study_type":"article","title":"Microplastics Outreach Program: A Systems-Thinking Approach To Teach High School Students about the Chemistry and Impacts of Plastics","type":"article","work_id":"W2982200123","year":2019}]}
