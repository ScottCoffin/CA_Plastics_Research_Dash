{"author":{"affiliation_history":[{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","years":[1990,1992,1993,1994,1995,1996,1997,1998,1999,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2014,2016,2017,2019,2020,2024,2025,2026]},{"country_code":"US","id":"I2803209242","name":"University of California System","years":[2007,2010]},{"country_code":"CA","id":"I4210089520","name":"Geoscience BC","years":[2009]},{"country_code":"JP","id":"I205401836","name":"National Institute for Materials Science","years":[2009]},{"country_code":"US","id":"I154570441","name":"University of California, Santa Barbara","years":[2009]},{"country_code":"US","id":"I181233156","name":"University of Oregon","years":[2009]},{"country_code":"US","id":"I43369023","name":"California State University, San Bernardino","years":[2006]},{"country_code":"US","id":"I63135867","name":"University of Cincinnati","years":[1979,1981,1982,1986,1990,1992,1996]},{"country_code":"US","id":"I92156820","name":"University of Cincinnati Medical Center","years":[1979,1983,1984,1985,1986,1987,1988,1989,1996]},{"country_code":"CA","id":"I32625721","name":"University of Saskatchewan","years":[1973,1974,1975,1976]}],"author_id":"A5042856509","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":113,"plastic":0,"year":2017},{"all":105,"plastic":0,"year":2018},{"all":106,"plastic":0,"year":2019},{"all":146,"plastic":0,"year":2020},{"all":125,"plastic":0,"year":2021},{"all":78,"plastic":0,"year":2022},{"all":95,"plastic":0,"year":2023},{"all":107,"plastic":0,"year":2024},{"all":90,"plastic":0,"year":2025},{"all":77,"plastic":0,"year":2026}],"cited_by_count":3404,"domain_tags":[],"early_career":false,"first_pub_year":1971,"first_year":2016,"h_index":26,"institution_ids":["I161318765"],"last_year":2016,"m_quotient":0.47,"name":"Shane S. Que Hee","orcid":"https://orcid.org/0000-0001-6885-879X","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2498253482"]},"schema_version":"s3.1","works":[{"abstract":"Concerns about the safety of Bisphenol A, a chemical found in plastics, receipts, food packaging and more, have led to its replacement with substitutes now found in a multitude of consumer products. However, several popular BPA-free alternatives, such as Bisphenol S, share a high degree of structural similarity with BPA, suggesting that these substitutes may disrupt similar developmental and reproductive pathways. We compared the effects of BPA and BPS on germline and reproductive functions using the genetic model system Caenorhabditis elegans. We found that, similarly to BPA, BPS caused severe reproductive defects including germline apoptosis and embryonic lethality. However, meiotic recombination, targeted gene expression, whole transcriptome and ontology analyses as well as ToxCast data mining all indicate that these effects are partly achieved via mechanisms distinct from BPAs. These findings therefore raise new concerns about the safety of BPA alternatives and the risk associated with human exposure to mixtures.","author_ids":["A5013476326","A5030992305","A5038441548","A5042856509","A5062835705","A5088751229","A5090730019","A5101438449"],"author_institution_ids":["I161318765"],"ca_any_author":true,"ca_led":true,"cited_by_count":105,"doi":"https://doi.org/10.1371/journal.pgen.1006223","domain_tags":["human_exposure_and_health_risk"],"facet_tags":["matrix:food_and_drink"],"institution_ids":["I161318765"],"is_oa":true,"journal":"PLoS Genetics","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://journals.plos.org/plosgenetics/article/file?id=10.1371/journal.pgen.1006223&type=printable","openalex_topics":["T10269","T10686","T11505"],"plastic_related":false,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10686","pub_date":"2016-07-29","study_type":"article","title":"Exposure to the BPA-Substitute Bisphenol S Causes Unique Alterations of Germline Function","type":"article","work_id":"W2498253482","year":2016}]}
