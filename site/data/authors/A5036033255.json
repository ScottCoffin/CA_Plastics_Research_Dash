{"author":{"affiliation_history":[{"country_code":"US","id":"I1301553790","name":"J. Craig Venter Institute","years":[2024,2026]},{"country_code":"US","id":"I170897317","name":"Duke University","years":[2016,2017,2018,2019,2021,2022,2024,2025]},{"country_code":"CN","id":"I61057504","name":"Fujian Agriculture and Forestry University","years":[2025]}],"author_id":"A5036033255","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":7,"plastic":0,"year":2017},{"all":17,"plastic":0,"year":2018},{"all":30,"plastic":0,"year":2019},{"all":52,"plastic":0,"year":2020},{"all":57,"plastic":0,"year":2021},{"all":107,"plastic":0,"year":2022},{"all":83,"plastic":0,"year":2023},{"all":127,"plastic":1,"year":2024},{"all":146,"plastic":1,"year":2025},{"all":165,"plastic":1,"year":2026}],"cited_by_count":794,"domain_tags":[],"early_career":true,"first_pub_year":2016,"first_year":2024,"h_index":10,"institution_ids":["I1301553790"],"last_year":2024,"m_quotient":1.0,"name":"Feilun Wu","orcid":"https://orcid.org/0000-0002-0093-1943","plastic_basis":"openalex","plastic_citations":3,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I1301553790","name":"J. Craig Venter Institute","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4399031136"]},"schema_version":"s3.1","works":[{"abstract":"Biotechnology for Sustainable Materials, positioned at the forefront of environmentally conscious practices, is pivotal in realizing the objectives of Sustainable Development Goal 12 (Responsible Consumption and Production). Sustainable materials are essential components in the quest for environmentally responsible practices. These materials, derived from renewable sources or recycled content, aim to minimize adverse environmental impacts throughout their life cycle. They contribute to the circular economy by prioritizing reuse, recycling, and closed-loop systems. Sustainable materials are characterized by low carbon footprints, biodegradability, and the ability to be recycled without compromising integrity. Biotechnological innovations play a pivotal role in developing materials derived from renewable sources or repurposed waste, aligning with the principles of sustainability. Biotechnology facilitates the production of plant- and microbe-based biopolymers, bioplastics, and other biomaterials with enhanced environmental credentials. This critical intersection of sustainable materials and biotechnology not only addresses immediate environmental concerns but also shapes a circular economy, promoting efficient resource use and waste reduction.","author_count":17,"author_ids":["A5015828851","A5034078097","A5036033255","A5049479765","A5054487597","A5057324664","A5069573028","A5074528942","A5077443636","A5081891279","A5081907768","A5082323415","A5084078871","A5086163932","A5088764494","A5100690866"],"author_institution_ids":["I1301553790"],"authors":[{"id":"A5082323415","name":"Shashi Kant Bhatia"},{"id":"A5077443636","name":"Saurabh Bhatia"},{"id":"A5081907768","name":"Mar\u00eda Eugenia Inda"},{"id":"A5086163932","name":"Konstantina Kourmentza"},{"id":"A5069573028","name":"Tae Seok Moon"},{"id":"A5084078871","name":"Vijai Singh"},{"id":"A5015828851","name":"Vishal Ahuja"},{"id":"A5100690866","name":"Jingbo Li"},{"id":"A5034078097","name":"Sanjeet Mehariya"},{"id":"A5049479765","name":"Abhishek Walia"},{"id":"A5081891279","name":"Jinjin Diao"},{"id":"","name":"Taehee Han"},{"id":"A5074528942","name":"Jothi Vinoth Kumar"},{"id":"A5054487597","name":"Chenyi Li"},{"id":"A5088764494","name":"\u00d6. Duhan Toparlak"},{"id":"A5036033255","name":"Feilun Wu"},{"id":"A5057324664","name":"Jikai Zhao"}],"ca_any_author":true,"ca_led":false,"cited_by_count":3,"doi":"https://doi.org/10.1186/s44316-024-00006-x","domain_tags":["soil_and_agriculture"],"facet_tags":["matrix:soil_and_agriculture"],"institution_ids":["I101407740","I1301553790","I142263535","I157485424","I204465549","I209803261","I240