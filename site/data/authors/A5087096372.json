071","name":"University of Illinois System","years":[2014]}],"author_id":"A5087096372","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":186,"plastic":0,"year":2017},{"all":311,"plastic":0,"year":2018},{"all":793,"plastic":0,"year":2019},{"all":1498,"plastic":0,"year":2020},{"all":2392,"plastic":0,"year":2021},{"all":2708,"plastic":0,"year":2022},{"all":4126,"plastic":0,"year":2023},{"all":4527,"plastic":6,"year":2024},{"all":5710,"plastic":5,"year":2025},{"all":4171,"plastic":3,"year":2026}],"cited_by_count":27072,"domain_tags":[],"early_career":false,"first_pub_year":2003,"first_year":2025,"h_index":69,"institution_ids":["I161318765"],"last_year":2025,"m_quotient":3.0,"name":"Kai-Wei Chang","orcid":"https://orcid.org/0000-0001-5365-0072","plastic_basis":"openalex","plastic_citations":14,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"},{"country_code":"SG","id":"I172675005","name":"Nanyang Technological University","source":"openalex_last_known"},{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"},{"country_code":"TW","id":"I4210102996","name":"Far Eastern Memorial Hospital","source":"openalex_last_known"},{"country_code":"US","id":"I4405258931","name":"MIT Computer Science and Artificial Intelligence Laboratory","source":"openalex_last_known"},{"country_code":"US","id":"I63966007","name":"Massachusetts Institute of Technology","source":"openalex_last_known"}],"rising_pct":48,"rising_score":0.0016,"work_count":1,"work_ids":["W4412888933"]},"schema_version":"s3.1","works":[{"abstract":"A common technique for aligning large language models (LLMs) relies on acquiring human preferences by comparing multiple generations conditioned on a fixed context.This method, however, relies solely on pairwise comparisons, where the generations are evaluated within an identical context.While effective to such conditional preferences often fail to encompass the nuanced and multidimensional nature of human preferences.In this work, we revisit the traditional paradigm of preference acquisition and propose a new axis based on eliciting preferences jointly over the instructionresponse pairs.Unlike prior preference optimizations, which are designed for conditional ranking protocols (e.g., DPO), we propose Joint Preference Optimization (JPO), a new preference optimization objective that upweights the joint probability of the chosen instructionresponse pair over the rejected instructionresponse pair.Interestingly, LLMs trained with joint instruction-response preference data using JPO outperform LLM trained with DPO by 5.2% and 3.3% win-rate for summarization and open-ended dialogue datasets, respectively.Our findings reveal that joint preferences over instruction and response pairs can significantly enhance the alignment of LLMs by tapping into a broader spectrum of human preference elicitation.The data and code is available at https://github.com/Hritikbansal/jpo.Create a list of four fruits other than Apple Create a list of four fruits Apple, Orange, Banana, Grape Orange, Blueberry, Kiwi, Banana Apple, Orange, Banana, Grape Create a list of beach activities wear sunscreen, don't litter","author_ids":["A5014409944","A5027401438","A5028997209","A5030248499","A5087096372","A5112428050"],"author_institution_ids":["I161318765"],"ca_any_author":true,"ca_led":true,"cited_by_count":14,"doi":"https://doi.org/10.18653/v1/2025.findings-acl.39","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I161318765","I201448701"],"is_oa":true,"journal":"Findings of the Association for Computational Linguistics: ACL (Findings of ACL)","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://aclanthology.org/2025.findings-acl.39.pdf","openalex_topics":["T10028","T10181","T11307"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10028","pub_date":"2025-01-01","study_type":"conference-paper","title":"Comparing Bad Apples to Good Oranges Aligning Large Language Models via Joint Preference Optimization","type":"conference-paper","work_id":"W4412888933","year":2025}]}
