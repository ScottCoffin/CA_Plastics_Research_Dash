{"author":{"affiliation_history":[{"country_code":"US","id":"I146094533","name":"Mitsubishi Corporation (United States)","years":[2008]},{"country_code":"US","id":"I16944753","name":"Clarkson University","years":[2007]},{"country_code":"US","id":"I157725225","name":"University of Illinois Urbana-Champaign","years":[2007]},{"country_code":"US","id":"I154570441","name":"University of California, Santa Barbara","years":[2006]},{"country_code":"DE","id":"I159176309","name":"Universit\u00e4t Hamburg","years":[1997,1998,1999,2000,2001]}],"author_id":"A5109069954","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":39,"plastic":0,"year":2017},{"all":32,"plastic":0,"year":2018},{"all":17,"plastic":0,"year":2019},{"all":23,"plastic":0,"year":2020},{"all":13,"plastic":0,"year":2021},{"all":13,"plastic":0,"year":2022},{"all":16,"plastic":0,"year":2023},{"all":7,"plastic":0,"year":2024},{"all":7,"plastic":0,"year":2025},{"all":4,"plastic":0,"year":2026}],"cited_by_count":777,"domain_tags":[],"early_career":false,"first_pub_year":1997,"first_year":2009,"h_index":10,"institution_ids":[],"last_year":2009,"m_quotient":0.34,"name":"Ines Meinel","orcid":"","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2024495322"]},"schema_version":"s3.1","works":[{"abstract":"We report the performance and characterization of a material based on poly[(3-mercaptopropyl)methylsiloxane] (PMMS) in various soft lithography applications. PMMS stamps were made by cross-linking with triallyl cyanurate and ethoxylated (4) bisphenol A dimethacrylate via thiol\u2212ene mixed-mode chemistry. The surface chemistry of the materials was characterized by XPS when varied from hydrophilic through oxygen plasma treatment, to hydrophobic by exposure to a fluorinated trichlorosilane agent. The materials are transparent above 300 nm and thermally stable up to 225 \u00b0C, thus rendering them capable to be employed in step-and-flash imprint lithography, nanoimprint lithography, nanotransfer printing, and proximity-field nanopatterning. The successful pattern replication from the micrometer to sub-100 nm scale was demonstrated.","author_count":10,"author_ids":["A5007699390","A5012052318","A5020001579","A5045551635","A5064340656","A5078455808","A5109069954","A5109909868","A5111683427"],"author_institution_ids":[],"authors":[{"id":"","name":"Luis M. Campos"},{"id":"A5007699390","name":"Tu T. Truong"},{"id":"A5111683427","name":"Dong Eun Erica Shim"},{"id":"A5078455808","name":"Michael D. Dimitriou"},{"id":"A5020001579","name":"Daniel Jay-Lee Shir"},{"id":"A5109069954","name":"Ines Meinel"},{"id":"A5012052318","name":"Jeffrey A. Gerbec"},{"id":"A5109909868","name":"H. Thomas Hahn"},{"id":"A5045551635","name":"John A. Rogers"},{"id":"A5064340656","name":"Craig J. Hawker"}],"ca_any_author":true,"ca_led":true,"cited_by_count":77,"doi":"https://doi.org/10.1021/cm902506a","domain_tags":["analytical_methods","wastewater_and_treatment"],"facet_tags":[],"institution_ids":["I154570441","I157725225","I161318765"],"is_oa":true,"journal":"Chemistry of Materials","last_updated":"2026-11-07T11:25:07.637180","license":"","needs_review":false,"oa_status":"green","oa_url":"https://www.osti.gov/servlets/purl/1875074","openalex_topics":["T11471","T11737","T12224"],"plastic_related":false,"plastic_tier":"chemicals-in-plastics","primary_topic":"T12224","pub_date":"2009-10-14","study_type":"article","title":"Applications of Photocurable PMMS Thiol\u2212Ene Stamps in Soft Lithography","type":"article","work_id":"W2024495322","year":2009}]}
