id":"A5072396214","name":"June-Soo Park"},{"id":"A5045661948","name":"Andrew E. Jahn"}],"ca_any_author":true,"ca_led":true,"cited_by_count":88,"doi":"https://doi.org/10.1016/j.marpolbul.2013.05.014","domain_tags":["ecotoxicology_and_trophic_transfer"],"facet_tags":[],"institution_ids":["CAAG-OEHHA","I65137940"],"is_oa":false,"journal":"Marine Pollution Bulletin","last_updated":"2026-11-04T10:54:05.112534","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.marpolbul.2013.05.014","openalex_topics":["T10122","T10447","T10753"],"plastic_related":false,"plastic_tier":"","primary_topic":"T10753","pub_date":"2013-06-05","study_type":"article","title":"Detection of nonylphenol and persistent organic pollutants in fish from the North Pacific Central Gyre","type":"article","work_id":"W1994187800","year":2013},{"abstract":"San Francisco Bay\u2019s sediment is currently monitored for a variety of contaminants; however, data regarding the microplastics (MPs) in the area are still scarce. MPs\u2019 occurrence in sediment samples has gained recognition as a reservoir for MP accumulation. Moreover, Bay sediment is also an important matrix for monitoring because sediment tends to accumulate certain contaminants and act as a source of contaminants in the Bay food web. This study analyzed MPs ranging from 25 \u00b5m to 5 mm in surface sediment grab samples (n = 8) and two sediment core samples (n = 2 cores analyzed with 11 samples from different depths). Our findings provide an evaluation of MP levels in different regions of the bay. The MP levels detected in Bay surface grab samples ranged from 2.1 to 11.9 MPs/g dry weight (n = 8), with a mean value of 6.2 MPs/g. The most abundant morphology was fibers, followed by fragments and films.","author_count":8,"author_ids":["A5013880253","A5039550459","A5072396214","A5075165617","A5078508466","A5080055759","A5085201863","A5101715429"],"author_institution_ids":["I180670191","I65137940"],"authors":[{"id