},{"all":203,"plastic":0,"year":2020},{"all":236,"plastic":0,"year":2021},{"all":268,"plastic":0,"year":2022},{"all":378,"plastic":0,"year":2023},{"all":425,"plastic":0,"year":2024},{"all":484,"plastic":0,"year":2025},{"all":434,"plastic":1,"year":2026}],"cited_by_count":3652,"domain_tags":[],"early_career":false,"first_pub_year":2000,"first_year":2026,"h_index":29,"institution_ids":["I98947143"],"last_year":2026,"m_quotient":1.12,"name":"Mingheng Li","orcid":"https://orcid.org/0000-0002-6611-425X","plastic_basis":"openalex","plastic_citations":1,"plastic_works_count":1,"primary_affiliations":[{"country_code":"CN","id":"I19820366","name":"Chinese Academy of Sciences","source":"openalex_last_known"},{"country_code":"CN","id":"I4210094836","name":"Ganzhou People's Hospital","source":"openalex_last_known"},{"country_code":"CN","id":"I4210165038","name":"University of Chinese Academy of Sciences","source":"openalex_last_known"},{"country_code":"CN","id":"I4210167311","name":"Institute of Zoology","source":"openalex_last_known"},{"country_code":"US","id":"I98947143","name":"California State Polytechnic University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W7171988558"]},"profile":{"bio":"","keywords":[],"links":[{"label":"Personal website","url":"https://sites.google.com/view/minghengli"}]},"schema_version":"s3.1","works":[{"abstract":"Disposable polypropylene (PP) face masks constitute a persistent waste stream that is poorly suited to mechanical recycling. Catalytic pyrolysis over ZSM-5 is a widely studied route for converting PP-derived vapors into fuel- and chemical-range hydrocarbons, yet the effects of bifunctional metal/acid zeolite modification on condensed-oil composition remain less explored for mask-derived feedstocks. In this study, ZSM-5 (SiO 2 /Al 2 O 3 = 38) was modified with Ni and Ni W by wet impregnation and evaluated for catalytic pyrolysis of three-ply PP masks in a semi-batch fixed-bed reactor at 475 \u00b0C. Condensed oils were characterized by GC\u2013MS/FID, density, and viscosity at 20 \u00b0C. Relative to parent ZSM-5, Ni/ZSM-5 shifted the recovered liquid product toward a C 8 maximum and increased the relative abundance of C 7 \u2013C 9 monoaromatics, yielding an oil with lower density (0.809 g mL \u22121 ) and the lowest kinematic viscosity (0.778 mm 2 /s). In contrast, Ni-W/ZSM-5 produced a less aromatic condensed oil with a pronounced C 9 maximum, reduced heavy fractions, and the lowest density (0.782 g mL \u22121 ). These results show that Ni and Ni W modification of ZSM-5 can induce modest shifts in condensed-oil composition under the tested conditions.","author_ids":["A5023886928","A5024925064","A5125109070","A5125115883","A5125145350","A5125231077","A5144098249"],"author_institution_ids":["I98947143"],"ca_any_author":true,"ca_led":true,"cited_by_count":1,"doi":"https://doi.org/10.1016/j.fuproc.2026.108550","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:freshwater"],"institution_ids":["I27825529","I98947143"],"is_oa":true,"journal":"Fuel Processing Technology","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://doi.org/10.1016/j.fuproc.2026.108550","openalex_topics":["T10088","T10353","T11630"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10088","pub_date":"2026-07-31","study_type":"article","title":"Tuning carbon-number selectivity in catalytic pyrolysis of polypropylene face masks via Ni- and Ni-W-modified ZSM-5","type":"article","work_id":"W7171988558","year":2026}]}
