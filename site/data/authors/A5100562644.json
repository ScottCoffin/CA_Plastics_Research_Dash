020]},{"country_code":"CN","id":"I83776822","name":"Shandong Institute of Business and Technology","years":[2015]},{"country_code":"CN","id":"I4210098607","name":"Jilin Province Tumor Hospital","years":[2010]},{"country_code":"CN","id":"I186691195","name":"Qingdao Binhai University","years":[2010]}],"author_id":"A5100562644","ca_plastic_works_count":5,"ca_works_count":4,"citations_by_year":[{"all":0,"plastic":0,"year":2017},{"all":1,"plastic":0,"year":2018},{"all":0,"plastic":0,"year":2019},{"all":3,"plastic":0,"year":2020},{"all":11,"plastic":0,"year":2021},{"all":58,"plastic":0,"year":2022},{"all":108,"plastic":14,"year":2023},{"all":227,"plastic":44,"year":2024},{"all":386,"plastic":53,"year":2025},{"all":401,"plastic":112,"year":2026}],"cited_by_count":1195,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2010,"first_year":2024,"h_index":19,"institution_ids":["I1301553790","I204465549"],"last_ca_year":2026,"last_year":2026,"m_quotient":1.19,"name":"Yuxin Tian","orcid":"https://orcid.org/0009-0003-4454-793X","plastic_basis":"openalex","plastic_citations":223,"plastic_works_count":7,"primary_affiliations":[{"country_code":"US","id":"I1301553790","name":"J. Craig Venter Institute","source":"openalex_last_known"},{"country_code":"CN","id":"I148099405","name":"Xi'an University of Architecture and Technology","source":"openalex_last_known"},{"country_code":"CN","id":"I179060312","name":"Northeast Electric Power University","source":"openalex_last_known"},{"country_code":"US","id":"I204465549","name":"Washington University in St. Louis","source":"openalex_last_known"},{"country_code":"CN","id":"I125839683","name":"Beijing Institute of Technology","source":"openalex_last_known"},{"country_code":"CN","id":"I126520041","name":"University of Science and Technology of China","source":"openalex_last_known"},{"country_code":"CN","id":"I135836153","name":"Shenyang Agricultural University","source":"openalex_last_known"},{"country_code":"CN","id":"I150807315","name":"Guangxi University","source":"openalex_last_known"},{"country_code":"CN","id":"I17721919","name":"Shanxi Medical University","source":"openalex_last_known"},{"country_code":"CN","id":"I1793135","name":"Yanbian University","source":"openalex_last_known"},{"country_code":"CN","id":"I183067930","name":"Shanghai Jiao Tong University","source":"openalex_last_known"},{"country_code":"CN","id":"I59028903","name":"Ocean University of China","source":"openalex_last_known"}],"rising_pct":87,"rising_score":0.0146,"work_count":5,"work_ids":["W4403289767","W4404643897","W4417216442","W7125918489","W7223812990"]},"schema_version":"s3.1","works":[{"abstract":"Each year, millions of tons of plastics are produced for use in such applications as packaging, construction, and textiles. While plastic is undeniably useful and convenient, its environmental fate and transport have raised growing concerns about waste and pollution. However, the ease and low cost of producing virgin plastic have so far made conventional plastic recycling economically unattractive. Common contaminants in plastic waste and shortcomings of the recycling processes themselves typically mean that recycled plastic products are of relatively low quality in some cases. The high cost and high energy requirements of typical recycling operations also reduce their economic benefits. In recent years, the bio-upcycling of chemically treated plastic waste has emerged as a promising alternative to conventional plastic recycling. Unlike recycling, bio-upcycling uses relatively mild process conditions to economically transform pretreated plastic waste into value-added products. In this review, we first provide a pr\u00e9cis of the general methodology and limits of conventional plastic recycling. Then, we review recent advances in hybrid chemical/biological upcycling methods for different plastics, including polyethylene terephthalate, polyurethane, polyamide, polycarbonate, polyethylene, polypropylene, polystyrene, and polyvinyl chloride. For each kind of plastic, we summarize both the pretreatment methods for making the plastic bio-available and the microbial chassis for degrading or converting the treated plastic waste to value-added products. We also discuss both the limitations of upcycling processes for major plastics and their potential for bio-upcycling.","author_count":4,"author_ids":["A5028528084","A5049904233","A5069573028","A5100562644"],"author_institution_ids":["I204465549"],"authors":[{"id":"A5049904233","name":"Yifeng Hu"},{"id":"A5100562644","name":"Yuxin Tian"},{"id":"A5028528084","name":"Chenghao Zou"},{"id":"A5069573028","name":"Tae Seok Moon"}],"ca_any_author":true,"ca_led":false,"cited_by_count":22,"doi":"https://doi.org/10.1016/j.biotechadv.2024.108462","domain_tags":["fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I1301553790","I204465549"],"is_oa":true,"journal":"Biotechnology Advances","last_updated":"2026-11-05T12:25:35.769452","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1016/j.biotechadv.2024.108462","openalex_topics":["T10324","T10661","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10324","pub_date":"2024-10-10","study_type":"review","title":"The current progress of tandem chemical and biological plastic upcycling","type":"review","work_id":"W4403289767","year":2024},{"abstract":"","author_count":4,"author_ids":["A5049904233","A5069573028","A5081891279","A5100562644"],"author_institution_ids":["I1301553790","I204465549"],"authors":[{"id":"A5081891279","name":"Jinjin Diao"},{"id":"A5100562644","name":"Yuxin Tian"},{"id":"A5049904233","name":"Yifeng Hu"},{"id":"A5069573028","name":"Tae Seok Moon"}],"ca_any_author":true,"ca_led":false,"cited_by_count":30,"doi":"https://doi.org/10.1016/j.tibtech.2024.10.018","domain_tags":[],"facet_tags":[],"institution_ids":["I1301553790","I204465549"],"is_oa":true,"journal":"Trends in biotechnology","last_updated":"2026-11-11T12:16:26.678958","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://www.sciencedirect.com/science/article/am/pii/S0167779924003093","openalex_topics":["T10324","T10661","T10932"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10932","pub_date":"2024-11-23","study_type":"review","title":"Producing multiple chemicals through biological upcycling of waste poly(ethylene terephthalate)","type":"review","work_id":"W4404643897","year":2024},{"abstract":"Recent studies in developing processes using \u2018single\u2019 plastic waste for microbial conversion have demonstrated great promise in advancing a circular economy. However, chemical complexity and compositional variability of post-consumer \u2018mixed\u2019 plastic waste pose huge challenges to using it as a feedstock for biomanufacturing. Here, we present a process leveraging a synthetic microbial consortium, comprising Rhodococcus jostii strain PET and Acinetobacter baylyi ADP1, enabled by engineering the division of labor. The robust consortium synergistically and stably consumes diverse mixtures of oxygenated compounds, derived from the depolymerization of post-consumer, mixed plastic waste, regardless of the fluctuating plastic waste compositions. We evaluate the upcycling potential of the stable consortium by applying rational metabolic engineering to both specialists, enabling the funneling of these oxygenates into lycopene and lipids. This work highlights the potential of stable microbial consortia to valorize untapped, mixed plastic waste for sustainable biomanufacturing, offering a promising solution to global plastic pollution. The chemical complexity of post-consumer \u2018mixed\u2019 plastic waste limits its use as a feedstock for biomanufacturing. Here the authors combine transition-metal-free plastic deconstruction with a microbial consortium platform to upcycle real-world mixed plastic waste into value-added chemicals.","author_count":5,"author_ids":["A5021676171","A5023893546","A5069573028","A5081891279","A5100562644"],"author_institution_ids":["I1301553790","I204465549"],"authors":[{"id":"A5081891279","name":"Jinjin Diao"},{"id":"A5100562644","name":"Yuxin Tian"},{"id":"A5023893546","name":"Sunkyu Park"},{"id":"A5021676171","name":"Seong-Min Cho"},{"id":"A5069573028","name":"Tae Seok Moon"}],"ca_any_author":true,"ca_led":false,"cited_by_count":34,"doi":"https://doi.org/10.1038/s41467-025-67409-w","domain_tags":[],"facet_tags":[],"institution_ids":["I1301553790","I137902535","I204465549","I4210138813"],"is_oa":true,"journal":"Nature Communications","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://www.nature.com/articles/s41467-025-67409-w_reference.pdf","openalex_topics":["T10324","T10661","T10932"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10324","pub_date":"2025-12-11","study_type":"article","title":"Engineering microbial consortia for mixed plastic upcycling","type":"article","work_id":"W4417216442","year":2025},{"abstract":"","author_count":5,"author_ids":["A5021676171","A5023893546","A5069573028","A5081891279","A5100562644"],"author_institution_ids":["I1301553790","I204465549"],"authors":[{"id":"A5100562644","name":"Yuxin Tian"},{"id":"A5021676171","name":"Seong-Min Cho"},{"id":"A5023893546","name":"Sunkyu Park"},{"id":"A5081891279","name":"Jinjin Diao"},{"id":"A5069573028","name":"Tae Seok Moon"}],"ca_any_author":true,"ca_led":true,"cited_by_count":2,"doi":"https://doi.org/10.1016/j.tibtech.2025.12.013","domain_tags":[],"facet_tags":[],"institution_ids":["I1301553790","I137902535","I204465549"],"is_oa":false,"journal":"Trends in biotechnology","last_updated":"2026-11-08T12:12:28.789561","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.tibtech.2025.12.013","openalex_topics":["T10324","T10661","T10932"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10932","pub_date":"2026-01-29","study_type":"review","title":"Elucidation of odd-chain dicarboxylate metabolism in Acinetobacter baylyi and application to polyethylene upcycling","type":"review","work_id":"W7125918489","year":2026},{"abstract":"","author_count":9,"author_ids":["A5018725927","A5019345945","A5030401347","A5045476051","A5069573028","A5081891279","A5100562644","A5103806764","A5141036718"],"author_institution_ids":["I1301553790","I204465549"],"authors":[{"id":"A5081891279","name":"Jinjin Diao"},{"id":"A5141036718","name":"Zhengyang Xiao"},{"id":"A5018725927","name":"Nanqing Zhou"},{"id":"A5045476051","name":"Bingdi Liu"},{"id":"A5103806764","name":"Yufei Sun"},{"id":"A5100562644","name":"Yuxin Tian"},{"id":"A5030401347","name":"Ludmilla Aristilde"},{"id":"A5019345945","name":"Yinjie Tang"},{"id":"A5069573028","name":"Tae Seok Moon"}],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"https://doi.org/10.1016/j.cej.2026.183574","domain_tags":[],"facet_tags":[],"institution_ids":["I111979921","I1301553790","I204465549"],"is_oa":false,"journal":"Chemical Engineering Journal","last_updated":"2026-11-08T12:12:28.789561","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.cej.2026.183574","openalex_topics":["T10324","T10932","T12688"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10932","pub_date":"2026-10-27","study_type":"article","title":"Catabolic network in Rhodococcus jostii PET for ethylene glycol upcycling","type":"article","work_id":"W7223812990","year":2026}]}
