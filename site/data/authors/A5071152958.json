{"author":{"affiliation_history":[{"country_code":"US","id":"I1344073410","name":"Howard Hughes Medical Institute","years":[2022,2023,2024,2025,2026]},{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","years":[2020,2022,2023,2024,2025,2026]},{"country_code":"US","id":"I200719446","name":"Vanderbilt University","years":[2016,2017,2018,2019,2020,2021,2022,2023,2024,2025]},{"country_code":"US","id":"I130785548","name":"Clark University","years":[2016,2023]},{"country_code":"US","id":"I2801578167","name":"Genetics Society of America","years":[2020]},{"country_code":"US","id":"I103635307","name":"University of California, Riverside","years":[2020]}],"author_id":"A5071152958","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":10,"plastic":0,"year":2017},{"all":19,"plastic":0,"year":2018},{"all":132,"plastic":0,"year":2019},{"all":281,"plastic":0,"year":2020},{"all":551,"plastic":0,"year":2021},{"all":549,"plastic":0,"year":2022},{"all":636,"plastic":0,"year":2023},{"all":1004,"plastic":0,"year":2024},{"all":1067,"plastic":0,"year":2025},{"all":1218,"plastic":3,"year":2026}],"cited_by_count":5472,"domain_tags":[],"early_career":false,"first_pub_year":2015,"first_year":2026,"h_index":36,"institution_ids":["I1344073410","I95457486"],"last_year":2026,"m_quotient":3.27,"name":"Jacob Lucas Steenwyk","orcid":"https://orcid.org/0000-0002-8436-595X","plastic_basis":"openalex","plastic_citations":3,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I1344073410","name":"Howard Hughes Medical Institute","source":"openalex_last_known"},{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W7135184874"]},"profile":{"bio":"","keywords":["Evolutionary genomics","Population genomics"],"links":[{"label":"Personal website","url":"https://jlsteenwyk.github.io/"}]},"schema_version":"s3.1","works":[{"abstract":"Abstract Candida ( Candidozyma ) auris is a critical priority fungal pathogen that emerged two decades ago near simultaneously on multiple continents. Since emergence, C. auris resistance to all four classes of antifungal drugs has been described, including pan-drug resistant isolates, sometimes evolving within patients. Here, we confirm the first isolation of C. auris from Antarctica and show cold-adapted phenotypes and an affinity for binding to nylon. We also provide evidence to suggest mutator phenotypes contribute to the rapid evolution of C. auris and are responsible for the emergence of multiple, distinct genetic clades worldwide. Isolates in clades I, III and IV with a mutator phenotype displayed elevated mutation rates compared to non- auris Candida species. This phenotype had a complex genetic basis and was associated with drug resistance mutations. We postulate that the mutator phenotype has a significant effect on evolutionary potential and is responsible for the emergence and rapid spread of drug-resistance C. auris and novel genetic clades.","author_count":19,"author_ids":["A5009421399","A5026173669","A5032906326","A5038725561","A5039990140","A5047875566","A5050234766","A5062892359","A5065133902","A5070474104","A5071152958","A5076265294","A5080533196","A5112793452","A5124069266","A5129039551","A5129060437","A5129060625","A5129063258"],"author_institution_ids":["I1344073410","I95457486"],"authors":[{"id":"A5038725561","name":"Norman van Rhijn"},{"id":"A5129060437","name":"Emma Gan"},{"id":"A5129039551","name":"Pilvi Hepo-oja"},{"id":"A5129063258","name":"Xinyi Wang"},{"id":"A5129060625","name":"Jia Li"},{"id":"A5076265294","name":"Se\u00e1na Duggan"},{"id":"A5047875566","name":"David Firer"},{"id":"A5112793452","name":"Laila Essa Omar AlSharqi"},{"id":"A5032906326","name":"Hugh Gifford"},{"id":"A5071152958","name":"Jacob Lucas Steenwyk"},{"id":"A5050234766","name":"Amelie P. Brackin"},{"id":"A5070474104","name":"Alireza Abdolrasouli"},{"id":"A5062892359","name":"Andrew M. Borman"},{"id":"A5009421399","name":"Christina A. Cuomo"},{"id":"A5065133902","name":"Matthew C. Fisher"},{"id":"A5026173669","name":"Darius P. H. Armstrong-James"},{"id":"A5080533196","name":"Rhys A. Farrer"},{"id":"A5039990140","name":"Jane Usher"},{"id":"A5124069266","name":"Johanna Rhodes"}],"ca_any_author":true,"ca_led":false,"cited_by_count":3,"doi":"https://doi.org/10.64898/2026.03.13.711634","domain_tags":[],"facet_tags":["matrix:marine"],"institution_ids":["I1344073410","I23923803","I27804330","I28407311","I3018483916","I4387153084","I4387153154","I47508984","I79619799","I95457486"],"is_oa":true,"journal":"bioRxiv (Cold Spring Harbor Laboratory)","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nd","needs_review":false,"oa_status":"green","oa_url":"https://www.biorxiv.org/content/biorxiv/early/2026/03/13/2026.03.13.711634.full.pdf","openalex_topics":["T10150","T10753","T12668"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10150","pub_date":"2026-03-13","study_type":"preprint","title":"Antarctic marine microplastics reveals environmental persistence and rapid evolution of Candida auris","type":"preprint","work_id":"W7135184874","year":2026}]}
