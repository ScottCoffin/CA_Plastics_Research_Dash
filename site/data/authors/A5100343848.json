unt":18,"author_ids":["A5002600060","A5015188538","A5021984684","A5026780188","A5036076820","A5042010300","A5060768508","A5068922521","A5079938762","A5089947106","A5100343848","A5100665512","A5101648087","A5112817212","A5113141783"],"author_institution_ids":["I84218800"],"authors":[{"id":"A5089947106","name":"Changzhi Shi"},{"id":"","name":"Ao Guo"},{"id":"A5079938762","name":"Shaochen Pang"},{"id":"A5112817212","name":"Jing Zhou Yang"},{"id":"A5100343848","name":"Min Liu"},{"id":"","name":"Feng Zhao"},{"id":"A5026780188","name":"Mengjing Wang"},{"id":"","name":"Xiaohan Dou"},{"id":"A5068922521","name":"Qian Sui"},{"id":"A5036076820","name":"Chaoran Xu"},{"id":"A5002600060","name":"Fengbang Wang"},{"id":"A5113141783","name":"Hongbo Fu"},{"id":"A5101648087","name":"Xiqing Li"},{"id":"A5015188538","name":"Zimeng Wang"},{"id":"A5021984684","name":"Xiangcheng Pan"},{"id":"A5060768508","name":"Maoyong Song"},{"id":"A5100665512","name":"Jianmin Chen"},{"id":"A5042010300","name":"Mingliang Fang"}],"ca_any_author":true,"ca_led":false,"cited_by_count":17,"doi":"https://doi.org/10.1038/s44221-025-00418-7","domain_tags":["analytical_methods"],"facet_tags":[],"institution_ids":["I106994412","I143593769","I180670191","I19820366","I20231570","I24943067","I31590910","I4210144289","I4392738069","I84218800"],"is_oa":false,"journal":"Nature Water","last_updated":"2026-11-08T12:12:28.789561","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1038/s44221-025-00418-7","openalex_topics":["T10180","T10419","T10753"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10753","pub_date":"2025-04-02","study_type":"article","title":"Precise characterization of the presence and fate of plastic oligomers in water","type":"article","work_id":"W4409162792","year":2025},{"abstract":"The gastrointestinal tract (GIT) is crucial in the absorption and metabolism of xenobiotics, including phthalates\u2500widespread environmental contaminants associated with various health risks. Estimating human exposure to phthalates via biomonitoring is challenging due to their complex metabolic pathways, resulting in a mass-balance gap between internal and external exposure. The relative contributions of the GIT and liver to phthalate metabolism remain underexplored. This study investigated the metabolism of three representative phthalate diesters\u2500dibutyl phthalate (DBP), di(2-ethylhexyl)phthalate (DEHP), and diethyl phthalate (DEP) in GIT. We first incubated these diesters in simulated stomach and small intestine fluids to identify the primary enzyme responsible for their hydrolysis. The kinetics were further investigated under varying pH conditions (4.0, 5.0, 6.0, 7.0 or 7.5) to mimic the small intestine environment. Next, using a refined human physiologically based toxicokinetic model, we quantified the relative contributions of preabsorption intestinal versus postabsorption hepatic biotransformation to the body burden of phthalates. Our results suggested that DBP and DEHP were extensively metabolized (>90%) in the GIT by lipase, with comparatively lower hepatic involvement, while DEP underwent minimal preadsorption metabolism (13%) in the GIT, highlighting the influence of structure-dependent differences on metabolic rates. This study emphasized the importance of incorporating both intestinal and hepatic metabolism into toxicokinetic analyses. The findings demonstrate the GIT's critical role in limiting phthalate bioavailability, underscoring the need to account for the intestinal first-pass effect in toxicokinetic models to enhance predictions of phthalate pharmacokinetics and health impacts.","author_count":9,"author_ids":["A5026780188","A5042010300","A5046926838","A5063197318","A5071332109","A5100343848","A5100361186","A5100371771"],"author_institution_ids":["I172675005","I84218800"],"authors":[{"id":"A5100343848","name":"Min Liu"},{"id":"","name":"Shenhong Wang"},{"id":"A5100371771","name":"Xing Chen"},{"id":"A5026780188","name":"Mengjing Wang"},{"id":"A5071332109","name":"Haoduo Zhao"},{"id":"A5063197318","name":"Fanrong Zhao"},{"id":"A5046926838","name":"Shixuan Cui"},{"id":"A5100361186","name":"Li Li"},{"id":"A5042010300","name":"Mingliang Fang"}],"ca_any_author":true,"ca_led":true,"cited_by_count":7,"doi":"https://doi.org/10.1021/acs.est.4c12870","domain_tags":["human_exposure_and_health_risk"],"facet_tags":[],"institution_ids":["I114027177","I134113660","I172675005","I180670191","I24943067","I28006308","I52158045","I84218800"],"is_oa":false,"journal":"Environmental Science & Technology","last_updated":"2026-11-04T10:54:05.112534","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.est.4c12870","openalex_topics":["T10122","T10686","T10875"],"plastic_related":true,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10686","pub_date":"2025-04-14","study_type":"article","title":"Separating the Role of Gut Enzymatic Transformation in Modulating Internal Exposure to Three Major Phthalates","type":"article","work_id":"W4409416166","year":2025}]}
