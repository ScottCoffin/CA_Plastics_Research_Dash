{"author":{"affiliation_history":[{"country_code":"US","id":"I4405266016","name":"Hopkins Marine Station","years":[2021,2022,2023,2024,2025,2026]},{"country_code":"US","id":"I97018004","name":"Stanford University","years":[2023]},{"country_code":"US","id":"I84218800","name":"University of California, Davis","years":[2014,2020,2021]},{"country_code":"US","id":"I79516672","name":"University of Louisiana at Lafayette","years":[2016]},{"country_code":"US","id":"I153592363","name":"Lawrence University","years":[2014]}],"author_id":"A5036201513","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":6,"plastic":0,"year":2017},{"all":7,"plastic":0,"year":2018},{"all":2,"plastic":0,"year":2019},{"all":9,"plastic":0,"year":2020},{"all":16,"plastic":0,"year":2021},{"all":39,"plastic":0,"year":2022},{"all":53,"plastic":14,"year":2023},{"all":80,"plastic":21,"year":2024},{"all":57,"plastic":18,"year":2025},{"all":77,"plastic":24,"year":2026}],"cited_by_count":351,"domain_tags":[],"early_career":false,"first_pub_year":2014,"first_year":2023,"h_index":10,"institution_ids":["I4405266016","I97018004"],"last_year":2023,"m_quotient":0.83,"name":"Brendan H. Cornwell","orcid":"https://orcid.org/0000-0001-7839-8379","plastic_basis":"openalex","plastic_citations":77,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I4405266016","name":"Hopkins Marine Station","source":"openalex_last_known"}],"rising_pct":71,"rising_score":0.0056,"work_count":1,"work_ids":["W4366163164"]},"schema_version":"s3.1","works":[{"abstract":"We show that the high seas are colonized by a diverse array of coastal species, which survive and reproduce in the open ocean, contributing strongly to its floating community composition. Analysis of rafting plastic debris in the eastern North Pacific Subtropical Gyre revealed 37 coastal invertebrate taxa, largely of Western Pacific origin, exceeding pelagic taxa richness by threefold. Coastal taxa, including diverse taxonomic groups and life history traits, occurred on 70.5% of debris items. Most coastal taxa possessed either direct development or asexual reproduction, possibly facilitating long-term persistence on rafts. Our results suggest that the historical lack of available substrate limited the colonization of the open ocean by coastal species, rather than physiological or ecological constraints as previously assumed. It appears that coastal species persist now in the open ocean as a substantial component of a neopelagic community sustained by the vast and expanding sea of plastic debris.","author_count":17,"author_ids":["A5006095851","A5006973475","A5024124486","A5024134323","A5028394790","A5036201513","A5038241764","A5050157218","A5052394898","A5058240698","A5064639579","A5064831180","A5068378342","A5073900948","A5090653877","A5107248040"],"author_institution_ids":["I4405266016","I97018004"],"authors":[{"id":"A5006095851","name":"Linsey E. Haram"},{"id":"A5006973475","name":"James T. Carlton"},{"id":"A5052394898","name":"Luca Centurioni"},{"id":"A5073900948","name":"Henry Choong"},{"id":"A5036201513","name":"Brendan H. Cornwell"},{"id":"A5028394790","name":"Mary Ellen Crowley"},{"id":"A5107248040","name":"Matthias Egger"},{"id":"A5064831180","name":"Jan Hafner"},{"id":"A5024124486","name":"Verena Hormann"},{"id":"A5050157218","name":"Laurent Lebreton"},{"id":"A5024134323","name":"Nikolai Maximenko"},{"id":"A5064639579","name":"Megan McCuller"},{"id":"A5058240698","name":"Cathryn Clarke Murray"},{"id":"A5038241764","name":"Jenny Par"},{"id":"A5090653877","name":"Andrey Shcherbina"},{"id":"","name":"Cynthia Wright"},{"id":"A5068378342","name":"Gregory M. Ruiz"}],"ca_any_author":true,"ca_led":false,"cited_by_count":77,"doi":"https://doi.org/10.1038/s41559-023-01997-y","domain_tags":["occurrence_and_monitoring","plastisphere"],"facet_tags":["matrix:marine"],"institution_ids":["I117965899","I1301826503","I1319689352","I1326324860","I150209017","I201448701","I22675022","I2801725644","I36258959","I4210086468","I4210138199","I4405266016","I52218309","I97018004"],"is_oa":true,"journal":"Nature Ecology & Evolution","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://www.nature.com/articles/s41559-023-01997-y.pdf","openalex_topics":["T10753","T10765","T12213"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2023-04-17","study_type":"article","title":"Extent and reproduction of coastal species on plastic debris in the North Pacific Subtropical Gyre","type":"article","work_id":"W4366163164","year":2023}]}
