"year":2023},{"all":64,"plastic":0,"year":2024},{"all":73,"plastic":0,"year":2025},{"all":68,"plastic":0,"year":2026}],"cited_by_count":486,"current_in_ca":false,"domain_tags":[],"early_career":false,"first_pub_year":1992,"first_year":2016,"h_index":10,"institution_ids":["I161318765"],"last_ca_year":2019,"last_year":2019,"m_quotient":0.29,"name":"Yichang Chen","orcid":"https://orcid.org/0000-0002-1756-4764","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"CN","id":"I3923682","name":"Soochow University","source":"openalex_last_known"},{"country_code":"CN","id":"I4210125137","name":"First Hospital of Jilin University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":2,"work_ids":["W2498253482","W2969437147"]},"schema_version":"s3.1","works":[{"abstract":"Concerns about the safety of Bisphenol A, a chemical found in plastics, receipts, food packaging and more, have led to its replacement with substitutes now found in a multitude of consumer products. However, several popular BPA-free alternatives, such as Bisphenol S, share a high degree of structural similarity with BPA, suggesting that these substitutes may disrupt similar developmental and reproductive pathways. We compared the effects of BPA and BPS on germline and reproductive functions using the genetic model system Caenorhabditis elegans. We found that, similarly to BPA, BPS caused severe reproductive defects including germline apoptosis and embryonic lethality. However, meiotic recombination, targeted gene expression, whole transcriptome and ontology analyses as well as ToxCast data mining all indicate that these effects are partly achieved via mechanisms distinct from BPAs. These findings therefore raise new concerns about the safety of BPA alternatives and the risk associated with human exposure to mixtures.","author_count":9,"author_ids":["A5013476326","A5030992305","A5038441548","A5042856509","A5062835705","A5088751229","A5090730019","A5101438449"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5101438449","name":"Yichang Chen"},{"id":"A5013476326","name":"Le Shu"},{"id":"A5038441548","name":"Zhiqun Qiu"},{"id":"","name":"Dong Yeon Lee"},{"id":"A5030992305","name":"Sara J. Settle"},{"id":"A5042856509","name":"Shane S. Que Hee"},{"id":"A5090730019","name":"Donatello Telesca"},{"id":"A5088751229","name":"Xia Yang"},{"id":"A5062835705","name":"Patrick Allard"}],"ca_any_author":true,"ca_led":true,"cited_by_count":105,"doi":"https://doi.org/10.1371/journal.pgen.1006223","domain_tags":["human_exposure_and_health_risk"],"facet_tags":["matrix:food_and_drink"],"institution_ids":["I161318765"],"is_oa":true,"journal":"PLoS Genetics","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://journals.plos.org/plosgenetics/article/file?id=10.1371/journal.pgen.1006223&type=printable","openalex_topics":["T10269","T10686","T11505"],"plastic_related":true,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10686","pub_date":"2016-07-29","study_type":"article","title":"Exposure to the BPA-Substitute Bisphenol S Causes Unique Alterations of Germline Function","type":"article","work_id":"W2498253482","year":2016},{"abstract":"","author_count":6,"author_ids":["A5004110728","A5046966231","A5052698369","A5062835705","A5101438449","A5103864417"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5101438449","name":"Yichang Chen"},{"id":"A5052698369","name":"Blake Panter"},{"id":"A5103864417","name":"Aleena Hussain"},{"id":"A5046966231","name":"Katherine Gibbs"},{"id":"A5004110728","name":"Daniel W. Ferreira"},{"id":"A5062835705","name":"Patrick Allard"}],"ca_any_author":true,"ca_led":true,"cited_by_count":23,"doi":"https://doi.org/10.1016/j.reprotox.2019.08.001","domain_tags":["fate_transport_and_sorption","human_exposure_and_health_risk"],"facet_tags":[],"institution_ids":["I157638225","I161318765"],"is_oa":