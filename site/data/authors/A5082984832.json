{"author":{"affiliation_history":[{"country_code":"PH","id":"I4210090490","name":"National University","years":[2020]},{"country_code":"US","id":"I4210112098","name":"National University","years":[2020]},{"country_code":"US","id":"I122266389","name":"University of Nebraska at Omaha","years":[2003,2006,2007,2012]}],"author_id":"A5082984832","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":4,"plastic":0,"year":2017},{"all":7,"plastic":0,"year":2018},{"all":5,"plastic":0,"year":2019},{"all":2,"plastic":0,"year":2020},{"all":7,"plastic":0,"year":2021},{"all":2,"plastic":0,"year":2022},{"all":5,"plastic":0,"year":2023},{"all":6,"plastic":0,"year":2024},{"all":0,"plastic":0,"year":2025},{"all":2,"plastic":0,"year":2026}],"cited_by_count":114,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2003,"first_year":2020,"h_index":5,"institution_ids":["I4210090490","I4210112098"],"last_ca_year":2020,"last_year":2020,"m_quotient":0.22,"name":"Heather A. Jensen","orcid":"","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":1,"primary_affiliations":[{"country_code":"PH","id":"I4210090490","name":"National University","source":"openalex_last_known"},{"country_code":"US","id":"I4210112098","name":"National University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W3018556095"]},"schema_version":"s3.1","works":[{"abstract":"With an ever\u2010growing public interest in plastic pollution in the ocean, its widespread ecological effects are still poorly understood at all points in its life cycle; including coastal microbiomes and microfilms. However, making sensible comparisons to waterborne communities, which have a much lower bacterial density, requires some additional experimental design considerations. By utilizing the Most Probable Number (MPN) method, we will measure microorganism growth, colony diversity and colony morphology of the surrounding ocean water compared to plastic samples that have been incubated for at least 30 days. We will discuss the process of collecting samples, applying and testing the MPN method, growing microbial samples, and the identification and testing of bacteria colonies.","author_count":2,"author_ids":["A5082984832"],"author_institution_ids":["I4210090490","I4210112098"],"authors":[{"id":"A5082984832","name":"Heather A. Jensen"},{"id":"","name":"Rachel Simmons"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.1096/fasebj.2020.34.s1.09489","domain_tags":["analytical_methods","occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I4210090490","I4210112098"],"is_oa":false,"journal":"The FASEB Journal","last_updated":"2026-09-27T08:07:27.782135","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1096/fasebj.2020.34.s1.09489","openalex_topics":["T10753","T11331","T11791"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2020-04-01","study_type":"conference-abstract","title":"The Standardization of Water Filtering to Compare Concentrations of Colony Morphology and Diversity to Plastic Samples","type":"conference-abstract","work_id":"W3018556095","year":2020}]}
