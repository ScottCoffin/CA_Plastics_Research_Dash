{"author":{"affiliation_history":[{"country_code":"US","id":"I1344073410","name":"Howard Hughes Medical Institute","years":[2019,2020,2021,2022,2023,2024,2025,2026]},{"country_code":"US","id":"I57206974","name":"New York University","years":[2026]},{"country_code":"US","id":"I97018004","name":"Stanford University","years":[2013,2014,2015,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026]},{"country_code":"CH","id":"I35440088","name":"ETH Zurich","years":[2015]},{"country_code":"CH","id":"I4405253839","name":"Institute of Environmental Engineering","years":[2015]},{"country_code":"US","id":"I103531236","name":"Boston College","years":[1999,2000,2001,2002,2005,2008,2009]},{"country_code":"US","id":"I136199984","name":"Harvard University","years":[2008,2009]},{"country_code":"US","id":"I63966007","name":"Massachusetts Institute of Technology","years":[1999,2001,2002,2005,2008]}],"author_id":"A5045999960","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":175,"plastic":25,"year":2017},{"all":231,"plastic":38,"year":2018},{"all":343,"plastic":28,"year":2019},{"all":485,"plastic":37,"year":2020},{"all":698,"plastic":37,"year":2021},{"all":772,"plastic":34,"year":2022},{"all":754,"plastic":30,"year":2023},{"all":933,"plastic":26,"year":2024},{"all":961,"plastic":16,"year":2025},{"all":973,"plastic":10,"year":2026}],"cited_by_count":7399,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1999,"first_year":2013,"h_index":45,"institution_ids":["I97018004"],"last_ca_year":2026,"last_year":2013,"m_quotient":1.67,"name":"Elizabeth S. Sattely","orcid":"https://orcid.org/0000-0002-7352-859X","plastic_basis":"openalex","plastic_citations":349,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I1344073410","name":"Howard Hughes Medical Institute","source":"openalex_last_known"},{"country_code":"US","id":"I57206974","name":"New York University","source":"openalex_last_known"},{"country_code":"US","id":"I97018004","name":"Stanford University","source":"openalex_last_known"}],"rising_pct":9,"rising_score":-0.0128,"work_count":1,"work_ids":["W2312367806"]},"profile":{"bio":"","keywords":[],"links":[],"photo":{"credit":"Own work","license":"CC BY-SA 4.0","source_url":"https://commons.wikimedia.org/wiki/File:SattelyTenureCelebration.jpg","thumb_url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/04/SattelyTenureCelebration.jpg/250px-SattelyTenureCelebration.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"}},"schema_version":"s3.1","works":[{"abstract":"The need for renewable alternatives to traditional petroleum-derived plastics has driven recent interest in biobased composite materials that are sourced from carbon-neutral feedstocks. Lignin, an abundant plant-derived feedstock, has been a candidate for renewable materials; however, it is often difficult to blend with other biopolymers. In order to improve the miscibility of lignin with other bioplastics, we developed a catalytic and solvent free method for synthesis of a lignin\u2013PLA copolymer. Graft polymerization of lactide onto lignin catalyzed by triazabicyclodecene (TBD) resulted in a lignin- g -poly(lactic acid) copolymer; chain length of the PLA is controlled by varying of the lignin/lactide ratio and preacetylation treatment. End-group analysis reveals high grafting efficiency and preferential grafting on lignin aliphatic hydroxyls over phenolic hydroxyls. The lignin- g -PLA copolymers display a glass transition temperature range from 45 to 85 \u00b0C and multiphase melting behavior. The lignin- g -PLA copolymers are used as dispersion modifiers in PLA-based materials to enhance UV absorption and reduce brittleness without a sacrifice in the modulus of elasticity.","author_count":7,"author_ids":["A5009737401","A5045999960","A5063798984","A5072106065","A5077663125","A5102343129","A5113725499"],"author_institution_ids":["I97018004"],"authors":[{"id":"A5113725499","name":"Yi\u2010Lin Chung"},{"id":"A5072106065","name":"Johan V. Olsson"},{"id":"A5063798984","name":"Russell Jingxian Li"},{"id":"A5102343129","name":"Curtis W. Frank"},{"id":"A5009737401","name":"Robert M. Waymouth"},{"id":"A5077663125","name":"Sarah L. Billington"},{"id":"A5045999960","name":"Elizabeth S. Sattely"}],"ca_any_author":true,"ca_led":true,"cited_by_count":349,"doi":"https://doi.org/10.1021/sc4000835","domain_tags":["soil_and_agriculture","wastewater_and_treatment"],"facet_tags":["matrix:soil_and_agriculture"],"institution_ids":["I97018004"],"is_oa":false,"journal":"ACS Sustainable Chemistry & Engineering","last_updated":"2026-11-07T11:25:07.637180","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/sc4000835","openalex_topics":["T10513","T10661","T11208"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2013-07-26","study_type":"article","title":"A Renewable Lignin\u2013Lactide Copolymer and Application in Biobased Composites","type":"article","work_id":"W2312367806","year":2013}]}
