{"author":{"affiliation_history":[{"country_code":"AU","id":"I4405259444","name":"Adelaide University","years":[2026]},{"country_code":"CN","id":"I183519381","name":"Capital Medical University","years":[2025,2026]},{"country_code":"AU","id":"I5681781","name":"The University of Adelaide","years":[2024,2025,2026]},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","years":[2020,2021,2022,2023,2024,2025,2026]},{"country_code":"CN","id":"I4210154593","name":"Beijing Shijitan Hospital","years":[2025]},{"country_code":"CN","id":"I176808543","name":"Liaoning Technical University","years":[2023,2024,2025]},{"country_code":"CA","id":"I2801766832","name":"McGill University Health Centre","years":[2025]},{"country_code":"CN","id":"I4210141942","name":"Peking University Third Hospital","years":[2019,2020,2021,2022,2023,2024,2025]},{"country_code":"CN","id":"I4210135812","name":"Sinochem Group (China)","years":[2024]},{"country_code":"CN","id":"I20231570","name":"Peking University","years":[2018,2020]},{"country_code":"CN","id":"I130750295","name":"Xinyang Normal University","years":[2018]},{"country_code":"CN","id":"I4210131919","name":"Xi'an University of Technology","years":[2017]}],"author_id":"A5027349342","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":0,"plastic":0,"year":2017},{"all":0,"plastic":0,"year":2018},{"all":7,"plastic":0,"year":2019},{"all":66,"plastic":0,"year":2020},{"all":457,"plastic":0,"year":2021},{"all":1351,"plastic":0,"year":2022},{"all":1679,"plastic":0,"year":2023},{"all":2281,"plastic":32,"year":2024},{"all":2309,"plastic":61,"year":2025},{"all":1896,"plastic":36,"year":2026}],"cited_by_count":10049,"domain_tags":[],"early_career":true,"first_pub_year":2017,"first_year":2024,"h_index":49,"institution_ids":["I161318765"],"last_year":2024,"m_quotient":5.44,"name":"Xun Zhao","orcid":"https://orcid.org/0000-0001-5543-0081","plastic_basis":"openalex","plastic_citations":129,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"},{"country_code":"CN","id":"I183519381","name":"Capital Medical University","source":"openalex_last_known"},{"country_code":"AU","id":"I4405259444","name":"Adelaide University","source":"openalex_last_known"},{"country_code":"AU","id":"I5681781","name":"The University of Adelaide","source":"openalex_last_known"}],"rising_pct":88,"rising_score":0.0149,"work_count":1,"work_ids":["W4390604011"]},"profile":{"bio":"","keywords":["Biological Sciences","Devices","Implants"],"links":[]},"schema_version":"s3.1","works":[{"abstract":"Future exploitation of marine resources in a sustainable and eco-friendly way requires autonomous underwater robotics with human-like perception. However, the development of such intelligent robots is now impeded by the lack of adequate underwater haptic sensing technology. Inspired by the populational coding strategy of the human tactile system, we harness the giant magnetoelasticity in soft polymer systems as an innovative platform technology to construct a multimodal underwater robotic skin for marine object recognition with intrinsic waterproofness and a simple configuration. The bioinspired magnetoelastic artificial skin enables multiplexed tactile modality in each single taxel and obtains an impressive classification rate of 95% in identifying seven types of marine creatures and marine litter. By introducing another degree of freedom in underwater haptic sensing, this work represents a milestone toward sustainable marine resource exploitation.","author_ids":["A5027349342","A5063665829","A5076654722","A5089040164","A5100450180","A5101846379","A5103268543"],"author_institution_ids":["I161318765"],"ca_any_author":true,"ca_led":true,"cited_by_count":126,"doi":"https://doi.org/10.1126/sciadv.adj8567","domain_tags":[],"facet_tags":["matrix:marine"],"institution_ids":["I161318765"],"is_oa":true,"journal":