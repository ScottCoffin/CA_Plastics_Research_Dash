191"],"last_year":2024,"m_quotient":1.67,"name":"Nirav Kiritkumar Pandya","orcid":"https://orcid.org/0000-0001-8753-853X","plastic_basis":"openalex","plastic_citations":17,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I1334226719","name":"American Academy of Orthopaedic Surgeons","source":"openalex_last_known"},{"country_code":"US","id":"I180670191","name":"University of California, San Francisco","source":"openalex_last_known"},{"country_code":"US","id":"I4210101648","name":"Connecticut Children's Medical Center","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4404579381"]},"schema_version":"s3.1","works":[{"abstract":"PURPOSE OF REVIEW: The physical health impacts of microplastics have received increasing attention in recent years. However, limited data impedes a full understanding of the internal exposure to microplastics, especially concerning the musculoskeletal system. The purpose of this review is to summarize the recent literature regarding the effects of microplastics on the musculoskeletal system. RECENT FINDINGS: Microplastics have been shown to cause abnormal endochondral ossification and disrupt the normal function of pre-osteoblasts, osteocyte-like cells, and pre-osteoclasts through gene mutations, endoplasmic reticulum stress induction, and reduced autophagosome formation in bone growth areas. Although there are few reports on their effects on muscle, it has been noted that microplastics inhibit energy and lipid metabolism, decrease type I muscle fiber density, impair muscle angiogenesis, cause muscle atrophy, and increase lipid deposition. Only a few recent studies have shown that microplastics interfere with the normal function of bone growth-related cells and reduce muscle mass and quality. This review underscores the need for further research into other parts of the musculoskeletal system and studies using human tissues at the disease level.","author_ids":["A5001653419","A5017234439","A5037019365","A5111212670","A5114733455"],"author_institution_ids":["I180670191"],"ca_any_author":true,"ca_led":true,"cited_by_count":17,"doi":"https://doi.org/10.1007/s12178-024-09932-9","domain_tags":["air"],"facet_tags":["matrix:air"],"institution_ids":["I180670191","I74973139"],"is_oa":true,"journal":"Current Reviews in Musculoskeletal Medicine","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://link.springer.com/content/pdf/10.1007/s12178-024-09932-9.pdf","openalex_topics":["T10059","T10686","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2024-11-22","study_type":"review","title":"The Effects of Microplastics on Musculoskeletal Disorder; A Narrative Review","type":"review","work_id":"W4404579381","year":2024}]}
