:[1992]},{"country_code":"US","id":"I122411786","name":"California Institute of Technology","years":[1986,1987,1988,1991]},{"country_code":"IL","id":"I4387154235","name":"Soreq Nuclear Research Center","years":[1988,1989,1990]},{"country_code":"US","id":"I44461941","name":"University of Houston","years":[1990]}],"author_id":"A5064071670","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":280,"plastic":0,"year":2017},{"all":298,"plastic":0,"year":2018},{"all":345,"plastic":5,"year":2019},{"all":368,"plastic":1,"year":2020},{"all":328,"plastic":6,"year":2021},{"all":361,"plastic":0,"year":2022},{"all":294,"plastic":4,"year":2023},{"all":399,"plastic":3,"year":2024},{"all":315,"plastic":3,"year":2025},{"all":373,"plastic":4,"year":2026}],"cited_by_count":9440,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1986,"first_year":2018,"h_index":53,"institution_ids":["I161318765"],"last_ca_year":2026,"last_year":2018,"m_quotient":1.32,"name":"Daniel Neuhauser","orcid":"https://orcid.org/0000-0003-3160-386X","plastic_basis":"openalex","plastic_citations":26,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"},{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"}],"rising_pct":30,"rising_score":-0.0013,"work_count":1,"work_ids":["W2889206662"]},"profile":{"bio":"","keywords":[],"links":[],"photo":{"credit":"Daniel Neuhauser","license":"CC BY-SA 3.0","source_url":"https://commons.wikimedia.org/wiki/File:Daniel_Neuhauser.jpg","thumb_url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/Daniel_Neuhauser.jpg/250px-Daniel_Neuhauser.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"}},"schema_version":"s3.1","works":[{"abstract":"Neutral zinc alkoxide complexes show high activity toward the ring-opening polymerization of cyclic esters and carbonates, to generate biodegradable plastics applicable in several areas. Herein, we use a ferrocene-chelating heteroscorpionate complex in redox-switchable polymerization reactions, and we show that it is a moderately active catalyst for the ring-opening polymerization of L-lactide, \u025b-caprolactone, trimethylene carbonate, and \u03b4-valerolactone. Uniquely for this type of catalyst, the oxidized complex has a similar polymerization activity as the corresponding reduced compound, but displays significantly different rates of reaction in the case of trimethylene carbonate and \u03b4-valerolactone. Investigations of the oxidized compound suggest the presence of an organic radical rather than an Fe(III) complex. Electronic structure and density functional theory (DFT) calculations were performed to support the proposed electronic states of the catalytic complex and to help explain the observed reactivity differences. The catalyst was also compared with a monomeric phenoxide complex to show the influence of the phosphine-zinc interaction on catalytic properties.","author_count":8,"author_ids":["A5011918079","A5013364233","A5029282916","A5033889166","A5048205380","A5048534926","A5064071670","A5077096576"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5013364233","name":"Mark Abubekerov"},{"id":"A5077096576","name":"Vojt\u011bch Vl\u010dek"},{"id":"A5033889166","name":"Junnian Wei"},{"id":"A5048205380","name":"Matthias E. Miehlich"},{"id":"A5048534926","name":"Stephanie M. Quan"},{"id":"A5011918079","name":"Karsten Meyer"},{"id":"A5064071670","name":"Daniel Neuhauser"},{"id":"A5029282916","name":"Paula L. Diaconescu"}],"ca_any_author":true,"ca_led":true,"cited_by_count":26,"doi":"https://doi.org/10.1016/j.isci.2018.08.020","domain_tags":[],"facet_tags":[],"institution_ids":["I161318765","I181369854"],"is_oa":true,"journal":"iScience","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://doi.org/10.1016/j.isci.2018.08.020","openalex_topics":["T10092","T10661","T11593"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2018-08-30","study_type":"article","title":"Exploring Oxidation State-Dependent Selectivity in Polymerization of Cyclic Esters and Carbonates with Zinc(II) Complexes","type":"article","work_id":"W2889206662","year":2018}]}
