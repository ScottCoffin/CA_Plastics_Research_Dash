003]}],"author_id":"A5100682324","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":1677,"plastic":0,"year":2017},{"all":1898,"plastic":0,"year":2018},{"all":2030,"plastic":0,"year":2019},{"all":2105,"plastic":0,"year":2020},{"all":2237,"plastic":0,"year":2021},{"all":2259,"plastic":0,"year":2022},{"all":2265,"plastic":1,"year":2023},{"all":3553,"plastic":7,"year":2024},{"all":4765,"plastic":10,"year":2025},{"all":3834,"plastic":8,"year":2026}],"cited_by_count":33401,"domain_tags":[],"early_career":false,"first_pub_year":2002,"first_year":2023,"h_index":80,"institution_ids":["I148283060"],"last_year":2023,"m_quotient":3.33,"name":"Gao Liu","orcid":"https://orcid.org/0000-0001-6886-0507","plastic_basis":"openalex","plastic_citations":26,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I148283060","name":"Lawrence Berkeley National Laboratory","source":"openalex_last_known"}],"rising_pct":56,"rising_score":0.0026,"work_count":1,"work_ids":["W4378234815"]},"schema_version":"s3.1","works":[{"abstract":"High Resolution Image Download MS PowerPoint Slide Poly(lactic acid) (PLA) is a biosourced green plastic derived from natural sources that can replace polyolefins in many applications; however, it is seldom recycled. PLA is a prime candidate for chemical recycling by depolymerization, which produces valuable commodity chemicals and/or fresh monomer for new production, compared to mechanical/thermal reprocessing which produces lesser-quality resin. A scalable, low-cost depolymerization process could render PLA the premier choice for designed-to-be-recycled products in a future circular plastics economy. Here, we report a novel process for depolymerization of PLA under mild conditions using alcoholysis with ionic liquid catalysts in the presence of dimethyl (or diethyl) carbonate as a green solvent, along with critical technoeconomic analysis of the potential impact of this process. The effects of catalyst structures, the solvent system, and PLA resin type on conversion and yield were studied. The reaction kinetics were statistically analyzed with experimental and modeling data, suggesting a fast first-order reaction in PLA degradation. Predictive modeling results based on empirical data further guide the design of scenarios and potential for practical application.","author_count":6,"author_ids":["A5017030250","A5018132574","A5042305887","A5065692955","A5091675263","A5100682324"],"author_institution_ids":["I148283060"],"authors":[{"id":"A5042305887","name":"Dion Hubble"},{"id":"A5091675263","name":"Sarah L. Nordahl"},{"id":"A5065692955","name":"Tianyu Zhu"},{"id":"A5017030250","name":"Nawa Raj Baral"},{"id":"A5018132574","name":"Corinne D. Scown"},{"id":"A5100682324","name":"Gao Liu"}],"ca_any_author":true,"ca_led":true,"cited_by_count":26,"doi":"https://doi.org/10.1021/acssuschemeng.2c06500","domain_tags":["fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I148283060","I53012624","I95457486"],"is_oa":true,"journal":"ACS Sustainable Chemistry & Engineering","last_updated":"2026-11-06T12:05:46.655746","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://pubs.acs.org/doi/pdf/10.1021/acssuschemeng.2c06500","openalex_topics":["T10389","T10661","T11009"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2023-05-24","study_type":"article","title":"Solvent-Assisted Poly(lactic acid) Upcycling under Mild Conditions","type":"article","work_id":"W4378234815","year":2023}]}
