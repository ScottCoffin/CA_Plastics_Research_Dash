09,"plastic":0,"year":2020},{"all":541,"plastic":0,"year":2021},{"all":657,"plastic":0,"year":2022},{"all":711,"plastic":1,"year":2023},{"all":890,"plastic":7,"year":2024},{"all":902,"plastic":10,"year":2025},{"all":838,"plastic":8,"year":2026}],"cited_by_count":5341,"domain_tags":[],"early_career":false,"first_pub_year":2011,"first_year":2023,"h_index":38,"institution_ids":["I148283060"],"last_year":2023,"m_quotient":2.53,"name":"Tianyu Zhu","orcid":"https://orcid.org/0000-0001-9115-6462","plastic_basis":"openalex","plastic_citations":26,"plastic_works_count":1,"primary_affiliations":[{"country_code":"CN","id":"I110440473","name":"Xi'an University of Science and Technology","source":"openalex_last_known"},{"country_code":"CN","id":"I139660479","name":"Central South University","source":"openalex_last_known"},{"country_code":"CN","id":"I183067930","name":"Shanghai Jiao Tong University","source":"openalex_last_known"},{"country_code":"CN","id":"I4210097066","name":"Shanghai Ninth People's Hospital","source":"openalex_last_known"},{"country_code":"CN","id":"I4210165038","name":"University of Chinese Academy of Sciences","source":"openalex_last_known"},{"country_code":"CN","id":"I76569877","name":"Southeast University","source":"openalex_last_known"},{"country_code":"US","id":"I8078737","name":"Clemson University","source":"openalex_last_known"}],"rising_pct":56,"rising_score":0.0026,"work_count":1,"work_ids":["W4378234815"]},"profile":{"bio":"","keywords":["Polymer Chemistry","Battery Materials","Ceramic Engineering"],"links":[{"label":"Zhu Research Lab","url":"http://zhuchemistry.org"}]},"schema_version":"s3.1","works":[{"abstract":"High Resolution Image Download MS PowerPoint Slide Poly(lactic acid) (PLA) is a biosourced green plastic derived from natural sources that can replace polyolefins in many applications; however, it is seldom recycled. PLA is a prime candidate for chemical recycling by depolymerization, which produces valuable commodity chemicals and/or fresh monomer for new production, compared to mechanical/thermal reprocessing which produces lesser-quality resin. A scalable, low-cost depolymerization process could render PLA the premier choice for designed-to-be-recycled products in a future circular plastics economy. Here, we report a novel process for depolymerization of PLA under mild conditions using alcoholysis with ionic liquid catalysts in the presence of dimethyl (or diethyl) carbonate as a green solvent, along with critical technoeconomic analysis of the potential impact of this process. The effects of catalyst structures, the solvent system, and PLA resin type on conversion and yield were studied. The reaction kinetics were statistically analyzed with experimental and modeling data, suggesting a fast first-order reaction in PLA degradation. Predictive modeling results based on empirical data further guide the design of scenarios and potential for practical application.","author_ids":["A5017030250","A5018132574","A5042305887","A5065692955","A5091675263","A5100682324"],"author_institution_ids":["I148283060"],"ca_any_author":true,"ca_led":true,"cited_by_count":26,"doi":"https://doi.org/10.1021/acssuschemeng.2c06500","domain_tags":["fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I148283060","I53012624","I95457486"],"is_oa":true,"journal":"ACS Sustainable Chemistry & Engineering","last_updated":"2026-11-06T12:05:46.655746","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://pubs.acs.org/doi/pdf/10.1021/acssuschemeng.2c06500","openalex_topics":["T10389","T10661","T11009"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2023-05-24","study_type":"article","title":"Solvent-Assisted Poly(lactic acid) Upcycling under Mild Conditions","type":"article","work_id":"W4378234815","year":2023}]}
