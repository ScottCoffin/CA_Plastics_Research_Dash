{"author":{"affiliation_history":[{"country_code":"US","id":"I1174212","name":"University of Southern California","years":[2019,2020,2021,2022,2024,2025,2026]},{"country_code":"CN","id":"I181326427","name":"Donghua University","years":[2015,2016,2017]},{"country_code":"CN","id":"I135905480","name":"Shanghai Polytechnic University","years":[2017]}],"author_id":"A5082103014","ca_plastic_works_count":1,"ca_works_count":2,"citations_by_year":[{"all":6,"plastic":0,"year":2017},{"all":9,"plastic":0,"year":2018},{"all":16,"plastic":0,"year":2019},{"all":38,"plastic":0,"year":2020},{"all":57,"plastic":0,"year":2021},{"all":72,"plastic":0,"year":2022},{"all":76,"plastic":0,"year":2023},{"all":55,"plastic":1,"year":2024},{"all":73,"plastic":5,"year":2025},{"all":43,"plastic":7,"year":2026}],"cited_by_count":450,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2015,"first_year":2024,"h_index":10,"institution_ids":["I1174212"],"last_ca_year":2026,"last_year":2024,"m_quotient":0.91,"name":"Haixu Du","orcid":"https://orcid.org/0009-0005-1945-5296","plastic_basis":"openalex","plastic_citations":13,"plastic_works_count":2,"primary_affiliations":[{"country_code":"US","id":"I1174212","name":"University of Southern California","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":2,"work_ids":["W4395468817","W4403298845"]},"schema_version":"s3.1","works":[{"abstract":"","author_count":6,"author_ids":["A5048754844","A5080941020","A5082103014","A5085789605","A5100421891","A5102218122"],"author_institution_ids":["I1174212"],"authors":[{"id":"A5102218122","name":"LI Ke-tian"},{"id":"A5080941020","name":"Yanchu Zhang"},{"id":"A5085789605","name":"Kunhao Yu"},{"id":"A5082103014","name":"Haixu Du"},{"id":"A5048754844","name":"Constantinos Sioutas"},{"id":"A5100421891","name":"Qiming Wang"}],"ca_any_author":true,"ca_led":true,"cited_by_count":3,"doi":"https://doi.org/10.1016/j.jmps.2024.105661","domain_tags":[],"facet_tags":[],"institution_ids":["I1174212"],"is_oa":true,"journal":"Journal of the Mechanics and Physics of Solids","last_updated":"2026-11-11T12:16:26.678958","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://www.sciencedirect.com/science/article/am/pii/S0022509624001273","openalex_topics":["T10396","T10753","T12362"],"plastic_related":false,"plastic_tier":"","primary_topic":"T10753","pub_date":"2024-04-25","study_type":"article","title":"Mechanics of abrasion-induced particulate matter emission","type":"article","work_id":"W4395468817","year":2024},{"abstract":"Recent research highlights that non-exhaust emissions from the abrasion of tires and other organic materials have emerged as a substantial source of airborne particulate matter and marine microplastics. Despite their growing impact, the underlying mechanisms driving these abrasion emissions have remained largely unexplored. In this study, we uncover that abrasion emissions from organic materials are fundamentally governed by a fatigue fracture process, wherein particles are progressively detached from the material surface under cyclic abrasion loads. Our findings demonstrate that these emissions increase significantly only when the applied abrasion loads surpass the material's toughness threshold. We establish a scaling relationship between the concentration of emitted particulate matter and the measurable crack propagation rate of the organic material, offering a robust quantitative method to estimate abrasion emissions. This work not only introduces a novel mechanistic framework for understanding particulate matter pollution from organic material abrasion but also provides a scientific basis for developing strategies to mitigate emissions of airborne particulates and marine microplastics.","author_count":6,"author_ids":["A5048754844","A5080941020","A5082103014","A5085789605","A5100421891","A5102218122"],"author_institution_ids":["I1174212"],"authors":[{"id":"A5102218122","name":"LI Ke-tian"},{"id":"A5085789605","name":"Kunhao Yu"},{"id":"A5080941020","name":"Yanchu Zhang"},{"id":"A5082103014","name":"Haixu Du"},{"id":"A5048754844","name":"Constantinos Sioutas"},{"id":"A5100421891","name":"Qiming Wang"}],"ca_any_author":true,"ca_led":true,"cited_by_count":9,"doi":"https://doi.org/10.1038/s41598-024-74137-6","domain_tags":["air"],"facet_tags":["matrix:air","matrix:marine"],"institution_ids":["I1174212"],"is_oa":true,"journal":"Scientific Reports","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://www.nature.com/articles/s41598-024-74137-6.pdf","openalex_topics":["T10075","T10753","T12095"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2024-10-10","study_type":"article","title":"Unveiling the mechanism secret of abrasion emissions of particulate matter and microplastics","type":"article","work_id":"W4403298845","year":2024}]}
