ticle","title":"SEM/EDS and optical microscopy analyses of microplastics in ocean trawl and fish guts","type":"article","work_id":"W2646028278","year":2017},{"abstract":"","author_count":5,"author_ids":["A5077213801","A5100751422","A5101715429"],"author_institution_ids":["I1336788258"],"authors":[{"id":"A5101715429","name":"Sutapa Ghosal"},{"id":"","name":"Michael Chen"},{"id":"","name":"Jeff Wagner"},{"id":"A5100751422","name":"Zhong-Min Wang"},{"id":"A5077213801","name":"Stephen M. Wall"}],"ca_any_author":true,"ca_led":true,"cited_by_count":144,"doi":"https://doi.org/10.1016/j.envpol.2017.10.014","domain_tags":["analytical_methods","ecotoxicology_and_trophic_transfer"],"facet_tags":[],"institution_ids":["I1336788258"],"is_oa":false,"journal":"Environmental Pollution","last_updated":"2026-11-07T11:25:07.637180","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.envpol.2017.10.014","openalex_topics":["T10122","T10753","T12316"],"plastic_related":false,"plastic_tier":"","primary_topic":"T10753","pub_date":"2017-10-14","study_type":"article","title":"Molecular identification of polymers and anthropogenic particles extracted from oceanic water and fish stomach \u2013 A Raman micro-spectroscopy study","type":"article","work_id":"W2761119328","year":2017},{"abstract":"Microplastics were extracted from freshwater sport fish stomachs containing substantial biomass and identified using optical microscopy, scanning electron microscopy plus energy-dispersive X-ray spectroscopy (SEM/EDS), and Fourier transform infrared (FTIR) micro-spectroscopy with automated spectral mapping. An extraction method is presented that uses a negatively pressurized sieve stack and purified water to preserve plastic surface characteristics and any adsorbed persistent organic pollutants (POPs). This nondestructive extraction method for large predators' stomachs enables multiple trophic-level studies from one fish sampling event and provides other dietary and behavioral data. FTIR-identified microplastics 50-1500 \u03bcm, including polyethylene (two with plastic additive POPs), styrene acrylonitrile, polystyrene, and nylon and polyethylene terephthalate fibers 10-50 \u03bcm wide. SEM/EDS revealed characteristic surface weathering on the plastic surfaces. The nylon fibers appear to be from human fishing activities, suggesting options for management. Some particles visually identified as potential plastics were revealed by micro-spectroscopy to be mineralized, natural polyamide proteins, or nonplastic shell pieces. A low-cost, reflective sample preparation method with stable particle mounting was developed to enable automated mapping, improved FTIR throughput, and lower detection size limit. This study yielded 37 intact prey items set aside for future analyses.","author_count":8,"author_ids":["A5051799392","A5055182216","A5077213801","A5100751422","A5101715429","A5109918051","A5113768328"],"author_institution_ids":["I1336788258"],"authors":[{"id":"","name":"Jeff Wagner"},{"id":"A5100751422","name":"Zhong-Min Wang"},{"id":"A5101715429","name":"Sutapa Ghosal"},{"id":"A5113768328","name":"Margaret C. Murphy"},{"id":"A5077213801","name":"Stephen M. Wall"},{"id":"A5051799392","name":"Anna\u2010Marie Cook"},{"id":"A5055182216","name":"William Robberson"},{"id":"A5109918051","name":"Harry L. Allen"}],"ca_any_author":true,"ca_led":true,"cited_by_count":63,"doi":"https://doi.org/10.1021/acs.est.9b05072","domain_tags":["analytical_methods","ecotoxicology_and_trophic_transfer"],"facet_tags":["matrix:food_and_drink","matrix:freshwater"],"institution_ids":["I1302368450","I1311206647","I1336788258"],"is_oa":false,"journal":"Environmental Science & Technology","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.est.9b05072","openalex_topics":["T10419","T10447","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2019-12-02","study_type":"article","title":"Nondestructive Extraction and Identification of Microplastics from Freshwater Sport Fish Stomachs","type":"article","work_id":"W2991403884","year":2019}]}
