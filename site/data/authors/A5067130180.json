mmarizes the EU's recent adoption of the Single-use Plastics Directive as part of the EU's Plastics Strategy and Circular Economy Action Plan.","author_count":1,"author_ids":["A5067130180"],"author_institution_ids":["I188017875","I58610484"],"authors":[{"id":"A5067130180","name":"Madeline June Kass"}],"ca_any_author":true,"ca_led":true,"cited_by_count":1,"doi":"","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I188017875","I58610484"],"is_oa":true,"journal":"SSRN Electronic Journal","last_updated":"2026-09-21T07:43:02.447757","license":"","needs_review":false,"oa_status":"green","oa_url":"https://papers.ssrn.com/sol3/papers.cfm?abstract_id=3423433","openalex_topics":["T10753","T12414","T14164"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2019-07-20","study_type":"preprint","title":"Fishing for Plastic: EU Targets Marine Pollution","type":"preprint","work_id":"W3205571406","year":2019}]}
