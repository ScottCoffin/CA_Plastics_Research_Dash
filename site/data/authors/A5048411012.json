6]},{"country_code":"US","id":"I51556381","name":"University of Virginia","years":[1994]},{"country_code":"US","id":"I2799584038","name":"Tripler Army Medical Center","years":[1991]},{"country_code":"US","id":"I4210088792","name":"United States Army","years":[1991]},{"country_code":"US","id":"I130238516","name":"University of Minnesota","years":[1936]}],"author_id":"A5048411012","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":356,"plastic":0,"year":2017},{"all":507,"plastic":0,"year":2018},{"all":502,"plastic":0,"year":2019},{"all":739,"plastic":0,"year":2020},{"all":756,"plastic":2,"year":2021},{"all":795,"plastic":6,"year":2022},{"all":836,"plastic":5,"year":2023},{"all":984,"plastic":4,"year":2024},{"all":1111,"plastic":6,"year":2025},{"all":799,"plastic":4,"year":2026}],"cited_by_count":9104,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1947,"first_year":2020,"h_index":52,"institution_ids":["I36258959"],"last_ca_year":2026,"last_year":2020,"m_quotient":0.66,"name":"John S. McCartney","orcid":"https://orcid.org/0000-0003-2109-0378","plastic_basis":"openalex","plastic_citations":27,"plastic_works_count":1,"primary_affiliations":[{"country_code":"CN","id":"I116953780","name":"Tongji University","source":"openalex_last_known"},{"country_code":"US","id":"I36258959","name":"University of California San Diego","source":"openalex_last_known"},{"country_code":"KW","id":"I36721946","name":"Kuwait University","source":"openalex_last_known"}],"rising_pct":40,"rising_score":-0.0,"work_count":1,"work_ids":["W3104957289"]},"profile":{"bio":"John S. McCartney is a Professor in the Department of Structural Engineering at the University of California San Diego, specializing in Geotechnical and Geoenvironmental Engineering. His research interests include unsaturated soil mechanics, geosynthetics engineering, and energy geotechnics. He has received several research awards, including the Walter L. Huber Research Prize from ASCE in 2016, the Arthur Casagrande Professional Development Award from ASCE in 2013, the J. James R. Croes medal from ASCE in 2012, the 2019 R.M. Quigley award from CGS in 2020, the DFI Young Professor Award in\u2026","keywords":["Geotechnical","Geoenvironmental","Unsaturated Soils"],"links":[{"label":"mccartney.ucsd.edu","url":"http://mccartney.ucsd.edu"}]},"schema_version":"s3.1","works":[{"abstract":"This study evaluated the strength properties of compacted lateritic soils reinforced with polypropylene (PP) waste strips cut from recycled plastic packing with the goal of promoting sustainability through using local materials for engineering work and reusing waste materials as low-cost reinforcements. Waste PP strips with widths of 15 mm and different lengths were uniformly mixed with clayey sand (SC) and clay (CL) soils with the goal of using these materials as low-cost fiber reinforcements. The impact of different PP strip contents (0.25% to 2.0%) and lengths (10, 15, 20, and 30 mm) on the unconfined compressive strength (UCS) of the soils revealed an optimum combination of PP strip content and length. Statistical analysis showed that PP strip content has a greater effect than the PP strip length on the UCS for both soils. Results led to the definition of an empirical equation to estimate the UCS of strip-reinforced soils. The results from direct shear tests indicate that the SC soil showed an increase in both apparent cohesion and friction angle after reinforcement, while the CL soil only showed an increase in friction angle after reinforcement. California bearing ratio (CBR) tests indicate that the SC soil experienced a 70% increase in CBR after reinforcement, while the CBR of the CL soil was not affected by strip inclusion.","author_count":6,"author_ids":["A5016677803","A5035213340","A5041349226","A5048411012","A5058478084","A5084869461"],"author_institution_ids":["I36258959"],"authors":[{"id":"A5041349226","name":"R\u00e9gis Mar\u00e7al"},{"id":"A5016677803","name":"Paulo C\u00e9sar Lodi"},{"id":"A5035213340","name":"Nat\u00e1lia S. Correia"},{"id":"A5058478084","name":"Heraldo Luiz Giacheti"},{"id":"A5084869461","name":"Roger Augusto Rodrigues"},{"id":"A5048411012","name":"John S. McCartney"}],"ca_any_author":true,"ca_led":false,"cited_by_count":27,"doi":"https://doi.org/10.3390/su12229572","domain_tags":["soil_and_agriculture"],"facet_tags":["matrix:soil_and_agriculture"],"institution_ids":["I177909021","I36258959","I879563668"],"is_oa":true,"journal":"Sustainability","last_updated":"2026-11-07T11:25:07.637180","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://www.mdpi.com/2071-1050/12/22/9572/pdf?version=1605672036","openalex_topics":["T10687","T11375","T13236"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T11375","pub_date":"2020-11-17","study_type":"article","title":"Reinforcing Effect of Polypropylene Waste Strips on Compacted Lateritic Soils","type":"article","work_id":"W3104957289","year":2020}]}
