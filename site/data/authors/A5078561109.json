id":"I4210118972","name":"Beijing Museum of Natural History","years":[2006]},{"country_code":"CN","id":"I159948400","name":"Jinan University","years":[2005]}],"author_id":"A5078561109","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":2,"plastic":0,"year":2017},{"all":1,"plastic":0,"year":2018},{"all":4,"plastic":0,"year":2019},{"all":70,"plastic":55,"year":2020},{"all":299,"plastic":277,"year":2021},{"all":567,"plastic":524,"year":2022},{"all":738,"plastic":678,"year":2023},{"all":824,"plastic":732,"year":2024},{"all":871,"plastic":723,"year":2025},{"all":838,"plastic":651,"year":2026}],"cited_by_count":4217,"current_in_ca":false,"domain_tags":[],"early_career":false,"first_pub_year":2005,"first_year":2020,"h_index":13,"institution_ids":["I154570441"],"last_ca_year":2022,"last_year":2020,"m_quotient":0.62,"name":"Yang Shuai Qiu","orcid":"https://orcid.org/0000-0003-4772-5079","plastic_basis":"openalex","plastic_citations":3643,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I112475681","name":"Joint Global Change Research Institute","source":"openalex_last_known"},{"country_code":"US","id":"I142606810","name":"Pacific Northwest National Laboratory","source":"openalex_last_known"},{"country_code":"CN","id":"I2799486974","name":"China Geological Survey","source":"openalex_last_known"},{"country_code":"US","id":"I2800421839","name":"Government of the United States of America","source":"openalex_last_known"},{"country_code":"CN","id":"I3124059619","name":"China University of Geosciences","source":"openalex_last_known"}],"rising_pct":96,"rising_score":0.0365,"work_count":1,"work_ids":["W3005332201"]},"schema_version":"s3.1","works":[{"abstract":"Abstract Plastic waste is currently generated at a rate approaching 400 Mt year\u20131. The amount of plastics accumulating in the environment is growing rapidly, yet our understanding of its persistence is very limited. This Perspective summarizes the existing literature on environmental degradation rates and pathways for the major types of thermoplastic polymers. A metric to harmonize disparate types of measurements, the specific surface degradation rate (SSDR), is implemented and used to extrapolate half-lives. SSDR values cover a very wide range, with some of the variability arising due to degradation studies conducted in different natural environments. SSDRs for high density polyethylene (HDPE) in the marine environment range from practically 0 to approximately 11 \u03bcm year\u20131. This approach yields a number of interesting insights. Using a mean SSDR for HDPE in the marine environment, linear extrapolation leads to estimated half-lives ranging from 58 years (bottles) to 1200 years (pipes). For example, SSDRs for HDPE and polylactic acid (PLA) are surprisingly similar in the marine environment, although PLA degrades approximately 20 times faster than HDPE on land. Our study highlights the need for better experimental studies under well-defined reaction conditions, standardized reporting of rates, and methods to simulate polymer degradation using.","author_count":9,"author_ids":["A5000097537","A5029871622","A5032876112","A5037874937","A5047156703","A5078561109","A5083397861","A5101695925"],"author_institution_ids":["I154570441"],"authors":[{"id":"A5000097537","name":"Ali Chamas"},{"id":"A5101695925","name":"Hyunjin Moon"},{"id":"","name":"Jiajia Zheng"},{"id":"A5078561109","name":"Yang Shuai Qiu"},{"id":"A5047156703","name":"Tarnuma Tabassum"},{"id":"A5032876112","name":"Jun Hee Jang"},{"id":"A5037874937","name":"Mahdi M. Abu\u2010Omar"},{"id":"A5029871622","name":"Susannah L. Scott"},{"id":"A5083397861","name":"Sangwon Suh"}],"ca_any_author":true,"ca_led":true,"cited_by_count":3638,"doi":"https://doi.org/10.1021/acssuschemeng.9b06635","domain_tags":["fate_transport_and_sorption"],"facet_tags":["matrix:marine"],"institution_ids":["I154570441"],"is_oa":true,"journal":"ACS Sustainable Chemistry & Engineering","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1021/acssuschemeng.9b06635","openalex_topics":["T10389","T10661","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2020-02-03","study_type":"article","title":"Degradation Rates of Plastics in the Environment","type":"article","work_id":"W3005332201","year":2020}]}
