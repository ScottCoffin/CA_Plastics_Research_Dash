{"country_code":"US","id":"I27837315","name":"University of Michigan","years":[2015]},{"country_code":"US","id":"I200719446","name":"Vanderbilt University","years":[2015]},{"country_code":"US","id":"I32971472","name":"Yale University","years":[2015]},{"country_code":"US","id":"I2803209242","name":"University of California System","years":[2003]},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","years":[1979]}],"author_id":"A5086077960","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":555,"plastic":0,"year":2017},{"all":594,"plastic":0,"year":2018},{"all":812,"plastic":0,"year":2019},{"all":1231,"plastic":0,"year":2020},{"all":1677,"plastic":0,"year":2021},{"all":1798,"plastic":0,"year":2022},{"all":1716,"plastic":0,"year":2023},{"all":2032,"plastic":0,"year":2024},{"all":2279,"plastic":0,"year":2025},{"all":2132,"plastic":1,"year":2026}],"cited_by_count":18800,"domain_tags":[],"early_career":false,"first_pub_year":1979,"first_year":2026,"h_index":67,"institution_ids":["I114073160","I4210124134"],"last_year":2026,"m_quotient":1.43,"name":"David Charles Klonoff","orcid":"https://orcid.org/0000-0001-6394-6862","plastic_basis":"openalex","plastic_citations":1,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I114073160","name":"Sutter Health","source":"openalex_last_known"},{"country_code":"US","id":"I4210102729","name":"San Mateo Medical Center","source":"openalex_last_known"},{"country_code":"US","id":"I4210124134","name":"Mills Peninsula Health Services","source":"openalex_last_known"},{"country_code":"US","id":"I4210154723","name":"Diabetes Technology Society","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W7123842462"]},"schema_version":"s3.1","works":[{"abstract":"The downside of the success story of diabetes technology is the amount of waste generated by manufacturing and using such medical products. Quantitative surveys performed in the United States and Germany document how many pounds of plastic waste, batteries, and electronic parts are piling up per patient with diabetes each year; however, the actual environmental burden of diabetes care has not been assessed yet. Given the highly probable further increase in usage of diabetes technology devices, what are the options to change the situation? Ideally, one would avoid generating waste by optimizing the design of the products (Eco-Design); however, this approach faces a number of complex regulatory and economic hurdles. The issue of waste management is becoming increasingly important as the use of wearable devices increases. Stewardship of the environment will require all stakeholders to address waste management.","author_ids":["A5055334461","A5069410126","A5086077960"],"author_institution_ids":["I114073160","I4210124134"],"ca_any_author":true,"ca_led":false,"cited_by_count":1,"doi":"https://doi.org/10.1177/19322968251412898","domain_tags":[],"facet_tags":[],"institution_ids":["I114073160","I4210124134"],"is_oa":true,"journal":"Journal of Diabetes Science and Technology","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"green","oa_url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC12799468/","openalex_topics":["T10435","T10560","T12920"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T12920","pub_date":"2026-01-13","study_type":"editorial","title":"Diabetes-Technology and Waste: The Future is Now","type":"editorial","work_id":"W7123842462","year":2026}]}
