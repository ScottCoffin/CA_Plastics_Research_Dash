ks_count":1,"primary_affiliations":[{"country_code":"","id":"I4210085935","name":"IBM Research - Almaden","source":"atlas_recent"}],"rising_pct":22,"rising_score":-0.0031,"work_count":1,"work_ids":["W2009646475"]},"schema_version":"s3.1","works":[{"abstract":"We report the effective organocatalysis of the aminolytic depolymerization of waste poly(ethylene terephthalate) (PET) using 1,5,7-triazabicyclo[4.4.0]dec-5-ene (TBD) producing a broad range of crystalline terephthalamides. This diverse set of monomers possesses great potential as building blocks for high performance materials with desirable thermal and mechanical properties deriving from the terephthalic moiety and amide hydrogen bonding. Further, a computational study established mechanistic insight into self-catalyzed and organocatalyzed aminolysis of terephthalic esters, suggesting that the bifunctionality of TBD particularly concerning activation of the carbonyl group differentiates TBD from other organic bases.","author_count":11,"author_ids":["A5009980534","A5021955781","A5023056666","A5054874461","A5066104534","A5075635802","A5087210753","A5087768520","A5088858068","A5089896035","A5111537141"],"author_institution_ids":["I4210085935"],"authors":[{"id":"A5088858068","name":"Kazuki Fukushima"},{"id":"A5089896035","name":"Julien M. Lecuyer"},{"id":"A5023056666","name":"Di Wei"},{"id":"A5066104534","name":"Hans W. Horn"},{"id":"A5021955781","name":"Gavin O. Jones"},{"id":"A5111537141","name":"Hamid A. Al\u2010Megren"},{"id":"A5087210753","name":"Abdullah M. Alabdulrahman"},{"id":"A5009980534","name":"Fares D. Alsewailem"},{"id":"A5054874461","name":"Melanie McNeil"},{"id":"A5075635802","name":"Julia E. Rice"},{"id":"A5087768520","name":"James L. Hedrick"}],"ca_any_author":true,"ca_led":true,"cited_by_count":220,"doi":"https://doi.org/10.1039/c2py20793a","domain_tags":[],"facet_tags":[],"institution_ids":["I1284598098","I131651094","I4210085935","I51504820"],"is_oa":false,"journal":"Polymer Chemistry","last_u