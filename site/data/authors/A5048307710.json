s":[2003]}],"author_id":"A5048307710","ca_plastic_works_count":2,"ca_works_count":2,"citations_by_year":[{"all":152,"plastic":0,"year":2017},{"all":188,"plastic":0,"year":2018},{"all":210,"plastic":0,"year":2019},{"all":282,"plastic":0,"year":2020},{"all":324,"plastic":0,"year":2021},{"all":315,"plastic":0,"year":2022},{"all":350,"plastic":0,"year":2023},{"all":348,"plastic":0,"year":2024},{"all":448,"plastic":0,"year":2025},{"all":397,"plastic":0,"year":2026}],"cited_by_count":3588,"current_in_ca":false,"domain_tags":[],"early_career":false,"first_pub_year":1999,"first_year":2020,"h_index":26,"institution_ids":["I161318765"],"last_ca_year":2024,"last_year":2022,"m_quotient":0.96,"name":"Yan Lin","orcid":"https://orcid.org/0000-0003-4384-8354","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"US","id":"I170897317","name":"Duke University","source":"openalex_last_known"},{"country_code":"CN","id":"I20231570","name":"Peking University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":2,"work_ids":["W3021568610","W4212857146"]},"schema_version":"s3.1","works":[{"abstract":"Recent studies suggested a significant downward trend in population's exposure to bisphenol A (BPA) in the United States. However, the temporal trend of BPA exposure remains unclear in China - a populous country with substantial industrial activities but less efforts made to phase out BPA in consumer products. In addition, it is unclear to what extent a visit from the United States to China could affect human exposure to BPA. In this natural experiment, we measured the concentration of total BPA in 418 urine samples repeatedly collected from 55 Los Angeles residents before, during, and after they spent 10 weeks in Beijing from 2012 to 2017. We found that traveling from Los Angeles to Beijing led to a 2.91-fold (95% CI: 2.43 to 3.50) increase in urinary BPA levels, which fully returned to baseline after study participants came back to Los Angeles. From 2012 to 2017, urinary BPA concentrations decreased in Los Angeles by 25.5% per year (95% CI: -30.8% to -19.8%; p < 0.001) but did not change in Beijing (p = 0.24). Consequently, the concentration ratio of urinary BPA between Beijing and Los Angeles increased from 1.23 (95% CI: 0.82 to 1.85) in 2012 to 4.05 (95% CI: 2.75 to 5.97) in 2017. These results indicate that BPA exposures may increase among international travelers to China. Additional efforts are needed to reduce population's exposure to BPA in China.","author_count":7,"author_ids":["A5023740323","A5027897053","A5032472429","A5048307710","A5055483615","A5062835705"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5048307710","name":"Yan Lin"},{"id":"A5032472429","name":"Xinghua Qiu"},{"id":"","name":"Jinming Liu"},{"id":"A5055483615","name":"Chi\u2010Hong Tseng"},{"id":"A5062835705","name":"Patrick Allard"},{"id":"A5023740323","name":"Jes\u00fas A. Araujo"},{"id":"A5027897053","name":"Yifang Zhu"}],"ca_any_author":true,"ca_led":true,"cited_by_count":20,"doi":"https://doi.org/10.1016/j.envint.2020.105758","domain_tags":["human_exposure_and_health_risk"],"facet_tags":[],"institution_ids":["I161318765","I20231570","I4210128533"],"is_oa":true,"journal":"Environment International","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://www.sciencedirect.com/science/article/pii/S0160412020306784/pdf","openalex_topics":["T10122","T10686","T14393"],"plastic_related":true,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10686","pub_date":"2020-05-08","study_type":"article","title":"Different temporal trends of exposure to Bisphenol A among international travelers between Los Angeles and Beijing","type":"article","work_id":"W3021568610","year":2020},{"abstract":"","author_count":8,"author_ids":["A5023740323","A5027897053","A5032472429","A5048307710","A5087349635","A5100445951","A510