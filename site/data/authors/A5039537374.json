 of Hazardous Materials","last_updated":"2026-10-31T12:09:11.096373","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.jhazmat.2026.141825","openalex_topics":["T10122","T10419","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-03-19","study_type":"article","title":"Atmospheric microplastic deposition in 24 Chinese cities with different socio-economic development levels","type":"article","work_id":"W7138935970","year":2026},{"abstract":"","author_count":3,"author_ids":["A5039537374","A5108062674","A5140744822"],"author_institution_ids":["I27781120","I2803209242"],"authors":[{"id":"A5108062674","name":"Xu Shang"},{"id":"A5140744822","name":"Dehua Luo"},{"id":"A5039537374","name":"Randy Alan Dahlgren"}],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"https://doi.org/10.1021/acs.est.6c08892","domain_tags":[],"facet_tags":[],"institution_ids":["I27781120","I2803209242"],"is_oa":false,"journal":"Environmental Science & Technology","last_updated":"2026-10-28T10:33:24.094632","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.est.6c08892","openalex_topics":["T10079","T10419","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-07-14","study_type":"editorial","title":"Rebuttal to Correspondence on \u201cMass Balance Tracing of In Vivo Biodistribution, Relocation, and Excretion of Europium-Doped Micro/Nanoplastics in Rats\u201d","type":"editorial","work_id":"W7168277321","year":2026}]}
