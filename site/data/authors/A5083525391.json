7:27.782135","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.atmosenv.2025.121686","openalex_topics":["T10075","T10190","T12095"],"plastic_related":false,"plastic_tier":"","primary_topic":"T10075","pub_date":"2025-11-20","study_type":"article","title":"Contributions of tailpipe and non-tailpipe emissions to the oxidative potential of source-resolved PM10 from major LDV- and HDV-dominated freeways in Los Angeles","type":"article","work_id":"W4416418629","year":2025},{"abstract":"","author_count":13,"author_ids":["A5001328363","A5028077050","A5029277426","A5036057349","A5048754844","A5076250081","A5083525391","A5084487425","A5117726111","A5120431484","A5138388453","A5140529446","A5140536228"],"author_institution_ids":["I1174212"],"authors":[{"id":"A5120431484","name":"Sahar Fazelvalipour"},{"id":"A5036057349","name":"Y U E J I He"},{"id":"A5029277426","name":"Mohammad Mahdi Badami"},{"id":"A5117726111","name":"Diego Ramos Aguilera"},{"id":"A5138388453","name":"Venezia Ramirez"},{"id":"A5083525391","name":"Yashar Aghaei"},{"id":"A5001328363","name":"Vahid Jalali Farahani"},{"id":"A5140529446","name":"Yunhan Huang"},{"id":"A5084487425","name":"Mo Chen"},{"id":"A5028077050","name":"Sara D. Forestieri"},{"id":"A5076250081","name":"David C. Quiros"},{"id":"A5048754844","name":"Constantinos Sioutas"},{"id":"A5140536228","name":"Jiachen Zhang"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.2139/ssrn.7114236","domain_tags":["fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I1174212"],"is_oa":true,"journal":"SSRN Electronic Journal","last_updated":"2026-11-09T13:22:03.289127","license":"","needs_review":false,"oa_status":"green","oa_url":"https://doi.org/10.2139/ssrn.7114236","openalex_topics":["T10768","T12095","T12126"],"plastic_related":false,"plastic_tier":"","primary_topic":"T12095","pub_date":"2026-01-01","study_type":"preprint","title":"Forgone Community Emission Benefits in Southern California Without Zero-Emission Truck Regulations","type":"preprint","work_id":"W7168186223","year":2026},{"abstract":"Airborne microplastics (MPs) are increasingly recognized as atmospheric pollutants with potential implications for human exposure; however, their occurrence, temporal variability, and associations with urban particulate matter remain poorly understood. This study investigated MPs associated with PM10 in central Los Angeles across two seasonal sampling campaigns by integrating MP abundance, morphology, size distribution, PM10 chemical composition, and meteorological observations. MPs were detected in all samples, with concentrations ranging from 2.2-4.0 MP/m3 during the cool-season campaign and 2.2-3.4 MP/m3 during the warm-season campaign. Fibers remained the dominant morphology, while particles <100 \u00b5m, particularly the 5-50 \u00b5m and 50-100 \u00b5m fractions, consistently dominated the airborne MP population. Strong positive correlations (generally \u03c1 \u2265 0.79) were observed between total MP concentrations and major crustal (Fe, Si, Mn, Ca, Al, and Mg), traffic-related (Ba, Cu, and Ni), and carbonaceous (OC and EC) tracers, indicating that MPs are closely associated with urban particulate mixtures influenced by resuspension and non-tailpipe traffic emissions. In contrast, short-term meteorological variability showed no consistent relationship with MP concentrations. These findings indicate that airborne MPs are a persistent component of the urban PM10 mixture rather than isolated contaminants, and provide new insight into their sources and behavior in densely populated urban environments.","author_count":8,"author_ids":["A5002529431","A5025419758","A5029277426","A5048754844","A5083525391","A5120431484","A5158027413","A5158057927"],"author_institution_ids":[],"authors":[{"id":"A5120431484","name":"Sahar Fazelvalipour"},{"id":"A5083525391","name":"Yashar Aghaei"},{"id":"A5029277426","name":"Mohammad Mahdi Badami"},{"id":"A5002529431","name":"Kanchana Chandrakanthan"},{"id":"A5025419758","name":"Pierre Herck\u00e8s"},{"id":"A5158057927","name":"Matthew P. Fraser"},{"id":"A5158027413","name":"Jiachen Zhang"},{"id":"A5048754844","name":"Constantinos Sioutas"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.20944/preprints202610.0577.v1","domain_tags":["air","occurrence_and_monitoring"],"facet_tags":["matrix:air"],"institution_ids":[],"is_oa":true,"journal":"Preprints.org","last_updated":"2026-11-09T13:22:03.289127","license":"cc-by","needs_review":false,"oa_status":"green","oa_url":"https://doi.org/10.20944/preprints202610.0577.v1","openalex_topics":["T10075","T10419","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-10-08","study_type":"preprint","title":"Size-Resolved Characteristics and Source Influences of Airborne Microplastics in Central Los Angeles","type":"preprint","work_id":"W7221132240","year":2026}]}
