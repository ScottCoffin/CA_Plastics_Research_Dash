{"author":{"affiliation_history":[{"country_code":"US","id":"I2803209242","name":"University of California System","years":[2019,2024,2025,2026]},{"country_code":"US","id":"I154570441","name":"University of California, Santa Barbara","years":[2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026]},{"country_code":"US","id":"I4210150264","name":"Anton Paar (United States)","years":[2022]},{"country_code":"US","id":"I86519309","name":"The University of Texas at Austin","years":[2009,2010,2012,2013,2014,2015,2016,2020]},{"country_code":"US","id":"I122411786","name":"California Institute of Technology","years":[2014,2015,2016,2017,2018,2019]},{"country_code":"AU","id":"I165779595","name":"The University of Melbourne","years":[2018]},{"country_code":"US","id":"I70076703","name":"Whittier College","years":[2017]},{"country_code":"BE","id":"I4210114974","name":"IMEC","years":[2016]},{"country_code":"US","id":"I4210139090","name":"Lam Research (United States)","years":[2016]},{"country_code":"US","id":"I130238516","name":"University of Minnesota","years":[2013,2016]},{"country_code":"GB","id":"I71052956","name":"University of Reading","years":[2016]},{"country_code":"CA","id":"I151746483","name":"University of Waterloo","years":[2016]},{"country_code":"US","id":"I4210085935","name":"IBM Research - Almaden","years":[2015]},{"country_code":"US","id":"I72951846","name":"Washington State University","years":[2007,2008]}],"author_id":"A5001435522","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":393,"plastic":0,"year":2017},{"all":392,"plastic":0,"year":2018},{"all":520,"plastic":0,"year":2019},{"all":649,"plastic":0,"year":2020},{"all":712,"plastic":0,"year":2021},{"all":798,"plastic":0,"year":2022},{"all":818,"plastic":6,"year":2023},{"all":988,"plastic":6,"year":2024},{"all":1094,"plastic":6,"year":2025},{"all":1098,"plastic":3,"year":2026}],"cited_by_count":8602,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2007,"first_year":2022,"h_index":45,"institution_ids":["I154570441"],"last_ca_year":2026,"last_year":2022,"m_quotient":2.37,"name":"Christopher M. Bates","orcid":"https://orcid.org/0000-0002-1598-794X","plastic_basis":"openalex","plastic_citations":21,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I154570441","name":"University of California, Santa Barbara","source":"openalex_last_known"},{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"}],"rising_pct":50,"rising_score":0.0018,"work_count":1,"work_ids":["W4306811487"]},"schema_version":"s3.1","works":[{"abstract":"Covalent adaptable networks (CANs) typically require external catalysts for efficient cross-linker exchange, which can limit network reprocessability due to catalyst leaching and degradation. In this study, catalysts were avoided by using a bicyclo[3.3.1]nonane bis-alkyl halide cross-linker with sulfur-atom neighboring group participation (NGP) to increase the rate of bond exchange. Stress relaxation analyses demonstrate that the resultant pyridine-based network has an Arrhenius dependence on viscous flow at elevated temperatures (130\u2013170 \u00b0C), which arises from S N 1 transalkylation exchange. This thermally mediated cross-link interchange and associated flow behavior enabled reprocessing of the ionic networks over multiple damage and repair cycles. Additionally, these NGP-based CANs are chemically recyclable, allowing for recovery of the pyridyl-based polymer starting material, which comprises >90 wt % of the parent network. The dual thermal and chemical recycling potential of this catalyst-free CAN platform addresses key criteria for designing thermosets with extended lifecycles.","author_count":7,"author_ids":["A5001435522","A5006028538","A5036216864","A5044252746","A5064340656","A5069441535","A5091065613"],"author_institution_ids":["I154570441"],"authors":[{"id":"A5006028538","name":"Lindsay L. Robinson"},{"id":"A5069441535","name":"Eden S. Taddese"},{"id":"A5044252746","name":"Jeffrey L. Self"},{"id":"A5001435522","name":"Christopher M. Bates"},{"id":"A5036216864","name":"Javier Read de Alaniz"},{"id":"A5091065613","name":"Zhishuai Geng"},{"id":"A5064340656","name":"Craig J. Hawker"}],"ca_any_author":true,"ca_led":true,"cited_by_count":21,"doi":"https://doi.org/10.1021/acs.macromol.2c01618","domain_tags":["analytical_methods","fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I142207940","I154570441"],"is_oa":false,"journal":"Macromolecules","last_updated":"2026-10-22T18:32:59.640997","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.macromol.2c01618","openalex_topics":["T10405","T10810","T11145"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10810","pub_date":"2022-10-19","study_type":"article","title":"Neighboring Group Participation in Ionic Covalent Adaptable Networks","type":"article","work_id":"W4306811487","year":2022}]}
