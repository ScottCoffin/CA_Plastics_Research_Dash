{"author":{"affiliation_history":[{"country_code":"US","id":"I59897056","name":"California State University, Long Beach","years":[1959,1960,1968,1970,1971,1973,1974,1976,1977,1978,1979,1980,1981,1983,1984,1986,1987,1991,1992,1993,1995,2003,2004,2005,2006,2007,2009,2010,2011,2012,2013,2014,2015,2018]},{"country_code":"US","id":"I1308126019","name":"National Oceanic and Atmospheric Administration","years":[2014,2015,2016,2018]},{"country_code":"US","id":"I127339247","name":"California State University System","years":[1970,1971,2005]},{"country_code":"US","id":"I1174212","name":"University of Southern California","years":[1953,1957]}],"author_id":"A5030566322","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":56,"plastic":10,"year":2017},{"all":77,"plastic":16,"year":2018},{"all":98,"plastic":24,"year":2019},{"all":68,"plastic":15,"year":2020},{"all":72,"plastic":16,"year":2021},{"all":52,"plastic":11,"year":2022},{"all":68,"plastic":22,"year":2023},{"all":57,"plastic":14,"year":2024},{"all":43,"plastic":16,"year":2025},{"all":36,"plastic":13,"year":2026}],"cited_by_count":2926,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1949,"first_year":2012,"h_index":29,"institution_ids":["I59897056"],"last_ca_year":2018,"last_year":2012,"m_quotient":0.38,"name":"Donald J. Reish","orcid":"","plastic_basis":"openalex","plastic_citations":232,"plastic_works_count":7,"primary_affiliations":[{"country_code":"","id":"I59897056","name":"California State University, Long Beach","source":"atlas_recent"}],"rising_pct":23,"rising_score":-0.003,"work_count":1,"work_ids":["W4250622028"]},"schema_version":"s3.1","works":[{"abstract":"This review covers selected 2011 articles on the biological, chemical and physical effects of natural and anthropogenic pollutants on marine and estuarine plants and animals. The review, based largely on journal articles, covers field and laboratory measurement activities (concentrations of contaminants, field surveys, toxicity testing and biomarkers). Reviewed papers focus further on pollution issues of current interest including endocrine disrupters, wastewater discharges, dredging and disposal, etc. Special emphasis is placed on oil spills and marine debris due in part to the catastrophic Deepwater Horizon blowout in the Gulf of Mexico and ongoing cleanup and the 2011 Japanese tsunami. Several topical areas reviewed in the past were dropped this year due to circumstances beyond our control. Further, the focus is on effects, not pollutant fate and transport. There is considerable overlap across subject areas (e.g. some bioaccumulation papers may be cited in other topical categories). As always, readers should only use this as a guide and must consult the original papers before citing them, including double\u2010checking units.","author_count":6,"author_ids":["A5003174412","A5030566322","A5042261411","A5063363715","A5079305081","A5108805511"],"author_institution_ids":["I59897056"],"authors":[{"id":"A5063363715","name":"Alan J. Mearns"},{"id":"A5030566322","name":"Donald J. Reish"},{"id":"A5079305081","name":"Philip S. Oshida"},{"id":"A5003174412","name":"Thomas C. Ginn"},{"id":"A5042261411","name":"Mary Ann Rempel\u2010Hester"},{"id":"A5108805511","name":"Courtney Arthur"}],"ca_any_author":true,"ca_led":false,"cited_by_count":8,"doi":"https://doi.org/10.2175/106143012x13407275695751","domain_tags":["fate_transport_and_sorption","soil_and_agriculture","wastewater_and_treatment"],"facet_tags":["matrix:marine","matrix:soil_and_agriculture","matrix:wastewater"],"institution_ids":["I1308126019","I13383945","I59897056"],"is_oa":true,"journal":"Water Environment Research","last_updated":"2026-11-04T10:54:05.112534","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://onlinelibrary.wiley.com/doi/pdfdirect/10.2175/106143012X13407275695751","openalex_topics":["T10447","T12316","T13485"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10447","pub