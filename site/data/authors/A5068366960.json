{"author":{"affiliation_history":[{"country_code":"NL","id":"I34352273","name":"Maastricht University","years":[2013,2015,2016,2017,2019,2020,2021,2022,2024]},{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","years":[2017,2018,2019,2020,2021]},{"country_code":"TW","id":"I4210156562","name":"Chiayi Chang Gung Memorial Hospital","years":[2019]},{"country_code":"KR","id":"I4210096527","name":"Kyungpook National University Medical Center","years":[2019]},{"country_code":"TW","id":"I165441096","name":"National Health Research Institutes","years":[2019]},{"country_code":"CN","id":"I2800810863","name":"Queen Mary Hospital","years":[2019]},{"country_code":"KR","id":"I139264467","name":"Seoul National University","years":[2019]},{"country_code":"HK","id":"I889458895","name":"University of Hong Kong","years":[2019]}],"author_id":"A5068366960","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":18,"plastic":0,"year":2017},{"all":77,"plastic":0,"year":2018},{"all":142,"plastic":0,"year":2019},{"all":343,"plastic":0,"year":2020},{"all":492,"plastic":0,"year":2021},{"all":402,"plastic":0,"year":2022},{"all":414,"plastic":0,"year":2023},{"all":403,"plastic":0,"year":2024},{"all":404,"plastic":0,"year":2025},{"all":348,"plastic":0,"year":2026}],"cited_by_count":3068,"domain_tags":[],"early_career":false,"first_pub_year":2013,"first_year":2019,"h_index":13,"institution_ids":["I34352273","I95457486"],"last_year":2019,"m_quotient":1.0,"name":"Linda Rieswijk","orcid":"https://orcid.org/0000-0002-6106-1347","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"NL","id":"I34352273","name":"Maastricht University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2985810567"]},"schema_version":"s3.1","works":[{"abstract":"Endocrine-disrupting chemicals (EDCs) are exogenous chemicals that interfere with hormone action, thereby increasing the risk of adverse health outcomes, including cancer, reproductive impairment, cognitive deficits and obesity. A complex literature of mechanistic studies provides evidence on the hazards of EDC exposure, yet there is no widely accepted systematic method to integrate these data to help identify EDC hazards. Inspired by work to improve hazard identification of carcinogens using key characteristics (KCs), we have developed ten KCs of EDCs based on our knowledge of hormone actions and EDC effects. In this Expert Consensus Statement, we describe the logic by which these KCs are identified and the assays that could be used to assess several of these KCs. We reflect on how these ten KCs can be used to identify, organize and utilize mechanistic data when evaluating chemicals as EDCs, and we use diethylstilbestrol, bisphenol A and perchlorate as examples to illustrate this approach.","author_count":16,"author_ids":["A5015903547","A5032055617","A5032107481","A5037771157","A5048164907","A5054226597","A5056745479","A5063374927","A5064434278","A5068037678","A5068366960","A5075356259","A5077633544","A5079234992","A5101896580","A5104098074"],"author_institution_ids":["I34352273","I95457486"],"authors":[{"id":"A5075356259","name":"Michele Andrea La Merrill"},{"id":"A5032055617","name":"Laura N. Vandenberg"},{"id":"A5068037678","name":"Martyn T. Smith"},{"id":"A5032107481","name":"William H. Goodson"},{"id":"A5015903547","name":"Patience Browne"},{"id":"A5056745479","name":"Heather B. Patisaul"},{"id":"A5054226597","name":"Kathryn Z. Guyton"},{"id":"A5063374927","name":"Andreas Kortenkamp"},{"id":"A5104098074","name":"Vincent James Cogliano"},{"id":"A5048164907","name":"Tracey J. Woodruff"},{"id":"A5068366960","name":"Linda Rieswijk"},{"id":"A5101896580","name":"Hideko Sone"},{"id":"A5037771157","name":"Kenneth Steven Korach"},{"id":"A5064434278","name":"Andrea C. Gore"},{"id":"A5079234992","name":"Lauren A. Zeise"},{"id":"A5077633544","name":"R. Thomas Zoeller"}],"ca_an