all":346,"plastic":2,"year":2025},{"all":265,"plastic":18,"year":2026}],"cited_by_count":2786,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2015,"first_year":2025,"h_index":17,"institution_ids":["I204823248","I2803209242"],"last_ca_year":2025,"last_year":2025,"m_quotient":1.55,"name":"Zhaoyang Liu","orcid":"https://orcid.org/0000-0002-3759-8160","plastic_basis":"openalex","plastic_citations":20,"plastic_works_count":1,"primary_affiliations":[{"country_code":"CN","id":"I142078773","name":"Shenyang Institute of Automation","source":"openalex_last_known"},{"country_code":"CN","id":"I19820366","name":"Chinese Academy of Sciences","source":"openalex_last_known"},{"country_code":"CN","id":"I204823248","name":"Huazhong Agricultural University","source":"openalex_last_known"},{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4414791560"]},"schema_version":"s3.1","works":[{"abstract":"In highly urbanized areas, heavy vehicular traffic generates large amounts of tire wear particles (TWPs) and tire additives and transformation products (TATPs), which are released into roadside environments. TATPs can cause acute and sublethal toxicities to nontarget organisms, but their levels and distribution in roadside soils are poorly understood. This study assessed TATP contamination in roadside soils along busy highways in Southern California. Representative TATPs (15) were monitored, and the total concentrations (\u03a3TATPs) ranged from 33.6 to 1747.5 ng/g. Compounds such as 1,3-diphenylguanidine (DPG) and benzothiazole and its derivatives (BTHs) were consistently detected at higher levels. The TATP contamination profile was influenced by season and surface runoff with higher levels in summer. TATP levels decreased with increasing distance from the road. Traffic volume positively correlated with total TATP levels, while the proportion of trucks contributed to elevated levels of paraphenylenediamine antioxidants (PPDs). These findings highlight the significant presence of TATPs in roadside soils, posing risks as secondary pollution sources for downstream ecosystems. Research is urgently needed to understand the transformations of TATPs in roadside soils, their transport potential to sensitive environments, and the mitigation role of natural and engineered infrastructures along highways.","author_count":5,"author_ids":["A5044488183","A5075951652","A5088307368","A5100603520","A5114503884"],"author_institution_ids":["I204823248","I2803209242"],"authors":[{"id":"A5044488183","name":"Zhongkun Du"},{"id":"A5114503884","name":"Ali Refaei"},{"id":"A5100603520","name":"Zhaoyang Liu"},{"id":"A5088307368","name":"Daniel Schlenk"},{"id":"A5075951652","name":"Jay J. Gan"}],"ca_any_author":true,"ca_led":true,"cited_by_count":19,"doi":"https://doi.org/10.1021/acs.est.5c10556","domain_tags":["fate_transport_and_sorption","soil_and_agriculture"],"facet_tags":["matrix:soil_and_agriculture"],"institution_ids":["I204823248","I2803209242","I74485261"],"is_oa":false,"journal":"Environmental Science & Technology","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.est.5c10556","openalex_topics":["T10122","T10419","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2025-10-03","study_type":"article","title":"Tire Additives and Transformation Products (TATPs) in Roadside Soils along Southern California Highways","type":"article","work_id":"W4414791560","year":2025}]}
