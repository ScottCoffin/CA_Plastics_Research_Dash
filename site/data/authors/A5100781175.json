{"author":{"affiliation_history":[{"country_code":"IL","id":"I2799810450","name":"Sheba Medical Center","years":[2012,2019,2020,2021,2022,2023,2024,2025,2026]},{"country_code":"IL","id":"I16391192","name":"Tel Aviv University","years":[2019,2021,2022,2023,2024,2025,2026]},{"country_code":"IL","id":"I4210144215","name":"Edmond and Lily Safra Children's Hospital","years":[2019,2021,2023,2024]},{"country_code":"US","id":"I36258959","name":"University of California San Diego","years":[2015,2016,2017,2018,2019,2022]},{"country_code":"US","id":"I4391012607","name":"Division of Cancer Epidemiology and Genetics","years":[2016]},{"country_code":"US","id":"I4210140884","name":"National Cancer Institute","years":[2016]},{"country_code":"US","id":"I188538660","name":"University of Colorado Boulder","years":[2014]},{"country_code":"US","id":"I4210155419","name":"Center for Systems Biology","years":[2013]},{"country_code":"US","id":"I136199984","name":"Harvard University","years":[2013]},{"country_code":"US","id":"I63966007","name":"Massachusetts Institute of Technology","years":[2013]},{"country_code":"IL","id":"I164950643","name":"Open University of Israel","years":[2013]},{"country_code":"US","id":"I160992636","name":"Toyota Technological Institute at Chicago","years":[2013]},{"country_code":"IL","id":"I53964585","name":"Weizmann Institute of Science","years":[2002,2004,2007,2008,2010,2011,2013]}],"author_id":"A5100781175","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":376,"plastic":0,"year":2017},{"all":910,"plastic":0,"year":2018},{"all":1356,"plastic":0,"year":2019},{"all":1742,"plastic":0,"year":2020},{"all":2163,"plastic":0,"year":2021},{"all":1879,"plastic":0,"year":2022},{"all":1705,"plastic":0,"year":2023},{"all":1650,"plastic":0,"year":2024},{"all":1645,"plastic":0,"year":2025},{"all":1564,"plastic":0,"year":2026}],"cited_by_count":15391,"domain_tags":[],"early_career":false,"first_pub_year":2002,"first_year":2017,"h_index":39,"institution_ids":["I36258959"],"last_year":2017,"m_quotient":1.62,"name":"Amnon Amir","orcid":"https://orcid.org/0000-0002-0903-6056","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"IL","id":"I16391192","name":"Tel Aviv University","source":"openalex_last_known"},{"country_code":"IL","id":"I2799810450","name":"Sheba Medical Center","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2762445857"]},"schema_version":"s3.1","works":[{"abstract":"Emerging evidence suggests that environmental toxicants may influence inflammation-promoted chronic disease susceptibility during early life. BPA, an environmental endocrine disruptor, can transfer across the placenta and accumulate in fetal gut and liver. However, underlying mechanisms for BPA-induced colonic and liver inflammation are not fully elucidated. In this report, we show how perinatal BPA exposure in rabbits alters gut microbiota and their metabolite profiles, which leads to colonic and liver inflammation as well as to increased gut permeability as measured by elevated serum lipopolysaccharide (LPS) levels in the offspring. Also, perinatal BPA exposure leads to reduced levels of gut bacterial diversity and bacterial metabolites (short-chain fatty acids [SCFA]) and elevated gut permeability\u2014three common early biomarkers of inflammation-promoted chronic diseases. In addition, we showed that SCFA ameliorated BPA-induced intestinal permeability in vitro . Thus, our study results suggest that correcting environmental toxicant-induced bacterial dysbiosis early in life may reduce the risk of chronic diseases later in life.","author_count":11,"author_ids":["A5024903706","A5025148058","A5033881627","A5039818507","A5053830431","A5077678200","A5084779674","A5086938254","A5090247900","A5100781175","A5103091692"],"author_institution_ids":["I36258959"],"authors":[{"id":"A5084779674","name":"Lavanya Reddivari"},{"id":"A5090247900","name":"D. N. Rao Veeramachaneni"},{"id":"A5025148058","name":"William Anton Walters"},{"id":"A5086938254","name":"Catherine Lozupone"},{"id":"A5077678200","name":"Jennifer S. Palmer"},{"id":"A5024903706","name":"M. K. Kurundu Hewage"},{"id":"A5053830431","name":"Rohil Sahai Bhatnagar"},{"id":"A5100781175","name":"Amnon Amir"},{"id":"A5039818507","name":"Mary J. Kennett"},{"id":"A5033881627","name":"Rob D. Knight"},{"id":"A5103091692","name":"Jairam Vanamala"}],"ca_any_author":true,"ca_led":false,"cited_by_count":119,"doi":"https://doi.org/10.1128/msystems.00093-17","domain_tags":["human_exposure_and_health_risk"],"facet_tags":[],"institution_ids":["I130769515","I36258959","I4210112458","I4405268258","I51713134","I92446798"],"is_oa":true,"journal":"mSystems","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://doi.org/10.1128/msystems.00093-17","openalex_topics":["T10066","T10269","T10686"],"plastic_related":false,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10066","pub_date":"2017-10-10","study_type":"article","title":"Perinatal Bisphenol A Exposure Induces Chronic Inflammation in Rabbit Offspring via Modulation of Gut Bacteria and Their Metabolites","type":"article","work_id":"W2762445857","year":2017}]}
