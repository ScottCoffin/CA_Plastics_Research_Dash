{"author":{"affiliation_history":[{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","years":[2024]},{"country_code":"US","id":"I148283060","name":"Lawrence Berkeley National Laboratory","years":[2022]},{"country_code":"US","id":"I4387154492","name":"Molecular Foundry","years":[2022]}],"author_id":"A5032980422","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":9,"plastic":9,"year":2022},{"all":19,"plastic":19,"year":2023},{"all":17,"plastic":17,"year":2024},{"all":25,"plastic":25,"year":2025},{"all":15,"plastic":15,"year":2026}],"cited_by_count":85,"domain_tags":[],"early_career":true,"first_pub_year":2022,"first_year":2022,"h_index":1,"institution_ids":["I148283060","I4387154492"],"last_year":2022,"m_quotient":0.25,"name":"Christopher W. Chan","orcid":"https://orcid.org/0000-0001-7805-6483","plastic_basis":"openalex","plastic_citations":85,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","source":"openalex_last_known"}],"rising_pct":69,"rising_score":0.0052,"work_count":1,"work_ids":["W4286203119"]},"schema_version":"s3.1","works":[{"abstract":"Footwear, carpet, automotive interiors, and multilayer packaging are examples of products manufactured from several types of polymers whose inextricability poses substantial challenges for recycling at the end of life. Here, we show that chemical circularity in mixed-polymer recycling becomes possible by controlling the rates of depolymerization of polydiketoenamines (PDK) over several orders of magnitude through molecular engineering. Stepwise deconstruction of mixed-PDK composites, laminates, and assemblies is chemospecific, allowing a prescribed subset of monomers, fillers, and additives to be recovered under pristine condition at each stage of the recycling process. We provide a theoretical framework to understand PDK depolymerization via acid-catalyzed hydrolysis and experimentally validate trends predicted for the rate-limiting step. The control achieved by PDK resins in managing chemical and material entropy points to wide-ranging opportunities for pairing circular design with sustainable manufacturing.","author_count":13,"author_ids":["A5000312223","A5010419764","A5012680865","A5013364233","A5018132574","A5027216595","A5029685348","A5032980422","A5037535334","A5045346726","A5047335957","A5047494949","A5091500565"],"author_institution_ids":["I148283060","I4387154492"],"authors":[{"id":"A5091500565","name":"J\u00e9r\u00e9my Demarteau"},{"id":"A5027216595","name":"Alexander Rizzolo Epstein"},{"id":"A5047335957","name":"Peter R. Christensen"},{"id":"A5013364233","name":"Mark Abubekerov"},{"id":"A5010419764","name":"Hai Wang"},{"id":"A5045346726","name":"Simon J. Teat"},{"id":"A5047494949","name":"Trevor J. Seguin"},{"id":"A5032980422","name":"Christopher W. Chan"},{"id":"A5018132574","name":"Corinne D. Scown"},{"id":"A5029685348","name":"Thomas P. Russell"},{"id":"A5000312223","name":"Jay D. Keasling"},{"id":"A5037535334","name":"Kristin Aslaug Persson"},{"id":"A5012680865","name":"Brett A. Helms"}],"ca_any_author":true,"ca_led":true,"cited_by_count":85,"doi":"https://doi.org/10.1126/sciadv.abp8823","domain_tags":[],"facet_tags":[],"institution_ids":["I148283060","I201537933","I24603500","I2801134892","I4210145761","I4387152530","I4387154492","I4405286224","I53012624","I95457486","I96673099"],"is_oa":true,"journal":"Science Advances","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://www.science.org/doi/pdf/10.1126/sciadv.abp8823?download=true","openalex_topics":["T10389","T10661","T10810"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10389","pub_date":"2022-07-20","study_type":"article","title":"Circularity in mixed-plastic chemical recycling enabled by variable rates of polydiketoenamine hydrolysis","type":"article","work_id":"W4286203119","year":2022}]}
