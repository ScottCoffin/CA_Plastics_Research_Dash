{"author":{"affiliation_history":[{"country_code":"US","id":"I122411786","name":"California Institute of Technology","years":[2026]},{"country_code":"US","id":"I92446798","name":"Colorado State University","years":[2025,2026]}],"author_id":"A5007085871","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":0,"plastic":0,"year":2020},{"all":0,"plastic":0,"year":2021},{"all":0,"plastic":0,"year":2022},{"all":0,"plastic":0,"year":2023},{"all":0,"plastic":0,"year":2024},{"all":1,"plastic":1,"year":2025},{"all":22,"plastic":22,"year":2026}],"cited_by_count":23,"current_in_ca":true,"domain_tags":[],"early_career":true,"first_pub_year":2020,"first_year":2026,"h_index":1,"institution_ids":["I122411786","I92446798"],"last_ca_year":2026,"last_year":2026,"m_quotient":0.17,"name":"Ethan Carey Quinn","orcid":"https://orcid.org/0000-0002-9609-806X","plastic_basis":"openalex","plastic_citations":23,"plastic_works_count":3,"primary_affiliations":[{"country_code":"US","id":"I122411786","name":"California Institute of Technology","source":"openalex_last_known"},{"country_code":"US","id":"I92446798","name":"Colorado State University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W7155363677"]},"schema_version":"s3.1","works":[{"abstract":"Recyclable polymers that can be produced at scale and readily tuned within the same polymer framework for specific properties is critical to achieving a circular materials economy. To this end, synthetic poly(3-hydroxyalkanoate)s (PHAs) have emerged as high-performance, chemically-recyclable variants of biological PHAs, but their difficult monomer syntheses and sub-optimal recycling efficiencies pose challenges for large-scale deployment. Here, we investigate a \u03b2-isopropylidene PHA, i-PHA, for which the lactone monomer can be synthesized by existing industrial methods from biomass-derived isobutyric acid. The alkylidene substituent prevents decarboxylative degradation typically observed during PHA depolymerization, enabling near-quantitative chemical recycling to monomer. Controlled hydrogenation of the \u03b2-isopropylidene side group produces PHAs with diverse performance metrics competitive with a range of commodity polymers, spanning strong fibers to ductile thermoplastics to superglue epoxy resins.","author_count":12,"author_ids":["A5007085871","A5018137652","A5018268999","A5035721241","A5037337879","A5042094606","A5053030488","A5054513202","A5070376800","A5117515613","A5134402262","A5134422346"],"author_institution_ids":["I122411786","I92446798"],"authors":[{"id":"A5035721241","name":"James H. May"},{"id":"A5134402262","name":"Li Zhou"},{"id":"A5042094606","name":"Ravikumar R. Gowda"},{"id":"A5037337879","name":"Levi J. Hamernik"},{"id":"A5054513202","name":"Jacob K. Kenny"},{"id":"A5134422346","name":"Lili Wang"},{"id":"A5117515613","name":"Christopher D Stubbs"},{"id":"A5007085871","name":"Ethan Carey Quinn"},{"id":"A5053030488","name":"Jason S. DesVeaux"},{"id":"A5070376800","name":"Katrina M. Knauer"},{"id":"A5018268999","name":"Gregg T. Beckham"},{"id":"A5018137652","name":"Eugene Y.\u2010X. Chen"}],"ca_any_author":true,"ca_led":false,"cited_by_count":1,"doi":"https://doi.org/10.5061/dryad.r7sqv9ssg","domain_tags":["fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I122411786","I1297288678","I4210112946","I92446798"],"is_oa":true,"journal":"DRYAD","last_updated":"2026-11-04T10:54:05.112534","license":"public-domain","needs_review":false,"oa_status":"green","oa_url":"https://doi.org/10.5061/dryad.r7sqv9ssg","openalex_topics":["T10389","T10661","T10810"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2026-03-17","study_type":"dataset","title":"Data from: Alkylidene functionalization produces highly recyclable and scalable polyhydroxyalkanoates","type":"dataset","work_id":"W7155363677","year":2026}]}
