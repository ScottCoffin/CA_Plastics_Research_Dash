known"}],"rising_pct":100,"rising_score":0.282,"work_count":6,"work_ids":["W4405484356","W4413968075","W4414065371","W7128928289","W7155363677","W7163170497"]},"schema_version":"s3.1","works":[{"abstract":"","author_count":11,"author_ids":["A5018268999","A5037670750","A5047979174","A5055898951","A5057725529","A5062042072","A5063417944","A5082594041","A5088190837","A5091301298","A5115512120"],"author_institution_ids":["I1297288678"],"authors":[{"id":"A5055898951","name":"Allison Z. Werner"},{"id":"A5115512120","name":"Young-Saeng Cho Avina"},{"id":"A5047979174","name":"Josefin Johnsen"},{"id":"A5063417944","name":"Felicia Bratti"},{"id":"A5037670750","name":"Hannah M. Alt"},{"id":"A5091301298","name":"Elsayed T. Mohamed"},{"id":"A5082594041","name":"Rita Clare"},{"id":"A5057725529","name":"Thomas D. Mand"},{"id":"A5088190837","name":"Adam M. Guss"},{"id":"A5062042072","name":"Adam M. Feist"},{"id":"A5018268999","name":"Gregg T. Beckham"}],"ca_any_author":true,"ca_led":false,"cited_by_count":33,"doi":"https://doi.org/10.1016/j.ymben.2024.12.006","domain_tags":[],"facet_tags":[],"institution_ids":["I1289243028","I1297288678","I2801134892","I36258959","I96673099"],"is_oa":true,"journal":"Metabolic Engineering","last_updated":"2026-11-11T12:16:26.678958","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://www.sciencedirect.com/science/article/am/pii/S1096717624001770","openalex_topics":["T10324","T10661","T10932"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10932","pub_date":"2024-12-18","study_type":"article","title":"Adaptive laboratory evolution and genetic engineering improved terephthalate utilization in Pseudomonas putida KT2440","type":"article","work_id":"W4405484356","year":2024},{"abstract":"The enzymatic depolymerization of poly-(ethylene terephthalate) (PET) is emerging as a leading chemical recycling technology for waste polyester. As part of this endeavor, new candidate enzymes identified from natural diversity can serve as useful starting points for enzyme evolution and engineering. In this study, we improved upon HMM searches by applying an iterative machine learning strategy to identify 400 putative PET-degrading enzymes (PET hydrolases) from naturally occurring homologs. Using high-throughput (HTP) experimental techniques, we successfully expressed and purified >200 enzyme candidates and assayed them for PET hydrolysis activity as a function of pH, temperature, and substrate crystallinity. From this library, we discovered 91 previously unknown PET hydrolases, 35 of which retain activity at pH 4.5 on crystalline material, which are conditions relevant to developing more efficient commercial processes. Notably, four enzymes showed equal to or higher activity than LCC-ICCG, a benchmark PET hydrolase, at this challenging condition in our screening assay, and 11 of which have pH optima <7. Using these data, we identified regions of PETases statistically correlated to activity at lower pH. We additionally investigated the effect of condition-specific activity data on trained machine learning predictors and found a precision (putative hit rate) improvement of up to 30% compared to a Hidden Markov Model alone. Our findings show that by pointing enzyme discovery toward conditions of interest with multiple rounds of experimental and machine learning, we can discover large sets of active enzymes and explore factors associated with activity at those conditions.","author_count":12,"author_ids":["A5013829048","A5018268999","A5018372701","A5023289644","A5030920869","A5031819819","A5038274735","A5083294830","A5085865532","A5089995487","A5094079002","A5119532247"],"author_institution_ids":["I1297288678","I4387153615"],"authors":[{"id":"A5085865532","name":"Brenna Norton\u2010Baker"},{"id":"A5023289644","name":"Evan Komp"},{"id":"A5013829048","name":"Japheth E. Gado"},{"id":"A5094079002","name":"Mackenzie C. R. Denton"},{"id":"A5030920869","name":"Irimpan I. Mathews"},{"id":"A5031819819","name":"Natasha P. Murphy"},{"id":"A5018372701","name":"Erika Erickson"},{"id":"A5119532247","name":"Olateju O. Storment"},{"id":"A5089995487","name":"Ritimukta Sarangi"},{"id":"A5083294830","name":"Nicholas Paul Gauthier"},{"id":"A5038274735","name":"J.E. McGeehan"},{"id":"A5018268999","name":"Gregg T. Beckham"}],"ca_any_author":true,"ca_led":true,"cited_by_count":39,"doi":"https://doi.org/10.1021/acscatal.5c03460","domain_tags":["analytical_methods","fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I1297288678","I136199984","I2801935854","I4210117453","I4210120900","I4387153615"],"is_oa":true,"journal":"ACS Catalysis","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://pubs.acs.org/doi/pdf/10.1021/acscatal.5c03460?ref=article_openPDF","openalex_topics":["T10404","T11136","T11617"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10404","pub_date":"2025-09-03","study_type":"article","title":"Machine Learning-Guided Identification of PET Hydrolases from Natural Diversity","type":"article","work_id":"W4413968075","year":2025},{"abstract":"","author_count":17,"author_ids":["A5018268999","A5022704014","A5025739057","A5027085113","A5027263869","A5033077213","A5034069191","A5037645538","A5053030488","A5058327588","A5070376800","A5100625845","A5102717994","A5106606842","A5108972405","A5111700215","A5113153136"],"author_institution_ids":["I1297288678"],"authors":[{"id":"A5034069191","name":"Julia B. Curley"},{"id":"A5027263869","name":"Yuanzhe Liang"},{"id":"A5053030488","name":"Jason S. DesVeaux"},{"id":"A5102717994","name":"Hoon Sang Choi"},{"id":"A5033077213","name":"Ryan W. Clarke"},{"id":"A5037645538","name":"Anjani Kumar Maurya"},{"id":"A5022704014","name":"William E. Michener"},{"id":"A5113153136","name":"Lisa M. Stanley"},{"id":"A5100625845","name":"Yue Wu"},{"id":"A5027085113","name":"Sarah A. Hesse"},{"id":"A5108972405","name":"Andrea L. Baer"},{"id":"A5106606842","name":"Hudson Neyer"},{"id":"A5025739057","name":"Christopher J. Tassone"},{"id":"A5111700215","name":"Alan J. Jacobsen"},{"id":"A5058327588","name":"Ofei Daku Mante"},{"id":"A5018268999","name":"Gregg T. Beckham"},{"id":"A5070376800","name":"Katrina M. Knauer"}],"ca_any_author":true,"ca_led":false,"cited_by_count":35,"doi":"https://doi.org/10.1038/s44286-025-00275-x","domain_tags":[],"facet_tags":[],"institution_ids":["I1297288678","I1311688040","I2801935854","I4210120900"],"is_oa":false,"journal":"Nature Chemical Engineering","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1038/s44286-025-00275-x","openalex_topics":["T10389","T10661","T14179"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10389","pub_date":"2025-09-08","study_type":"article","title":"Closed-loop recycling of mixed polyesters via catalytic methanolysis and monomer separations","type":"article","work_id":"W4414065371","year":2025},{"abstract":"Transitioning to a circular plastics economy will require use of renewable feedstocks, energy-efficient processes, and closed-loop recyclable polymers, such as polyesters. A key challenge lies in sustainably sourcing monomers used to make recyclable polyesters. This work presents a catalytic platform utilizing earth-abundant Cu(x)Ca(1-x)O mixed metal oxides for the oxidative dehydrocyclization of bio-based diols to lactones, which are advantaged for energy-efficient ring-opening polymerization. Operating below 200 \u00b0C, at ambient pressure, and without solvent, the process uses air as the sole oxidant, achieving high yields of lactones across a broad substrate scope of C4-8 diols in the liquid phase. The oxidative dehydrocyclization reaction is thermodynamically downhill due to water formation and energy-efficient compared to incumbent, non-redox pathways utilized in fossil carbon-based industrial processes for lactone production. Mechanistic studies reveal facile redox cycling of Cu2+-O(Ca2+)-Cu2+ interfacial sites unique to the developed catalyst. Techno-economic analysis and life cycle assessment estimate 40% lower energy demand and 15% lower GHG intensity per mass of butyrolactone produced compared to the fossil carbon-based route. Liquid-phase oxidative dehydrocyclization offers a promising approach for scalable lactone production from renewable, bio-based diols to enable circular polyesters. Lactone monomers for recyclable polyesters are conventionally synthesized via endergonic, non-oxidative dehydrocyclization of fossil-derived diols in the vapor phase over precious-metal catalysts at elevated temperatures. Here, the authors demonstrate a low-temperature, solvent-free, oxidative route to lactones from bio-derivable liquid diols using earth-abundant calcium-copper mixed-metal oxide catalysts.","author_count":10,"author_ids":["A5003351487","A5016126135","A5018268999","A5028323119","A5036976749","A5047493092","A5053030488","A5053381942","A5055938115","A5087034449"],"author_institution_ids":["I1297288678"],"authors":[{"id":"A5028323119","name":"Daniyal Kiani"},{"id":"A5087034449","name":"Gloria Rosetto"},{"id":"A5003351487","name":"Faysal Ibrahim"},{"id":"A5036976749","name":"\u00d6zge Deniz Bozkurt"},{"id":"A5055938115","name":"Ajinkya Pal"},{"id":"A5053381942","name":"Elisabeth C. Van Roijen"},{"id":"A5053030488","name":"Jason S. DesVeaux"},{"id":"A5047493092","name":"Simon R. Bare"},{"id":"A5016126135","name":"Ive Hermans"},{"id":"A5018268999","name":"Gregg T. Beckham"}],"ca_any_author":true,"ca_led":false,"cited_by_count":3,"doi":"https://doi.org/10.1038/s41467-026-69362-8","domain_tags":[],"facet_tags":[],"institution_ids":["I1297288678","I145311948","I2801935854","I4210120900"],"is_oa":true,"journal":"Nature Communications","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://www.nature.com/articles/s41467-026-69362-8_reference.pdf","openalex_topics":["T10661","T11009","T11593"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2026-02-14","study_type":"article","title":"Solventless, ambient-pressure production of bio-based lactones over earth-abundant, mixed metal oxide catalysts for circular polyesters","type":"article","work_id":"W7128928289","year":2026},{"abstract":"Recyclable polymers that can be produced at scale and readily tuned within the same polymer framework for specific properties is critical to achieving a circular materials economy. To this end, synthetic poly(3-hydroxyalkanoate)s (PHAs) have emerged as high-performance, chemically-recyclable variants of biological PHAs, but their difficult monomer syntheses and sub-optimal recycling efficiencies pose challenges for large-scale deployment. Here, we investigate a \u03b2-isopropylidene PHA, i-PHA, for which the lactone monomer can be synthesized by existing industrial methods from biomass-derived isobutyric acid. The alkylidene substituent prevents decarboxylative degradation typically observed during PHA depolymerization, enabling near-quantitative chemical recycling to monomer. Controlled hydrogenation of the \u03b2-isopropylidene side group produces PHAs with diverse performance metrics competitive with a range of commodity polymers, spanning strong fibers to ductile thermoplastics to superglue epoxy resins.","author_count":12,"author_ids":["A5007085871","A5018137652","A5018268999","A5035721241","A5037337879","A5042094606","A5053030488","A5054513202","A5070376800","A5117515613","A5134402262","A5134422346"],"author_institution_ids":["I1297288678"],"authors":[{"id":"A5035721241","name":"James H. May"},{"id":"A5134402262","name":"Li Zhou"},{"id":"A5042094606","name":"Ravikumar R. Gowda"},{"id":"A5037337879","name":"Levi J. Hamernik"},{"id":"A5054513202","name":"Jacob K. Kenny"},{"id":"A5134422346","name":"Lili Wang"},{"id":"A5117515613","name":"Christopher D Stubbs"},{"id":"A5007085871","name":"Ethan Carey Quinn"},{"id":"A5053030488","name":"Jason S. DesVeaux"},{"id":"A5070376800","name":"Katrina M. Knauer"},{"id":"A5018268999","name":"Gregg T. Beckham"},{"id":"A5018137652","name":"Eugene Y.\u2010X. Chen"}],"ca_any_author":true,"ca_led":false,"cited_by_count":1,"doi":"https://doi.org/10.5061/dryad.r7sqv9ssg","domain_tags":["fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I122411786","I1297288678","I4210112946","I92446798"],"is_oa":true,"journal":"DRYAD","last_updated":"2026-11-04T10:54:05.112534","license":"public-domain","needs_review":false,"oa_status":"green","oa_url":"https://doi.org/10.5061/dryad.r7sqv9ssg","openalex_topics":["T10389","T10661","T10810"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2026-03-17","study_type":"dataset","title":"Data from: Alkylidene functionalization produces highly recyclable and scalable polyhydroxyalkanoates","type":"dataset","work_id":"W7155363677","year":2026},{"abstract":"","author_count":13,"author_ids":["A5004170933","A5018268999","A5023917549","A5029871622","A5030433677","A5053188243","A5062542554","A5062768733","A5063364599","A5067358423","A5135900186","A5137653889"],"author_institution_ids":[],"authors":[{"id":"A5004170933","name":"Maximilian Baur"},{"id":"A5029871622","name":"Susannah L. Scott"},{"id":"A5135900186","name":"Ding Ma"},{"id":"A5018268999","name":"Gregg T. Beckham"},{"id":"A5067358423","name":"Soon Hyeok Hong"},{"id":"","name":"Rodney S. Ridley"},{"id":"A5023917549","name":"Hal S. Alper"},{"id":"A5062768733","name":"Kim Ragaert"},{"id":"A5063364599","name":"Mara Silber"},{"id":"A5062542554","name":"Bernhard von Vacano"},{"id":"A5137653889","name":"Corrine D. Scown"},{"id":"A5030433677","name":"Andrew P. Dove"},{"id":"A5053188243","name":"Bert Marc Weckhuysen"}],"ca_any_author":true,"ca_led":true,"cited_by_count":1,"doi":"https://doi.org/10.1016/j.checir.2026.100046","domain_tags":[],"facet_tags":[],"institution_ids":[],"is_oa":false,"journal":"Chem Circularity","la