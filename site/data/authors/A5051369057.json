ount":2,"work_ids":["W3003636267","W3040523150"]},"schema_version":"s3.1","works":[{"abstract":"","author_count":6,"author_ids":["A5002279065","A5023692080","A5026952128","A5029906007","A5051369057","A5111566152"],"author_institution_ids":["I4210137306","I97018004"],"authors":[{"id":"A5029906007","name":"Samantha L. Wong"},{"id":"A5026952128","name":"Anna E. Epperson"},{"id":"A5023692080","name":"Jayna Rogers"},{"id":"A5111566152","name":"Ralph J. Castro"},{"id":"A5002279065","name":"Robert K. Jackler"},{"id":"A5051369057","name":"Judith J. Prochaska"}],"ca_any_author":true,"ca_led":true,"cited_by_count":18,"doi":"https://doi.org/10.1016/j.ypmed.2020.106008","domain_tags":[],"facet_tags":[],"institution_ids":["I4210137306","I97018004"],"is_oa":true,"journal":"Preventive Medicine","last_updated":"2026-11-11T12:16:26.678958","license":"","needs_review":false,"oa_status":"green","oa_url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC7396290/","openalex_topics":["T10060","T12816","T12831"],"plastic_related":false,"plastic_tier":"","primary_topic":"T10060","pub_date":"2020-02-03","study_type":"article","title":"A multimodal assessment of tobacco use on a university campus and support for adopting a comprehensive tobacco-free policy","type":"article","work_id":"W3003636267","year":2020},{"abstract":"INTRODUCTION: Research has documented higher smoking prevalence with unemployment and greater difficulty with gaining re-employment for those who smoke. Using photo elicitation methods, we sought to gain a deeper understanding of the connection between job-seeking and tobacco use. METHODS: Unemployed daily smokers (18 men, 1 woman) were recruited from the San Francisco Employment Development Department (EDD) and provided disposable cameras with 27 exposures and a list of 20 photo prompts related to job-seeking and tobacco. Study staff reviewed the photos with the participants and audio-recorded their narratives. The photos and narratives were coded for themes. RESULTS: Of 363 photos, the most frequent photo imagery related to transportation (n = 56, 15.4%), work or education (n = 39, 10.7%), and littered cigarettes (n = 39, 10.7%). Narrated themes centered on motivators to quit smoking (255 mentions from 15 participants); people, places, and things associated with smoking (248 mentions, 16 participants); and motivators to secure work (157 mentions, 13 participants). The intersection of smoking and unemployment received 92 mentions from 11 participants, with 60 mentions (8 participants) identifying smoking as a barrier to re-employment. CONCLUSIONS: Both motivators to quit and associated smoking cues were salient in the environments of job-seeking smokers. Struggles with quitting and perceptions that smoking is harming re-employment success suggest the potential for offering tobacco treatment in EDD settings. With permission, the photos and themes have been incorporated into a tobacco treatment intervention for job-seeking smokers.","author_count":4,"author_ids":["A5025398280","A5029906007","A5030647071","A5051369057"],"author_institution_ids":["I4210137306","I97018004"],"authors":[{"id":"A5025398280","name":"Anne K. Michalek"},{"id":"A5029906007","name":"Samantha L. Wong"},{"id":"A5030647071","name":"Cati G. Brown\u2010Johnson"},{"id":"A5051369057","name":"Judith J. Prochaska"}],"ca_any_author":true,"ca_led":true,"cited_by_count":13,"doi":"https://doi.org/10.1177/1179173x20921446","domain_tags":["wastewater_and_treatment"],"facet_tags":[],"institution_ids":["I4210137306","I97018004"],"is_oa":true,"journal":"Tobacco Use Insights","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by-nc","needs_review":false,"oa_status":"gold","oa_url":"https://journals.sagepub.com/doi/pdf/10.1177/1179173X20921446","openalex_topics":["T10060","T11944","T11959"],"plastic_related":false,"plastic_tier":"","primary_topic":"T10060","pub_date":"2020-01-01","study_type":"article","title":"Smoking and Unemployment: A Photo Elicitation Project","type":"article","work_id":"W3040523150","year":2020}]}
