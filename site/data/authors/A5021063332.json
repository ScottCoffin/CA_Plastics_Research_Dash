{"author":{"affiliation_history":[{"country_code":"US","id":"I84218800","name":"University of California, Davis","years":[1995,1998,1999,2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2014,2015,2016,2017,2018,2021,2023,2025]},{"country_code":"US","id":"I910567637","name":"St. John Fisher University","years":[2010]},{"country_code":"US","id":"I2803209242","name":"University of California System","years":[2008,2009]},{"country_code":"US","id":"I205783295","name":"Cornell University","years":[2008]},{"country_code":"US","id":"I153901656","name":"University of North Carolina Wilmington","years":[2008]},{"country_code":"US","id":"I191826795","name":"Sacramento City College","years":[2005]},{"country_code":"FR","id":"I1294671590","name":"Centre National de la Recherche Scientifique","years":[2004]},{"country_code":"FR","id":"I4210089824","name":"Centre d'\u00c9cologie Fonctionnelle et \u00c9volutive","years":[2004]},{"country_code":"US","id":"I201448701","name":"University of Washington","years":[1992,1994,1997]},{"country_code":"US","id":"I181233156","name":"University of Oregon","years":[1995]},{"country_code":"US","id":"I4387153569","name":"Friday Harbor Laboratories","years":[1991]},{"country_code":"US","id":"I4405266016","name":"Hopkins Marine Station","years":[1986]}],"author_id":"A5021063332","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":396,"plastic":21,"year":2017},{"all":228,"plastic":26,"year":2018},{"all":237,"plastic":23,"year":2019},{"all":264,"plastic":38,"year":2020},{"all":304,"plastic":41,"year":2021},{"all":282,"plastic":50,"year":2022},{"all":241,"plastic":35,"year":2023},{"all":237,"plastic":42,"year":2024},{"all":350,"plastic":39,"year":2025},{"all":213,"plastic":32,"year":2026}],"cited_by_count":5800,"domain_tags":[],"early_career":false,"first_pub_year":1986,"first_year":2016,"h_index":41,"institution_ids":["I84218800"],"last_year":2016,"m_quotient":1.02,"name":"Gabrielle A. Nevitt","orcid":"https://orcid.org/0000-0002-0346-2126","plastic_basis":"openalex","plastic_citations":349,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I84218800","name":"University of California, Davis","source":"openalex_last_known"}],"rising_pct":12,"rising_score":-0.0105,"work_count":1,"work_ids":["W2549620114"]},"schema_version":"s3.1","works":[{"abstract":"Plastic debris is ingested by hundreds of species of organisms, from zooplankton to baleen whales, but how such a diversity of consumers can mistake plastic for their natural prey is largely unknown. The sensory mechanisms underlying plastic detection and consumption have rarely been examined within the context of sensory signals driving marine food web dynamics. We demonstrate experimentally that marine-seasoned microplastics produce a dimethyl sulfide (DMS) signature that is also a keystone odorant for natural trophic interactions. We further demonstrate a positive relationship between DMS responsiveness and plastic ingestion frequency using procellariiform seabirds as a model taxonomic group. Together, these results suggest that plastic debris emits the scent of a marine infochemical, creating an olfactory trap for susceptible marine wildlife.","author_count":4,"author_ids":["A5021063332","A5049256544","A5058920710","A5074815942"],"author_institution_ids":["I84218800"],"authors":[{"id":"A5074815942","name":"Matthew S. Savoca"},{"id":"A5058920710","name":"Martha Wohlfeil Zillig"},{"id":"A5049256544","name":"Susan E. Ebeler"},{"id":"A5021063332","name":"Gabrielle A. Nevitt"}],"ca_any_author":true,"ca_led":true,"cited_by_count":349,"doi":"https://doi.org/10.1126/sciadv.1600395","domain_tags":["ecotoxicology_and_trophic_transfer","human_exposure_and_health_risk"],"facet_tags":["matrix:food_and_drink","matrix:marine"],"institution_ids":["I84218800"],"is_oa":true,"journal":"Science Advances","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc","needs_review":false,"oa_status":"gold","oa_url":"http