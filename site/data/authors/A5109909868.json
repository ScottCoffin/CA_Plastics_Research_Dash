ll":260,"plastic":0,"year":2024},{"all":232,"plastic":0,"year":2025},{"all":170,"plastic":0,"year":2026}],"cited_by_count":7421,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1970,"first_year":2009,"h_index":46,"institution_ids":["I161318765"],"last_ca_year":2020,"last_year":2009,"m_quotient":0.82,"name":"H. Thomas Hahn","orcid":"","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2024495322"]},"schema_version":"s3.1","works":[{"abstract":"We report the performance and characterization of a material based on poly[(3-mercaptopropyl)methylsiloxane] (PMMS) in various soft lithography applications. PMMS stamps were made by cross-linking with triallyl cyanurate and ethoxylated (4) bisphenol A dimethacrylate via thiol\u2212ene mixed-mode chemistry. The surface chemistry of the materials was characterized by XPS when varied from hydrophilic through oxygen plasma treatment, to hydrophobic by exposure to a fluorinated trichlorosilane agent. The materials are transparent above 300 nm and thermally stable up to 225 \u00b0C, thus rendering them capable to be employed in step-and-flash imprint lithography, nanoimprint lithography, nanotransfer printing, and proximity-field nanopatterning. The successful pattern replication from the micrometer to sub-100 nm scale was demonstrated.","author_count":10,"author_ids":["A5007699390","A5012052318","A5020001579","A5045551635","A5064340656","A5078455808","A5109069954","A5109909868","A5111683427"],"author_institution_ids":["I161318765"],"authors":[{"id":"","name":"Luis M. Campos"},{"id":"A5007699390","name":"Tu T. Truong"},{"id":"A5111683427","name":"Dong Eun Erica Shim"},{"id":"A5078455808","name":"Michael D. Dimitriou"},{"id":"A5020001579","name":"Daniel Jay-Lee Shir"},{"id":"A510