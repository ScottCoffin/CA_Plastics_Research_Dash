,{"all":694,"plastic":0,"year":2021},{"all":716,"plastic":0,"year":2022},{"all":843,"plastic":0,"year":2023},{"all":913,"plastic":0,"year":2024},{"all":751,"plastic":0,"year":2025},{"all":709,"plastic":0,"year":2026}],"cited_by_count":11960,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1975,"first_year":2019,"h_index":53,"institution_ids":["I142207940","I161318765"],"last_ca_year":2026,"last_year":2019,"m_quotient":1.04,"name":"Leonard H. Rome","orcid":"https://orcid.org/0000-0002-1236-2063","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"US","id":"I122411786","name":"California Institute of Technology","source":"openalex_last_known"},{"country_code":"US","id":"I142207940","name":"California NanoSystems Institute","source":"openalex_last_known"},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2914661508"]},"schema_version":"s3.1","works":[{"abstract":"We report an effective and environmentally sustainable water treatment approach using enzymes encapsulated in biogenic vault nanoparticles. Manganese peroxidase (MnP), whose stability was remarkably extended by encapsulating into vaults, rapidly catalyzed the biotransformation of endocrine-disrupting compounds, including bisphenol A (BPA), bisphenol F (BPF), and bisphenol AP (BPAP). The vault-encapsulated MnP (vMnP) treatment removed 80\u201395% of each of the tested bisphenols (BPs) at lower enzyme dosage, while free native MnP (nMnP) only resulted in a 19\u201336% removal, over a 24-h period. Treatment by vMnP and nMnP resulted in considerable disparities in product species and abundance, which were consistent with the observed changes in the estrogenic activities of BPs. To test if vMnP-catalyzed transformations generated toxic intermediates, we assessed biological hallmarks of BP toxicity, namely, the ability to disrupt reproductive processes. The toxicity of vMnP-treated samples, as measured in the model organism, Caenorhabditis elegans, was dramatically reduced for all three BPs, including the reproductive indicators of BPA exposure such as reduced fertility and increased germ cell death. Collectively, our results indicate that the vMnP system represents an efficient and safe approach for the removal of BPs and promise the development of vault-encapsulated customized enzymes for treating other targeted organic compounds in contaminated waters.","author_count":6,"author_ids":["A5006198449","A5018057574","A5062835705","A5090083375","A5090944960","A5101438452"],"author_institution_ids":["I142207940","I161318765"],"authors":[{"id":"A5090944960","name":"Meng Wang"},{"id":"A5101438452","name":"Yi\u2010Chang Chen"},{"id":"A5090083375","name":"Valerie A. Kickhoefer"},{"id":"A5006198449","name":"Leonard H. Rome"},{"id":"A5062835705","name":"Patrick Allard"},{"id":"A5018057574","name":"Shaily Mahendra"}],"ca_any_author":true,"ca_led":true,"cited_by_count":36,"doi":"https://doi.org/10.1021/acssuschemeng.8b05432","domain_tags":["fate_transport_and_sorption","human_exposure_and_health_risk","occurrence_and_monitoring","wastewater_and_treatment"],"facet_tags":[],"institution_ids":["I142207940","I161318765"],"is_oa":true,"journal":"ACS Sustainable Chemistry & Engineering","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"green","oa_url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC9681160/","openalex_topics":["T10210","T10404","T11136"],"plastic_related":true,"plastic_tier":"chemicals-in-plastics","primary_topic":"T11136","pub_date":"2019-02-14","study_type":"article","title":"A Vault-Encapsulated Enzyme Approach for Efficient Degradation and Detoxification of Bisphenol A and Its Analogues","type":"article","work_id":"W2914661508","year":2019}]}
