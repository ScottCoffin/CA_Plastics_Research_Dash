{"author":{"affiliation_history":[{"country_code":"US","id":"I2803209242","name":"University of California System","years":[2026]},{"country_code":"US","id":"I154570441","name":"University of California, Santa Barbara","years":[2022]},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","years":[2017]}],"author_id":"A5014572173","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":1,"plastic":0,"year":2017},{"all":9,"plastic":0,"year":2018},{"all":9,"plastic":1,"year":2019},{"all":11,"plastic":0,"year":2020},{"all":11,"plastic":0,"year":2021},{"all":11,"plastic":0,"year":2022},{"all":6,"plastic":0,"year":2023},{"all":12,"plastic":0,"year":2024},{"all":6,"plastic":1,"year":2025},{"all":5,"plastic":0,"year":2026}],"cited_by_count":81,"current_in_ca":true,"domain_tags":[],"early_career":true,"first_pub_year":2016,"first_year":2022,"h_index":2,"institution_ids":["I154570441"],"last_ca_year":2026,"last_year":2022,"m_quotient":0.2,"name":"Liviu Iancu","orcid":"https://orcid.org/0000-0002-4641-2321","plastic_basis":"openalex","plastic_citations":2,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4205270324"]},"schema_version":"s3.1","works":[{"abstract":"Abstract Tobacco and cannabis product use can result in debris (a.k.a. litter) on the landscape, with implications to soil and water quality and thus potential impacts to ecosystems. More information is needed regarding how much debris exists on the landscape, such that the magnitude of potential associated environment problems can be quantified. Such information can raise awareness in the public about environmental hazards from tobacco and cannabis product use. The goal of this protocol is to quantify, via a timed survey approach, the tobacco and cannabis debris load (i.e. cigarette butts, cannabis or e-cigarette waste) at study sites. Multiple sites in a geographical location may be of interest for comparative analysis, for example sites used regularly by humans (e.g. trails, parking lots, around buildings, garbage cans) versus other sites that are suspected to have low human use. In any case, the same survey data sheet would be used (included with this protocol). Each survey will take 15 minutes per site to conduct. In the process of surveying, debris is collected and retained for later sorting, counting, and photographic documentation. The time to sort and count the collected debris will depend on the quantity and diversity of debris collected.","author_count":17,"author_ids":["A5004697086","A5006257842","A5011570523","A5014572173","A5017717153","A5022348449","A5023539943","A5023645209","A5027222165","A5030364824","A5030741233","A5039024444","A5044303354","A5045735049","A5048919120","A5081141264","A5086625460"],"author_institution_ids":["I154570441"],"authors":[{"id":"A5011570523","name":"Laurie C. Van De Werfhorst"},{"id":"A5023539943","name":"Christopher L. Jerde"},{"id":"A5039024444","name":"Marc W. Beutel"},{"id":"A5030364824","name":"Andrew J. Brooks"},{"id":"A5086625460","name":"Van Butsic"},{"id":"A5048919120","name":"Srimanti Duttagupta"},{"id":"A5027222165","name":"Michelle E. Gilmore"},{"id":"A5030741233","name":"Thomas C. Harmon"},{"id":"A5045735049","name":"Stephen C. Hart"},{"id":"A5023645209","name":"Eunha Hoh"},{"id":"A5014572173","name":"Liviu Iancu"},{"id":"A5006257842","name":"Timnit Kefela"},{"id":"A5081141264","name":"Thomas E. Novotny"},{"id":"A5044303354","name":"Katelyn Nynas"},{"id":"A5017717153","name":"Becca Reynolds"},{"id":"A5022348449","name":"Ariani C. Wartenberg"},{"id":"A5004697086","name":"Patricia Ann Holden"}],"ca_any_author":true,"ca_led":true,"cited_by_count":2,"doi":"https://doi.org/10.21203/rs.3.pex-1719/v1","domain_tags":["soil_and_agriculture"],"facet_tags":["matrix:soil_and_agriculture"],"institution_ids":["I