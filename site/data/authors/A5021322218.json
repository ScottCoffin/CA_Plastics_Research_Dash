":"JP","id":"I874359049","name":"Nippon Paper Industries (Japan)","years":[2009,2010]},{"country_code":"US","id":"I130701444","name":"Georgia Institute of Technology","years":[2009]},{"country_code":"BR","id":"I17974374","name":"Universidade de S\u00e3o Paulo","years":[2009]},{"country_code":"IR","id":"I23946033","name":"University of Tehran","years":[2008]},{"country_code":"JP","id":"I4405264227","name":"Harima Chemicals, Inc. (Japan)","years":[2006]},{"country_code":"US","id":"I16944753","name":"Clarkson University","years":[1985]}],"author_id":"A5021322218","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":495,"plastic":0,"year":2017},{"all":498,"plastic":0,"year":2018},{"all":716,"plastic":0,"year":2019},{"all":896,"plastic":2,"year":2020},{"all":1127,"plastic":12,"year":2021},{"all":1227,"plastic":60,"year":2022},{"all":1231,"plastic":72,"year":2023},{"all":1440,"plastic":122,"year":2024},{"all":1580,"plastic":135,"year":2025},{"all":1486,"plastic":93,"year":2026}],"cited_by_count":13399,"domain_tags":[],"early_career":false,"first_pub_year":1978,"first_year":2020,"h_index":58,"institution_ids":["I137902535","I148283060"],"last_year":2020,"m_quotient":1.21,"name":"Martin Allen Hubbe","orcid":"https://orcid.org/0000-0002-2321-4218","plastic_basis":"openalex","plastic_citations":498,"plastic_works_count":5,"primary_affiliations":[{"country_code":"US","id":"I137902535","name":"North Carolina State University","source":"openalex_last_known"}],"rising_pct":93,"rising_score":0.0253,"work_count":1,"work_ids":["W3102371844"]},"profile":{"bio":"","keywords":["Papermaking science and technology; Wet-end chemistry; Colloids; BioResources editor"],"links":[{"label":"Website:  Opportunities in Wet-End Chemistry","url":"http://www4.ncsu.edu/~hubbe/"}]},"schema_version":"s3.1","works":[{"abstract":"Society\u2019s wish list for future packaging systems is placing some daunting challenges upon researchers: In addition to protecting contents during storage and shipping, the material must not bio-accumulate, and it should be readily recyclable by using practical processing steps. This article considers strategies employing bio-based plastics and reviews published information relative to their performance. Though bioplastics such as poly(lactic acid) (PLA) and poly(hydroxybutyrate) (PHB) can be prepared from plant materials, their default properties are generally inferior to those of popular synthetic plastics. In addition, some bioplastics are not easily decomposed in soil or seawater, and the polymers can undergo chemical breakdown during recycling. This review considers strategies to overcome such challenges, including the use of biodegradable cellulose-based reinforcing particles. In addition to contributing to strength, the cellulose can swell the bioplastic, allowing enzymatic attack. The rate-controlling step in bioplastic degradation also can be abiotic, i.e. not involving enzymes. Though there is much more work to be done, much progress has been achieved in formulating bioplastic composites that are biodegradable, recyclable, and higher in strength compared to the neat polymer. Emphasis in this review is placed on PLA and PHB, but not to the exclusion of other bioplastic matrix materials.","author_count":4,"author_ids":["A5019229507","A5021322218","A5066771968","A5083527126"],"author_institution_ids":["I137902535","I148283060"],"authors":[{"id":"A5021322218","name":"Martin Allen Hubbe"},{"id":"A5083527126","name":"Nathalie Lavoine"},{"id":"A5066771968","name":"Lucian A. Lucia"},{"id":"A5019229507","name":"Chang Dou"}],"ca_any_author":true,"ca_led":true,"cited_by_count":73,"doi":"https://doi.org/10.15376/biores.16.1.hubbe","domain_tags":["fate_transport_and_sorption","soil_and_agriculture"],"facet_tags":["matrix:food_and_drink","matrix:soil_and_agriculture"],"institution_ids":["I137902535","I148283060"],"is_oa":true,"journal":"BioResources","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"gold","oa_url":"https://bioresources.cnr.ncsu.edu/wp-content/uploads/2020/11/BioRes_16_1_2021_Hubbe_LLD_REVIEW_Fomulating_Bioplastic_Composites_Recyc_Performce_18024.pdf","openalex_topics":["T10488","T10513","T10661"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2020-11-01","study_type":"article","title":"Formulating bioplastic composites for biodegradability, recycling, and performance: A Review","type":"article","work_id":"W3102371844","year":2020}]}
