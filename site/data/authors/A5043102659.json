c":0,"year":2025},{"all":294,"plastic":0,"year":2026}],"cited_by_count":4822,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2002,"first_year":2024,"h_index":28,"institution_ids":["I150209017","I160856358"],"last_ca_year":2026,"last_year":2024,"m_quotient":1.17,"name":"Ryan F. Hechinger","orcid":"https://orcid.org/0000-0002-6633-253X","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I150209017","name":"Scripps Institution of Oceanography","source":"openalex_last_known"},{"country_code":"US","id":"I36258959","name":"University of California San Diego","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4400419592"]},"schema_version":"s3.1","works":[{"abstract":"Trophically transmitted parasites, which move from one host to the next through host feeding activities, are subject to direct and indirect stressors within their hosts and the surrounding ecosystem. Infection success can be disrupted by host defenses and environmental conditions that exceed the tolerances of the parasites or their hosts. These interruptions can be caused by various factors, including host-derived antagonists, alterations in the host\u2019s environment, exposure to toxic molecules, and disruption to the host\u2019s microbial communities. Here, we present novel findings on the responses of intestinal helminth infracommunities to stressors associated with shifts in the microbiome due to bacterial infection and under a range of conditions where microplastics were consumed.","author_count":5,"author_ids":["A5017018189","A5027019514","A5043102659","A5066914715"],"author_institution_ids":["I150209017","I160856358"],"authors":[{"id":"A5017018189","name":"Kate L. Sheehan"},{"id":"","name":"Sonja Barber"},{"id":"A5043102659","name":"Ryan F. Hechinger"},{"id":"A5066914715","name":"Brian S. Dorr"},{"id":"A5027019514","name":"Douglas Causey"}],"ca_any_autho