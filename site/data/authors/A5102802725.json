rs":[2011]},{"country_code":"CN","id":"I4210166499","name":"Henan Polytechnic University","years":[2010]},{"country_code":"CN","id":"I119203015","name":"Shandong University of Technology","years":[2009,2010]},{"country_code":"CN","id":"I4800084","name":"Southwest Jiaotong University","years":[2008]},{"country_code":"CN","id":"I4402554004","name":"People's Liberation Army Air Force","years":[2006]}],"author_id":"A5102802725","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":123,"plastic":0,"year":2017},{"all":155,"plastic":0,"year":2018},{"all":144,"plastic":0,"year":2019},{"all":293,"plastic":0,"year":2020},{"all":305,"plastic":0,"year":2021},{"all":395,"plastic":0,"year":2022},{"all":407,"plastic":0,"year":2023},{"all":527,"plastic":0,"year":2024},{"all":623,"plastic":5,"year":2025},{"all":567,"plastic":21,"year":2026}],"cited_by_count":3678,"domain_tags":[],"early_career":false,"first_pub_year":2000,"first_year":2025,"h_index":34,"institution_ids":["I103635307","I859038795"],"last_year":2025,"m_quotient":1.31,"name":"Juhong Chen","orcid":"https://orcid.org/0000-0002-6484-2739","plastic_basis":"openalex","plastic_citations":26,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I103635307","name":"University of California, Riverside","source":"openalex_last_known"},{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"},{"country_code":"US","id":"I859038795","name":"Virginia Tech","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4411937302"]},"schema_version":"s3.1","works":[{"abstract":"Due to its low cost of manufacturing, poly(ethylene terephthalate) (PET, a polyester plastic) has been the most widely used plastic material for food packaging. However, PET is nonbiodegradable. It can take years to degrade when it is discarded into the environment. In recent years, plastic pollution has received much attention and has become a major environmental issue. In this study, we engineered yeast surfaces to display two PET-degrading enzymes (PETase and MHETase) to degrade PET plastics. The enzymes displayed on the yeast surface were characterized by using confocal microscopy and flow cytometry. The reaction conditions to degrade PET plastics using the engineered yeasts were optimal at pH 9 and 30 \u00b0C. In addition, the engineered yeasts showed great stability and reusability to degrade PET films. Furthermore, we demonstrated that the engineered yeasts as whole-cell catalysts can be used to degrade drinking water bottles into value-added products. This study provides a novel whole-cell biocatalyst using engineered yeasts to degrade plastic waste, offering a new strategy to solve plastic pollution and recycling challenges.","author_ids":["A5059839204","A5102802725","A5118787144"],"author_institution_ids":["I103635307","I859038795"],"ca_any_author":true,"ca_led":false,"cited_by_count":26,"doi":"https://doi.org/10.1021/acssynbio.5c00209","domain_tags":["analytical_methods","fate_transport_and_sorption"],"facet_tags":["matrix:food_and_drink"],"institution_ids":["I103635307","I859038795"],"is_oa":true,"journal":"ACS Synthetic Biology","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc-nd","needs_review":false,"oa_status":"hybrid","oa_url":"https://pubs.acs.org/doi/pdf/10.1021/acssynbio.5c00209?ref=article_openPDF","openalex_topics":["T10404","T10661","T11617"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10404","pub_date":"2025-07-02","study_type":"article","title":"Engineered Yeasts Displaying PETase and MHETase as Whole-Cell Biocatalysts for the Degradation of Polyethylene Terephthalate (PET)","type":"article","work_id":"W4411937302","year":2025}]}
