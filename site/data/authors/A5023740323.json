{"author":{"affiliation_history":[{"country_code":"US","id":"I2803209242","name":"University of California System","years":[2010,2011,2026]},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","years":[2000,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026]},{"country_code":"CN","id":"I20231570","name":"Peking University","years":[2016]},{"country_code":"CN","id":"I4210128533","name":"State Key Joint Laboratory of Environment Simulation and Pollution Control","years":[2016]},{"country_code":"US","id":"I201448701","name":"University of Washington","years":[2013]},{"country_code":"US","id":"I4210091812","name":"Bristol-Myers Squibb (United States)","years":[2011]},{"country_code":"US","id":"I2799798094","name":"UCLA Health","years":[2010]},{"country_code":"US","id":"I87216513","name":"Michigan State University","years":[2008]},{"country_code":"US","id":"I204250578","name":"University of California, Irvine","years":[2008]},{"country_code":"US","id":"I1174212","name":"University of Southern California","years":[2008]},{"country_code":"US","id":"I4390039250","name":"UAB Medicine","years":[2007]},{"country_code":"US","id":"I32389192","name":"University of Alabama at Birmingham","years":[2007]},{"country_code":"VE","id":"I191242182","name":"Instituto Venezolano de Investigaciones Cient\u00edficas","years":[1995]}],"author_id":"A5023740323","ca_plastic_works_count":2,"ca_works_count":2,"citations_by_year":[{"all":291,"plastic":0,"year":2017},{"all":282,"plastic":0,"year":2018},{"all":370,"plastic":0,"year":2019},{"all":454,"plastic":0,"year":2020},{"all":458,"plastic":0,"year":2021},{"all":446,"plastic":0,"year":2022},{"all":397,"plastic":0,"year":2023},{"all":389,"plastic":0,"year":2024},{"all":395,"plastic":0,"year":2025},{"all":290,"plastic":0,"year":2026}],"cited_by_count":5589,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1994,"first_year":2020,"h_index":33,"institution_ids":["I161318765"],"last_ca_year":2026,"last_year":2022,"m_quotient":1.03,"name":"Jes\u00fas A. Araujo","orcid":"https://orcid.org/0000-0001-8279-8922","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"},{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":2,"work_ids":["W3021568610","W4212857146"]},"schema_version":"s3.1","works":[{"abstract":"Recent studies suggested a significant downward trend in population's exposure to bisphenol A (BPA) in the United States. However, the temporal trend of BPA exposure remains unclear in China - a populous country with substantial industrial activities but less efforts made to phase out BPA in consumer products. In addition, it is unclear to what extent a visit from the United States to China could affect human exposure to BPA. In this natural experiment, we measured the concentration of total BPA in 418 urine samples repeatedly collected from 55 Los Angeles residents before, during, and after they spent 10 weeks in Beijing from 2012 to 2017. We found that traveling from Los Angeles to Beijing led to a 2.91-fold (95% CI: 2.43 to 3.50) increase in urinary BPA levels, which fully returned to baseline after study participants came back to Los Angeles. From 2012 to 2017, urinary BPA concentrations decreased in Los Angeles by 25.5% per year (95% CI: -30.8% to -19.8%; p < 0.001) but did not change in Beijing (p = 0.24). Consequently, the concentration ratio of urinary BPA between Beijing and Los Angeles increased from 1.23 (95% CI: 0.82 to 1.85) in 2012 to 4.05 (95% CI: 2.75 to 5.97) in 2017. These results indicate that BPA exposures may increase among international travelers to China. Additional efforts are needed to reduce population's exposure to BPA in China.","author_count":7,"author_ids":["A5023740323","A5027897053","A5032472429","A5048307710","A5055483615","A5062835705"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5048307710","name":"Yan Lin"},{"id":"A5032472429","name":"Xinghua Qiu"},{"id":"","name":"Jinming Liu"},{"id":"A5055483615","name":"Chi\u2010Hong Tseng"},{"id":"A5062835705","name":"Patrick Allard"},{"id":"A5023740323","name":"Jes\u00fas A. Araujo"},{"id":"A5027897053","name":"Yifang Zhu"}],"ca_any_author":true,"ca_led":true,"cited_by_count":20,"doi":"https://doi.org/10.1016/j.envint.2020.105758","domain_tags":["human_exposure_and_health_risk","plastic_associated_chemicals"],"facet_tags":[],"institution_ids":["I161318765","I20231570","I4210128533"],"is_oa":true,"journal":"Environment International","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://www.sciencedirect.com/science/article/pii/S0160412020306784/pdf","openalex_topics":["T10122","T10686","T14393"],"plastic_related":true,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10686","pub_date":"2020-05-08","study_type":"article","title":"Different temporal trends of exposure to Bisphenol A among international travelers between Los Angeles and Beijing","type":"article","work_id":"W3021568610","year":2020},{"abstract":"","author_count":8,"author_ids":["A5023740323","A5027897053","A5032472429","A5048307710","A5087349635","A5100445951","A5100676696","A5110916702"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5110916702","name":"Xinchen Lu"},{"id":"A5048307710","name":"Yan Lin"},{"id":"A5032472429","name":"Xinghua Qiu"},{"id":"A5100676696","name":"Jinming Liu"},{"id":"A5100445951","name":"Tong Zhu"},{"id":"A5023740323","name":"Jes\u00fas A. Araujo"},{"id":"A5087349635","name":"Oliver Fiehn"},{"id":"A5027897053","name":"Yifang Zhu"}],"ca_any_author":true,"ca_led":false,"cited_by_count":8,"doi":"https://doi.org/10.1016/j.scitotenv.2022.153991","domain_tags":["plastic_associated_chemicals"],"facet_tags":[],"institution_ids":["I161318765","I20231570","I4210128533","I84218800"],"is_oa":true,"journal":"The Science of The Total Environment","last_updated":"2026-11-11T12:16:26.678958","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://www.sciencedirect.com/science/article/am/pii/S004896972201083X","openalex_topics":["T10122","T10686","T14393"],"plastic_related":true,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10686","pub_date":"2022-02-19","study_type":"article","title":"Triglyceride profiles are associated with subacute exposure to bisphenol A in healthy young adults","type":"article","work_id":"W4212857146","year":2022}]}
