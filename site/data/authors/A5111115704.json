{"author":{"affiliation_history":[{"country_code":"US","id":"I84218800","name":"University of California, Davis","years":[2024,2025,2026]}],"author_id":"A5111115704","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":1,"plastic":0,"year":2024},{"all":2,"plastic":1,"year":2025},{"all":3,"plastic":0,"year":2026}],"cited_by_count":6,"current_in_ca":true,"domain_tags":[],"early_career":true,"first_pub_year":2024,"first_year":2025,"h_index":1,"institution_ids":["I84218800"],"last_ca_year":2026,"last_year":2025,"m_quotient":0.5,"name":"Amy L. Parkhurst","orcid":"","plastic_basis":"openalex","plastic_citations":1,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I84218800","name":"University of California, Davis","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4410869716"]},"schema_version":"s3.1","works":[{"abstract":"Objectives: Microplastics (MP) and nanoplastics (NP) are a growing health concern globally. Microplastics (MP) have emerged as environmental pollutant due to the risks they pose to both wildlife and human health. The breakdown of plastics leads to the formation of high amounts of MPs and NPs. This has led to animal consumption within their natural environments, accumulating up the food chain. MPs and NPs can further be consumed through contamination during food production and leaching from packaging surrounding food and drinks.","author_count":3,"author_ids":["A5038061178","A5065221882","A5111115704"],"author_institution_ids":["I84218800"],"authors":[{"id":"A5111115704","name":"Amy L. Parkhurst"},{"id":"A5038061178","name":"Ming-Fo Hsu"},{"id":"A5065221882","name":"Fawaz G. Haj"}],"ca_any_author":true,"ca_led":true,"cited_by_count":1,"doi":"https://doi.org/10.1016/j.cdnut.2025.106121","domain_tags":[],"facet_tags":["matrix:food_and_drink"],"institution_ids":["I84218800"],"is_oa":true,"journal":"Current Developments in Nutrition","last_updated":"2026-09-22T06:5