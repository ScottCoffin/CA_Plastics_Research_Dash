stic":0,"year":2022},{"all":133,"plastic":0,"year":2023},{"all":200,"plastic":0,"year":2024},{"all":302,"plastic":0,"year":2025},{"all":430,"plastic":2,"year":2026}],"cited_by_count":1291,"domain_tags":[],"early_career":false,"first_pub_year":2014,"first_year":2025,"h_index":21,"institution_ids":["I161318765"],"last_year":2025,"m_quotient":1.75,"name":"Tianyu Wang","orcid":"https://orcid.org/0000-0002-8738-9869","plastic_basis":"openalex","plastic_citations":2,"plastic_works_count":1,"primary_affiliations":[{"country_code":"CN","id":"I106994412","name":"Sinopec (China)","source":"openalex_last_known"},{"country_code":"CN","id":"I1327237609","name":"Ministry of Education of the People's Republic of China","source":"openalex_last_known"},{"country_code":"CN","id":"I154099455","name":"Shandong University","source":"openalex_last_known"},{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"},{"country_code":"CN","id":"I4210143193","name":"Beijing Vaccum Electronic Research Institute","source":"openalex_last_known"},{"country_code":"CN","id":"I87445476","name":"Xi'an Jiaotong University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4410950174"]},"schema_version":"s3.1","works":[{"abstract":"Polyethylene (PE) constitutes a significant portion of plastic waste, representing approximately 30% of nondegradable plastics. Efficiently utilizing waste PE is essential to address plastic pollution. This study proposed the thermal decomposition of powdered PE using atmospheric microwave plasmas, with processing time under 1 s. Gas temperature was measured in the plasma using optical emission spectroscopy (OES) method as 4780 K. The scanning electron microscopy (SEM) and transmission electron microscopy (TEM) were utilized to examine the surface morphology of the products, which indicated that the average size of the nanoparticles produced was$29~\\pm ~0.58$nm, with the majority of particles having a diameter below 50 nm. The X-ray diffraction (XRD) and Raman spectroscopy confirmed the formation of few-layer graphene within the reaction products ($\\leq 5$layers). Based on the characterization results, the reaction mechanism was subsequently analyzed. The experimental results indicate that microwave plasma thermal decomposition can convert PE solid material into carbon nanomaterials under atmospheric pressure in an ultrafast, one-step process, offering new possibilities for large-scale industrial preparation of graphene materials and PE waste treatment.","author_ids":["A5074288833","A5078995248","A5090849386","A5100417431","A5100627957"],"author_institution_ids":["I161318765"],"ca_any_author":true,"ca_led":false,"cited_by_count":2,"doi":"https://doi.org/10.1109/tps.2025.3562889","domain_tags":["analytical_methods","wastewater_and_treatment"],"facet_tags":[],"institution_ids":["I161318765","I17442442","I99065089"],"is_oa":false,"journal":"IEEE Transactions on Plasma Science","last_updated":"2026-10-16T09:59:22.235173","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1109/tps.2025.3562889","openalex_topics":["T10083","T10642","T12270"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10642","pub_date":"2025-06-02","study_type":"article","title":"Thermal Decomposition of Polyethylene for Carbon Nanomaterials Synthesis via Atmospheric-Pressure Microwave Plasmas","type":"article","work_id":"W4410950174","year":2025}]}
