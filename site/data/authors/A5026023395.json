"A5013880253","name":"Diana Lin"},{"id":"A5056917873","name":"Alicia N. Gilbreath"},{"id":"A5041615522","name":"Elisabeth S. R\u00f8dland"},{"id":"A5015823765","name":"Win Cowger"},{"id":"A5116868045","name":"Hazel Vaquero"},{"id":"A5140184435","name":"Andrea Amend"},{"id":"A5037157725","name":"Rebecca Sutton"}],"ca_any_author":true,"ca_led":true,"cited_by_count":4,"doi":"https://doi.org/10.1039/d6ew00232c","domain_tags":["wastewater_and_treatment"],"facet_tags":["matrix:freshwater","matrix:wastewater"],"institution_ids":["I201448701","I2802939387","I4210086075","I4210111001","I4210150356"],"is_oa":true,"journal":"Environmental Science Water Research & Technology","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by-nc","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1039/d6ew00232c","openalex_topics":["T10419","T11119","T11781"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T11119","pub_date":"2026-01-01","study_type":"article","title":"Load and concentration based performance outcomes for emerging organic contaminants in bioretention stormwater treatment systems","type":"article","work_id":"W7167644354","year":2026},{"abstract":"Abstract Rivers act as both major pathways for marine plastic pollution and as important features for the storage and burial of plastic pollution. To better understand plastic emissions from watersheds to the ocean, we measured retention and remobilization of floating plastic bottles in rivers using Global Positioning System (GPS) tracking across 30 river reaches in 7 coastal watersheds throughout the United States and southern Canada. Movement data revealed that mobilization events and travel distances were related to river discharge, reach geomorphology, and upstream land cover. Bottles moved an average of 6.1 km (min. 73 m, max. 53.5 km) over a mean deployment period of 87 days. Bottle mobilization events were related to specific stream power and the time a bottle remained lodged prior to a high-flow event. Mobilization distance increased with discharge, decreased with forest cover, and increased with urban cover (all with p < 0.001). A probabilistic model estimated that 50% of bottles that reach the ocean or the Great Lakes in any given year originated from more than 15.7( \u00b1 0.8) km inland and up to 200 km. Our results suggest that cleanups and efforts to prevent plastic pollution from entering urban rivers in coastal watersheds are vital to help curb ever-increasing marine plastic pollution.","author_count":16,"author_ids":["A5000551075","A5015823765","A5026023395","A5031423229","A5056917873","A5060724374","A5061178374","A5062818371","A5067061434","A5078225497","A5079457441","A5086257126","A5124120606","A5128232577","A5147868681","A5160181012"],"author_institution_ids":["I4210111001"],"authors":[{"id":"A5067061434","name":"Shan Zuidema"},{"id":"A5000551075","name":"Hannah De Frond"},{"id":"A5086257126","name":"W. M. Wollheim"},{"id":"A5128232577","name":"Suraj Subrahmanyan"},{"id":"A5031423229","name":"Chelsea M. Rochman"},{"id":"A5160181012","name":"Jessie R. Ribera"},{"id":"A5147868681","name":"Ritvik Manicka"},{"id":"A5061178374","name":"Richard B. Lammers"},{"id":"A5062818371","name":"John S. Kominoski"},{"id":"A5060724374","name":"Timothy J. Hoellein"},{"id":"A5124120606","name":"Jacob Haney"},{"id":"A5078225497","name":"Rebecca L. Hale"},{"id":"A5056917873","name":"Alicia N. Gilbreath"},{"id":"A5026023395","name":"Jennifer A. Dougherty"},{"id":"A5015823765","name":"Win Cowger"},{"id":"A5079457441","name":"Britta R. Baechler"}],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"https://doi.org/10.1021/acsestwater.6c00604","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:freshwater","matrix:marine"],"institution_ids":["I1174212","I151746483","I161057412","I169521973","I185261750","I1925986","I19700959","I2801250486","I4210111001","I52218309"],"is_oa":false,"journal":"ACS ES&T Water","last_updated":"2026-11-01T11: