t8s64r20x.pdf?t=rxn4js","openalex_topics":["T10419","T10753","T14179"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2023-05-25","study_type":"review","title":"Microplastic pollution characteristics and its future perspectives in the Tibetan Plateau","type":"review","work_id":"W4378190671","year":2023},{"abstract":"","author_ids":["A5001920708","A5011805813","A5039537374","A5044274879","A5062325279","A5100370653","A5100717842","A5100737340","A5103969144","A5108062674"],"ca_any_author":true,"ca_led":false,"cited_by_count":86,"doi":"https://doi.org/10.1016/j.jhazmat.2023.133177","domain_tags":["air"],"facet_tags":["matrix:air"],"institution_ids":["I146620803","I19820366","I27781120","I4210160793","I84218800"],"is_oa":true,"journal":"Journal of Hazardous Materials","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"green","oa_url":"https://escholarship.org/content/qt39w041z7/qt39w041z7.pdf","openalex_topics":["T10122","T10419","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2023-12-05","study_type":"article","title":"Airborne microplastics in urban, rural and wildland environments on the Tibetan Plateau","type":"article","work_id":"W4389340784","year":2023},{"abstract":"","author_ids":["A5011805813","A5039537374","A5060319514","A5100370653","A5100458050","A5100717842","A5100737340","A5103969144","A5107996758","A5108062674","A5113091488"],"ca_any_author":true,"ca_led":false,"cited_by_count":142,"doi":"https://doi.org/10.1016/j.jhazmat.2023.133412","domain_tags":["air","occurrence_and_monitoring","risk_assessment"],"facet_tags":["matrix:air"],"institution_ids":["I27781120","I84218800"],"is_oa":true,"journal":"Journal of Hazardous Materials","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"green","oa_url":"https://escholarship.org/content/qt6718h21g/qt6718h21g.pdf","openalex_topics":["T10190","T10419","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2024-01-08","study_type":"review","title":"Micro- and nano-plastics in the atmosphere: A review of occurrence, properties and human health risks","type":"review","work_id":"W4390685570","year":2024},{"abstract":"The discovery of micro/nanoplastics (MNPs) in the human circulatory system raises great health concerns. It is generally believed the in vivo transport and fate of MNPs are size dependent regulated by various physiological barriers, but recently, increasing reports of MNP accumulation in the brain or excreted through urine challenges this knowledge. Herein, the biodistribution, relocation, and excretion of intravenously administered MNPs were quantitatively traced in female rats for 3 months based on mass balance assessment using europium-doped polystyrene MNPs. With an overall recovery \u223c90%, MNPs were mainly found in liver and spleen but seldom in brain and heart, indicating in vivo MNP transport follows classical size-dependent rules. Muscles with low concentrations of MNPs become the second largest long-term sink after the liver due to their high overall mass within the body. Dose-dependent accumulation was observed in RES (reticuloendothelial system) organs, while similar concentrations in low- and high-dose treatments imply a low maximum accumulation for MNP in the heart and brain. Although only minor toxicity effects were observed, just \u223c80% of 77 nm and \u223c15% of 300 and 2000 nm MNPs were exclusively excreted through feces, mostly in the first 3 weeks following a growth-curve pattern, thereby demonstrating long-term accumulation and potential health concerns.","author_ids":["A5039537374","A5061968975","A5069464955","A5100458050","A5100737340","A5100744933","A5103969144","A5108062674","A5113091488","A5124312825","A5125239481","A5128055218","A5128059438","A5128066204","A5140744822"],"ca_any_author":true,"ca_led":false,"cited_by_count":4,"doi":"https://doi.org/10.1021/acs.est.5c18689","domain_tags":["fate_transport_and_sorption","occurrence_and_monitoring","wastewater_and_treatment"],"facet_tags":[],"institution_ids":["I27781120","I2803209242","I3133055985","I4210148790","I4210162457"],"is_oa":false,"journal":"Environmental Science & Technology","last_updated":"2026-11-06T12:05:46.655746","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.est.5c18689","openalex_topics":["T10079","T10419","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-03-04","study_type":"article","title":"Mass Balance Tracing of In Vivo Biodistribution, Relocation, and Excretion of Europium-Doped Micro/Nanoplastics in Rats","type":"article","work_id":"W7133510488","year":2026}]}
