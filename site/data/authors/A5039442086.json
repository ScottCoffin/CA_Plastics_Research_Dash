_by_count":13,"doi":"https://doi.org/10.1016/j.apcatb.2023.122991","domain_tags":[],"facet_tags":[],"institution_ids":["I122411786","I155781252","I2800102766","I95457486"],"is_oa":true,"journal":"Applied Catalysis B: Environmental","last_updated":"2026-11-11T12:16:26.678958","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://www.sciencedirect.com/science/article/am/pii/S0926337323006343","openalex_topics":["T10088","T10353","T11009"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10353","pub_date":"2023-06-12","study_type":"article","title":"H-ZSM-5 Catalysts for the catalytic upcycling of polypropylene glycol","type":"article","work_id":"W4380357527","year":2023},{"abstract":"Multi-scale upcycling of PPG polymer synthesizes propionaldehyde in 95% selectivity & 86% yield.","author_count":11,"author_ids":["A5001705651","A5039379015","A5039442086","A5043668343","A5045044600","A5066549311","A5069459050","A5077106676","A5079400136","A5087892496","A5100652667"],"author_institution_ids":["I122411786"],"authors":[{"id":"A5077106676","name":"Abraham Martinez"},{"id":"A5045044600","name":"Kanan Shikhaliyev"},{"id":"A5100652667","name":"Xuemin Li"},{"id":"A5001705651","name":"Jinyi Han"},{"id":"A5043668343","name":"Kaustav Chaudhuri"},{"id":"A5039442086","name":"Son\u2010Jong Hwang"},{"id":"A5079400136","name":"Jagoda M. Urban-Klaehn"},{"id":"A5087892496","name":"A. Kuperman"},{"id":"A5066549311","name":"Anne M. Gaffney"},{"id":"A5039379015","name":"Jochen A. Lauterbach"},{"id":"A5069459050","name":"Alexander Katz"}],"ca_any_author":true,"ca_led":true,"cited_by_count":2,"doi":"https://doi.org/10.1039/d4re00001c","domain_tags":[],"facet_tags":[],"institution_ids":["I122411786","I155781252","I2800102766","I4210118014","I95457486"],"is_oa":true,"journal":"Reaction Chemistry & Engineering","last_updated":"2026-10-01T08:54:57.152042","license":"","needs_review":false,"oa_status":"bronze","oa_url":"https://pubs.rsc.org/en/content/articlepdf/2024/re/d4re00001c","openalex_topics":["T10353","T11009","T11831"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10353","pub_date":"2024-01-01","study_type":"article","title":"A multiscale investigation of polypropylene glycol polymer upcycling to propionaldehyde via catalytic cracking on acid sites of mesoporous Y zeolites","type":"article","work_id":"W4400201002","year":2024},{"abstract":"Mesoporous Y (Meso-Y) zeolites are an emerging class of catalysts with mesopores (typically smaller than 9 nm in diameter) for accommodating sterically bulky reactant molecules, such as those commonly encountered in biomass and polymer waste upcycling. Here, in this manuscript, we report the synthesis, physicochemical characterization, and catalysis of novel Meso-Y zeolites consisting of tunable mesopores ranging from 9 to 20 nm in diameter and mesopore volumes of approximately 0.6 cm 3 /g. Our synthetic approach involves partial dissolution of the zeolite framework and zinc redistribution during calcination and hydrothermal treatment (HT) of conventional Meso-Y zeolites. The synthesis proceeds through an intermediate zinc-rich zincoaluminosilicate (ZnAlSi) phase, which was characterized by scanning electron microscopy\u2013energy-dispersive X-ray spectroscopy (SEM-EDX) before HT as a phase partially separated from the zeolite in syntheses involving high zinc concentrations. SEM-EDX characterization of these materials after HT demonstrates large mesopores, accompanied by zinc levels redistributing to the same uniformly low values throughout the material. Data from SEM, scanning transmission electron microscopy\u2013energy-dispersive X-ray spectroscopy (STEM-EDS), and high-angle annular dark-field\u2013scanning transmission electron microscopy (HAADF-STEM) show the synthesis of large mesopores after HT within the zeolite. H/D exchange and n -decane hydroconversion data prove acid-site accessibility in our catalysts under thermodynamically and kinetically controlled conditions, respectively, which is similar to a conventional Meso-Y control catalyst.","author_count":13,"author_ids":["A5001705651","A5004773300","A5018333095","A5023656083","A5039442086","A5043668343","A5069459050","A5071006382","A5077106676","A5087892496","A5100600696","A5100652667"],"author_institution_ids":["I122411786"],"authors":[{"id":"A5100652667","name":"Xuemin Li"},{"id":"A5004773300","name":"Oleksandr O. Trybrat"},{"id":"A5077106676","name":"Abraham Martinez"},{"id":"A5001705651","name":"Jinyi Han"},{"id":"A5043668343","name":"Kaustav Chaudhuri"},{"id":"A5100600696","name":"Yi-Sheng Chen"},{"id":"A5023656083","name":"Cong-Yan Chen"},{"id":"","name":"Michael Girgis"},{"id":"A5018333095","name":"Joel E. Schmidt"},{"id":"A5071006382","name":"Howard S. Lacheen"},{"id":"A5087892496","name":"A. Kuperman"},{"id":"A5039442086","name":"Son\u2010Jong Hwang"},{"id":"A5069459050","name":"Alexander Katz"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.1021/acs.chemmater.5c02486","domain_tags":["analytical_methods","wastewater_and_treatment"],"facet_tags":[],"institution_ids":["I122411786","I2803209242","I4210118014","I95457486"],"is_oa":false,"journal":"Chemistry of Materials","last_updated":"2026-10-28T10:33:24.094632","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.chemmater.5c02486","openalex_topics":["T10096","T10353","T10735"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10353","pub_date":"2025-11-11","study_type":"article","title":"Large-Mesopore Catalysts Synthesized via Calcination and Hydrothermal Treatment of Zinc-Meso-Y Zeolite Composites","type":"article","work_id":"W4416674436","year":2025}]}
