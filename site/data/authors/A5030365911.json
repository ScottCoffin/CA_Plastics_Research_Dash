ywords":["Aerosol","Air pollution","Air quality","Nanoparticle emissions"],"links":[{"label":"Home page","url":"http://www.engr.ucr.edu/~heejung"}]},"schema_version":"s3.1","works":[{"abstract":"","author_count":15,"author_ids":["A5000368149","A5005697276","A5024945494","A5026935353","A5030365911","A5048570462","A5054560749","A5060500732","A5069632856","A5070324997","A5072628153","A5086087395","A5088747461","A5100766770","A5102438288"],"author_institution_ids":["I103635307"],"authors":[{"id":"A5102438288","name":"Brenda Lopez"},{"id":"A5086087395","name":"Xiaoliang Wang"},{"id":"A5054560749","name":"L.\u2010W. Antony Chen"},{"id":"A5069632856","name":"Tianyi Ma"},{"id":"A5060500732","name":"David Mendez-Jimenez"},{"id":"A5026935353","name":"Ling Cui Cobb"},{"id":"A5024945494","name":"Chas Frederickson"},{"id":"A5088747461","name":"Ting Fang"},{"id":"A5000368149","name":"Brian C. H. Hwang"},{"id":"A5070324997","name":"Manabu Shiraiwa"},{"id":"A5048570462","name":"Minhan Park"},{"id":"A5100766770","name":"Kihong Park"},{"id":"A5072628153","name":"Qi Yao"},{"id":"A5005697276","name":"Seungju Yoon"},{"id":"A5030365911","name":"Heejung Jung"}],"ca_any_author":true,"ca_led":true,"cited_by_count":96,"doi":"https://doi.org/10.1016/j.scitotenv.2023.163561","domain_tags":["air"],"facet_tags":["matrix:air"],"institution_ids":["I103635307","I1316958739","I133999245","I204250578","I39534123","I4405261251","I60138030"],"is_oa":true,"journal":"The Science of The Total Environment","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"green","oa_url":"https://doi.org/10.2139/ssrn.4293042","openalex_topics":["T10075","T10190","T12095"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10075","pub_date":"2022-01-01","study_type":"article","title":"Metal Contents and Size Distributions of Brake and Tire Wear Particles Dispersed in the Near-Road Environment","type":"article","work_id":"W4366779372","year":2022},{"abstract":"","author_count":10,"author_ids":["A5005697276","A5006183071","A5023666453","A5030365911","A5054560749","A5058031354","A5060202803","A5072628153","A5086087395","A5102438288"],"author_institution_ids":["I103635307","I4405281303"],"authors":[{"id":"A5054560749","name":"L.\u2010W. Antony Chen"},{"id":"A5086087395","name":"Xiaoliang Wang"},{"id":"A5102438288","name":"Brenda Lopez"},{"id":"A5006183071","name":"Guoyuan Wu"},{"id":"A5058031354","name":"Steven Sai Hang Ho"},{"id":"A5060202803","name":"Judith C. Chow"},{"id":"A5023666453","name":"John G. Watson"},{"id":"A5072628153","name":"Qi Yao"},{"id":"A5005697276","name":"Seungju Yoon"},{"id":"A5030365911","name":"Heejung Jung"}],"ca_any_author":true,"ca_led":false,"cited_by_count":31,"doi":"https://doi.org/10.1016/j.envpol.2023.122283","domain_tags":["air"],"facet_tags":["matrix:air"],"institution_ids":["I103635307","I1316958739","I133999245","I4405281303","I60138030"],"is_oa":false,"journal":"Environmental Pollution","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.envpol.2023.122283","openalex_topics":["T10075","T10190","T12095"],"plastic_related":false,"plastic_tier":"","primary_topic":"T10075","pub_date":"2023-07-28","study_type":"article","title":"Contributions of non-tailpipe emissions to near-road PM2.5 and PM10: A chemical mass balance study","type":"article","work_id":"W4385337261","year":2023},{"abstract":"BACKGROUND AND AIM: Highway emissions are large contributors to particulate matter exposures. METHOD: PM2.5 and PM10 filter samples were collected upwind and downwind of two southern California highways and analyzed for phthalates, potentially toxic metals, ions, organic and elemental carbon, polycyclic aromatic hydrocarbons (PAHs), and marker species for source apportionment. Source samples of road dusts, brake dusts, and tire dusts were also obtained, suspended, sampled onto filters through size selective inlets, and analyzed for the same components. RESULTS: Phthalate concentrations were as high as 4 \u00b5g/m3 and were dominated by bis(2-ethylhexyl)phthalate (DEHP) followed by di-n-octyl phthalate (DnBP); these are plasticizing agents used in some tire manufacturing. Average PAH concentrations ranged from 5.1 to 8.6 \u00b5g/m3 and were dominated by engine exhaust contributions. Brake pads contained potentially toxic metals such as copper, zinc, barium and lead and were enriched in ambient air near the highways. PM2.5 and PM10 mass concentrations averaged 10-15 and ~30 \u00b5g/m3, respectively. The most abundant PM2.5 components were: organic matter (OM; ~30\u201340%), mineral dust (~25\u201330%), and elemental carbon (EC; ~10\u201315%). For PM10, mineral dust (~40\u201345%), OM (~25%), nitrate (~6-11%), and EC (6-8%) were the dominant component. High correlations were found for elements with common sources, such as markers for brake wear and road dust. CONCLUSIONS: On average, contributions from non-tailpipe fractions (brake and tire wear) to PM2.5 exceeded those of tailpipe fractions (diesel and gasoline emissions) at one of the highways (~30% vs. 20%) while they were comparable at another highway that experienced twice the diesel traffic (15\u201317% vs. 15\u201319%). For PM10, non-tailpipe contributions were 2 \u2013 3 times the tailpipe contributions. Brake wear particles were more abundant than tire wear particles, though there was a higher uncertainty in the tire wear contribution estimates.","author_count":7,"author_ids":["A5019812798","A5023666453","A5030365911","A5054560749","A5058031354","A5060202803","A5086087395"],"author_institution_ids":["I103635307"],"authors":[{"id":"A5023666453","name":"John G. Watson"},{"id":"A5086087395","name":"Xiaoliang Wang"},{"id":"A5060202803","name":"Judith C. Chow"},{"id":"A5019812798","name":"Steven D. Kohl"},{"id":"A5058031354","name":"Steven Sai Hang Ho"},{"id":"A5030365911","name":"Heejung Jung"},{"id":"A5054560749","name":"L.\u2010W. Antony Chen"}],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"https://doi.org/10.1289/isee.2023.ep-079","domain_tags":["air","human_exposure_and_health_risk"],"facet_tags":["matrix:air"],"institution_ids":["I103635307","I133999245","I60138030"],"is_oa":true,"journal":"ISEE Conference Abstracts","last_updated":"2026-09-24T07:57:37.273135","license":"public-domain","needs_review":false,"oa_status":"diamond","oa_url":"https://doi.org/10.1289/isee.2023.ep-079","openalex_topics":["T10075","T10122","T10190"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10075","pub_date":"2023-09-17","study_type":"conference-abstract","title":"Particulate matter phthalate, polycyclic aromatic hydrocarbons, and toxic metal concentrations in tailpipe and non-tailpipe emissions near highways","type":"conference-abstract","work_id":"W4390993962","year":2023}]}
