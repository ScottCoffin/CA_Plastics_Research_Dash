{"author":{"affiliation_history":[{"country_code":"US","id":"I86519309","name":"The University of Texas at Austin","years":[2020,2021,2022,2023,2024,2025,2026]},{"country_code":"US","id":"I97018004","name":"Stanford University","years":[2024,2025]},{"country_code":"US","id":"I130769515","name":"Pennsylvania State University","years":[2018,2019,2020]}],"author_id":"A5055475446","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":0,"plastic":0,"year":2018},{"all":3,"plastic":0,"year":2019},{"all":21,"plastic":0,"year":2020},{"all":45,"plastic":0,"year":2021},{"all":57,"plastic":0,"year":2022},{"all":67,"plastic":0,"year":2023},{"all":110,"plastic":0,"year":2024},{"all":117,"plastic":0,"year":2025},{"all":122,"plastic":1,"year":2026}],"cited_by_count":542,"current_in_ca":false,"domain_tags":[],"early_career":true,"first_pub_year":2018,"first_year":2025,"h_index":14,"institution_ids":["I97018004"],"last_ca_year":2025,"last_year":2025,"m_quotient":1.75,"name":"Laxmicharan Samineni","orcid":"https://orcid.org/0000-0001-9792-0994","plastic_basis":"openalex","plastic_citations":1,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I86519309","name":"The University of Texas at Austin","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4406033327"]},"schema_version":"s3.1","works":[{"abstract":"Nanoparticles (NPs) are present in the environment because of the widespread use of engineered nanomaterials and the breakdown of plastic waste. NPs can negatively impact human health, and water treatment plants lack treatment trains that are optimized for NP removal. Thus, there is a crucial need for a low-cost, effective NP removal technology. We fabricated a low-cost filter using diatomaceous earth (DE) and cationic proteins extracted from Moringa oleifera (MO) seeds. These filters achieve 4.9 log removal of a palladium-doped plastic NP and greater than 2.9 log removal of silver NPs and polystyrene latex particles. Moringa protein-functionalized filters can be utilized to remove NPs in a variety of applications such as for point-of-use drinking water treatment, washing machine effluent filtration, or municipal water treatment.","author_count":12,"author_ids":["A5000175833","A5008646321","A5015402706","A5023545826","A5025924711","A5055475446","A5056149629","A5066320776","A5077085087","A5077813936","A5088631926","A5115757294"],"author_institution_ids":["I97018004"],"authors":[{"id":"A5000175833","name":"Sophie De Respino"},{"id":"A5115757294","name":"Shaina Field-Farias"},{"id":"A5023545826","name":"Harekrushna Behera"},{"id":"A5008646321","name":"Hyeonji Oh"},{"id":"A5056149629","name":"Lettie A. Smith"},{"id":"A5025924711","name":"Hugh C. Daigle"},{"id":"A5066320776","name":"Xun Zhan"},{"id":"A5015402706","name":"Jiho Kang"},{"id":"A5055475446","name":"Laxmicharan Samineni"},{"id":"A5077085087","name":"Delia J. Milliron"},{"id":"A5077813936","name":"Charles Buddie Mullins"},{"id":"A5088631926","name":"Manish Kumar"}],"ca_any_author":true,"ca_led":false,"cited_by_count":1,"doi":"https://doi.org/10.1021/acsestwater.4c00753","domain_tags":["soil_and_agriculture","wastewater_and_treatment"],"facet_tags":["matrix:soil_and_agriculture","matrix:wastewater"],"institution_ids":["I4405271599","I86519309","I97018004"],"is_oa":false,"journal":"ACS ES&T Water","last_updated":"2026-11-01T11:40:01.658920","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acsestwater.4c00753","openalex_topics":["T10079","T11188","T12078"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T11188","pub_date":"2025-01-03","study_type":"article","title":"Moringa oleifera Protein-Functionalized Diatomaceous Earth for Nanoparticle Removal","type":"article","work_id":"W4406033327","year":2025}]}
