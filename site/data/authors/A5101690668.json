tic_citations":0,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I4210137306","name":"Stanford Medicine","source":"openalex_last_known"},{"country_code":"US","id":"I4405269264","name":"Stanford Cardiovascular Institute","source":"openalex_last_known"},{"country_code":"US","id":"I97018004","name":"Stanford University","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W7128915509"]},"schema_version":"s3.1","works":[{"abstract":"Micro- and nanoplastics (MNPs) are increasingly detected in human tissues, yet their causal contribution to cardiovascular disease remains poorly understood. Here we show that oral exposure to polyethylene (PE) and polyvinyl chloride (PVC) -- the most abundant polymers found in human atheromas -- accelerates atherosclerosis in ApoE-/- mice through distinct, polymer-specific molecular mechanisms. While both polymers increased plaque burden and reduced contractile smooth muscle cell (SMC) markers, single-cell transcriptomic profiling revealed divergent phenotypic trajectories. PE exposure drives SMCs toward a chondromyocyte-like cell (CMC) state, characterized by upregulated osteogenic signaling and markedly increased vascular calcification. Conversely, PVC exposure promotes a fibromyocyte-like program associated with altered collagen metabolism and accelerated cell migration without enhancing calcification. These distinct SMC programs are reflected in the transcriptional signatures of symptomatic human carotid plaques, suggesting clinical relevance for polymer-specific vascular remodeling. Our findings establish a causal link between common environmental plastics and accelerated atherosclerosis, demonstrating that MNP-induced vascular risk is mediated by divergent SMC fate decisions. These results provide a mechanistic framework for assessing the cardiovascular impact of global plastic pollution and identifying potential therapeutic targets to mitigate MNP-associated vascular toxicity.","author_count":21,"author_ids":["A5009118071","A5019908632","A5022989976","A5034742427","A5038272951","A5038904980","A5043570709","A5047669998","A5063863943","A5075402324","A5076523611","A5077078597","A5077194189","A5079406097","A5082713311","A5083472766","A5090161874","A5101690668","A5102425747","A5104099786","A5119663675"],"author_institution_ids":["I4210137306","I4405269264","I97018004"],"authors":[{"id":"A5076523611","name":"Siwen Zheng"},{"id":"A5063863943","name":"Wenduo Gu"},{"id":"A5047669998","name":"Quanyi Zhao"},{"id":"A5101690668","name":"Yoko Kojima"},{"id":"A5077078597","name":"Kaylin C.A. Palm"},{"id":"A5083472766","name":"Michal Mokr\u00fd"},{"id":"A5075402324","name":"Kai-Uwe Jarr"},{"id":"A5022989976","name":"Hua Gao"},{"id":"A5082713311","name":"Isabella Damiani"},{"id":"A5009118071","name":"Guyu Tracy Qin"},{"id":"A5119663675","name":"Gurmenjit Kaur Bahia"},{"id":"A5102425747","name":"Sugandha Basu"},{"id":"A5104099786","name":"Ramendra Krishna Kundu"},{"id":"A5043570709","name":"Matthew D. Worssam"},{"id":"A5077194189","name":"Jo\u00e3o P. Monteiro"},{"id":"A5034742427","name":"Alexa Berezowitz"},{"id":"A5079406097","name":"Chad S. Weldy"},{"id":"A5090161874","name":"Paul P. Cheng"},{"id":"A5038272951","name":"Gerard Pasterkamp"},{"id":"A5038904980","name":"Nicholas James Leeper"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.64898/2026.02.10.26345390","domain_tags":[],"facet_tags":[],"institution_ids":["I193662353","I2802164966","I3018483916","I4210127591","I4210137306","I4405269264","I97018004"],"is_oa":true,"journal":"medRxiv","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by-nc-nd","needs_review":false,"oa_status":"green","oa_url":"https://www.medrxiv.org/content/medrxiv/early/2026/02/14/2026.02.10.26345390.full.pdf","openalex_topics":["T10753","T11618","T12955"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-02-14","study_type":"preprint","title":"Polyethylene and Polyvinyl Chloride Nanoplastics Accelerate Atherosclerosis Through Distinct Smooth Muscle Cell Phenotypic Transitions","type":"preprint","work_id":"W7128915509","year":2026}]}
