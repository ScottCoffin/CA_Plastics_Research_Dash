ars":[2001,2003]},{"country_code":"CN","id":"I4210126590","name":"General Research Institute for Nonferrous Metals (China)","years":[1999]}],"author_id":"A5100429292","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":290,"plastic":0,"year":2017},{"all":312,"plastic":0,"year":2018},{"all":373,"plastic":0,"year":2019},{"all":470,"plastic":0,"year":2020},{"all":650,"plastic":0,"year":2021},{"all":587,"plastic":0,"year":2022},{"all":625,"plastic":1,"year":2023},{"all":623,"plastic":8,"year":2024},{"all":634,"plastic":10,"year":2025},{"all":521,"plastic":14,"year":2026}],"cited_by_count":6536,"current_in_ca":false,"domain_tags":[],"early_career":false,"first_pub_year":1999,"first_year":2022,"h_index":33,"institution_ids":["I148283060","I38257878","I53012624","I95457486"],"last_ca_year":2025,"last_year":2022,"m_quotient":1.22,"name":"Yan Wang","orcid":"https://orcid.org/0000-0002-9147-1136","plastic_basis":"openalex","plastic_citations":33,"plastic_works_count":3,"primary_affiliations":[{"country_code":"CN","id":"I154099455","name":"Shandong University","source":"openalex_last_known"},{"country_code":"PK","id":"I193670377","name":"University of Karachi","source":"openalex_last_known"},{"country_code":"CN","id":"I29739308","name":"Guangxi Normal University","source":"openalex_last_known"},{"country_code":"PK","id":"I4210121526","name":"International Center for Chemical and Biological Sciences","source":"openalex_last_known"},{"country_code":"CN","id":"I4405270581","name":"State Key Laboratory for Chemistry and Molecular Engineering of Medicinal Resources","source":"openalex_last_known"}],"rising_pct":57,"rising_score":0.0027,"work_count":1,"work_ids":["W4319332929"]},"schema_version":"s3.1","works":[{"abstract":"High Resolution Image Download MS PowerPoint Slide Scalable, low-cost biofuel and biochemical production can accelerate progress on the path to a more circular carbon economy and reduced dependence on crude oil. Rather than producing a single fuel product, lignocellulosic biorefineries have the potential to serve as hubs for the production of fuels, production of petrochemical replacements, and treatment of high-moisture organic waste. A detailed techno-economic analysis and life-cycle greenhouse gas assessment are developed to explore the cost and emission impacts of integrated corn stover-to-ethanol biorefineries that incorporate both codigestion of organic wastes and different strategies for utilizing biogas, including onsite energy generation, upgrading to bio-compressed natural gas (bioCNG), conversion to poly(3-hydroxybutyrate) (PHB) bioplastic, and conversion to single-cell protein (SCP). We find that codigesting manure or a combination of manure and food waste alongside process wastewater can reduce the biorefinery\u2019s total costs per metric ton of CO 2 equivalent mitigated by half or more. Upgrading biogas to bioCNG is the most cost-effective climate mitigation strategy, while upgrading biogas to PHB or SCP is competitive with combusting biogas onsite.","author_count":4,"author_ids":["A5017030250","A5018132574","A5052210682","A5100429292"],"author_institution_ids":["I148283060","I38257878","I53012624","I95457486"],"authors":[{"id":"A5100429292","name":"Yan Wang"},{"id":"A5017030250","name":"Nawa Raj Baral"},{"id":"A5052210682","name":"Minliang Yang"},{"id":"A5018132574","name":"Corinne D. Scown"}],"ca_any_author":true,"ca_led":true,"cited_by_count":32,"doi":"https://doi.org/10.1021/acs.est.2c06674","domain_tags":["wastewater_and_treatment"],"facet_tags":["matrix:food_and_drink","matrix:wastewater"],"institution_ids":["I148283060","I38257878","I53012624","I95457486"],"is_oa":true,"journal":"Environmental Science & Technology","last_updated":"2026-11-07T11:25:07.637180","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://pubs.acs.org/doi/pdf/10.1021/acs.est.2c06674","openalex_topics":["T10171","T10284","T13240"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10171","pub_date":"2022-01-01","study_type":"article","title":"Co-Processing Agricultural Residues and Wet Organic Waste Can Produce Lower-Cost Carbon-Negative Fuels and Bioplastics","type":"article","work_id":"W4319332929","year":2022}]}
