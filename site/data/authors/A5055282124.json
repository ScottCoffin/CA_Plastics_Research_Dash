y_code":"US","id":"I201448701","name":"University of Washington","years":[1980,1981,1982]},{"country_code":"US","id":"I12834331","name":"University of Wyoming","years":[1982]}],"author_id":"A5055282124","ca_plastic_works_count":1,"ca_works_count":2,"citations_by_year":[{"all":1611,"plastic":52,"year":2017},{"all":1881,"plastic":77,"year":2018},{"all":2687,"plastic":79,"year":2019},{"all":2882,"plastic":133,"year":2020},{"all":3080,"plastic":143,"year":2021},{"all":2743,"plastic":157,"year":2022},{"all":2888,"plastic":133,"year":2023},{"all":2591,"plastic":111,"year":2024},{"all":2406,"plastic":102,"year":2025},{"all":1815,"plastic":92,"year":2026}],"cited_by_count":30243,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1980,"first_year":2013,"h_index":51,"institution_ids":["I1316194761","I95457486"],"last_ca_year":2026,"last_year":2024,"m_quotient":1.11,"name":"Anthony D. Barnosky","orcid":"https://orcid.org/0000-0003-0265-7113","plastic_basis":"openalex","plastic_citations":1117,"plastic_works_count":3,"primary_affiliations":[{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","source":"openalex_last_known"}],"rising_pct":3,"rising_score":-0.0442,"work_count":2,"work_ids":["W2156117663","W2251856535"]},"schema_version":"s3.1","works":[{"abstract":"Abstract Palaeontology formed the basis for defining most of the geological eras, periods, epochs and ages that are commonly recognized. By the same token, the Anthropocene can be defined by diverse palaeontological criteria, in accordance with commonly accepted biostratigraphic practice. The most useful Anthropocene biostratigraphic zones will be assemblage and abundance zones based on mixes of native and non-native species in both the marine and terrestrial realms, although lineage zones based on evolution of crop plants may also have utility. Also useful are human-produced trace fossils, which have resulted in prominent biohorizons that can mark the onset of the Anthropocene, especially the paved road system, widespread through terrestrial regions, and microplastics, ubiquitous in near-shore and deep-water marine sediments. Most of these palaeontological criteria support placing the Holocene\u2013Anthropocene boundary near 1950. Continuation of current extinction rates would produce an extinction biohorizon on the scale of the Big Five mass extinctions within a few centuries, but enhanced conservation measures could prevent making mass extinction an Anthropocene signature. A grand challenge for palaeontologists now is to define Anthropocene biostratigraphic zones rigorously, not only as a necessary precursor to formalizing the epoch, but also to more fully understand how humans have restructured the biosphere.","author_count":1,"author_ids":["A5055282124"],"author_institution_ids":["I95457486"],"authors":[{"id":"A5055282124","name":"Anthony D. Barnosky"}],"ca_any_author":true,"ca_led":true,"cited_by_count":73,"doi":"https://doi.org/10.1144/sp395.6","domain_tags":["analytical_methods","occurrence_and_monitoring","soil_and_agriculture"],"facet_tags":["matrix:marine","matrix:soil_and_agriculture"],"institution_ids":["I95457486"],"is_oa":false,"journal":"Geological Society London Special Publications","last_updated":"2026-11-07T11:25:07.637180","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1144/sp395.6","openalex_topics":["T10017","T10109","T14047"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10109","pub_date":"2013-10-24","study_type":"article","title":"Palaeontological evidence for defining the Anthropocene","type":"article","work_id":"W2156117663","year":2013},{"abstract":"","author_count":17,"author_ids":["A5001313270","A5004317685","A5007602452","A5011307993","A5013597562","A5016536266","A5023824006","A5033788286","A5036672347","A5043465473","A5055282124","A5067048169","A5071561016","A5075896370","A5082106145","A5085214583","A5108420520"],"author_institution_ids":["