3},{"all":447,"plastic":267,"year":2024},{"all":452,"plastic":300,"year":2025},{"all":396,"plastic":284,"year":2026}],"cited_by_count":5070,"domain_tags":[],"early_career":false,"first_pub_year":2000,"first_year":2013,"h_index":27,"institution_ids":["I84218800"],"last_year":2014,"m_quotient":1.04,"name":"Tomofumi Kurobe","orcid":"https://orcid.org/0000-0003-3906-1989","plastic_basis":"openalex","plastic_citations":2965,"plastic_works_count":2,"primary_affiliations":[{"country_code":"JP","id":"I4210117686","name":"Japan Fisheries Research and Education Agency","source":"openalex_last_known"},{"country_code":"JP","id":"I4405286149","name":"Fisheries Technology Institute","source":"openalex_last_known"}],"rising_pct":2,"rising_score":-0.0853,"work_count":2,"work_ids":["W2009120022","W2116464510"]},"profile":{"bio":"","keywords":["Fish Pathology","Virology"],"links":[]},"schema_version":"s3.1","works":[{"abstract":"","author_count":4,"author_ids":["A5031423229","A5063514822","A5068717196","A5076568131"],"author_institution_ids":["I84218800"],"authors":[{"id":"A5031423229","name":"Chelsea M. Rochman"},{"id":"A5076568131","name":"Tomofumi Kurobe"},{"id":"A5068717196","name":"Ida Flores"},{"id":"A5063514822","name":"Swee Joo Teh"}],"ca_any_author":true,"ca_led":true,"cited_by_count":789,"doi":"https://doi.org/10.1016/j.scitotenv.2014.06.051","domain_tags":["ecotoxicology_and_trophic_transfer","human_exposure_and_health_risk"],"facet_tags":["matrix:marine"],"institution_ids":["I84218800"],"is_oa":false,"journal":"The Science of The Total Environment","last_updated":"2026-11-11T12:16:26.678958","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.scitotenv.2014.06.051","openalex_topics":["T10447","T10686","T10753"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10753","pub_date":"2014-07-02","study_type":"article","title":"Early warning signs of endocrine disruption in adult fish from the ingestion of polyethylene with and without sorbed chemical pollutants from the marine environment","type":"article","work_id":"W2009120022","year":2014},{"abstract":"Plastic debris litters aquatic habitats globally, the majority of which is microscopic (< 1 mm), and is ingested by a large range of species. Risks associated with such small fragments come from the material itself and from chemical pollutants that sorb to it from surrounding water. Hazards associated with the complex mixture of plastic and accumulated pollutants are largely unknown. Here, we show that fish, exposed to a mixture of polyethylene with chemical pollutants sorbed from the marine environment, bioaccumulate these chemical pollutants and suffer liver toxicity and pathology. Fish fed virgin polyethylene fragments also show signs of stress, although less severe than fish fed marine polyethylene fragments. We provide baseline information regarding the bioaccumulation of chemicals and associated health effects from plastic ingestion in fish and demonstrate that future assessments should consider the complex mixture of the plastic material and their associated chemical pollutants.","author_count":4,"author_ids":["A5023645209","A5031423229","A5063514822","A5076568131"],"author_institution_ids":["I84218800"],"authors":[{"id":"A5031423229","name":"Chelsea M. Rochman"},{"id":"A5023645209","name":"Eunha Hoh"},{"id":"A5076568131","name":"Tomofumi Kurobe"},{"id":"A5063514822","name":"Swee Joo Teh"}],"ca_any_author":true,"ca_led":true,"cited_by_count":2175,"doi":"https://doi.org/10.1038/srep03263","domain_tags":["ecotoxicology_and_trophic_transfer","human_exposure_and_health_risk"],"facet_tags":["matrix:marine"],"institution_ids":["I26538001","I84218800"],"is_oa":true,"journal":"Scientific Reports","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://www.nature.com/articles/srep03263.pdf","openalex_topics":["T10122","T10447","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2013-11-21","study_type":"article","title":"Ingested plastic transfers hazardous chemicals to fish and induces hepatic stress","type":"article","work_id":"W2116464510","year":2013}]}
