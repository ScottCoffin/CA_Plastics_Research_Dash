.35,"name":"Patr\u00edcia Pereira Serafini","orcid":"https://orcid.org/0000-0002-2448-7621","plastic_basis":"openalex","plastic_citations":57,"plastic_works_count":4,"primary_affiliations":[{"country_code":"AU","id":"I11587721","name":"ACAP University College","source":"openalex_last_known"},{"country_code":"GB","id":"I40120149","name":"University of Oxford","source":"openalex_last_known"},{"country_code":"BR","id":"I4104125","name":"Universidade Federal de Santa Catarina","source":"openalex_last_known"},{"country_code":"BR","id":"I4210139426","name":"Instituto Chico Mendes de Conserva\u00e7\u00e3o da Biodiversidade","source":"openalex_last_known"}],"rising_pct":64,"rising_score":0.0038,"work_count":4,"work_ids":["W3205598821","W4313703396","W4396758916","W4403985685"]},"profile":{"bio":"Patricia Pereira Serafini is a wildlife vet specializing in ecology and conservation, particularly focusing on albatrosses, petrels and other seabirds. Currently, she is doing a PhD at the Federal University of Santa Catarina while working as an environmental analyst at the National Center for Research and Conservation of Wild Birds (CEMAVE/ICMBio/Ministry of Environment), in Brazil. Patricia\u00b4s expertise is in a One Health approach to the conservation crisis facing seabirds, and her research involves population monitoring, molecular biology, biochemistry, ecotoxicology, and epidemiology.","keywords":[],"links":[]},"schema_version":"s3.1","works":[{"abstract":"","author_count":6,"author_ids":["A5014427421","A5048284589","A5065509561","A5075732279","A5075765975","A5086477070"],"author_institution_ids":["I4210139426"],"authors":[{"id":"A5086477070","name":"Ralph Eric Thijl Vanstreels"},{"id":"A5075765975","name":"Luciana Gallo"},{"id":"A5075732279","name":"Patr\u00edcia Pereira Serafini"},{"id":"A5014427421","name":"Allan Poltronieri Santos"},{"id":"A5048284589","name":"Leandro Egert"},{"id":"A5065509561","name":"Marcela Uhart"}],"ca_any_author":true,"ca_led":true,"cited_by_count":22,"doi":"https://doi.org/10.1016/j.marpolbul.2021.113046","domain_tags":["ecotoxicology_and_trophic_transfer","human_exposure_and_health_risk"],"facet_tags":["matrix:marine"],"institution_ids":["I151201029","I4210139426","I4405256283","I84218800"],"is_oa":true,"journal":"Marine Pollution Bulletin","last_updated":"2026-11-04T10:54:05.112534","license":"cc-by-nc-sa","needs_review":false,"oa_status":"green","oa_url":"http://hdl.handle.net/11336/167102","openalex_topics":["T10659","T10753","T11656"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10753","pub_date":"2021-10-19","study_type":"article","title":"Ingestion of plastics and other debris by coastal and pelagic birds along the coast of Esp\u00edrito Santo, Eastern Brazil","type":"article","work_id":"W3205598821","year":2021},{"abstract":"Plastic ingestion is a problem for seabirds worldwide. In addition to direct health effects such as obstruction or perforation of the gastrointestinal tract, plastic ingestion can also lead to indirect health effects through the release of chemicals that may be absorbed and cause systemic and chronic toxicity. Among chemicals that can be released by plastics are phthalate esters, a group of chemicals widely used as plasticizers or additives to change the physical characteristics of plastics. In this study, three phthalate esters, dimethyl phthalate (DMP), dibuthyl phthalate (DBP), and diethylhexyl phthalate (DEHP), were quantified in the uropygial gland of 48 seabirds from 16 species collected ashore in a tropical region, the coast of Esp\u00edrito Santo, Eastern Brazil. Including trace levels, DMP was detected in 16 birds (33%) from 10 species, with an average concentration of 0.014 \u00b1 0.005 ng/\u00b5l (mean \u00b1 SD for individuals with concentrations above the practical level of detection of 0.01 ng/\u00b5l). DBP was detected in 15 birds (31%) from 11 species, with an average concentration of 0.049 \u00b1 0.032 ng/\u00b5l. DEHP was detected in 21 birds (44%) from 11 species, with an average concentration of 0.115 \u00b1 0.105 ng/\u00b5l. DMP concentration in the uropygial gland was positively associated with the presence, number, and mass of plastic items in the upper digestive tract. However, no such relationship was noted for DBP nor DEHP, suggesting the concentration of phthalate compounds in the uropygial gland might not always serve as a reliable proxy for plastic ingestion. In spite of relatively high frequencies of detection, the low concentrations of phthalates detected in this study suggest levels of exposure below known toxicity thresholds. Further studies on the potential adverse effects of phthalate exposure in seabirds are necessary, especially on the reproductive development of embryos and chicks.","author_count":9,"author_ids":["A5014427421","A5048284589","A5053051965","A5065509561","A5075732279","A5075765975","A5077074620","A5086477070"],"author_institution_ids":["I151201029","I4104125","I4210139426","I4210163949","I4405256283","I84218800"],"authors":[{"id":"A5086477070","name":"Ralph Eric Thijl Vanstreels"},{"id":"A5077074620","name":"Isadora N. Piccinin"},{"id":"A5053051965","name":"Marcelo Maraschin"},{"id":"A5075765975","name":"Luciana Gallo"},{"id":"A5075732279","name":"Patr\u00edcia Pereira Serafini"},{"id":"","name":"Alice Pereira"},{"id":"A5014427421","name":"Allan Poltronieri Santos"},{"id":"A5048284589","name":"Leandro Egert"},{"id":"A5065509561","name":"Marcela Uhart"}],"ca_any_author":true,"ca_led":true,"cited_by_count":18,"doi":"https://doi.org/10.1638/2022-0053","domain_tags":["ecotoxicology_and_trophic_transfer","human_exposure_and_health_risk","risk_assessment"],"facet_tags":[],"institution_ids":["I151201029","I4104125","I4210139426","I4210163949","I4405256283","I84218800"],"is_oa":false,"journal":"Journal of Zoo and Wildlife Medicine","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1638/2022-0053","openalex_