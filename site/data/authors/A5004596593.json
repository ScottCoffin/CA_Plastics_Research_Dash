023},{"all":755,"plastic":0,"year":2024},{"all":767,"plastic":0,"year":2025},{"all":1007,"plastic":0,"year":2026}],"cited_by_count":9863,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1989,"first_year":2025,"h_index":42,"institution_ids":["I2803209242"],"last_ca_year":2026,"last_year":2025,"m_quotient":1.14,"name":"Elizabeth A. Murphy","orcid":"https://orcid.org/0000-0003-0846-7943","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"US","id":"I154570441","name":"University of California, Santa Barbara","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4412132509"]},"schema_version":"s3.1","works":[{"abstract":"Polymer recycling is currently predicated on the separation of a vast array of chemically different and immiscible polymer chains. As a result, only a relatively small fraction of plastic waste is ultimately recycled. Overcoming the repulsion of chemically dissimilar polymeric chains would enable the formation of strong, optically clear, and useful materials to be obtained from mixed plastics recycling waste. Here, we demonstrate the utility of relatively sparse ionic bonds (\u22481.0 and 6.5 mol % functionalization of a polymer backbone) coupled with a sulfonic acid-to-imidazole base proton transfer mechanism to facilitate the formation of optically clear materials in otherwise incompatible poly(dimethylsiloxane) and poly( n -butyl acrylate) mixtures. Adjusting the degree of ionic functionality spans a spectrum from nanometer-scale assemblies driven by electrostatic interactions to fully homogeneous blends with unique viscoelastic characteristics. This study highlights the complex physics of sparsely charged polymer blends and their potential impact on addressing society\u2019s pressing plastic waste challenges.","author_count":9,"author_ids":["A5001305555","A5001568631","A5004596593","A5036216864","A5057560264","A5064340656","A5065253425","A5066596999","A5118869461"],"author_institution_ids":["I2803209242"],"authors":[{"id":"A5065253425","name":"Jerrick Edmund"},{"id":"A5057560264","name":"Kseniia M. Karnaukh"},{"id":"A5066596999","name":"Shuyi Xie"},{"id":"A5004596593","name":"Elizabeth A. Murphy"},{"id":"A5001568631","name":"Allison Abdilla"},{"id":"A5118869461","name":"Eiko Ino"},{"id":"A5036216864","name":"Javier Read de Alaniz"},{"id":"A5064340656","name":"Craig J. Hawker"},{"id":"A5001305555","name":"Rachel A. Segalman"}],"ca_any_author":true,"ca_led":true,"cited_by_count":6,"doi":"https://doi.org/10.1021/acs.macromol.5c00274","domain_tags":["analytical_methods"],"facet_tags":[],"institution_ids":["I2803209242"],"is_oa":false,"journal":"Macromolecules","last_updated":"2026-10-28T10:33:24.094632","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.macromol.5c00274","openalex_topics":["T10389","T10405","T11471"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10389","pub_date":"2025-07-08","study_type":"article","title":"Compatibilization of Immiscible Polymer Blends through Pendant Ionic Interactions","type":"article","work_id":"W4412132509","year":2025}]}
