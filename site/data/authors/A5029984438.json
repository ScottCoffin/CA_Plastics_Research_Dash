{"author":{"affiliation_history":[{"country_code":"US","id":"I122411786","name":"California Institute of Technology","years":[2023,2025,2026]},{"country_code":"US","id":"I1334627681","name":"Jet Propulsion Laboratory","years":[2022,2023,2024,2025,2026]},{"country_code":"US","id":"I1313003366","name":"Woodwell Climate Research Center","years":[2024]},{"country_code":"US","id":"I33434090","name":"University of Massachusetts Boston","years":[2017,2019,2020,2021,2023]}],"author_id":"A5029984438","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":1,"plastic":0,"year":2017},{"all":3,"plastic":0,"year":2018},{"all":10,"plastic":0,"year":2019},{"all":25,"plastic":0,"year":2020},{"all":45,"plastic":0,"year":2021},{"all":48,"plastic":0,"year":2022},{"all":69,"plastic":0,"year":2023},{"all":51,"plastic":0,"year":2024},{"all":78,"plastic":1,"year":2025},{"all":98,"plastic":4,"year":2026}],"cited_by_count":428,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2014,"first_year":2025,"h_index":10,"institution_ids":["I1334627681"],"last_ca_year":2026,"last_year":2025,"m_quotient":0.83,"name":"Kelly M. A. Luis","orcid":"https://orcid.org/0000-0001-9975-3480","plastic_basis":"openalex","plastic_citations":5,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I122411786","name":"California Institute of Technology","source":"openalex_last_known"},{"country_code":"US","id":"I1334627681","name":"Jet Propulsion Laboratory","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4414598847"]},"profile":{"bio":"","keywords":[],"links":[{"label":"Website","url":"http://m11keluis.github.io"}]},"schema_version":"s3.1","works":[{"abstract":"Abstract The increase in international production of plastics since the 1950s and waste mismanagement have contributed to the proliferation of microplastics. Understanding plastic presence on land is crucial, as most pollution originates from land\u2010based sources. From its vantage point on the International Space Station, NASA's EMIT imaging spectrometer collects high signal\u2010to\u2010noise surface reflectance spectra (380\u20132500 nm). These spectra are obtained for every point within the imaged area, with 60\u2010m spatial sampling. We present a study using this instrument to detect distinctive absorption features of High\u2010density polyethylene (HDPE) and poly(vinyl chloride) (PVC) plastics in the shortwave infrared. By applying a column\u2010wise adaptive matched filter and using an open\u2010access spectral library, we successfully inferred signatures of these two types of plastics across multiple continents between latitudes bounds of \u00b152\u00b0, primarily related to agricultural practices. Our study underscores the importance of monitoring land\u2010based sources of plastic pollution to guide future mitigation strategies.","author_count":8,"author_ids":["A5004825526","A5022369533","A5025810253","A5029984438","A5033640187","A5075918914","A5083238237","A5083971802"],"author_institution_ids":["I1334627681"],"authors":[{"id":"A5025810253","name":"Raissa Estrela"},{"id":"A5022369533","name":"David Ray Thompson"},{"id":"A5004825526","name":"Philip Gregory Brodrick"},{"id":"A5083238237","name":"K. Dana Chadwick"},{"id":"A5075918914","name":"Michelle M. Gierach"},{"id":"A5029984438","name":"Kelly M. A. Luis"},{"id":"A5033640187","name":"Robert O. Green"},{"id":"A5083971802","name":"Mark G. Swain"}],"ca_any_author":true,"ca_led":true,"cited_by_count":5,"doi":"https://doi.org/10.1029/2024gl112416","domain_tags":["occurrence_and_monitoring"],"facet_tags":[],"institution_ids":["I1334627681"],"is_oa":true,"journal":"Geophysical Research Letters","last_updated":"2026-11-09T13:22:03.289127","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://onlinelibrary.wiley.com/doi/pdfdirect/10.1029/2024GL112416","openalex_topics":["T10689","T10753","T13890"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2025-09-12","study_type":"article","title":"Global\u2010Scale Detection of Plastic From Space With the EMIT Imaging Spectrometer","type":"article","work_id":"W4414598847","year":2025}]}
