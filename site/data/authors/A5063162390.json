18},{"all":118,"plastic":0,"year":2019},{"all":176,"plastic":0,"year":2020},{"all":234,"plastic":5,"year":2021},{"all":439,"plastic":136,"year":2022},{"all":555,"plastic":163,"year":2023},{"all":752,"plastic":203,"year":2024},{"all":800,"plastic":156,"year":2025},{"all":811,"plastic":178,"year":2026}],"cited_by_count":4113,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2005,"first_year":2021,"h_index":33,"institution_ids":["I150209017","I36258959","I881766915"],"last_ca_year":2026,"last_year":2025,"m_quotient":1.57,"name":"Peipei Wu","orcid":"https://orcid.org/0000-0002-3969-3372","plastic_basis":"openalex","plastic_citations":841,"plastic_works_count":8,"primary_affiliations":[{"country_code":"CN","id":"I126520041","name":"University of Science and Technology of China","source":"openalex_last_known"},{"country_code":"US","id":"I150209017","name":"Scripps Institution of Oceanography","source":"openalex_last_known"},{"country_code":"CN","id":"I173899330","name":"Henan University","source":"openalex_last_known"},{"country_code":"US","id":"I36258959","name":"University of California San Diego","source":"openalex_last_known"},{"country_code":"CN","id":"I4210138501","name":"Chinese Academy of Agricultural Sciences","source":"openalex_last_known"},{"country_code":"CN","id":"I4210158190","name":"Institute of Crop Sciences","source":"openalex_last_known"},{"country_code":"CN","id":"I47720641","name":"Huazhong University of Science and Technology","source":"openalex_last_known"}],"rising_pct":95,"rising_score":0.0295,"work_count":7,"work_ids":["W3212449458","W4324055503","W4413908427","W4414335965","W7135194629","W7135234398","W7205002109"]},"schema_version":"s3.1","works":[{"abstract":"The COVID-19 pandemic has led to an increased demand for single-use plastics that intensifies pressure on an already out-of-control global plastic waste problem. While it is suspected to be large, the magnitude and fate of this pandemic-associated mismanaged plastic waste are unknown. Here, we use our MITgcm ocean plastic model to quantify the impact of the pandemic on plastic discharge. We show that 8.4 \u00b1 1.4 million tons of pandemic-associated plastic waste have been generated from 193 countries as of August 23, 2021, with 25.9 \u00b1 3.8 thousand tons released into the global ocean representing 1.5 \u00b1 0.2% of the global total riverine plastic discharge. The model projects that the spatial distribution of the discharge changes rapidly in the global ocean within 3 y, with a significant portion of plastic debris landing on the beach and seabed later and a circumpolar plastic accumulation zone will be formed in the Arctic. We find hospital waste represents the bulk of the global discharge (73%), and most of the global discharge is from Asia (72%), which calls for better management of medical waste in developing countries.","author_count":4,"author_ids":["A5056825945","A5063162390","A5068232281","A5101674870"],"author_institution_ids":["I881766915"],"authors":[{"id":"A5101674870","name":"Yiming Peng"},{"id":"A5063162390","name":"Peipei Wu"},{"id":"A5056825945","name":"Amina Traore Schartup"},{"id":"A5068232281","name":"Yanxu Zhang"}],"ca_any_author":true,"ca_led":false,"cited_by_count":560,"doi":"https://doi.org/10.1073/pnas.2111530118","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I150209017","I36258959","I881766915"],"is_oa":true,"journal":"Proceedings of the National Academy of Sciences","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc-nd","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1073/pnas.2111530118","openalex_topics":["T10753","T12916","T12920"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2021-11-08","study_type":"article","title":"Plastic waste release caused by COVID-19 and its fate in the global ocean","type":"article","work_id":"W3212449458","year":2021},{"abstract":"Abstract Marine plastic pollution poses a potential threat to the ecosystem, but the sources and their magnitudes remain largely unclear. Existing bottom-up emission inventories vary among studies for two to three orders of magnitudes (OMs). Here, we adopt a top-down approach that uses observed dataset of sea surface plastic concentrations and an ensemble of ocean transport models to reduce the uncertainty of global plastic discharge. The optimal estimation of plastic emissions in this study varies about 1.5 OMs: 0.70 (0.13\u20133.8 as a 95% confidence interval) million metric tons yr\u22121 at the present day. We find that the variability of surface plastic abundance caused by different emission inventories is higher than that caused by model parameters. We suggest that more accurate emission inventories, more data for the abundance in the seawater and other compartments, and more accurate model parameters are required to further reduce the uncertainty of our estimate.","author_count":19,"author_ids":["A5023277730","A5039797144","A5044638051","A5049869650","A5053381150","A5056825945","A5061759963","A5063162390","A5068232281","A5070512232","A5071969820","A5074550236","A5085348395","A5100320443","A5101384102","A5101674870","A5101737712","A5103168655","A5112544052"],"author_institution_ids":["I881766915"],"authors":[{"id":"A5068232281","name":"Yanxu Zhang"},{"id":"A5063162390","name":"Peipei Wu"},{"id":"A5101384102","name":"Ruochong Xu"},{"id":"A5049869650","name":"Xuantong Wang"},{"id":"A5071969820","name":"Lili Lei"},{"id":"A5056825945","name":"Amina Traore Schartup"},{"id":"A5101674870","name":"Yiming Peng"},{"id":"A5112544052","name":"Qiaotong Pang"},{"id":"A5103168655","name":"Xinle Wang"},{"id":"A5039797144","name":"Lei Mai"},{"id":"A5101737712","name":"Ruwei Wang"},{"id":"A5023277730","name":"Huan Liu"},{"id":"A5100320443","name":"Xiaotong Wang"},{"id":"A5085348395","name":"Arjen Pieter Luijendijk"},{"id":"A5044638051","name":"Eric P. Chassignet"},{"id":"A5053381150","name":"Xiaobiao Xu"},{"id":"A5070512232","name":"Huizhong Shen"},{"id":"A5074550236","name":"Shuxiu Zheng"},{"id":"A5061759963","name":"Eddy Yongping Zeng"}],"ca_any_author":true,"ca_led":false,"cited_by_count":154,"doi":"https://doi.org/10.1038/s41467-023-37108-5","domain_tags":["fate_transport_and_sorption","occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I103163165","I150209017","I159948400","I20231570","I3045169105","I36258959","I4210103266","I4405272157","I881766915","I98358874","I99065089"],"is_oa":true,"journal":"Nature Communications","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://www.nature.com/articles/s41467-023-37108-5.pdf","openalex_topics":["T10032","T10753","T12316"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2023-03-13","study_type":"article","title":"Plastic waste discharge to the global ocean constrained by seawater observations","type":"article","work_id":"W4324055503","year":2023},{"abstract":"","author_count":10,"author_ids":["A5006887926","A5061759963","A5063162390","A5068232281","A5071969820","A5076524957","A5100741304","A5103168655","A5112544052"],"author_institution_ids":["I150209017","I36258959"],"authors":[{"id":"","name":"Ziman Zhang"},{"id":"A5063162390","name":"Peipei Wu"},{"id":"A5103168655","name":"Xinle Wang"},{"id":"A5112544052","name":"Qiaotong Pang"},{"id":"A5076524957","name":"Yujuan Wang"},{"id":"A5100741304","name":"Xianming Zhang"},{"id":"A5006887926","name":"Karin Kvale"},{"id":"A5061759963","name":"Eddy Yongping Zeng"},{"id":"A5071969820","name":"Lili Lei"},{"id":"A5068232281","name":"Yanxu Zhang"}],"ca_any_author":true,"ca_led":false,"cited_by_count":40,"doi":"https://doi.org/10.1038/s41893-025-01620-x","domain_tags":["risk_assessment"],"facet_tags":["matrix:marine"],"institution_ids":["I114832834","I150209017","I36258959","I60158472","I881766915","I90610280"],"is_oa":false,"journal":"Nature Sustainability","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1038/s41893-025-01620-x","openalex_topics":["T10447","T10753","T12316"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2025-09-02","study_type":"article","title":"Ecological risk assessment of marine plastic pollution","type":"article","work_id":"W4413908427","year":2025},{"abstract":"","author_count":8,"author_ids":["A5045610213","A5063131595","A5063162390","A5068232281","A5077860943","A5103168655","A5112544052"],"author_institution_ids":["I150209017","I36258959"],"authors":[{"id":"A5112544052","name":"Qiaotong Pang"},{"id":"A5063162390","name":"Peipei Wu"},{"id":"A5063131595","name":"Luisa Galgani"},{"id":"A5103168655","name":"Xinle Wang"},{"id":"","name":"Ziman Zhang"},{"id":"A5077860943","name":"Tengfei Yuan"},{"id":"A5045610213","name":"Haikun Wang"},{"id":"A5068232281","name":"Yanxu Zhang"}],"ca_any_author":true,"ca_led":false,"cited_by_count":14,"doi":"https://doi.org/10.1038/s41893-025-01632-7","domain_tags":[],"facet_tags":["matrix:marine"],"institution_ids":["I102064193","I114832834","I150209017","I36258959","I881766915"],"is_oa":true,"journal":"Nature Sustainability","last_updated":"2026-11-07T11:25:07.637180","license":"cc-by-nc-nd","needs_review":false,"oa_status":"green","oa_url":"https://hdl.handle.net/11365/1330420","openalex_topics":["T10032","T10255","T10753"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10753","pub_date":"2025-09-18","study_type":"article","title":"The potential impacts of plastic on the marine carbon cycle","type":"article","work_id":"W4414335965","year":2025},{"abstract":"Plastic pollution poses considerable threats to the marine ecosystem, necessitating comprehensive risk assessment. However, the evaluation of multiple ecological risk pathways for marine organisms in the global ocean remains limited. Here, we assess the global risks of plastic ingestion, entanglement, pollutant adsorption (Methylmercury, MeHg; Perfluorooctane, PFOS), and additive leaching (Bisphenol A, BPA; Phthalate esters, PAEs) by integrating a marine plastic model, multi-size marine organism data, as well as MeHg and PFOS datasets. We reveal significant ingestion risks concentrated in the mid-latitude North Pacific and Atlantic Ocean, North Indian Ocean, and pronounced leaching of plastic additives in these regions. Entanglement hotspots align with regions of flourishing coastal fisheries, highlighting a significant threat to marine species. Furthermore, our analysis indicates that marine plastic debris acts as a vector for persistent organic pollutants. Modeled adsorption load are highest for PFOS on plastics in the North Atlantic and along the densely populated coasts of East and Southeast Asia (0.1\u20130.3 pg m\u207b\u00b2), and for MeHg in the North Indian Ocean and the Southwest Atlantic Ocean (1\u201318 pg m\u207b\u00b2). Using future emission scenarios, we project plastic concentrations and estimate reduced risks under emission control strategies. These findings underscore the urgent need for targeted cleanup efforts and policy interventions to mitigate the pervasive impact of plastic pollution on marine ecosystems.","author_count":10,"author_ids":["A5006887926","A5061759963","A5063162390","A5068232281","A5071969820","A5076524957","A5087915948","A5100741304","A5103168655","A5112544052"],"author_institution_ids":["I150209017","I36258959"],"authors":[{"id":"A5087915948","name":"Ziman Zhang"},{"id":"A5063162390","name":"Peipei Wu"},{"id":"A5103168655","name":"Xinle Wang"},{"id":"A5112544052","name":"Qiaotong Pang"},{"id":"A5076524957","name":"Yujuan Wang"},{"id":"A5100741304","name":"Xianming Zhang"},{"id":"A5006887926","name":"Karin Kvale"},{"id":"A5061759963","name":"Eddy Yongping Zeng"},{"id":"A5071969820","name":"Lili Lei"},{"id":"A5068232281","name":"Yanxu Zhang"}],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"https://doi.org/10.5194/egusphere-egu26-2759","domain_tags":["ecotoxicology_and_trophic_transfer","fate_transport_and_sorption","human_exposure_and_health_risk","occurrence_and_monitoring","risk_assessment"],"facet_tags":["matrix:marine"],"institution_ids":["I114832834","I150209017","I200845125","I36258959","I60158472","I881766915","I90610280"],"is_oa":true,"journal":"EGU General Assembly Conference Abstracts","last_updated":"2026-11-09T13:22:03.289127","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.5194/egusphere-egu26-2759","openalex_topics":["T10447","T10753","T12316"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-03-13","study_type":"conference-abstract","title":"Toward a United Ecological Risk Assessment of Marine Plastics","type":"conference-abstract","work_id":"W7135194629","year":2026},{"abstract":"Based on our modeling, more than 10 million tonnes of plastic have entered the oceans, yet their ultimate fate and long-term impacts remain uncertain. We developed a multimedia model constrained by observations from beaches, seawaters, and seabeds to reconstruct the size (\u2265>0.2 mm), source, age, and storage of marine plastics since 1950. We find that beaches are the primary mass reservoir, while most particles remain suspended in the water column or sink toward the deep ocean. Continental emissions primarily contaminate nearby regions, whereas maritime sources disperse particles widely across ocean basins. Global mean ages of plastics range from 14 (10\u201316) years at the surface to 26 (20\u201332) years on beaches and 38 (35\u201342) years on seabeds on a mass-weighted basis, and are generally higher when weighted by particle numbers, highlighting the enduring legacy of historical plastic emissions. Persistent fragmentation of older plastics, combined with accelerating new inputs, produces a numerical dominance of small plastic fragments (","author_count":13,"author_ids":["A5020495424","A5049869650","A5056825945","A5061759963","A5063162390","A5068232281","A5071969820","A5087915948","A5101384102","A5103168655","A5112544052","A5128983486","A5129050119"],"author_institution_ids":["I150209017","I36258959"],"authors":[{"id":"A5103168655","name":"Xinle Wang"},{"id":"A5063162390","name":"Peipei Wu"},{"id":"A5112544052","name":"Qiaotong Pang"},{"id":"A5087915948","name":"Ziman Zhang"},{"id":"A5128983486","name":"Dong Peng"},{"id":"A5101384102","name":"Ruochong Xu"},{"id":"A5049869650","name":"Xuantong Wang"},{"id":"A5129050119","name":"Xiang-Rong Xu"},{"id":"A5061759963","name":"Eddy Yongping Zeng"},{"id":"A5020495424","name":"Andr\u00e9s C\u00f3zar"},{"id":"A5056825945","name":"Amina Traore Schartup"},{"id":"A5071969820","name":"Lili Lei"},{"id":"A5068232281","name":"Yanxu Zhang"}],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"https://doi.org/10.5194/egusphere-egu26-4170","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I114832834","I150209017","I150807315","I36258959","I39147953","I881766915","I90610280","I99065089"],"is_oa":true,"journal":"EGU General Assembly Conference Abstracts","last_updated":"2026-11-09T13:22:03.289127","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.5194/egusphere-egu26-4170","openalex_topics":["T10032","T10753","T12316"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-03-13","study_type":"conference-abstract","title":"Plastics long shadow: legacy and fate of plastic pollution in the oceans","type":"conference-abstract","work_id":"W7135234398","year":2026},{"abstract":"Mercury and plastics are emblematic pollutants of the Anthropocene. Despite differences in material properties, transformations, and exposure pathways, they share features in cross-compartment transport and long-term persistence. Drawing on decades of research and the Minamata Convention, mercury science has established coordinated observations, source inventories, and mass-balance models. Here, we assess how elements of this infrastructure can inform plastic pollution research by comparing source\u2013transport\u2013sink dynamics and identifying where mercury-based approaches are suitable for adaptation. We argue that socioeconomic analysis should be integrated with Earth system modeling to trace plastic fluxes from human technospheres to environmental sinks. Priorities include harmonized methods, sustained observations, transparent release inventories, and models that evaluate policy effects on sources, transport, transformation, exposure, and accumulation. This comparison is methodological, not mechanistic, and supports a science\u2013policy interface for plastics governance.","author_count":28,"author_ids":["A5000878312","A5002599864","A5016422700","A5017250420","A5023220319","A5046986222","A5050157218","A5056825945","A5063162390","A5068232281","A5070512232","A5073840672","A5076104832","A5077768422","A5078915253","A5079016258","A5100633773","A5101810190","A5103168655","A5110619086","A5112845802","A5123189232","A5126660407","A5128983486","A5129050119","A5148987405","A5149018165","A5149094386"],"author_institution_ids":["I150209017","I36258959"],"authors":[{"id":"A5128983486","name":"Dong Peng"},{"id":"A5103168655","name":"Xinle Wang"},{"id":"A5000878312","name":"H\u00e9l\u00e8ne Angot"},{"id":"A5078915253","name":"Michael S. Bank"},{"id":"A5079016258","name":"Silvia Bucci"},{"id":"A5076104832","name":"Hancheng Dai"},{"id":"A5149094386","name":"Jianhua Gao"},{"id":"A5046986222","name":"Roland Geyer"},{"id":"A5073840672","name":"Xianda Gong"},{"id":"A5101810190","name":"Ga\u00ebl Le Roux"},{"id":"A5050157218","name":"Laurent Lebreton"},{"id":"A5123189232","name":"Ting Lei"},{"id":"A5110619086","name":"Daoji Li"},{"id":"A5148987405","name":"Maodian Liu"},{"id":"A5077768422","name":"Yurong Liu"},{"id":"A5017250420","name":"Camille Richon"},{"id":"A5056825945","name":"Amina Traore Schartup"},{"id":"A5070512232","name":"Huizhong Shen"},{"id":"A5149018165","name":"Zhengcheng Song"},{"id":"A5016422700","name":"Jeroen E. Sonke"}],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"https://doi.org/10.1038/s44454-026-00056-y","domain_tags":["fate_transport_and_sorption","occurrence_and_monitoring"],"facet_tags":[],"institution_ids":["I106785703","I114832834","I1294671590","I129774422","I138938424","I150209017","I150807315","I154202486","I154570441","I17301866","I19820366","I20231570","I204823248","I205747304","I24603500","I2802153510","I3045169105","I3133055985","I31683504","I36258959","I4210086468","I4210088668","I4210098176","I4210104620","I4210121220","I4210135735","I4210157108","I4210162872","I4210164289","I4210166444","I4391768061","I4391768259","I4405258862","I4405272157","I66867065","I881766915","I90610280","I913481162","I99065089"],"is_oa":true,"journal":"npj Emerging Contaminants","last_updated":"2026-11-01T11:40:01.658920","license":"cc-by-nc-nd","needs_review":false,"oa_status":"gold","oa_url":"https://www.nature.com/articles/s44454-026-00056-y.pdf","openalex_topics":["T10122","T10753","T10819"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-09-02","study_type":"article","title":"From mercury to plastics: Earth system science and governance strategies","type":"article","work_id":"W7205002109","year":2026}]}
