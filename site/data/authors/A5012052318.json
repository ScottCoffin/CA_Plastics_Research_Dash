{"author":{"affiliation_history":[{"country_code":"US","id":"I154570441","name":"University of California, Santa Barbara","years":[2005,2009,2013,2015,2016,2017,2018,2019,2021]},{"country_code":"US","id":"I142207940","name":"California NanoSystems Institute","years":[2017]},{"country_code":"US","id":"I111979921","name":"Northwestern University","years":[2017]},{"country_code":"US","id":"I146094533","name":"Mitsubishi Corporation (United States)","years":[2009]},{"country_code":"US","id":"I103163165","name":"Florida State University","years":[2005]},{"country_code":"US","id":"I36053171","name":"California State University, Chico","years":[2001]}],"author_id":"A5012052318","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":104,"plastic":0,"year":2017},{"all":101,"plastic":0,"year":2018},{"all":114,"plastic":0,"year":2019},{"all":100,"plastic":0,"year":2020},{"all":99,"plastic":0,"year":2021},{"all":93,"plastic":0,"year":2022},{"all":73,"plastic":0,"year":2023},{"all":75,"plastic":0,"year":2024},{"all":59,"plastic":0,"year":2025},{"all":47,"plastic":0,"year":2026}],"cited_by_count":1421,"current_in_ca":null,"domain_tags":[],"early_career":false,"first_pub_year":2001,"first_year":2009,"h_index":15,"institution_ids":[],"last_ca_year":2021,"last_year":2009,"m_quotient":0.6,"name":"Jeffrey A. Gerbec","orcid":"","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2024495322"]},"schema_version":"s3.1","works":[{"abstract":"We report the performance and characterization of a material based on poly[(3-mercaptopropyl)methylsiloxane] (PMMS) in various soft lithography applications. PMMS stamps were made by cross-linking with triallyl cyanurate and ethoxylated (4) bisphenol A dimethacrylate via thiol\u2212ene mixed-mode chemistry. The surface chemistry of the materials was characterized by XPS when varied from hydrophilic through oxygen plasma treatment, to hydrophobic by exposure to a fluorinated trichlorosilane agent. The materials are transparent above 300 nm and thermally stable up to 225 \u00b0C, thus rendering them capable to be employed in step-and-flash imprint lithography, nanoimprint lithography, nanotransfer printing, and proximity-field nanopatterning. The successful pattern replication from the micrometer to sub-100 nm scale was demonstrated.","author_count":10,"author_ids":["A5007699390","A5012052318","A5020001579","A5045551635","A5064340656","A5078455808","A5109069954","A5109909868","A5111683427"],"author_institution_ids":[],"authors":[{"id":"","name":"Luis M. Campos"},{"id":"A5007699390","name":"Tu T. Truong"},{"id":"A5111683427","name":"Dong Eun Erica Shim"},{"id":"A5078455808","name":"Michael D. Dimitriou"},{"id":"A5020001579","name":"Daniel Jay-Lee Shir"},{"id":"A5109069954","name":"Ines Meinel"},{"id":"A5012052318","name":"Jeffrey A. Gerbec"},{"id":"A5109909868","name":"H. Thomas Hahn"},{"id":"A5045551635","name":"John A. Rogers"},{"id":"A5064340656","name":"Craig J. Hawker"}],"ca_any_author":true,"ca_led":true,"cited_by_count":77,"doi":"https://doi.org/10.1021/cm902506a","domain_tags":["analytical_methods","wastewater_and_treatment"],"facet_tags":[],"institution_ids":["I154570441","I157725225","I161318765"],"is_oa":true,"journal":"Chemistry of Materials","last_updated":"2026-11-07T11:25:07.637180","license":"","needs_review":false,"oa_status":"green","oa_url":"https://www.osti.gov/servlets/purl/1875074","openalex_topics":["T11471","T11737","T12224"],"plastic_related":false,"plastic_tier":"chemicals-in-plastics","primary_topic":"T12224","pub_date":"2009-10-14","study_type":"article","title":"Applications of Photocurable PMMS Thiol\u2212Ene Stamps in Soft Lithography","type":"article","work_id":"W2024495322","year":2009}]}
