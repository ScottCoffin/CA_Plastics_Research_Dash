{"country_code":"US","id":"I118118575","name":"New Jersey Institute of Technology","years":[2011]},{"country_code":"US","id":"I137902535","name":"North Carolina State University","years":[2011]},{"country_code":"US","id":"I8078737","name":"Clemson University","years":[2006,2007,2008,2009,2010]},{"country_code":"FI","id":"I9927081","name":"Aalto University","years":[2008]},{"country_code":"US","id":"I123534392","name":"University of North Texas","years":[2007]}],"author_id":"A5006892025","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":823,"plastic":0,"year":2017},{"all":981,"plastic":3,"year":2018},{"all":974,"plastic":4,"year":2019},{"all":1258,"plastic":14,"year":2020},{"all":1262,"plastic":11,"year":2021},{"all":1247,"plastic":10,"year":2022},{"all":1266,"plastic":42,"year":2023},{"all":1201,"plastic":71,"year":2024},{"all":1131,"plastic":91,"year":2025},{"all":916,"plastic":135,"year":2026}],"cited_by_count":14365,"current_in_ca":false,"domain_tags":[],"early_career":false,"first_pub_year":2006,"first_year":2010,"h_index":57,"institution_ids":["I116953780","I142207940","I161318765","I4210090489"],"last_ca_year":2018,"last_year":2018,"m_quotient":2.85,"name":"Sijie Lin","orcid":"https://orcid.org/0000-0002-6970-8221","plastic_basis":"openalex","plastic_citations":382,"plastic_works_count":11,"primary_affiliations":[{"country_code":"CN","id":"I116953780","name":"Tongji University","source":"openalex_last_known"},{"country_code":"CN","id":"I4210096899","name":"Jiangsu University of Science and Technology","source":"openalex_last_known"},{"country_code":"CN","id":"I4210128175","name":"Shanghai East Hospital","source":"openalex_last_known"},{"country_code":"CN","id":"I4392738303","name":"Shanghai Institute of Pollution Control and Ecological Security","source":"openalex_last_known"}],"rising_pct":91,"rising_score":0.0192,"work_count":1,"work_ids":["W2782571191"]},"profile":{"bio":"","keywords":["nano EHS","nano-bio interface","environmental science","high throughput/content screening","nanotechnolo"],"links":[{"label":"linlab.tongji.edu.cn","url":"http://linlab.tongji.edu.cn"}]},"schema_version":"s3.1","works":[{"abstract":"Nanoenabled products (NEPs) have numerous outdoor uses in construction, transportation or consumer scenarios, and there is evidence that their fragments are released in the environment at low rates. We hypothesized that the lower surface availability of NEPs fragment reduced their environmental effects with respect to pristine nanomaterials. This hypothesis was explored by testing fragments generated by intentional micronisation (\"the SUN approach\"; Nowack et al. Meeting the Needs for Released Nanomaterials Required for Further Testing: The SUN Approach. Environmental Science & Technology, 2016 (50), 2747). The NEPs were composed of four matrices (epoxy, polyolefin, polyoxymethylene, and cement) with up to 5% content of three nanomaterials (carbon nanotubes, iron oxide, and organic pigment). Regardless of the type of nanomaterial or matrix used, it was observed that nanomaterials were only partially exposed at the NEP fragment surface, indicating that mostly the intrinsic and extrinsic properties of the matrix drove the NEP fragment toxicity. Ecotoxicity in multiple assays was done covering relevant media from terrestrial to aquatic, including sewage treatment plant (biological activity), soil worms (Enchytraeus crypticus), and fish (zebrafish embryo and larvae and trout cell lines). We designed the studies to explore the possible modulation of ecotoxicity by nanomaterial additives in plastics/polymer/cement, finding none. The results support NEPs grouping by the matrix material regarding ecotoxicological effect during the use phase. Furthermore, control results on nanomaterial-free polymer fragments representing microplastic had no significant adverse effects up to the highest concentration tested.","author_count":19,"author_ids":["A5006892025","A5007700138","A5008889869","A5011506032","A5012077515","A5034195776","A5036174856","A5038264749","A5042410162","A5044583774","A5049870120","A5050687086","A5051528309","A5073053565","A5073107103","A5075548630","A5078152853","A5090211289","A5091205267"],"author_institution_ids":["I116953780","I142207940","I161318765","I4210090489"],"authors":[{"id":"A5073053565","name":"M\u00f3nica J.B. Amorim"},{"id":"A5006892025","name":"Sijie Lin"},{"id":"A5050687086","name":"Karsten Schlich"},{"id":"A5073107103","name":"Jose Maria Navas"},{"id":"A5042410162","name":"Andrea Brunelli"},{"id":"A5036174856","name":"Nicole Neubauer"},{"id":"A5011506032","name":"Klaus Vilsmeier"},{"id":"A5044583774","name":"Anna Luisa Costa"},{"id":"A5051528309","name":"Andreas P. Gondikas"},{"id":"A5091205267","name":"Tian Xia"},{"id":"A5078152853","name":"Liliana Galbis"},{"id":"A5008889869","name":"Elena Badetti"},{"id":"A5034195776","name":"Antonio Marcomini"},{"id":"A5012077515","name":"Danail Rumenov Hristozov"},{"id":"A5090211289","name":"Frank von der Kammer"},{"id":"A5049870120","name":"Kerstin Hund\u2010Rinke"},{"id":"A5038264749","name":"Janeck James Scott-Fordsmand"},{"id":"A5075548630","name":"Andr\u00e9 E. Nel"},{"id":"A5007700138","name":"Wendel Wohlleben"}],"ca_any_author":true,"ca_led":false,"cited_by_count":45,"doi":"https://doi.org/10.1021/acs.est.7b04122","domain_tags":["ecotoxicology_and_trophic_transfer","soil_and_agriculture","wastewater_and_treatment"],"facet_tags":["matrix:soil_and_agriculture","matrix:wastewater"],"institution_ids":["I116953780","I129774422","I142207940","I149461666","I161318765","I204337017","I4210090489","I4210106474","I4210107087","I4210108183","I4210134473","I4210155236","I60858718"],"is_oa":true,"journal":"Environmental Science & Technology","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by-nc-sa","needs_review":false,"oa_status":"green","oa_url":"http://hdl.handle.net/20.500.12792/566","openalex_topics":["T10079","T10447","T10753"],"plastic_related":true,"plastic_tier":"core","p