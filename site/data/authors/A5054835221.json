{"author":{"affiliation_history":[{"country_code":"US","id":"I4405264838","name":"Metropolitan Water District of Southern California","years":[2015,2016,2020,2021,2022,2023,2024,2025,2026]},{"country_code":"PE","id":"I115253235","name":"Federico Villarreal National University","years":[2021]},{"country_code":"US","id":"I84218800","name":"University of California, Davis","years":[2011,2012,2013,2021]}],"author_id":"A5054835221","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":27,"plastic":0,"year":2017},{"all":23,"plastic":0,"year":2018},{"all":27,"plastic":0,"year":2019},{"all":32,"plastic":0,"year":2020},{"all":40,"plastic":0,"year":2021},{"all":57,"plastic":0,"year":2022},{"all":76,"plastic":1,"year":2023},{"all":104,"plastic":0,"year":2024},{"all":121,"plastic":0,"year":2025},{"all":99,"plastic":3,"year":2026}],"cited_by_count":657,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2011,"first_year":2021,"h_index":14,"institution_ids":["I115253235","I4405264838","I84218800"],"last_ca_year":2026,"last_year":2021,"m_quotient":0.93,"name":"Shawn Acu\u00f1a","orcid":"https://orcid.org/0000-0003-1380-1520","plastic_basis":"openalex","plastic_citations":4,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I4405264838","name":"Metropolitan Water District of Southern California","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W3208535646"]},"schema_version":"s3.1","works":[{"abstract":"Microplastics are tiny plastic pieces, <5 mm, which is smaller than a pencil eraser. Did you know that you can find microplastics everywhere? They are in the air, water, soil, and within living creatures. You can find them from the deep sea to the snow in the Arctic. You can find them across beaches in California, and in the San Francisco Bay waters. Many living organisms ranging from zooplankton to whales contain microplastics in their bodies, including aquatic creatures from California. In this article, you will learn about the origin of microplastics, where you can find them, why they are a concern, how they can affect the Sacramento-San Joaquin Delta, and how you can help to reduce their global invasion.","author_count":5,"author_ids":["A5032322982","A5054835221","A5063514822","A5075107023","A5076809886"],"author_institution_ids":["I115253235","I4405264838","I84218800"],"authors":[{"id":"A5075107023","name":"Charlene Luj\u00e1n-Vega"},{"id":"A5076809886","name":"Jos\u00e9 Luis Ortega-Alfaro"},{"id":"A5032322982","name":"Jennifer M. Cossaboon"},{"id":"A5054835221","name":"Shawn Acu\u00f1a"},{"id":"A5063514822","name":"Swee Joo Teh"}],"ca_any_author":true,"ca_led":true,"cited_by_count":4,"doi":"https://doi.org/10.3389/frym.2021.606974","domain_tags":["ecotoxicology_and_trophic_transfer","soil_and_agriculture"],"facet_tags":["matrix:soil_and_agriculture"],"institution_ids":["I115253235","I4405264838","I84218800"],"is_oa":true,"journal":"Frontiers for Young Minds","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"diamond","oa_url":"https://www.frontiersin.org/articles/10.3389/frym.2021.606974/pdf","openalex_topics":["T10419","T10753","T14179"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2021-10-25","study_type":"article","title":"How Are Microplastics Invading the World?","type":"article","work_id":"W3208535646","year":2021}]}
