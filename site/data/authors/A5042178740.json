"all":8437,"plastic":117,"year":2025},{"all":7057,"plastic":102,"year":2026}],"cited_by_count":127257,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1966,"first_year":2021,"h_index":162,"institution_ids":["I161318765"],"last_ca_year":2026,"last_year":2021,"m_quotient":2.7,"name":"Kendall N. Houk","orcid":"https://orcid.org/0000-0002-8387-5261","plastic_basis":"openalex","plastic_citations":606,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"},{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"},{"country_code":"US","id":"I36258959","name":"University of California San Diego","source":"openalex_last_known"},{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","source":"openalex_last_known"}],"rising_pct":85,"rising_score":0.0121,"work_count":1,"work_ids":["W3121331573"]},"profile":{"bio":"","keywords":[],"links":[],"photo":{"credit":"Own work","license":"Public domain","source_url":"https://commons.wikimedia.org/wiki/File:HoukPicture03_2.jpg","thumb_url":"https://upload.wikimedia.org/wikipedia/commons/c/ce/HoukPicture03_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"}},"schema_version":"s3.1","works":[{"abstract":"Nature has provided a fantastic array of enzymes that are responsible for essential biochemical functions but not usually suitable for technological applications. Not content with the natural repertoire, protein engineering holds promise to extend the applications of improved enzymes with tailored properties. However, engineering of robust proteins remains a difficult task since the positive mutation library may not cooperate to reach the target function in most cases owing to the ubiquity of epistatic effects. The main demand lies in identifying an efficient path of accumulated mutations. Herein, we devised a computational strategy (greedy accumulated strategy for protein engineering, GRAPE) to improve the robustness of a PETase from Ideonella sakaiensis . A systematic clustering analysis combined with greedy accumulation of beneficial mutations in a computationally derived library enabled the redesign of a variant, DuraPETase, which exhibits an apparent melting temperature that is drastically elevated by 31 \u00b0C and a strikingly enhanced degradation toward semicrystalline poly(ethylene terephthalate) (PET) films (30%) at mild temperatures (over 300-fold). Complete biodegradation of 2 g/L microplastics to water-soluble products under mild conditions is also achieved, opening up opportunities to steer the biological degradation of uncollectable PET waste and further conversion of the resulting monomers to high-value molecules. The crystal structure revealed the individual mutation match with the design model. Concurrently, synergistic effects are captured, while epistatic interactions are alleviated during the accumulation process. We anticipate that our design strategy will provide a broadly applicable strategy for global optimization of enzyme performance.","author_count":21,"author_ids":["A5003355711","A5009693445","A5020144785","A5020415389","A5022783439","A5036086539","A5040539007","A5042178740","A5045104920","A5046976591","A5051802294","A5062524393","A5101838771","A5102385381","A5102828205","A5103843943","A5104234491"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5022783439","name":"Yinglu Cui"},{"id":"A5101838771","name":"Yanchun Chen"},{"id":"A5104234491","name":"Xinyue Liu"},{"id":"A5102385381","name":"Saijun Dong"},{"id":"","name":"Yu\u2019e Tian"},{"id":"","name":"Yuxin Qiao"},{"id":"A5040539007","name":"Ruchira Mitra"},{"id":"A5020144785","name":"Jing Han"},{"id":"A5103843943","name":"Chunli Li"},{"id":"","name":"Xu Han"},{"id":"A5003355711","name":"Weidong Liu"},{"id":"","name":"Quan Chen"},{"id":"A5009693445","name":"Wangqing Wei"},{"id":"A5102828205","name":"Xin Wang"},{"id":"A5020415389","name":"Wenbin Du"},{"id":"A5046976591","name":"Shuang\u2010Yan Tang"},{"id":"A5062524393","name":"Hua Xiang"},{"id":"A5036086539","name":"Haiyan Liu"},{"id":"A5051802294","name":"Yong Fang Liang"},{"id":"A5042178740","name":"Kendall N. Houk"}],"ca_any_author":true,"ca_led":false,"cited_by_count":606,"doi":"https://doi.org/10.1021/acscatal.0c05126","domain_tags":["fate_transport_and_sorption","occurrence_and_monitoring"],"facet_tags":[],"institution_ids":["I126520041","I161318765","I19820366","I4210134982","I4210139473","I4210165038","I4391768059","I881766915"],"is_oa":true,"journal":"ACS Catalysis","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by","needs_review":false,"oa_status":"green","oa_url":"https://www.biorxiv.org/content/biorxiv/early/2019/10/30/787069.full.pdf","openalex_topics":["T10044","T10404","T10661"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10404","pub_date":"2021-01-13","study_type":"article","title":"Computational Redesign of a PETase for Plastic Biodegradation under Ambient Condition by the GRAPE Strategy","type":"article","work_id":"W3121331573","year":2021}]}
