,"first_pub_year":1965,"first_year":1994,"h_index":43,"institution_ids":["I84218800"],"last_ca_year":2022,"last_year":1994,"m_quotient":0.7,"name":"Jerold A. Last","orcid":"https://orcid.org/0000-0002-1964-1209","plastic_basis":"openalex","plastic_citations":30,"plastic_works_count":2,"primary_affiliations":[{"country_code":"US","id":"I84218800","name":"University of California, Davis","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":2,"work_ids":["W2015535435","W4241789605"]},"schema_version":"s3.1","works":[{"abstract":"","author_count":5,"author_ids":["A5007106181","A5085069329","A5109160737","A5110218045","A5112423753"],"author_institution_ids":["I84218800"],"authors":[{"id":"A5110218045","name":"Hanspeter R. Witschi"},{"id":"A5007106181","name":"Sara M. Lundgaard"},{"id":"A5112423753","name":"Padmanabhan Sharda Rajini"},{"id":"A5109160737","name":"Andrew G. Hendrickx"},{"id":"A5085069329","name":"Jerold A. Last"}],"ca_any_author":true,"ca_led":true,"cited_by_count":27,"doi":"https://doi.org/10.1016/0378-4274(94)90114-7","domain_tags":[],"facet_tags":[],"institution_ids":["I84218800"],"is_oa":false,"journal":"Toxicology Letters","last_updated":"2026-11-06T12:05:46.655746","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/0378-4274(94)90114-7","openalex_topics":["T10060","T11633","T12229"],"plastic_related":false,"plastic_tier":"","primary_topic":"T11633","pub_date":"1994-05-01","study_type":"article","title":"Effects of exposure to nicotine and to sidestream smoke on pregnancy outcome in rats","type":"article","work_id":"W2015535435","year":1994},{"abstract":"Pregnant Sprague-Dawley rats were exposed to sidestream Cigarette smoke (SS) for 6 hr a day, at a concentration of 1 mg/m3 of respirable total suspended particulate material (TSP) on Days 3, 6\u201310, and 13\u201317 of pregnancy. Controls were kept in an identical chamber without smoke exposure. The animals were killed on Day 20 of gestation. No differences were found in maternal body weight gain or average daily food consumption between the smoke-exposed and control groups. The numbers of fetuses and of implantation sites per litter were comparable among the groups. None of the pups showed any gross malformations and no difference was found between controls and SS-exposed pups when examined for reduced skeletal ossifications. However, there was a small but significant reduction in mean pup weight. We conclude that intermittent exposure of rats to sidestream cigarette smoke at concentrations severalfold greater than those encountered in smokey public indoor environments causes intrauterine growth retardation.","author_count":5,"author_ids":["A5008249397","A5085069329","A5109160737","A5110218045","A5112423753"],"author_institution_ids":["I84218800"],"authors":[{"id":"A5112423753","name":"Padmanabhan Sharda Rajini"},{"id":"A5085069329","name":"Jerold A. Last"},{"id":"A5008249397","name":"Kent E. Pinkerton"},{"id":"A5109160737","name":"Andrew G. Hendrickx"},{"id":"A5110218045","name":"Hanspeter R. Witschi"}],"ca_any_author":true,"ca_led":true,"cited_by_count":3,"doi":"https://doi.org/10.1093/toxsci/22.3.400","domain_tags":[],"facet_tags":["matrix:food_and_drink"],"institution_ids":["I84218800"],"is_oa":false,"journal":"Toxicological Sciences","last_updated":"2026-11-04T10:54:05.112534","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1093/toxsci/22.3.400","openalex_topics":["T10060","T10290","T11633"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T11633","pub_date":"1994-01-01","study_type":"article","title":"Decreased Fetal Weights in Rats Exposed to Sidestream Cigarette Smoke","type":"article","work_id":"W4241789605","year":1994}]}
