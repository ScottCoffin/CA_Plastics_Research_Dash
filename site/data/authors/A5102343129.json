ast_known"}],"rising_pct":9,"rising_score":-0.0128,"work_count":1,"work_ids":["W2312367806"]},"schema_version":"s3.1","works":[{"abstract":"The need for renewable alternatives to traditional petroleum-derived plastics has driven recent interest in biobased composite materials that are sourced from carbon-neutral feedstocks. Lignin, an abundant plant-derived feedstock, has been a candidate for renewable materials; however, it is often difficult to blend with other biopolymers. In order to improve the miscibility of lignin with other bioplastics, we developed a catalytic and solvent free method for synthesis of a lignin\u2013PLA copolymer. Graft polymerization of lactide onto lignin catalyzed by triazabicyclodecene (TBD) resulted in a lignin- g -poly(lactic acid) copolymer; chain length of the PLA is controlled by varying of the lignin/lactide ratio and preacetylation treatment. End-group analysis reveals high grafting efficiency and preferential grafting on lignin aliphatic hydroxyls over phenolic hydroxyls. The lignin- g -PLA copolymers display a glass transition temperature range from 45 to 85 \u00b0C and multiphase melting behavior. The lignin- g -PLA copolymers are used as dispersion modifiers in PLA-based materials to enhance UV absorption and reduce brittleness without a sacrifice in the modulus of elasticity.","author_ids":["A5009737401","A5045999960","A5063798984","A5072106065","A5077663125","A5102343129","A5113725499"],"author_institution_ids":["I97018004"],"ca_any_author":true,"ca_led":true,"cited_by_count":349,"doi":"https://doi.org/10.1021/sc4000835","domain_tags":["soil_and_agriculture","wastewater_and_treatment"],"facet_tags":["matrix:soil_and_agriculture"],"institution_ids":["I97018004"],"is_oa":false,"journal":"ACS Sustainable Chemistry & Engineering","last_updated":"2026-11-07T11:25:07.637180","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/sc4000835","openalex_topics":["T10513","T10661","T11208"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2013-07-26","study_type":"article","title":"A Renewable Lignin\u2013Lactide Copolymer and Application in Biobased Composites","type":"article","work_id":"W2312367806","year":2013}]}
