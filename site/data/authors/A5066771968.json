ntry_code":"US","id":"I4210126421","name":"Forest Products Laboratory","years":[2009]},{"country_code":"US","id":"I1313416372","name":"US Forest Service","years":[2009]},{"country_code":"US","id":"I1336096307","name":"United States Department of Agriculture","years":[2009]},{"country_code":"CN","id":"I37461747","name":"Wuhan University","years":[2009]},{"country_code":"CN","id":"I88372448","name":"Dalian Polytechnic University","years":[2008]},{"country_code":"US","id":"I130701444","name":"Georgia Institute of Technology","years":[1998,2001,2002,2003,2004,2005,2006,2008]},{"country_code":"ES","id":"I251424209","name":"Universitat de Girona","years":[2008]},{"country_code":"FR","id":"I4387154544","name":"Institut National de la Recherche Agronomique","years":[2006]},{"country_code":"JP","id":"I60134161","name":"Nagoya University","years":[2003]},{"country_code":"JP","id":"I69740276","name":"Tokyo Metropolitan University","years":[2003]},{"country_code":"US","id":"I5388228","name":"University of Rochester","years":[1996,1998,2003]},{"country_code":"US","id":"I1343871089","name":"Los Alamos National Laboratory","years":[1998]},{"country_code":"US","id":"I33213144","name":"University of Florida","years":[1993,1994,1996,1997,1998]}],"author_id":"A5066771968","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":1008,"plastic":0,"year":2017},{"all":1044,"plastic":0,"year":2018},{"all":1201,"plastic":0,"year":2019},{"all":1431,"plastic":3,"year":2020},{"all":1608,"plastic":11,"year":2021},{"all":1631,"plastic":19,"year":2022},{"all":1561,"plastic":24,"year":2023},{"all":1712,"plastic":46,"year":2024},{"all":1937,"plastic":52,"year":2025},{"all":2073,"plastic":77,"year":2026}],"cited_by_count":19376,"current_in_ca":false,"domain_tags":[],"early_career":false,"first_pub_year":1993,"first_year":2020,"h_index":60,"institution_ids":["I137902535","I148283060"],"last_ca_year":null,"last_year":2020,"m_quotient":1.82,"name":"Lucian A. Lucia","orcid":"https://orcid.org/0000-0003-0157-2505","plastic_basis":"openalex","plastic_citations":232,"plastic_works_count":13,"primary_affiliations":[{"country_code":"US","id":"I137902535","name":"North Carolina State University","source":"openalex_last_known"}],"rising_pct":77,"rising_score":0.0079,"work_count":1,"work_ids":["W3102371844"]},"schema_version":"s3.1","works":[{"abstract":"Society\u2019s wish list for future packaging systems is placing some daunting challenges upon researchers: In addition to protecting contents during storage and shipping, the material must not bio-accumulate, and it should be readily recyclable by using practical processing steps. This article considers strategies employing bio-based plastics and reviews published information relative to their performance. Though bioplastics such as poly(lactic acid) (PLA) and poly(hydroxybutyrate) (PHB) can be prepared from plant materials, their default properties are generally inferior to those of popular synthetic plastics. In addition, some bioplastics are not easily decomposed in soil or seawater, and the polymers can undergo chemical breakdown during recycling. This review considers strategies to overcome such challenges, including the use of biodegradable cellulose-based reinforcing particles. In addition to contributing to strength, the cellulose can swell the bioplastic, allowing enzymatic attack. The rate-controlling step in bioplastic degradation also can be abiotic, i.e. not involving enzymes. Though there is much more work to be done, much progress has been achieved in formulating bioplastic composites that are biodegradable, recyclable, and higher in strength compared to the neat polymer. Emphasis in this review is placed on PLA and PHB, but not to the exclusion of other bioplastic matrix materials.","author_count":4,"author_ids":["A5019229507","A5021322218","A5066771968","A5083527126"],"author_institution_ids":["I137902535","I148283060"],"authors":[{"id":"A5021322218","name":"Martin Allen Hubbe"},{"id":"A5083527126","name":"Nathalie Lavoine"},{"id":"A5066771968","name":"Lucian A. Lucia"},{"id":"A5019229507","name":"Chang Dou"}],"ca_any_author":true,"ca_led":true,"cited_by_count":73,"doi":"https://doi.org/10.15376/biores.16.1.hubbe","domain_tags":["fate_transport_and_sorption","soil_and_agriculture"],"facet_tags":["matrix:food_and_drink","matrix:soil_and_agriculture"],"institution_ids":["I137902535","I148283060"],"is_oa":true,"journal":"BioResources","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"gold","oa_url":"https://bioresources.cnr.ncsu.edu/wp-content/uploads/2020/11/BioRes_16_1_2021_Hubbe_LLD_REVIEW_Fomulating_Bioplastic_Composites_Recyc_Performce_18024.pdf","openalex_topics":["T10488","T10513","T10661"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10661","pub_date":"2020-11-01","study_type":"article","title":"Formulating bioplastic composites for biodegradability, recycling, and performance: A Review","type":"article","work_id":"W3102371844","year":2020}]}
