,2004]},{"country_code":"GB","id":"I43439940","name":"University of Southampton","years":[2000]},{"country_code":"US","id":"I2801159745","name":"Huntsman Cancer Institute","years":[1998]},{"country_code":"US","id":"I223532165","name":"University of Utah","years":[1998]}],"author_id":"A5047794053","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":337,"plastic":0,"year":2017},{"all":382,"plastic":0,"year":2018},{"all":450,"plastic":0,"year":2019},{"all":620,"plastic":0,"year":2020},{"all":767,"plastic":0,"year":2021},{"all":821,"plastic":0,"year":2022},{"all":763,"plastic":0,"year":2023},{"all":822,"plastic":0,"year":2024},{"all":787,"plastic":0,"year":2025},{"all":677,"plastic":0,"year":2026}],"cited_by_count":9292,"domain_tags":[],"early_career":false,"first_pub_year":1992,"first_year":2022,"h_index":49,"institution_ids":["I84218800"],"last_year":2022,"m_quotient":1.44,"name":"Carolyn M. Slupsky","orcid":"https://orcid.org/0000-0002-5100-1594","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"US","id":"I84218800","name":"University of California, Davis","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4294838990"]},"schema_version":"s3.1","works":[{"abstract":"Prenatal exposure to phthalates, a family of endocrine-disrupting plasticizers, is associated with disruption of maternal metabolism and impaired neurodevelopment. We investigated associations between prenatal phthalate exposure and alterations of both the maternal third trimester serum metabolome and the placental metabolome at birth, and associations of these with child neurodevelopmental outcomes using data and samples from the Markers of Autism Risk in Babies Learning Early Signs (MARBLES) cohort. The third trimester serum (n = 106) and placental (n = 132) metabolomes were investigated using 1H nuclear magnetic resonance spectroscopy. Children were assessed clinically for autism spectrum disorder (ASD) and cognitive development. Although none of the urinary phthalate metabolite concentrations were associated with maternal serum metabolites after adjustment for covariates, mixture analysis using quantile g-computation revealed alterations in placental metabolites with increasing concentrations of phthalate metabolites that included reduced concentrations of 2-hydoxybutyrate, carnitine, O-acetylcarnitine, glucitol, and N-acetylneuraminate. Child neurodevelopmental outcome was not associated with the third trimester serum metabolome, but it was correlated with the placental metabolome in male children only. Maternal phthalate exposure during pregnancy is associated with differences in the placental metabolome at delivery, and the placental metabolome is associated with neurodevelopmental outcomes in males in a cohort with high familial ASD risk.","author_count":9,"author_ids":["A5007281012","A5011753086","A5036896252","A5038452276","A5040217678","A5042457051","A5046460654","A5047794053","A5073062370"],"author_institution_ids":["I84218800"],"authors":[{"id":"A5046460654","name":"Mariana Parenti"},{"id":"A5038452276","name":"Rebecca J. Schmidt"},{"id":"A5007281012","name":"Sally J. Ozonoff"},{"id":"A5040217678","name":"Hyeong\u2010Moo Shin"},{"id":"A5036896252","name":"Daniel Joseph Tancredi"},{"id":"A5011753086","name":"Paula Krakowiak"},{"id":"A5073062370","name":"Irva Hertz\u2010Picciotto"},{"id":"A5042457051","name":"Cheryl K. Walker"},{"id":"A5047794053","name":"Carolyn M. Slupsky"}],"ca_any_author":true,"ca_led":true,"cited_by_count":30,"doi":"https://doi.org/10.3390/metabo12090829","domain_tags":["human_exposure_and_health_risk"],"facet_tags":[],"institution_ids":["I157394403","I84218800"],"is_oa":true,"journal":"Metabolites","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://www.mdpi.com/2218-1989/12/9/829/pdf?version=1662120541","openalex_topics":["T10686","T