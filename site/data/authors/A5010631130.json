},{"all":906,"plastic":666,"year":2020},{"all":1062,"plastic":799,"year":2021},{"all":965,"plastic":699,"year":2022},{"all":994,"plastic":712,"year":2023},{"all":875,"plastic":603,"year":2024},{"all":723,"plastic":535,"year":2025},{"all":594,"plastic":375,"year":2026}],"cited_by_count":10528,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1997,"first_year":2012,"h_index":38,"institution_ids":["I1174212","I4210142476"],"last_ca_year":2026,"last_year":2014,"m_quotient":1.31,"name":"J. C. Borrero","orcid":"https://orcid.org/0000-0003-4879-3890","plastic_basis":"openalex","plastic_citations":5918,"plastic_works_count":2,"primary_affiliations":[{"country_code":"US","id":"I1174212","name":"University of Southern California","source":"openalex_last_known"}],"rising_pct":0,"rising_score":-0.2302,"work_count":2,"work_ids":["W2038832122","W2130707940"]},"profile":{"bio":"","keywords":["tsunami","erosion","nature based solutions","coastal protection","coastal hazards"],"links":[{"label":"Personal Web Page","url":"http://www.jocabo.net"},{"label":"Business Website","url":"http://www.orcas-coastal.com"},{"label":"Tsunami Research","url":"http://www.tsunamiresearch.co.nz"}]},"schema_version":"s3.1","works":[{"abstract":"","author_count":3,"author_ids":["A5010631130","A5035510229","A5050157218"],"author_institution_ids":["I1174212"],"authors":[{"id":"A5050157218","name":"Laurent Lebreton"},{"id":"A5035510229","name":"S. Dougal Greer"},{"id":"A5010631130","name":"J. C. Borrero"}],"ca_any_author":true,"ca_led":true,"cited_by_count":896,"doi":"https://doi.org/10.1016/j.marpolbul.2011.10.027","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I1174212"],"is_oa":false,"journal":"Marine Pollution Bulletin","last_updated":"2026-11-11T12:16:26.678958","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.marpolbul.2011.10.027","openalex_topics":["T10255","T10753","T12316"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10753","pub_date":"2012-01-27","study_type":"article","title":"Numerical modelling of floating debris in the world\u2019s oceans","type":"article","work_id":"W2038832122","year":2012},{"abstract":"Plastic pollution is ubiquitous throughout the marine environment, yet estimates of the global abundance and weight of floating plastics have lacked data, particularly from the Southern Hemisphere and remote regions. Here we report an estimate of the total number of plastic particles and their weight floating in the world's oceans from 24 expeditions (2007-2013) across all five sub-tropical gyres, costal Australia, Bay of Bengal and the Mediterranean Sea conducting surface net tows (N = 680) and visual survey transects of large plastic debris (N = 891). Using an oceanographic model of floating debris dispersal calibrated by our data, and correcting for wind-driven vertical mixing, we estimate a minimum of 5.25 trillion particles weighing 268,940 tons. When comparing between four size classes, two microplastic <4.75 mm and meso- and macroplastic >4.75 mm, a tremendous loss of microplastics is observed from the sea surface compared to expected rates of fragmentation, suggesting there are mechanisms at play that remove <4.75 mm plastic particles from the ocean surface.","author_count":9,"author_ids":["A5009412499","A5010631130","A5012886667","A5023495526","A5026034854","A5037974743","A5041423834","A5050157218","A5106859066"],"author_institution_ids":["I4210142476"],"authors":[{"id":"A5041423834","name":"Marcus Eriksen"},{"id":"A5050157218","name":"Laurent Lebreton"},{"id":"A5026034854","name":"Henry S. Carson"},{"id":"A5012886667","name":"Mart\u00edn Thiel"},{"id":"A5106859066","name":"Charles James Moore"},{"id":"A5010631130","name":"J. C. Borrero"},{"id":"A5009412499","name":"Fran\u00e7ois Galgani"},{"id":"A5023495526","name":"Peter G. Ryan"},{"id":"A5037974743","name":"J\u00falia Reisser"}],"ca_any_author":true,"ca_led":true,"cited_by_count":5020,"doi":"https://doi.org/10.1371/journal.pone.0111913","domain_tags":["occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I154202486","I157614274","I177877127","I2802166871","I35722693","I4210132764","I4210142476","I4405252610","I56947373"],"is_oa":true,"journal":"PLoS ONE","last_updated":"2026-11-10T11:39:43.021295","license":"public-domain","needs_review":false,"oa_status":"gold","oa_url":"https://journals.plos.org/plosone/article/file?id=10.1371/journal.pone.0111913&type=printable","openalex_topics":["T10032","T10753","T12316"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2014-12-10","study_type":"article","title":"Plastic Pollution in the World's Oceans: More than 5 Trillion Plastic Pieces Weighing over 250,000 Tons Afloat at Sea","type":"article","work_id":"W2130707940","year":2014}]}
