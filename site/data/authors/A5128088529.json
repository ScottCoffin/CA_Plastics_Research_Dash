{"author":{"affiliation_history":[{"country_code":"US","id":"I148283060","name":"Lawrence Berkeley National Laboratory","years":[2013,2020,2021,2023,2026]},{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","years":[2019,2020,2021,2023,2024,2026]},{"country_code":"CA","id":"I151746483","name":"University of Waterloo","years":[2026]}],"author_id":"A5128088529","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":0,"plastic":0,"year":2021},{"all":1,"plastic":0,"year":2022},{"all":1,"plastic":0,"year":2023},{"all":4,"plastic":0,"year":2024},{"all":3,"plastic":0,"year":2025},{"all":2,"plastic":0,"year":2026}],"cited_by_count":12,"domain_tags":[],"early_career":true,"first_pub_year":2021,"first_year":2026,"h_index":2,"institution_ids":["I95457486"],"last_year":2026,"m_quotient":0.4,"name":"Jeffrey Reimer","orcid":"","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I148283060","name":"Lawrence Berkeley National Laboratory","source":"openalex_last_known"},{"country_code":"CA","id":"I151746483","name":"University of Waterloo","source":"openalex_last_known"},{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W7165908127"]},"schema_version":"s3.1","works":[{"abstract":"Blending polymers produces brittle materials due to macrophase separation and poor interfacial adhesion, which is exemplified by mixtures of polyolefins. This presents a formidable challenge for the mechanical recycling of mixed plastic waste. Here, we demonstrate that dynamic covalent crosslinking of immiscible polyolefin blends creates macrophase-separated co-continuous architectures, yet they display excellent mechanical properties, which challenges the conventional wisdom regarding morphology-property relationships in polymer blend compatibilization. We find that the position and orientation of dynamic crosslinks and their influence on crystallinity are key to understanding the structure-morphology-property relationships. In particular, high-resolution microscopy imaging reveals alignment of crystallite planes with strong orientational preference, particularly at polymer-polymer interfaces, which contribute to material performance. We further demonstrate that changes in crosslinker density and valency allow the properties of binary and ternary polyolefin blends to be tuned in a modular fashion.","author_count":15,"author_ids":["A5001839231","A5006463823","A5006948939","A5010555283","A5012680865","A5056066091","A5056365904","A5062519013","A5066668731","A5075220872","A5083706074","A5108822322","A5108823605","A5128088529","A5129794252"],"author_institution_ids":["I95457486"],"authors":[{"id":"A5066668731","name":"Eliza K. Neidhart"},{"id":"A5006463823","name":"Stephanie M. Ribet"},{"id":"A5108823605","name":"T N Guhr Lee"},{"id":"A5083706074","name":"Logan T. Kearney"},{"id":"A5129794252","name":"Karen Bustillo"},{"id":"A5075220872","name":"Eric A. Dailing"},{"id":"A5001839231","name":"Mutian Hua"},{"id":"A5006948939","name":"Colin Ophus"},{"id":"A5010555283","name":"S Fricke"},{"id":"A5056365904","name":"Ah\u2010Young Song"},{"id":"A5128088529","name":"Jeffrey Reimer"},{"id":"A5056066091","name":"Erik J. Alexanian"},{"id":"A5108822322","name":"J.S. Atkin"},{"id":"A5012680865","name":"Brett A. Helms"},{"id":"A5062519013","name":"Frank A. Leibfarth"}],"ca_any_author":true,"ca_led":false,"cited_by_count":0,"doi":"https://doi.org/10.5061/dryad.p2ngf1w4z","domain_tags":[],"facet_tags":[],"institution_ids":["I114027177","I1289243028","I148283060","I201448701","I95457486","I97018004"],"is_oa":true,"journal":"DRYAD","last_updated":"2026-10-14T16:39:01.820549","license":"public-domain","needs_review":false,"oa_status":"green","oa_url":"https://doi.org/10.5061/dryad.p2ngf1w4z","openalex_topics":["T10389","T10810","T11471"],"pla