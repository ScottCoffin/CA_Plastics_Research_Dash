sity","years":[1996]}],"author_id":"A5113775237","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":328,"plastic":0,"year":2017},{"all":286,"plastic":0,"year":2018},{"all":309,"plastic":0,"year":2019},{"all":329,"plastic":0,"year":2020},{"all":357,"plastic":0,"year":2021},{"all":224,"plastic":0,"year":2022},{"all":213,"plastic":0,"year":2023},{"all":201,"plastic":0,"year":2024},{"all":166,"plastic":0,"year":2025},{"all":124,"plastic":0,"year":2026}],"cited_by_count":5558,"current_in_ca":false,"domain_tags":[],"early_career":false,"first_pub_year":1990,"first_year":2014,"h_index":28,"institution_ids":["I1280536761"],"last_ca_year":2014,"last_year":2014,"m_quotient":0.78,"name":"Masood Z. Hadi","orcid":"","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":2,"primary_affiliations":[{"country_code":"","id":"I1280536761","name":"Ames Research Center","source":"atlas_recent"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W2965797350"]},"schema_version":"s3.1","works":[{"abstract":"Plastic is the major waste-product during NASA space missions, recycling this waste-stream to produce other beneficial materials would decrease upmass. Bacterial called plastisomes have been demonstrated to metabolize non-biodegradable plastics such as polyethylene and polystyrene. Characterization and engineering of these bacteria, and their eventual incorporation as life support systems would enable space flight beyond lower earth orbit. We will utilize molecular techniques to identify and isolate the most productive plastisome. Environmental samples obtained from locations known to be rich in plastic will be cultured in a laboratory defined-media supplemented with plastic as the sole carbon source. Cultures will be monitored for growth over time. Ribosomal DNA will be amplified from cultures that exhibit growth using PCR. These amplified fragments will be sequenced to determine the identity of the consortia in the cultures. We will then perform bioinformatics analysis on the data to identify the plastisomes and generate phylogenetic trees. Morphological and physiological profile of the plastisomes will also be conducted by microscopy and biochemical tests. Our results would reveal a bacterial strain that can break down plastics efficiently. The implication for this project would not only benefit space exploration but also make a major impact towards sustainability development on Earth.","author_count":5,"author_ids":["A5039217128","A5059895110","A5088844069","A5112459402","A5113775237"],"author_institution_ids":["I1280536761"],"authors":[{"id":"A5112459402","name":"Nathan Nguyen"},{"id":"A5059895110","name":"Tyler Cleveland"},{"id":"A5088844069","name":"Josiah Paul Zayner"},{"id":"A5039217128","name":"Frank F. Shang"},{"id":"A5113775237","name":"Masood Z. Hadi"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"","domain_tags":["analytical_methods"],"facet_tags":["matrix:freshwater"],"institution_ids":["I1280536761","I180670191","I185103710"],"is_oa":false,"journal":"NASA Technical Reports Server (NASA)","last_updated":"2026-11-01T11:40:01.658920","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://ntrs.nasa.gov/api/citations/20190026641/downloads/20190026641.pdf","openalex_topics":["T10324","T10661","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10324","pub_date":"2014-08-02","study_type":"article","title":"Characterization of Plastic Degrading Bacteria from Environmental Samples by Genetic and Biochemical Analysis","type":"article","work_id":"W2965797350","year":2014}]}
