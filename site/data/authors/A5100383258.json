":"University of California, Los Angeles","years":[2005]},{"country_code":"CN","id":"I204983213","name":"Harbin Institute of Technology","years":[2002]},{"country_code":"US","id":"I27837315","name":"University of Michigan","years":[1997,1998,1999,2000,2001,2002]},{"country_code":"CN","id":"I180585399","name":"Dalian Institute of Chemical Physics","years":[2000]},{"country_code":"CN","id":"I4391767904","name":"State Key Laboratory of Catalysis","years":[2000]},{"country_code":"DE","id":"I62916508","name":"Technical University of Munich","years":[1999]},{"country_code":"TW","id":"I75357094","name":"National Yunlin University of Science and Technology","years":[1995]}],"author_id":"A5100383258","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":1311,"plastic":5,"year":2017},{"all":1570,"plastic":2,"year":2018},{"all":2051,"plastic":5,"year":2019},{"all":2621,"plastic":3,"year":2020},{"all":3004,"plastic":1,"year":2021},{"all":3054,"plastic":2,"year":2022},{"all":2840,"plastic":3,"year":2023},{"all":3247,"plastic":2,"year":2024},{"all":3142,"plastic":3,"year":2025},{"all":2417,"plastic":0,"year":2026}],"cited_by_count":34799,"domain_tags":[],"early_career":false,"first_pub_year":1986,"first_year":2002,"h_index":89,"institution_ids":["I95457486"],"last_year":2005,"m_quotient":2.23,"name":"Liwei Lin","orcid":"https://orcid.org/0000-0001-7083-624X","plastic_basis":"openalex","plastic_citations":134,"plastic_works_count":3,"primary_affiliations":[{"country_code":"CN","id":"I24185976","name":"Sichuan University","source":"openalex_last_known"},{"country_code":"CN","id":"I4210153482","name":"Changzhou University","source":"openalex_last_known"},{"country_code":"CN","id":"I87445476","name":"Xi'an Jiaotong University","source":"openalex_last_known"},{"country_code":"US","id":"I95457486","name":"University of California, Berkeley","source":"openalex_last_known"}],"rising_pct":41,"rising_score":0.0001,"work_count":1,"work_ids":["W2091329075"]},"profile":{"bio":"","keywords":["MEMS","Nano Technology"],"links":[{"label":"Homepage","url":"https://lwlin.me.berkeley.edu/"}]},"schema_version":"s3.1","works":[{"abstract":"Recently, millimeter-wave devices have been attracted more attentions in applications owing to their short wavelengths, higher resolutions, broader bandwidths and higher environmental tolerance. The great challenges of high fabrication and assembly costs, bulky volumes, and heavy weights of millimeter-wave systems call for new integrated manufacturing techniques. The hot embossing technique could address these challenges. In this paper, a review of micro plastic hot embossing was given for the fabrication of miniaturized millimeter-wave systems. The micro hot embossing on plastic materials demonstrated its advantages on significant costs, volume and weight reduction, while maintaining high performances. We have designed, fabricated and characterized a W-band rectangular waveguide and a W-band iris waveguide filter with integrated plastic flanges using micro hot embossing and selective electroplating. In this paper, we reviewed the results and discussed the design methodology in details for the micromachined components. The prototype devices showed promise for the system designs.","author_count":5,"author_ids":["A5033472595","A5049737468","A5100383258","A5101692994","A5103476842"],"author_institution_ids":["I95457486"],"authors":[{"id":"A5101692994","name":"Ying Cai"},{"id":"A5049737468","name":"Firas Sammoura"},{"id":"A5103476842","name":"Chen-Yu Chi"},{"id":"A5100383258","name":"Liwei Lin"},{"id":"A5033472595","name":"J.\u2010C. Chiao"}],"ca_any_author":true,"ca_led":false,"cited_by_count":2,"doi":"https://doi.org/10.1117/12.638259","domain_tags":[],"facet_tags":[],"institution_ids":["I138285227","I189196454","I95457486"],"is_oa":false,"journal":"Proceedings of SPIE, the International Society for Optical Engineering/Proceedings of SPIE","last_updated":"2026-09-26T08:19:03.415552","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1117/12.638259","openalex_topics":["T10262","T10369","T10752"],"plastic_related":false,"plastic_tier":"","primary_topic":"T10262","pub_date":"2005-12-28","study_type":"conference-paper","title":"Micro hot embossed plastic millimeter-wave systems","type":"conference-paper","work_id":"W2091329075","year":2005}]}
