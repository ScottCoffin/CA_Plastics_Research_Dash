_year":2017,"h_index":10,"institution_ids":["I106745318","I124104796","I1308126019","I4387930223"],"last_year":2017,"m_quotient":0.62,"name":"Claire A. Simeone","orcid":"https://orcid.org/0000-0002-4576-4106","plastic_basis":"openalex","plastic_citations":38,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I124104796","name":"Marine Mammal Center","source":"openalex_last_known"},{"country_code":"US","id":"I157725225","name":"University of Illinois Urbana-Champaign","source":"openalex_last_known"},{"country_code":"US","id":"I2801919071","name":"University of Illinois System","source":"openalex_last_known"},{"country_code":"CA","id":"I32625721","name":"University of Saskatchewan","source":"openalex_last_known"},{"country_code":"US","id":"I4210090881","name":"National Marine Mammal Foundation","source":"openalex_last_known"}],"rising_pct":32,"rising_score":-0.0011,"work_count":1,"work_ids":["W2766958317"]},"profile":{"bio":"","keywords":["Marine Mammal","California sea lion","Bottlenose dolphin","Conservation","Ophthalmology","Pinniped","Cetacean","Marine Debris","Health"],"links":[{"label":"The Marine Mammal Center","url":"http://www.marinemammalcenter.org"},{"label":"TMMC - International Veterinary In-Residence","url":"http://www.marinemammalcenter.org/science/ivir/"}]},"schema_version":"s3.1","works":[{"abstract":"Abstract A total of 11,162 stranded marine mammals was admitted to a rehabilitation center on the central California coast between January 2003 and September 2015. Six hundred seventeen animals (6%) had evidence of anthropogenic trauma (AT). California sea lions comprised the majority (83%) of AT cases, particularly by entanglement in marine debris (n = 277) and gunshot injuries (n = 165). Guadalupe fur seals had the highest prevalence of entanglement in marine debris. Cetaceans were primarily affected by boat collisions (n = 19). The highest numbers of overall strandings were recorded in 2009 (n = 1,690) and 2015 (n = 1,666); 2009 also had the highest total number (n = 137) and prevalence (8%) of AT cases. Prevalence of fishing tackle cases increased compared to similar data from 1986 to 1998 while prevalence of gunshot cases decreased, and other causes remained static. Cases of fisheries interactions were further examined and characterized, and when direct fisheries interactions were separated from other causes of AT, fisheries interactions accounted for 50% (n = 310) of all AT cases during the study period. Direct fisheries interactions were the most common type of AT observed among stranded marine mammals in central California. Tracking AT trends is important to further understand possible causes and inform mitigation efforts.","author_count":4,"author_ids":["A5002433494","A5020949551","A5022237535","A5077449581"],"author_institution_ids":["I106745318","I124104796","I1308126019","I4387930223"],"authors":[{"id":"A5022237535","name":"Daniela B\u00e1rcenas de la Cruz"},{"id":"A5020949551","name":"Eugene J. DeRango"},{"id":"A5077449581","name":"Shawn Johnson"},{"id":"A5002433494","name":"Claire A. Simeone"}],"ca_any_author":true,"ca_led":true,"cited_by_count":38,"doi":"https://doi.org/10.1111/mms.12457","domain_tags":[],"facet_tags":["matrix:marine"],"institution_ids":["I106745318","I124104796","I1308126019","I158011677","I4387930223"],"is_oa":false,"journal":"Marine Mammal Science","last_updated":"2026-11-07T11:25:07.637180","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1111/mms.12457","openalex_topics":["T10659","T10753","T11622"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10659","pub_date":"2017-10-23","study_type":"article","title":"Evidence of anthropogenic trauma in marine mammals stranded along the central California coast, 2003\u20132015","type":"article","work_id":"W2766958317","year":2017}]}
