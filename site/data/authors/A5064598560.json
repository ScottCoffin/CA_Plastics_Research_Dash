s. Results from our study provide empirical data on the distribution of microplastics on the most populated and visited of the Hawaiian islands.","author_count":3,"author_ids":["A5004811779","A5042897849","A5064598560"],"author_institution_ids":["I103635307"],"authors":[{"id":"A5042897849","name":"Savannah Franklin Rey"},{"id":"A5064598560","name":"Janet Franklin"},{"id":"A5004811779","name":"Sergio Joseph Rey"}],"ca_any_author":true,"ca_led":true,"cited_by_count":53,"doi":"https://doi.org/10.1371/journal.pone.0247224","domain_tags":[],"facet_tags":[],"institution_ids":["I103635307","I149581226"],"is_oa":true,"journal":"PLoS ONE","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://journals.plos.org/plosone/article/file?id=10.1371/journal.pone.0247224&type=printable","openalex_topics":["T10419","T10753","T11656"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2021-02-18","study_type":"article","title":"Microplastic pollution on island beaches, Oahu, Hawai`i","type":"article","work_id":"W3130765807","year":2021}]}
