de":"AT","id":"I15766117","name":"University of Graz","years":[1998]},{"country_code":"US","id":"I1282311441","name":"Lawrence Livermore National Laboratory","years":[1995]},{"country_code":"IL","id":"I124227911","name":"Ben-Gurion University of the Negev","years":[1993]},{"country_code":"DE","id":"I110079840","name":"University of Hohenheim","years":[1985,1987]},{"country_code":"US","id":"I149919469","name":"California Polytechnic State University","years":[1985]}],"author_id":"A5074121194","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":475,"plastic":0,"year":2017},{"all":492,"plastic":0,"year":2018},{"all":524,"plastic":0,"year":2019},{"all":771,"plastic":0,"year":2020},{"all":802,"plastic":0,"year":2021},{"all":856,"plastic":0,"year":2022},{"all":758,"plastic":0,"year":2023},{"all":699,"plastic":0,"year":2024},{"all":750,"plastic":0,"year":2025},{"all":514,"plastic":3,"year":2026}],"cited_by_count":9941,"domain_tags":[],"early_career":false,"first_pub_year":1985,"first_year":2025,"h_index":53,"institution_ids":["I1312222531","I1336096307","I4210090748"],"last_year":2025,"m_quotient":1.29,"name":"Gary S. Ba\u00f1uelos","orcid":"https://orcid.org/0000-0002-9161-6139","plastic_basis":"openalex","plastic_citations":3,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I1312222531","name":"Agricultural Research Service","source":"openalex_last_known"},{"country_code":"US","id":"I4210090748","name":"San Joaquin Valley Agricultural Sciences Center","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4417263513"]},"schema_version":"s3.1","works":[{"abstract":"Microplastics (MPs) and Sclerotinia sclerotiorum (HP) impair plant growth; however, their combined effects and selenium nanoparticles (SeNPs) mitigation remain unclear. This study assessed SeNPs\u2019 protective role in rapeseed ( Brassica napus L.) under combined biotic-abiotic stress using physiological, biochemical, and transcriptomic analyses. SeNPs enhanced seed germination and vigor, whereas MPs reduced the rate of growth. Co-application of SeNPs with MPs alleviated stress by improving photosynthesis, chlorophyll, nitrogen assimilation, and leaf moisture. SeNPs showed strong antifungal activity against S. sclerotiorum (EC 5 0 = 9.15 mg/L), resulting in hyphal distortion and reducing the secretion of cellulase, polygalacturonase, and oxalic acid. Under combined stress, SeNPs decreased ROS and lipid peroxidation, modulated H 2 O 2, and enhanced antioxidant enzymes, glutathione, and PAL. Transcriptomic analysis revealed that SeNPs restored photosynthetic and defense-related gene expression, modulated MAPK signaling, and enhanced redox balance. Overall, SeNPs mitigate MP-induced phytotoxicity and fungal pathogenicity, highlighting their regulatory potential and the need to consider health risks from environmental MP exposure.","author_count":6,"author_ids":["A5002726018","A5053297764","A5054596048","A5074121194","A5102967691","A5106613360"],"author_institution_ids":["I1312222531","I1336096307","I4210090748"],"authors":[{"id":"A5054596048","name":"Kunhao Zhang"},{"id":"A5102967691","name":"Muhammad Raza Farooq"},{"id":"A5053297764","name":"Youtao Chen"},{"id":"A5002726018","name":"Xuebin Yin"},{"id":"A5074121194","name":"Gary S. Ba\u00f1uelos"},{"id":"A5106613360","name":"Miao Li"}],"ca_any_author":true,"ca_led":false,"cited_by_count":3,"doi":"https://doi.org/10.1021/acs.jafc.5c10601","domain_tags":["soil_and_agriculture"],"facet_tags":["matrix:soil_and_agriculture"],"institution_ids":["I1312222531","I1336096307","I140221134","I4210090748","I4210109416"],"is_oa":false,"journal":"Journal of Agricultural and Food Chemistry","last_updated":"2026-11-01T11:40:01.658920","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.jafc.5c10601","openalex_topics":["T10014","T10753","T12771"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T12771","pub_date":"2025-12-12","study_type":"article","title":"Dual-Stress Mitigation of Sclerotinia under Microplastic Toxicity by Nano-Selenium: Redox Balance, Pathogen Suppression, and Transcriptome Reprogramming","type":"article","work_id":"W4417263513","year":2025}]}
