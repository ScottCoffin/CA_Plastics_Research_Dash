{"author":{"affiliation_history":[{"country_code":"US","id":"I55732556","name":"Arizona State University","years":[2024,2025,2026]},{"country_code":"US","id":"I154570441","name":"University of California, Santa Barbara","years":[2016,2018,2019,2020,2021,2022]},{"country_code":"US","id":"I130238516","name":"University of Minnesota","years":[2016,2022]},{"country_code":"US","id":"I86519309","name":"The University of Texas at Austin","years":[2012,2014,2016,2017,2021]},{"country_code":"GB","id":"I71052956","name":"University of Reading","years":[2016]},{"country_code":"CA","id":"I151746483","name":"University of Waterloo","years":[2016]},{"country_code":"US","id":"I4405271599","name":"Texas Materials Institute","years":[2012]}],"author_id":"A5044252746","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":47,"plastic":0,"year":2017},{"all":44,"plastic":0,"year":2018},{"all":73,"plastic":0,"year":2019},{"all":113,"plastic":0,"year":2020},{"all":147,"plastic":0,"year":2021},{"all":208,"plastic":0,"year":2022},{"all":234,"plastic":6,"year":2023},{"all":271,"plastic":6,"year":2024},{"all":294,"plastic":6,"year":2025},{"all":244,"plastic":3,"year":2026}],"cited_by_count":1815,"domain_tags":[],"early_career":false,"first_pub_year":2012,"first_year":2022,"h_index":19,"institution_ids":["I154570441"],"last_year":2022,"m_quotient":1.36,"name":"Jeffrey L. Self","orcid":"https://orcid.org/0000-0002-9394-4582","plastic_basis":"openalex","plastic_citations":21,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I55732556","name":"Arizona State University","source":"openalex_last_known"}],"rising_pct":50,"rising_score":0.0018,"work_count":1,"work_ids":["W4306811487"]},"profile":{"bio":"","keywords":[],"links":[{"label":"Self Lab at ASU","url":"https://labs.engineering.asu.edu/self/"}]},"schema_version":"s3.1","works":[{"abstract":"Covalent adaptable networks (CANs) typically require external catalysts for efficient cross-linker exchange, which can limit network reprocessability due to catalyst leaching and degradation. In this study, catalysts were avoided by using a bicyclo[3.3.1]nonane bis-alkyl halide cross-linker with sulfur-atom neighboring group participation (NGP) to increase the rate of bond exchange. Stress relaxation analyses demonstrate that the resultant pyridine-based network has an Arrhenius dependence on viscous flow at elevated temperatures (130\u2013170 \u00b0C), which arises from S N 1 transalkylation exchange. This thermally mediated cross-link interchange and associated flow behavior enabled reprocessing of the ionic networks over multiple damage and repair cycles. Additionally, these NGP-based CANs are chemically recyclable, allowing for recovery of the pyridyl-based polymer starting material, which comprises >90 wt % of the parent network. The dual thermal and chemical recycling potential of this catalyst-free CAN platform addresses key criteria for designing thermosets with extended lifecycles.","author_count":7,"author_ids":["A5001435522","A5006028538","A5036216864","A5044252746","A5064340656","A5069441535","A5091065613"],"author_institution_ids":["I154570441"],"authors":[{"id":"A5006028538","name":"Lindsay L. Robinson"},{"id":"A5069441535","name":"Eden S. Taddese"},{"id":"A5044252746","name":"Jeffrey L. Self"},{"id":"A5001435522","name":"Christopher M. Bates"},{"id":"A5036216864","name":"Javier Read de Alaniz"},{"id":"A5091065613","name":"Zhishuai Geng"},{"id":"A5064340656","name":"Craig J. Hawker"}],"ca_any_author":true,"ca_led":true,"cited_by_count":21,"doi":"https://doi.org/10.1021/acs.macromol.2c01618","domain_tags":["analytical_methods","fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I142207940","I154570441"],"is_oa":false,"journal":"Macromolecules","last_updated":"2026-10-22T18:32:59.640997","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/acs.macromol.2c01618","openalex_topics":["T10405","T10810","T11145"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10810","pub_date":"2022-10-19","study_type":"article","title":"Neighboring Group Participation in Ionic Covalent Adaptable Networks","type":"article","work_id":"W4306811487","year":2022}]}
