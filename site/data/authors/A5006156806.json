/doi.org/10.2139/ssrn.6210414","domain_tags":["soil_and_agriculture"],"facet_tags":["matrix:soil_and_agriculture"],"institution_ids":["I1280640908"],"is_oa":true,"journal":"SSRN Electronic Journal","last_updated":"2026-11-09T13:22:03.289127","license":"","needs_review":false,"oa_status":"green","oa_url":"https://doi.org/10.2139/ssrn.6210414","openalex_topics":["T10111","T10753","T13890"],"plastic_related":true,"plastic_tier":"","primary_topic":"T10111","pub_date":"2026-01-01","study_type":"preprint","title":"Fields of plastic: Tracking the growing footprint of agricultural plastics using remote sensing in California","type":"preprint","work_id":"W7128534292","year":2026},{"abstract":"Code repository to accompany Geyer et al., Policy is Essential to Curb Plastic Pollution: The Example of California's Senate Bill 54. In Review","author_count":4,"author_ids":["A5006156806","A5046986222","A5060555767","A5108326557"],"author_institution_ids":[],"authors":[{"id":"A5046986222","name":"Roland Geyer"},{"id":"A5060555767","name":"Sara Orofino"},{"id":"A5108326557","name":"Eleanor Thomas"},{"id":"A5006156806","name":"Darcy Bradley"}],"ca_any_author":true,"ca_led":true,"cited_by_count":1,"doi":"https://doi.org/10.5281/zenodo.23580756","domain_tags":[],"facet_tags":[],"institution_ids":["I154570441"],"is_oa":true,"journal":"Zenodo (CERN European Organization for Nuclear Research)","last_updated":"2026-11-22T12:46:00.618207","license":"cc-by","needs_review":false,"oa_status":"green","oa_url":"https://doi.org/10.5281/zenodo.23580756","openalex_topics":["T10753","T11108","T14179"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-10-22","study_type":"article","title":"Plastic consumption, waste generation, and waste management in California 1950-2050","type":"article","work_id":"W7223225806","year":2026},{"abstract":"As plastic pollution continues to rise, policies to curb plastic consumption and waste generation are urgently needed. Using material flow analysis, economic input-output models, and trend projection, we construct a business-as-usual baseline of plastic consumption, and plastic waste generation and management in California for 1950\u20132050. We then simulate the impact of source reduction, recycled content, and recycling rate mandates on plastic production, waste generation, and associated greenhouse gas emissions using California\u2019s Senate Bill 54 as a case study. We find that, if implemented successfully, Senate Bill 54 could reduce plastic waste by nearly 56 Mt and decrease associated greenhouse gas emissions by 164 Mt CO 2 equivalent between 2025 and 2050. Our results highlight the importance of integrated, multi-faceted policy by showing the effect of policy interventions in isolation and in combination. Our modeling approach provides a broadly applicable framework to support the design and evaluation of evidence-based plastic management strategies.","author_count":4,"author_ids":["A5006156806","A5046986222","A5060555767","A5108326557"],"author_institution_ids":["I1280640908","I154570441","I2801250486"],"authors":[{"id":"A5046986222","name":"Roland Geyer"},{"id":"A5060555767","name":"Sara Orofino"},{"id":"A5108326557","name":"Eleanor Thomas"},{"id":"A5006156806","name":"Darcy Bradley"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.1016/j.resconrec.2026.109248","domain_tags":[],"facet_tags":[],"institution_ids":["I1280640908","I154570441","I2801250486"],"is_oa":true,"journal":"Resources Conservation and Recycling","last_updated":"2026-11-22T12:46:00.618207","license":"cc-by-nc","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1016/j.resconrec.2026.109248","openalex_topics":["T10435","T10753","T11108"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2026-11-21","study_type":"article","title":"Policy is essential to curb plastic pollution: the example of California\u2019s senate Bill 54","type":"article","work_id":"W7237360680","year":2026}]}
