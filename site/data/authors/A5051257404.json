r":2020},{"all":2104,"plastic":0,"year":2021},{"all":2061,"plastic":0,"year":2022},{"all":1958,"plastic":0,"year":2023},{"all":1964,"plastic":0,"year":2024},{"all":1932,"plastic":6,"year":2025},{"all":1638,"plastic":14,"year":2026}],"cited_by_count":23652,"current_in_ca":false,"domain_tags":[],"early_career":false,"first_pub_year":2002,"first_year":2024,"h_index":75,"institution_ids":["I36258959","I73616290","I88761825"],"last_ca_year":2025,"last_year":2024,"m_quotient":3.12,"name":"Choong\u2010Min Ryu","orcid":"https://orcid.org/0000-0002-7276-1189","plastic_basis":"openalex","plastic_citations":20,"plastic_works_count":1,"primary_affiliations":[{"country_code":"YE","id":"I118692353","name":"University of Science and Technology","source":"openalex_last_known"},{"country_code":"KR","id":"I73616290","name":"Korea Research Institute of Bioscience and Biotechnology","source":"openalex_last_known"},{"country_code":"KR","id":"I88761825","name":"Korea University of Science and Technology","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4403667492"]},"profile":{"bio":"","keywords":["PGPR","AMR","ISR","Bacterial volatiles"],"links":[{"label":"Researchgate","url":"https://www.researchgate.net/profile/Choong-Min_Ryu"},{"label":"Google Scholar","url":"https://scholar.google.com/citations?user=hK3GxlIAAAAJ&hl=en"},{"label":"KRIBB","url":"https://oak.kribb.re.kr/researcher-profile?ep=161&type=Article"}]},"schema_version":"s3.1","works":[{"abstract":"Polyethylene is widely used but highly resistant to biodegradation, owing to its composition of only a hydrocarbon backbone. For biodegradation to occur, oxidation within the polymer needs to be initiated. Galleria mellonella was the first insect discovered to autonomously oxidize polyethylene without the aid of gut microbes. However, the specific enzyme remains unidentified. Here, we identified for the first time two polyethylene oxidation enzyme candidates of cytochrome P450 (CYP) 6B2-GP04 and CYP6B2-13G08 from the G. mellonella midgut. Both candidate clones oxidized polyethylene efficiently, generating short-chain aliphatic compounds, with CYP6B2-GP04 exhibiting higher activity than CYP6B2-13G08 in yeast and insect cells. In silico structural modeling approaches revealed that the CYP6B2-GP04 Phe118 was essential for interacting with hydrocarbons, which was further validated by mutating phenylalanine to glycine. Furthermore, directed enzyme evolution led to the identification of an enzyme variant with significantly increased oxidation efficiency. Our findings offer promising enzyme-based solutions for polyethylene biodegradation, potentially mitigating polyethylene-driven plastic pollution.","author_count":9,"author_ids":["A5006140642","A5026295761","A5042719761","A5051257404","A5066536588","A5100443298"],"author_institution_ids":["I36258959","I73616290","I88761825"],"authors":[{"id":"A5026295761","name":"Jin\u2010Soo Son"},{"id":"A5100443298","name":"Soohyun Lee"},{"id":"A5066536588","name":"Sungbo Hwang"},{"id":"","name":"Jinyoung Jeong"},{"id":"A5006140642","name":"Seonghan Jang"},{"id":"","name":"Jiyoung Gong"},{"id":"","name":"Jae Young Choi"},{"id":"A5042719761","name":"Yeon Ho Je"},{"id":"A5051257404","name":"Choong\u2010Min Ryu"}],"ca_any_author":true,"ca_led":false,"cited_by_count":19,"doi":"https://doi.org/10.1016/j.jhazmat.2024.136264","domain_tags":["analytical_methods","fate_transport_and_sorption"],"facet_tags":[],"institution_ids":["I139264467","I36258959","I73616290","I88761825"],"is_oa":true,"journal":"Journal of Hazardous Materials","last_updated":"2026-11-09T13:22:03.289127","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1016/j.jhazmat.2024.136264","openalex_topics":["T10324","T10404","T11136"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10404","pub_date":"2024-10-23","study_type":"article","title":"Enzymatic oxidation of polyethylene by Galleria mellonella intestinal cytochrome P450s","type":"article","work_id":"W4403667492","year":2024}]}
