3759","name":"Fund for Scientific Research","years":[1994,1995,1996,1997]}],"author_id":"A5079164874","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":3387,"plastic":6,"year":2017},{"all":3461,"plastic":11,"year":2018},{"all":3477,"plastic":5,"year":2019},{"all":3408,"plastic":11,"year":2020},{"all":3641,"plastic":21,"year":2021},{"all":3368,"plastic":26,"year":2022},{"all":3102,"plastic":26,"year":2023},{"all":3111,"plastic":51,"year":2024},{"all":2688,"plastic":136,"year":2025},{"all":2006,"plastic":126,"year":2026}],"cited_by_count":61493,"current_in_ca":false,"domain_tags":[],"early_career":false,"first_pub_year":1989,"first_year":2014,"h_index":120,"institution_ids":["I130929987","I4210085935"],"last_ca_year":2014,"last_year":2014,"m_quotient":3.24,"name":"Philippe D\u00fabois","orcid":"https://orcid.org/0000-0003-1534-1564","plastic_basis":"openalex","plastic_citations":420,"plastic_works_count":13,"primary_affiliations":[{"country_code":"BE","id":"I130929987","name":"University of Mons","source":"openalex_last_known"},{"country_code":"BE","id":"I4210153783","name":"Materia Nova","source":"openalex_last_known"}],"rising_pct":91,"rising_score":0.0197,"work_count":1,"work_ids":["W2316708679"]},"schema_version":"s3.1","works":[{"abstract":"Identifying solvent- and catalyst-free conditions for polymerizations of engineering thermoplastics is of increasing interest due to new polymer processing technologies such as 3-D printing. We report the selective formation of linear poly(aryl ether sulfone)s (PESs) from the polycondensation of trimethylsilyl-protected bisphenol A (TMS-BPA) with nitro-substituted diaryl fluorides without added solvent or catalyst. DFT calculations show that nitro groups strategically placed in the ortho -position to the fluoride leaving group form a stable Meisenheimer complex during polyether synthesis. This strategy represents a route to linear PESs that employs anionic conditions, destabilizing propagating phenoxide chain ends preventing backbiting while simultaneously stabilizing the Meisenheimer complex intermediate. Thermodynamic over kinetic control in the polycondensation minimizes cyclic PES formation and promotes the formation of pure linear PESs.","author_count":8,"author_ids":["A5003328029","A5021955781","A5027080519","A5066104534","A5079164874","A5081220960","A5086640196","A5087768520"],"author_institution_ids":["I130929987","I4210085935"],"authors":[{"id":"A5003328029","name":"Jeannette M. Garc\u00eda"},{"id":"A5021955781","name":"Gavin O. Jones"},{"id":"A5081220960","name":"Julien De Winter"},{"id":"A5066104534","name":"Hans W. Horn"},{"id":"A5086640196","name":"Olivier Coulembier"},{"id":"A5079164874","name":"Philippe D\u00fabois"},{"id":"A5027080519","name":"Pascal Gerbaux"},{"id":"A5087768520","name":"James L. Hedrick"}],"ca_any_author":true,"ca_led":true,"cited_by_count":14,"doi":"https://doi.org/10.1021/ma501735q","domain_tags":["analytical_methods","human_exposure_and_health_risk"],"facet_tags":[],"institution_ids":["I130929987","I4210085935"],"is_oa":false,"journal":"Macromolecules","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1021/ma501735q","openalex_topics":["T10405","T10661","T12084"],"plastic_related":true,"plastic_tier":"chemicals-in-plastics","primary_topic":"T12084","pub_date":"2014-11-24","study_type":"article","title":"Meisenheimer Complex Inspired Catalyst- and Solvent-Free Synthesis of Noncyclic Poly(aryl ether sulfone)s","type":"article","work_id":"W2316708679","year":2014}]}
