d":"I182386381","name":"Zunyi Medical University","source":"openalex_last_known"},{"country_code":"US","id":"I223532165","name":"University of Utah","source":"openalex_last_known"},{"country_code":"CN","id":"I2802939634","name":"Chinese PLA General Hospital","source":"openalex_last_known"},{"country_code":"US","id":"I4210097601","name":"The University of Kansas Cancer Center","source":"openalex_last_known"},{"country_code":"CN","id":"I4210105984","name":"Guangdong Provincial Hospital of Chinese Medicine","source":"openalex_last_known"},{"country_code":"CN","id":"I4210115919","name":"The People's Hospital of Guangxi Zhuang Autonomous Region","source":"openalex_last_known"},{"country_code":"CN","id":"I4210132741","name":"Shanghai Tenth People's Hospital","source":"openalex_last_known"},{"country_code":"CN","id":"I4210151987","name":"Ministry of Agriculture and Rural Affairs","source":"openalex_last_known"},{"country_code":"CN","id":"I4210152119","name":"Jiangsu Province Hospital","source":"openalex_last_known"},{"country_code":"CN","id":"I4210159223","name":"Hainan Provincial Hospital of Traditional Chinese Medicine","source":"openalex_last_known"},{"country_code":"CN","id":"I4210160531","name":"Chinese People's Liberation Army","source":"openalex_last_known"},{"country_code":"CN","id":"I52158045","name":"China Agricultural University","source":"openalex_last_known"},{"country_code":"CN","id":"I55538621","name":"China Jiliang University","source":"openalex_last_known"},{"country_code":"CN","id":"I61057504","name":"Fujian Agriculture and Forestry University","source":"openalex_last_known"},{"country_code":"CN","id":"I90610280","name":"South China University of Technology","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W4317802055"]},"schema_version":"s3.1","works":[{"abstract":"Exposure to ubiquitous plastic-associated endocrine disrupting chemicals (EDCs) is associated with the increased risk of many chronic diseases. For example, phthalate exposure is associated with cardiometabolic mortality in humans, with societal costs \u223c $39 billion/year or more. We recently demonstrated that several widely used plastic-associated EDCs increase cardiometabolic disease in appropriate mouse models. In addition to affecting adult health, parental exposure to EDCs has also been shown to cause metabolic disorders, including obesity and diabetes, in the offspring. While most studies have focused on the impact of maternal EDC exposure on the offspring's health, little is known about the effects of paternal EDC exposure. In the current study, we investigated the adverse impact of paternal exposure to a ubiquitous but understudied phthalate, dicyclohexyl phthalate (DCHP) on the metabolic health of F1 and F2 offspring in mice. Paternal DCHP exposure led to exacerbated insulin resistance and impaired insulin signaling in F1 offspring without affecting diet-induced obesity. We previously showed that sperm small non-coding RNAs including tRNA-derived small RNAs (tsRNAs) and rRNA-derived small RNAs (rsRNAs) contribute to the intergenerational transmission of paternally acquired metabolic disorders. Using a novel PANDORA-seq, we revealed that DCHP exposure can lead to sperm tsRNA/rsRNA landscape changes that were undetected by traditional RNA-seq, which may contribute to DCHP-elicited adverse effects. Lastly, we found that paternal DCHP can also cause sex-specific transgenerational adverse effects in F2 offspring and elicited glucose intolerance in female F2 descendants. Our results suggest that exposure to endocrine disrupting phthalates may have intergenerational and transgenerational adverse effects on the metabolic health of their offspring. These findings increase our understanding of the etiology of chronic human diseases originating from chemical-elicited intergenerational and transgenerational effects.","author_count":9,"author_ids":["A5002815687","A5008342397","A5021206091","A5032462126","A5055436613","A5056516011","A5058762676","A5100326770","A5100340125"],"author_institution_ids":["I103635307"],"authors":[{"id":"A5100326770","name":"Jingwei Liu"},{"id":"A5058762676","name":"Junchao Shi"},{"id":"A5002815687","name":"Rebecca Hernandez"},{"id":"A5021206091","name":"Xiuchun Li"},{"id":"A5032462126","name":"Pranav Konchadi"},{"id":"A5056516011","name":"Yuma Miyake"},{"id":"A5100340125","name":"Qi Chen"},{"id":"A5055436613","name":"Tong Zhou"},{"id":"A5008342397","name":"Changcheng Zhou"}],"ca_any_author":true,"ca_led":true,"cited_by_count":84,"doi":"https://doi.org/10.1016/j.envint.2023.107769","domain_tags":["human_exposure_and_health_risk"],"facet_tags":[],"institution_ids":["I103635307","I134113660"],"is_oa":true,"journal":"Environment International","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"https://ars.els-cdn.com/content/image/1-s2.0-S0160412023000429-ga1_lrg.jpg","openalex_topics":["T10116","T10686","T11629"],"plastic_related":true,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10686","pub_date":"2023-01-23","study_type":"article","title":"Paternal phthalate exposure-elicited offspring metabolic disorders are associated with altered sperm small RNAs in mice","type":"article","work_id":"W4317802055","year":2023}]}
