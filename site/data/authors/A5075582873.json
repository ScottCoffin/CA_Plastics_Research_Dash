url":"https://doi.org/10.1016/b978-0-443-15332-7.00012-0","openalex_topics":["T10419","T10753","T14179"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2024-01-01","study_type":"book-chapter","title":"Microplastics in the terrestrial environment","type":"book-chapter","work_id":"W4391072224","year":2024},{"abstract":"","author_count":4,"author_ids":["A5008081391","A5075582873","A5136108258"],"author_institution_ids":["I11006740"],"authors":[{"id":"A5008081391","name":"Wenjian Lao"},{"id":"A5136108258","name":"Sydney Dial Sauers"},{"id":"","name":"Marina Salmon"},{"id":"A5075582873","name":"Charles S. Wong"}],"ca_any_author":true,"ca_led":true,"cited_by_count":22,"doi":"https://doi.org/10.1016/j.scitotenv.2024.170528","domain_tags":["soil_and_agriculture","wastewater_and_treatment"],"facet_tags":["matrix:soil_and_agriculture","matrix:wastewater"],"institution_ids":["I11006740"],"is_oa":false,"journal":"The Science of The Total Environment","last_updated":"2026-11-04T10:54:05.112534","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.scitotenv.2024.170528","openalex_topics":["T10180","T10419","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2024-01-29","study_type":"article","title":"Development and validation of an acid/alkaline digestion method for efficient microplastic extraction from wastewater treatment plant effluents: Sulfuric acid concentration and contact time do matter","type":"article","work_id":"W4391326442","year":2024},{"abstract":"","author_count":2,"author_ids":["A5042187657","A5075582873"],"author_institution_ids":["I11006740"],"authors":[{"id":"A5075582873","name":"Charles S. Wong"},{"id":"A5042187657","name":"Stephen B. Weisberg"}],"ca_any_author":true,"ca_led":true,"cited_by_count":10,"doi":"https://doi.org/10.1016/j.chemosphere.2024.141568","domain_tags":["occurrence_and_monitoring"],"facet_tags":[],"institution_ids":["I11006740"],"is_oa":false,"journal":"Chemosphere","last_updated":"2026-11-07T11:25:07.637180","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.chemosphere.2024.141568","openalex_topics":["T10180","T10753","T11890"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2024-02-26","study_type":"article","title":"Development of an accreditation process for analytical methods to measure microplastics in drinking water for regulatory monitoring","type":"article","work_id":"W4392170690","year":2024},{"abstract":"","author_count":4,"author_ids":["A5031423229","A5042187657","A5075582873","A5086442776"],"author_institution_ids":["I11006740"],"authors":[{"id":"A5075582873","name":"Charles S. Wong"},{"id":"A5086442776","name":"Scott Coffin"},{"id":"A5031423229","name":"Chelsea M. Rochman"},{"id":"A5042187657","name":"Stephen B. Weisberg"}],"ca_any_author":true,"ca_led":true,"cited_by_count":0,"doi":"https://doi.org/10.1016/j.chemosphere.2024.141662","domain_tags":[],"facet_tags":[],"institution_ids":["CAAG-OEHHA","I11006740","I185261750"],"is_oa":false,"journal":"Chemosphere","last_updated":"2026-10-31T12:09:11.096373","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1016/j.chemosphere.2024.141662","openalex_topics":["T10180","T10753","T11890"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2024-03-07","study_type":"editorial","title":"Informing methods for detecting and quantifying microplastics through the lens of a global intercalibration exercise: An editorial overview of the special issue and beyond","type":"editorial","work_id":"W4392560702","year":2024},{"abstract":"The concentration, character, and distribution of microplastics in coastal marine environments remain poorly understood, with most research focusing on the abundance of microplastics at the sea surface. To address this gap, we conducted one of the first comprehensive assessments of microplastic distribution through the marine water column and benthic sediment during the wet and dry season in the coastal waters of the San Pedro Bay Southern California, USA . Microplastic concentrations in the water column did not vary significantly across season but were significantly higher in nearshore environments and at the surface of the water column. Sediment samples contained significantly more microplastics in the wet season and in offshore environments. Black particles were the most dominant color, while fibers were the most abundant morphology, accounting for over 50% of both water column and sediment microplastics. Polyethylene and polypropylene were identified as the most abundant polymers in the water column regardless of morphology type. Tire and road wear particles were found through the study domain. Average microplastic concentrations in the San Pedro Bay were estimated to be 8.65 \u00d7 10 5 \u00b1 7.60 \u00d7 10 5 particles/km 2 and 3.19 \u00b1 2.96 particles/m\u00b3. This study highlights the complexity of microplastic concentration, character, and distribution in marine environments and demonstrates that surface only sampling strategies significantly underestimate microplastic concentrations. Our findings underscore the need for continued and expanded research into microplastic distribution and transport dynamics across the marine environment to aid in understanding, managing, and mitigating plastic pollution in coastal marine systems.","author_count":16,"author_ids":["A5003134517","A5004032318","A5015823765","A5017037052","A5036129385","A5039798807","A5061956366","A5063497734","A5070320621","A5074004321","A5075582873","A5082245751","A5101999092","A5106859066","A5115893263","A5115893264"],"author_institution_ids":["I11006740"],"authors":[{"id":"A5101999092","name":"Samiksha Singh"},{"id":"A5017037052","name":"Andrew B. Gray"},{"id":"A5070320621","name":"Clare Murphy-Hagan"},{"id":"A5074004321","name":"Hannah Hapich"},{"id":"A5015823765","name":"Win Cowger"},{"id":"A5115893263","name":"John Perna"},{"id":"A5003134517","name":"Tri Le"},{"id":"A5036129385","name":"Hinako Nogi"},{"id":"A5115893264","name":"Bani Badwal"},{"id":"A5061956366","name":"Karen McLaughlin"},{"id":"A5004032318","name":"Fay\u00e7al Kessouri"},{"id":"A5106859066","name":"Charles James Moore"},{"id":"A5082245751","name":"Gwen Lattin"},{"id":"A5039798807","name":"Leah M. Thornton Hampton"},{"id":"A5075582873","name":"Charles S. Wong"},{"id":"A5063497734","name":"Martha A. Sutula"}],"ca_any_author":true,"ca_led":true,"cited_by_count":30,"doi":"https://doi.org/10.1016/j.envres.2025.120866","domain_tags":["analytical_methods","fate_transport_and_sorption","occurrence_and_monitoring"],"facet_tags":["matrix:marine"],"institution_ids":["I103635307","I11006740"],"is_oa":true,"journal":"Environmental Research","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1016/j.envres.2025.120866","openalex_topics":["T10419","T10753","T12316"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2025-01-15","study_type":"article","title":"Microplastic pollution in the water column and benthic sediment of the San Pedro Bay, California, USA","type":"article","work_id":"W4406411186","year":2025},{"abstract":"","author_count":3,"author_ids":["A5008081391","A5075582873","A5136108258"],"author_institution_ids":["I11006740"],"authors":[{"id":"A5008081391","name":"Wenjian Lao"},{"id":"A5136108258","name":"Sydney Dial Sauers"},{"id":"A5075582873","name":"Charles S. Wong"}],"ca_any_author":true,"ca_led":true,"cited_by_count":7,"doi":"https://doi.org/10.1016/j.jhazmat.2025.140309","domain_tags":["air","analytical_methods"],"facet_tags":["matrix:air"],"institution_ids":["I11006740"],"is_oa":false,"journal":"Journal of Hazardous Materials","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://