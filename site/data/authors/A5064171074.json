thor_id":"A5064171074","ca_plastic_works_count":2,"ca_works_count":2,"citations_by_year":[{"all":298,"plastic":0,"year":2017},{"all":313,"plastic":0,"year":2018},{"all":240,"plastic":0,"year":2019},{"all":246,"plastic":0,"year":2020},{"all":252,"plastic":0,"year":2021},{"all":251,"plastic":28,"year":2022},{"all":323,"plastic":50,"year":2023},{"all":354,"plastic":112,"year":2024},{"all":333,"plastic":110,"year":2025},{"all":289,"plastic":109,"year":2026}],"cited_by_count":12670,"domain_tags":[],"early_career":false,"first_pub_year":1979,"first_year":2022,"h_index":57,"institution_ids":["I103635307"],"last_year":2024,"m_quotient":1.21,"name":"Michael C. Pirrung","orcid":"https://orcid.org/0000-0003-4585-8353","plastic_basis":"openalex","plastic_citations":409,"plastic_works_count":2,"primary_affiliations":[{"country_code":"US","id":"I103635307","name":"University of California, Riverside","source":"openalex_last_known"},{"country_code":"US","id":"I204250578","name":"University of California, Irvine","source":"openalex_last_known"}],"rising_pct":95,"rising_score":0.0285,"work_count":2,"work_ids":["W4210636251","W4396807674"]},"schema_version":"s3.1","works":[{"abstract":"Abstract Tire road wear particles (TRWPs) are one of the largest sources of microplastics to the urban environment with recent concerns as they also provide a pathway for additive chemicals to leach into the environment. Stormwater is a major source of TRWPs and associated additives to urban surface water, with additives including the antioxidant derivative N-(1,3-dimethylbutyl)-N\u2032-phenyl-p-phenylenediamine-quinone (6PPD-quinone) demonstrating links to aquatic toxicity at environmentally relevant concentrations. The present study used complementary analysis methods to quantify both TRWPs and a suite of known tire additive chemicals (including 6PPD-quinone) to an urban tributary in Australia during severe storm events. Concentrations of additives increased more than 40 times during storms, with a maximum concentration of 2760 ng/L for \u221115additives, 88 ng/L for 6PPD-quinone, and a similar profile observed in each storm. TRWPs were detected during storm peaks with a maximum concentration between 6.4 and 18 mg/L, and concentrations of TRWPs and all additives were highly correlated. Contaminant mass loads to this catchment were estimated as up to 100 g/storm for \u221115additives, 3 g/storm for 6PPD-quinone, and between 252 and 730 kg of TRWPs/storm. While 6PPD-quinone concentrations in this catchment were lower than previous studies, elevated concentrations post storm suggest prolonged aquatic exposure.","author_ids":["A5006316137","A5020019418","A5064171074","A5076180727","A5086226830","A5113095053"],"author_institution_ids":["I103635307"],"ca_any_author":true,"ca_led":false,"cited_by_count":379,"doi":"https://doi.org/10.1021/acs.est.1c07451","domain_tags":[],"facet_tags":["matrix:freshwater"],"institution_ids":["I103635307","I165143802"],"is_oa":true,"journal":"Environmental Science & Technology","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"green","oa_url":"https://escholarship.org/content/qt8c65j530/qt8c65j530.pdf","openalex_topics":["T10419","T10753","T11119"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2022-01-31","study_type":"article","title":"Concentrations of Tire Additive Chemicals and Tire Road Wear Particles in an Australian Urban Tributary","type":"article","work_id":"W4210636251","year":2022},{"abstract":"","author_ids":["A5018388046","A5056973848","A5064171074","A5065507145","A5086226830","A5088876514","A5111193301"],"author_institution_ids":["I103635307"],"ca_any_author":true,"ca_led":false,"cited_by_count":27,"doi":"https://doi.org/10.1016/j.chemosphere.2024.142319","domain_tags":[],"facet_tags":[],"institution_ids":["I103635307","I106938459","I173945262","I662221"],"is_oa":true,"journal":"Chemosphere","last_updated":"2026-11-10T11:39:43.021295","license":"c