{"author":{"affiliation_history":[{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","years":[2020,2021,2022,2023,2024,2025,2026]},{"country_code":"CN","id":"I76569877","name":"Southeast University","years":[2025]},{"country_code":"CN","id":"I37461747","name":"Wuhan University","years":[2024,2025]},{"country_code":"CN","id":"I24407930","name":"Hunan University of Science and Engineering","years":[2024]},{"country_code":"CN","id":"I4387152797","name":"Shandong Institute of Advanced Technology","years":[2024]},{"country_code":"CN","id":"I63371133","name":"Chongqing Jiaotong University","years":[2022]},{"country_code":"CN","id":"I162868743","name":"Tianjin University","years":[2022]},{"country_code":"CN","id":"I177739611","name":"Yangtze University","years":[2018,2022]},{"country_code":"CN","id":"I4391767789","name":"State Key Laboratory of Silicon Materials","years":[2018,2019,2021]},{"country_code":"CN","id":"I76130692","name":"Zhejiang University","years":[2018,2019,2021]},{"country_code":"CN","id":"I116953780","name":"Tongji University","years":[2020]},{"country_code":"US","id":"I2803209242","name":"University of California System","years":[2020]},{"country_code":"CN","id":"I17442442","name":"State Grid Corporation of China (China)","years":[2016]},{"country_code":"CN","id":"I4405280778","name":"State Grid Liaoning Electric Power Company (China)","years":[2016]},{"country_code":"CN","id":"I17145004","name":"Northwestern Polytechnical University","years":[2002,2003]}],"author_id":"A5103268543","ca_plastic_works_count":0,"ca_works_count":1,"citations_by_year":[{"all":0,"plastic":0,"year":2017},{"all":3,"plastic":0,"year":2018},{"all":7,"plastic":0,"year":2019},{"all":218,"plastic":0,"year":2020},{"all":866,"plastic":0,"year":2021},{"all":1874,"plastic":0,"year":2022},{"all":2358,"plastic":0,"year":2023},{"all":2869,"plastic":32,"year":2024},{"all":2596,"plastic":61,"year":2025},{"all":1673,"plastic":36,"year":2026}],"cited_by_count":12473,"domain_tags":[],"early_career":false,"first_pub_year":2002,"first_year":2024,"h_index":47,"institution_ids":["I161318765"],"last_year":2024,"m_quotient":1.96,"name":"Guorui Chen","orcid":"https://orcid.org/0000-0001-8387-5723","plastic_basis":"openalex","plastic_citations":129,"plastic_works_count":1,"primary_affiliations":[{"country_code":"US","id":"I161318765","name":"University of California, Los Angeles","source":"openalex_last_known"}],"rising_pct":88,"rising_score":0.0149,"work_count":1,"work_ids":["W4390604011"]},"schema_version":"s3.1","works":[{"abstract":"Future exploitation of marine resources in a sustainable and eco-friendly way requires autonomous underwater robotics with human-like perception. However, the development of such intelligent robots is now impeded by the lack of adequate underwater haptic sensing technology. Inspired by the populational coding strategy of the human tactile system, we harness the giant magnetoelasticity in soft polymer systems as an innovative platform technology to construct a multimodal underwater robotic skin for marine object recognition with intrinsic waterproofness and a simple configuration. The bioinspired magnetoelastic artificial skin enables multiplexed tactile modality in each single taxel and obtains an impressive classification rate of 95% in identifying seven types of marine creatures and marine litter. By introducing another degree of freedom in underwater haptic sensing, this work represents a milestone toward sustainable marine resource exploitation.","author_count":7,"author_ids":["A5027349342","A5063665829","A5076654722","A5089040164","A5100450180","A5101846379","A5103268543"],"author_institution_ids":["I161318765"],"authors":[{"id":"A5101846379","name":"Yihao Zhou"},{"id":"A5027349342","name":"Xun Zhao"},{"id":"A5063665829","name":"Jing Hua Xu"},{"id":"A5103268543","name":"Guorui Chen"},{"id":"A5076654722","name":"Trinny Tat"},{"id":"A5089040164","name":"Justin Li"},{"id":"A5100450180","name":"Jun Chen"}],"ca_any_author":true,"ca_led":true,"cited_by_count":126,"doi":"https://doi.org/10.1126/sciadv.adj8567","domain_tags":[],"facet_tags":["matrix:marine"],"institution_ids":["I161318765"],"is_oa":true,"journal":"Science Advances","last_updated":"2026-11-11T12:16:26.678958","license":"cc-by-nc","needs_review":false,"oa_status":"gold","oa_url":"https://doi.org/10.1126/sciadv.adj8567","openalex_topics":["T10338","T10868","T10914"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T10868","pub_date":"2024-01-05","study_type":"article","title":"A multimodal magnetoelastic artificial skin for underwater haptic sensing","type":"article","work_id":"W4390604011","year":2024}]}
