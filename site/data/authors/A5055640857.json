":null,"work_count":1,"work_ids":["W2022145333"]},"schema_version":"s3.1","works":[{"abstract":"Recent results showing a crystallographic orientation dependence of growth kinetics, secondary defects, and stress relief in annealing of ion-implanted Si are shown to be self-consistent if interpreted in terms of the influence of stresses upon annealing processes. The stress influence proposed is microplastic shear which is induced in [112] directions on (111) planes inclined to the implant surface by the biaxial stress created in the implant region by ion-implantation damage. The shear stresses are shown to be dependent on crystallographic orientation in a manner consistent with the model.","author_ids":["A5055640857","A5109887450"],"author_institution_ids":["I4210104735","I95457486"],"ca_any_author":true,"ca_led":true,"cited_by_count":14,"doi":"https://doi.org/10.1063/1.90168","domain_tags":[],"facet_tags":[],"institution_ids":["I4210104735","I95457486"],"is_oa":false,"journal":"Applied Physics Letters","last_updated":"2026-09-22T06:50:58.402377","license":"","needs_review":false,"oa_status":"closed","oa_url":"https://doi.org/10.1063/1.90168","openalex_topics":["T10472","T11853","T12166"],"plastic_related":false,"plastic_tier":"core","primary_topic":"T12166","pub_date":"1978-07-01","study_type":"article","title":"Role of stresses in annealing of ion-implantation damage in Si","type":"article","work_id":"W2022145333","year":1978}]}
