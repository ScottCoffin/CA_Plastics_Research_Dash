003]},{"country_code":"US","id":"I4210138199","name":"University of Washington Applied Physics Laboratory","years":[2003]},{"country_code":"US","id":"I4210086312","name":"Scientific Solutions (United States)","years":[2002]},{"country_code":"AU","id":"I31746571","name":"UNSW Sydney","years":[1992,1993,1995]},{"country_code":"CA","id":"I129902397","name":"Dalhousie University","years":[1989]}],"author_id":"A5045870646","ca_plastic_works_count":1,"ca_works_count":1,"citations_by_year":[{"all":433,"plastic":3,"year":2017},{"all":463,"plastic":6,"year":2018},{"all":632,"plastic":4,"year":2019},{"all":714,"plastic":27,"year":2020},{"all":909,"plastic":36,"year":2021},{"all":856,"plastic":27,"year":2022},{"all":941,"plastic":29,"year":2023},{"all":840,"plastic":17,"year":2024},{"all":885,"plastic":24,"year":2025},{"all":791,"plastic":15,"year":2026}],"cited_by_count":10831,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":1986,"first_year":2019,"h_index":58,"institution_ids":["I150209017"],"last_ca_year":2026,"last_year":2019,"m_quotient":1.45,"name":"M. A. Merrifield","orcid":"https://orcid.org/0000-0002-5026-8393","plastic_basis":"openalex","plastic_citations":190,"plastic_works_count":2,"primary_affiliations":[{"country_code":"US","id":"I150209017","name":"Scripps Institution of Oceanography","source":"openalex_last_known"},{"country_code":"US","id":"I36258959","name":"University of California San Diego","source":"openalex_last_known"}],"rising_pct":11,"rising_score":-0.0108,"work_count":1,"work_ids":["W2985644207"]},"schema_version":"s3.1","works":[{"abstract":"Life for many of the world\u2019s marine fish begins at the ocean surface. Ocean conditions dictate food availability and govern survivorship, yet little is known about the habitat preferences of larval fish during this highly vulnerable life-history stage. Here we show that surface slicks, a ubiquitous coastal ocean convergence feature, are important nurseries for larval fish from many ocean habitats at ecosystem scales. Slicks had higher densities of marine phytoplankton (1.7-fold), zooplankton (larval fish prey; 3.7-fold), and larval fish (8.1-fold) than nearby ambient waters across our study region in Hawai\u2018i. Slicks contained larger, more well-developed individuals with competent swimming abilities compared to ambient waters, suggesting a physiological benefit to increased prey resources. Slicks also disproportionately accumulated prey-size plastics, resulting in a 60-fold higher ratio of plastics to larval fish prey than nearby waters. Dissections of hundreds of larval fish found that 8.6% of individuals in slicks had ingested plastics, a 2.3-fold higher occurrence than larval fish from ambient waters. Plastics were found in 7 of 8 families dissected, including swordfish (Xiphiidae), a commercially targeted species, and flying fish (Exocoetidae), a principal prey item for tuna and seabirds. Scaling up across an \u223c1,000 km 2 coastal ecosystem in Hawai\u2018i revealed slicks occupied only 8.3% of ocean surface habitat but contained 42.3% of all neustonic larval fish and 91.8% of all floating plastics. The ingestion of plastics by larval fish could reduce survivorship, compounding threats to fisheries productivity posed by overfishing, climate change, and habitat loss.","author_count":19,"author_ids":["A5002915984","A5009425326","A5013034720","A5019310643","A5024473463","A5035372982","A5040681359","A5045216253","A5045408715","A5045870646","A5049804685","A5053461750","A5067068993","A5069241845","A5074586535","A5084090691","A5087897098","A5091907671","A5110965321"],"author_institution_ids":["I150209017"],"authors":[{"id":"A5013034720","name":"Jamison M. Gove"},{"id":"A5053461750","name":"Jonathan Whitney"},{"id":"A5087897098","name":"Margaret A. McManus"},{"id":"A5067068993","name":"Joey Lecky"},{"id":"A5045408715","name":"Felipe Carvalho"},{"id":"A5084090691","name":"Jennifer M. Lynch"},{"id":"A5009425326","name":"Jiwei Li"},{"id":"A50