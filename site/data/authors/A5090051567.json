{"all":364,"plastic":18,"year":2026}],"cited_by_count":6085,"current_in_ca":true,"domain_tags":[],"early_career":false,"first_pub_year":2002,"first_year":2022,"h_index":41,"institution_ids":["I4210095563"],"last_ca_year":2025,"last_year":2023,"m_quotient":1.71,"name":"Ryan C. Moffet","orcid":"https://orcid.org/0000-0002-2352-5454","plastic_basis":"openalex","plastic_citations":82,"plastic_works_count":2,"primary_affiliations":[{"country_code":"","id":"I4210095563","name":"Sonoma Technology (United States)","source":"atlas_recent"}],"rising_pct":74,"rising_score":0.0067,"work_count":2,"work_ids":["W4302362666","W4386902471"]},"schema_version":"s3.1","works":[{"abstract":"","author_count":16,"author_ids":["A5012514445","A5019467914","A5020360624","A5030520392","A5032668969","A5034122195","A5047496397","A5048915696","A5052385389","A5079743468","A5085320090","A5089108911","A5089929335","A5090051567","A5115592973","A5134907344"],"author_institution_ids":["I4210095563"],"authors":[{"id":"A5047496397","name":"Ana C. Morales"},{"id":"A5089929335","name":"Jay M. Tomlin"},{"id":"A5079743468","name":"Christopher P. West"},{"id":"A5012514445","name":"Felipe A. Rivera-Adorno"},{"id":"A5048915696","name":"Brianna N. Peterson"},{"id":"A5019467914","name":"Steven Sharpe"},{"id":"A5115592973","name":"Yoorae Noh"},{"id":"A5020360624","name":"Seyedeh Mahboobeh Teimouri Sendesi"},{"id":"A5052385389","name":"Brandon E. Boor"},{"id":"A5089108911","name":"John A. Howarter"},{"id":"A5090051567","name":"Ryan C. Moffet"},{"id":"A5034122195","name":"Swarup China"},{"id":"A5134907344","name":"Brian T. O\u2019Callahan"},{"id":"A5085320090","name":"Patrick Zakhia El-Khoury"},{"id":"A5030520392","name":"Andrew J. Whelton"},{"id":"A5032668969","name":"Alexander Laskin"}],"ca_any_author":true,"ca_led":false,"cited_by_count":72,"doi":"https://doi.org/10.1038/s41565-022-01219-9","domain_tags":[],"facet_tags":[],"institution_ids":["I142606810","I219193219","I2801280572","I4210095563"],"is_oa":true,"journal":"Nature Nanotechnology","last_updated":"2026-11-10T11:39:43.021295","license":"","needs_review":false,"oa_status":"green","oa_url":"https://www.osti.gov/servlets/purl/1988613","openalex_topics":["T10079","T10419","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2022-10-06","study_type":"article","title":"Atmospheric emission of nanoplastics from sewer pipe repairs","type":"article","work_id":"W4302362666","year":2022},{"abstract":"Microplastic particles are of increasing environmental concern due to the widespread uncontrolled degradation of various commercial products made of plastic and their associated waste disposal. Recently, common technology used to repair sewer pipes was reported as one of the emission sources of airborne microplastics in urban areas. This research presents results of the multi-modal comprehensive chemical characterization of the microplastic particles related to waste discharged in the pipe repair process and compares particle composition with the components of uncured resin and cured plastic composite used in the process. Analysis of these materials employs complementary use of surface-enhanced Raman spectroscopy, scanning transmission X-ray spectro-microscopy, single particle mass spectrometry, and direct analysis in real-time high-resolution mass spectrometry. It is shown that the composition of the relatively large (100 \u03bcm) microplastic particles resembles components of plastic material used in the process. In contrast, the composition of the smaller (micrometer and sub-micrometer) particles is significantly different, suggesting their formation from unintended polymerization of water-soluble components occurring in drying droplets of the air-discharged waste. In addition, resin material type influences the composition of released microplastic particles. Results are further discussed to guide the detection and advanced characterization of airborne microplastics in future field and laboratory studies pertaining to sewer pipe repair technology.","author_count":17,"author_ids":["A5012514445","A5019467914","A5030520392","A5032668969","A5041261757","A5042416176","A5047496397","A5047588154","A5048915696","A5055039515","A5058370161","A5085320090","A5089929335","A5090051567","A5092911421","A5115592973","A5134907344"],"author_institution_ids":["I4210095563"],"authors":[{"id":"A5048915696","name":"Brianna N. Peterson"},{"id":"A5047496397","name":"Ana C. Morales"},{"id":"A5089929335","name":"Jay M. Tomlin"},{"id":"A5042416176","name":"Carrie G. W. Gorman"},{"id":"A5058370161","name":"Peter E. Christ"},{"id":"A5019467914","name":"Steven Sharpe"},{"id":"A5041261757","name":"Shelby M. Huston"},{"id":"A5012514445","name":"Felipe A. Rivera-Adorno"},{"id":"A5134907344","name":"Brian T. O\u2019Callahan"},{"id":"A5055039515","name":"Matthew Fraund"},{"id":"A5115592973","name":"Yoorae Noh"},{"id":"A5092911421","name":"Pritee Pahari"},{"id":"A5030520392","name":"Andrew J. Whelton"},{"id":"A5085320090","name":"Patrick Zakhia El-Khoury"},{"id":"A5090051567","name":"Ryan C. Moffet"},{"id":"A5047588154","name":"Alla Zelenyuk"},{"id":"A5032668969","name":"Alexander Laskin"}],"ca_any_author":true,"ca_led":false,"cited_by_count":10,"doi":"https://doi.org/10.1039/d3em00193h","domain_tags":["air","analytical_methods","fate_transport_and_sorption"],"facet_tags":["matrix:air"],"institution_ids":["I142606810","I219193219","I2801280572","I4210095563"],"is_oa":true,"journal":"Environmental Science Processes & Impacts","last_updated":"2026-11-07T11:25:07.637180","license":"","needs_review":false,"oa_status":"green","oa_url":"https://www.osti.gov/servlets/purl/2204292","openalex_topics":["T10419","T10753","T13793"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10753","pub_date":"2023-01-01","study_type":"article","title":"Chemical characterization of microplastic particles formed in airborne waste discharged from sewer pipe repairs","type":"article","work_id":"W4