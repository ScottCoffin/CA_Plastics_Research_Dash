6070,"plastic":0,"year":2024},{"all":5849,"plastic":0,"year":2025},{"all":5330,"plastic":0,"year":2026}],"cited_by_count":190293,"domain_tags":[],"early_career":false,"first_pub_year":1974,"first_year":2021,"h_index":213,"institution_ids":["I1307098950"],"last_year":2021,"m_quotient":4.1,"name":"Ronald M. Evans","orcid":"https://orcid.org/0000-0002-9986-5965","plastic_basis":"openalex","plastic_citations":0,"plastic_works_count":0,"primary_affiliations":[{"country_code":"US","id":"I1307098950","name":"Salk Institute for Biological Studies","source":"openalex_last_known"}],"rising_pct":null,"rising_score":null,"work_count":1,"work_ids":["W3196598954"]},"schema_version":"s3.1","works":[{"abstract":"Bisphenol A and its derivatives are recognized as endocrine disruptors based on their complex effects on estrogen receptor (ER) signaling. While the effects of bisphenol derivatives on ER\u03b1 have been thoroughly evaluated, how these chemicals affect ER\u03b2 signaling is less well understood. Herein, we sought to identify novel ER\u03b2 ligands using a radioligand competitive binding assay to screen a chemical library of bisphenol derivatives. Many of the compounds identified showed intriguing dual activities as both ER\u03b1 agonists and ER\u03b2 antagonists. Docking simulations of these compounds and ER\u03b2 suggested that they bound not only to the canonical binding site of ER\u03b2 but also to the coactivator binding site located on the surface of the receptor, suggesting that they act as coactivator-binding inhibitors (CBIs). Receptor-ligand binding experiments using WT and mutated ER\u03b2 support the presence of a second ligand-interaction position at the coactivator-binding site in ER\u03b2, and direct binding experiments of ER\u03b2 and a coactivator peptide confirmed that these compounds act as CBIs. Our study is the first to propose that bisphenol derivatives act as CBIs, presenting critical insight for the future development of ER signaling-based drugs and their potential to function as endocrine disruptors.","author_count":11,"author_ids":["A5005581815","A5006471039","A5011147640","A5054837831","A5069654436","A5073418734","A5087519016","A5087598197","A5112446516","A5112681274"],"author_institution_ids":["I1307098950"],"authors":[{"id":"A5006471039","name":"Masaki Iwamoto"},{"id":"A5011147640","name":"Takahiro Masuya"},{"id":"A5005581815","name":"Mari Hosose"},{"id":"A5112681274","name":"Koki Tagawa"},{"id":"","name":"Tomoka Ishibashi"},{"id":"A5112446516","name":"Keitaro Suyama"},{"id":"A5069654436","name":"Takeru Nose"},{"id":"A5054837831","name":"Eiji Yoshihara"},{"id":"A5087598197","name":"Michael Downes"},{"id":"A5087519016","name":"Ronald M. Evans"},{"id":"A5073418734","name":"Ayami Matsushima"}],"ca_any_author":true,"ca_led":false,"cited_by_count":33,"doi":"https://doi.org/10.1016/j.jbc.2021.101173","domain_tags":[],"facet_tags":[],"institution_ids":["I1307098950","I135598925","I161318765","I177607063","I4210165985"],"is_oa":true,"journal":"Journal of Biological Chemistry","last_updated":"2026-11-10T11:39:43.021295","license":"cc-by","needs_review":false,"oa_status":"gold","oa_url":"http://www.jbc.org/article/S0021925821009753/pdf","openalex_topics":["T10211","T10686","T10756"],"plastic_related":false,"plastic_tier":"chemicals-in-plastics","primary_topic":"T10756","pub_date":"2021-09-06","study_type":"article","title":"Bisphenol A derivatives act as novel coactivator-binding inhibitors for estrogen receptor \u03b2","type":"article","work_id":"W3196598954","year":2021}]}
