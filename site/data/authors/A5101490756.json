":2022},{"all":441,"plastic":5,"year":2023},{"all":524,"plastic":37,"year":2024},{"all":663,"plastic":70,"year":2025},{"all":583,"plastic":86,"year":2026}],"cited_by_count":2982,"current_in_ca":true,"domain_tags":[],"early_career":true,"first_pub_year":2018,"first_year":2024,"h_index":28,"institution_ids":["I204250578"],"last_ca_year":2026,"last_year":2024,"m_quotient":3.5,"name":"Ziwei Han","orcid":"https://orcid.org/0000-0001-7377-3934","plastic_basis":"openalex","plastic_citations":198,"plastic_works_count":5,"primary_affiliations":[{"country_code":"CN","id":"I143593769","name":"East China University of Science and Technology","source":"openalex_last_known"},{"country_code":"CN","id":"I204710742","name":"Ministry of Ecology and Environment","source":"openalex_last_known"},{"country_code":"US","id":"I2803209242","name":"University of California System","source":"openalex_last_known"}],"rising_pct":90,"rising_score":0.0172,"work_count":1,"work_ids":["W4400619554"]},"profile":{"bio":"","keywords":["Environmental Engineering","Nano-remediation","Environmental Chemistry"],"links":[]},"schema_version":"s3.1","works":[{"abstract":"Biosolids from municipal wastewater treatment contain many contaminants of emerging concern, including microplastics (MPs), per- and polyfluoroalkyl substances (PFAS), pharmaceuticals and chemicals from personal care products (PPCPs). Many of these contaminants have very slow biotic or abiotic degradation rates and have been shown to have human and ecological health impacts. Application of biosolids to agriculture, a common disposal method, can result in extended environmental contamination. An approach for eliminating the contaminants is pyrolysis, which can also generate biochar, enhancing carbon sequestration as a side-benefit. We pyrolyzed biosolid samples from an operating facility at various temperatures from 400 to 700 \u00b0C with a 2-hour residence time. We then evaluated contaminant removal, which in many cases was 100 %, with only a few residuals. No trace of PFAS was detectable even at 400 \u00b0C. Overall mass removal of PPCPs, including PFAS, was over 99.9 %. MP removal via pyrolysis ranged from 91 to 97 %. The biochar contains significant amounts of Fe and P, which make it a useful fertilizer amendment. The techno-economic analysis indicates that pyrolysis may generate significant cost savings, and revenue from the sale of biochar, sufficient to more than cover the investment and operating costs of the dryer and pyrolysis unit.","author_count":8,"author_ids":["A5051088289","A5065885875","A5070104772","A5078071191","A5101490756","A5104487762","A5104518140","A5108326557"],"author_institution_ids":["I204250578"],"authors":[{"id":"A5065885875","name":"Arturo A. Keller"},{"id":"A5078071191","name":"Weiwei Li"},{"id":"A5104487762","name":"Yuki Floyd"},{"id":"A5051088289","name":"James Bae"},{"id":"A5104518140","name":"Kayla Marie Clemens"},{"id":"A5108326557","name":"Eleanor Thomas"},{"id":"A5101490756","name":"Ziwei Han"},{"id":"A5070104772","name":"Adeyemi S. Adeleye"}],"ca_any_author":true,"ca_led":true,"cited_by_count":55,"doi":"https://doi.org/10.1016/j.scitotenv.2024.174773","domain_tags":["fate_transport_and_sorption","soil_and_agriculture","wastewater_and_treatment"],"facet_tags":["matrix:soil_and_agriculture","matrix:wastewater"],"institution_ids":["I154570441","I204250578","I78577930"],"is_oa":true,"journal":"The Science of The Total Environment","last_updated":"2026-11-07T11:25:07.637180","license":"cc-by","needs_review":false,"oa_status":"hybrid","oa_url":"https://doi.org/10.1016/j.scitotenv.2024.174773","openalex_topics":["T10088","T10419","T10753"],"plastic_related":true,"plastic_tier":"core","primary_topic":"T10419","pub_date":"2024-07-14","study_type":"article","title":"Elimination of microplastics, PFAS, and PPCPs from biosolids via pyrolysis to produce biochar: Feasibility and techno-economic analysis","type":"article","work_id":"W4400619554","year":2024}]}
